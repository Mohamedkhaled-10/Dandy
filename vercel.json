{
  "redirects": [
    { "source": "/pages/shop/all-products(.html)?", "destination": "/all-products", "permanent": true },
    { "source": "/pages/shop/special-offers(.html)?", "destination": "/special-offers", "permanent": true },
    { "source": "/pages/shop/product(.html)?", "destination": "/product", "permanent": true },
    { "source": "/pages/shop/cart(.html)?", "destination": "/cart", "permanent": true },
    { "source": "/pages/shop/invoice(.html)?", "destination": "/invoice", "permanent": true },
    { "source": "/pages/shop/track-order(.html)?", "destination": "/track-order", "permanent": true },
    { "source": "/pages/support/help(.html)?", "destination": "/help", "permanent": true },
    { "source": "/pages/support/client-reviews(.html)?", "destination": "/client-reviews", "permanent": true },
    { "source": "/pages/blog/blog(.html)?", "destination": "/blog", "permanent": true },
    { "source": "/pages/blog/post(.html)?", "destination": "/post", "permanent": true },
    { "source": "/pages/legal/about-us(.html)?", "destination": "/about-us", "permanent": true },
    { "source": "/pages/legal/contact-us(.html)?", "destination": "/contact-us", "permanent": true },
    { "source": "/pages/legal/privacy-policy(.html)?", "destination": "/privacy-policy", "permanent": true },
    { "source": "/pages/legal/terms(.html)?", "destination": "/terms", "permanent": true },
    { "source": "/pages/auth/login(.html)?", "destination": "/login", "permanent": true },
    { "source": "/pages/dashboard/dashboard(.html)?", "destination": "/dashboard", "permanent": true },
    { "source": "/pages/dashboard/dashboard-order(.html)?", "destination": "/dashboard-order", "permanent": true },
    { "source": "/pages/dashboard/dashboard-product(.html)?", "destination": "/dashboard-product", "permanent": true },
    { "source": "/pages/dashboard/dashboard-blog(.html)?", "destination": "/dashboard-blog", "permanent": true },
    { "source": "/pages/dashboard/dashboard-index(.html)?", "destination": "/dashboard-index", "permanent": true },
    { "source": "/pages/dashboard/statues(.html)?", "destination": "/statues", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/all-products.html", "destination": "/all-products", "permanent": true },
    { "source": "/special-offers.html", "destination": "/special-offers", "permanent": true },
    { "source": "/product.html", "destination": "/product", "permanent": true },
    { "source": "/cart.html", "destination": "/cart", "permanent": true },
    { "source": "/invoice.html", "destination": "/invoice", "permanent": true },
    { "source": "/track-order.html", "destination": "/track-order", "permanent": true },
    { "source": "/help.html", "destination": "/help", "permanent": true },
    { "source": "/client-reviews.html", "destination": "/client-reviews", "permanent": true },
    { "source": "/blog.html", "destination": "/blog", "permanent": true },
    { "source": "/post.html", "destination": "/post", "permanent": true },
    { "source": "/about-us.html", "destination": "/about-us", "permanent": true },
    { "source": "/contact-us.html", "destination": "/contact-us", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/dashboard.html", "destination": "/dashboard", "permanent": true },
    { "source": "/dashboard-order.html", "destination": "/dashboard-order", "permanent": true },
    { "source": "/dashboard-product.html", "destination": "/dashboard-product", "permanent": true },
    { "source": "/dashboard-blog.html", "destination": "/dashboard-blog", "permanent": true },
    { "source": "/dashboard-index.html", "destination": "/dashboard-index", "permanent": true },
    { "source": "/statues.html", "destination": "/statues", "permanent": true }
  ],
  "rewrites": [
    { "source": "/product/:slug", "destination": "/product" },
    { "source": "/blog/:slug", "destination": "/post" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
