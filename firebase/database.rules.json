{
  "rules": {
    ".read": false,
    ".write": false,
    "homepage": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true"
    },
    "categories": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true"
    },
    "products": {
      ".read": true,
      ".indexOn": ["slug"],
      ".write": "auth != null && auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true"
    },
    "orders": {
      ".read": "(auth != null && auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true) || (auth != null && query.orderByChild == 'customerId' && query.equalTo == auth.uid)",
      ".indexOn": ["phone", "customerId", "invoiceCode"],
      ".write": false
    },
    "settings": {
      ".read": false,
      ".write": false
    },
    "testimonials": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true"
    },
    "customers": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true))",
        ".write": "auth != null && ((auth.uid == $uid && newData.exists()) || (auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true))",
        "phone": {
          ".validate": "newData.isString() && newData.val().length >= 10 && (!data.exists() || (auth != null && auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true) || newData.val() == data.val())"
        }
      }
    },
    "wishlists": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true))",
        ".write": "auth != null && (auth.uid == $uid || (auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true))"
      }
    },
    "reviews": {
      "$productId": {
        ".read": true,
        "$customerId": {
          ".write": false
        }
      },
      ".write": false
    },
    "_archive": {
      ".read": "auth != null && auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true",
      ".write": "auth != null && auth.token.email == 'admin@dandy.com' && auth.token.email_verified == true"
    },
    "privateOrderAccess": {
      ".read": false,
      ".write": false
    },
    "privateInvoiceAccess": {
      ".read": false,
      ".write": false
    },
    "privateOrderIdempotency": {
      ".read": false,
      ".write": false
    },
    "privateRateLimits": {
      ".read": false,
      ".write": false
    },
    "privateDeletedOrders": {
      ".read": false,
      ".write": false
    },
    "notifications_outbox": {
      ".read": false,
      ".write": false,
      ".indexOn": ["orderId", "timestamp"]
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
