// نسخة توثيقية من القواعد الحالية المنشورة فعليًا على Firebase Console بتاريخ 4 سبتمبر 2026. أي تعديل فعلي على الصلاحيات نفسها يتم في مرحلة أمان منفصلة لاحقًا — لا تُعدَّل هنا.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'orders@dandy.com';
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /change_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /staff_accounts/{staffId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
