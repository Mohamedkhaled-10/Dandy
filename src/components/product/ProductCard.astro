---
/**
 * DANDY COSMETICS — UNIFIED BOTANICAL EDITORIAL PRODUCT CARD (PHASE 3)
 * Reusable, accessible SSR product card grounded strictly in catalog & Pink Friday data.
 */
import Icon from '../ui/Icon.astro';
import type { Product } from '../../utils/products';
import type { CampaignPricingResult } from '../../utils/pink-friday-server';
import type { Locale } from '../../i18n/types';
import { buildLocalizedPath } from '../../i18n/routes';
import {
  FALLBACK_PRODUCT_IMAGE,
  formatEgpPrice,
  resolveProductCardViewModel,
} from '../../scripts/product-card';

export interface Props {
  product: Product;
  pinkFridayPricing?: CampaignPricingResult | null;
  priority?: boolean;
  revealChild?: boolean;
  locale?: Locale;
}

const {
  product,
  pinkFridayPricing = null,
  priority = false,
  revealChild = false,
  locale = 'ar',
} = Astro.props;

const isEn = locale === 'en';
const vm = resolveProductCardViewModel(product, pinkFridayPricing, locale);
const categoryHref = buildLocalizedPath(`/category/${vm.categorySlug}`, locale);
const fallbackAttr = FALLBACK_PRODUCT_IMAGE;
---

<article
  class:list={[
    'dandy-pcard',
    { 'is-sold-out': vm.isSoldOut, 'is-pink-friday': vm.isPinkFriday },
  ]}
  data-product-id={vm.id}
  data-category={vm.categorySlug}
  data-price={vm.currentPrice}
  data-sold-out={vm.isSoldOut ? 'true' : 'false'}
  data-dandy-reveal-child={revealChild ? '' : undefined}
>
  <div class:list={['dandy-pcard-stage', { 'is-fallback': vm.isFallbackImage }]}>
    {vm.badge && (
      <span class={`dandy-pcard-tag is-${vm.badge.tone}`}>
        {vm.badge.text}
      </span>
    )}

    <img
      src={vm.imageUrl}
      alt={vm.name}
      width="480"
      height="480"
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      referrerpolicy="no-referrer"
      class="dandy-pcard-img"
      onerror={`this.onerror=null;this.src='${fallbackAttr}';this.closest('.dandy-pcard-stage')?.classList.add('is-fallback');`}
    />
  </div>

  <div class="dandy-pcard-body">
    <div class="dandy-pcard-meta">
      <a href={categoryHref} class="dandy-pcard-category">
        {vm.categoryLabelAr}
      </a>
      {vm.shouldShowRating && vm.ratingValue && (
        <span
          class="dandy-pcard-rating"
          aria-label={
            isEn
              ? `Rated ${vm.ratingValue} out of 5 based on ${vm.reviewCount} reviews`
              : `تقييم ${vm.ratingValue} من 5 بناءً على ${vm.reviewCount} تقييم`
          }
        >
          <span aria-hidden="true" class="dandy-pcard-sep">·</span>
          <Icon name="star" size={12} strokeWidth={2} class="dandy-pcard-star" />
          <span class="dandy-tabular">{vm.ratingValue}</span>
          <span class="dandy-pcard-reviews dandy-tabular">({vm.reviewCount})</span>
        </span>
      )}
    </div>

    <h3 class="dandy-pcard-title">
      <a href={vm.href} class="dandy-pcard-link">{vm.name}</a>
    </h3>

    <div class="dandy-pcard-price-row">
      <span class="dandy-pcard-price dandy-tabular">{formatEgpPrice(vm.currentPrice, locale)}</span>
      {vm.oldPrice !== null && (
        <del
          class="dandy-pcard-old-price dandy-tabular"
          aria-label={
            isEn
              ? `Original price ${formatEgpPrice(vm.oldPrice, locale)}`
              : `السعر قبل الخصم ${formatEgpPrice(vm.oldPrice, locale)}`
          }
        >
          {formatEgpPrice(vm.oldPrice, locale)}
        </del>
      )}
    </div>

    <div class="dandy-pcard-actions">
      {vm.isSoldOut ? (
        <button
          type="button"
          class="dandy-pcard-btn is-soldout"
          disabled
          aria-disabled="true"
        >
          <span>{vm.ctaLabel}</span>
        </button>
      ) : vm.requiresVariantSelection ? (
        <a href={vm.href} class="dandy-pcard-btn is-variant">
          <Icon name="sliders" size={15} strokeWidth={1.8} />
          <span>{vm.ctaLabel}</span>
        </a>
      ) : (
        <button
          type="button"
          class="dandy-pcard-btn is-add"
          data-dandy-add-to-cart
          data-cart-payload={JSON.stringify(vm.cartPayload)}
        >
          <Icon name="shopping-bag" size={15} strokeWidth={1.8} />
          <span data-btn-label>{vm.ctaLabel}</span>
        </button>
      )}
    </div>
  </div>
</article>

<script>
  import { initProductCardActions } from '../../scripts/product-card-client';
  initProductCardActions();
</script>

<style is:global>
  .dandy-pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--dandy-bg-page);
    border: 1px solid var(--dandy-border-subtle);
    border-radius: var(--dandy-radius-md);
    overflow: hidden;
    transition:
      transform var(--dandy-transition-base),
      border-color var(--dandy-transition-base),
      box-shadow var(--dandy-transition-base);
  }

  .dandy-pcard:hover {
    transform: translateY(-2px);
    border-color: var(--dandy-border-default);
    box-shadow: var(--dandy-shadow-sm);
  }

  .dandy-pcard-stage {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: var(--dandy-bg-stage);
    overflow: hidden;
    text-decoration: none;
  }

  .dandy-pcard-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 360ms var(--dandy-ease-out);
  }

  .dandy-pcard-stage.is-fallback .dandy-pcard-img {
    object-fit: contain;
    padding: var(--dandy-space-8);
    opacity: 0.78;
  }

  .dandy-pcard:hover .dandy-pcard-img {
    transform: scale(1.025);
  }

  .dandy-pcard.is-sold-out .dandy-pcard-img {
    opacity: 0.62;
    filter: grayscale(0.2);
  }

  /* Single clean editorial tag (no pill capsule spam) */
  .dandy-pcard-tag {
    position: absolute;
    top: 10px;
    inset-inline-start: 10px;
    z-index: 2;
    padding: 4px 9px;
    border-radius: var(--dandy-radius-xs);
    font-family: var(--dandy-font-active-sans);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
    pointer-events: none;
  }

  .dandy-pcard-tag.is-discount {
    background-color: var(--dandy-ink-primary);
    color: var(--dandy-ink-inverse);
  }

  .dandy-pcard-tag.is-campaign {
    background-color: var(--dandy-plum-ink);
    color: var(--dandy-ink-inverse);
  }

  .dandy-pcard-tag.is-soldout {
    background-color: var(--dandy-bg-elevated);
    color: var(--dandy-ink-secondary);
    border: 1px solid var(--dandy-border-default);
  }

  .dandy-pcard-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 16px;
    gap: 8px;
  }

  /* Clean unboxed metadata row */
  .dandy-pcard-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: var(--dandy-text-xs);
    color: var(--dandy-ink-muted);
    line-height: 1.4;
  }

  .dandy-pcard-category {
    position: relative;
    z-index: 2;
    color: var(--dandy-ink-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--dandy-transition-fast);
  }

  .dandy-pcard-category:hover {
    color: var(--dandy-ink-primary);
  }

  .dandy-pcard-rating {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--dandy-ink-secondary);
    font-weight: 600;
  }

  .dandy-pcard-sep {
    color: var(--dandy-border-default);
    margin-inline-end: 2px;
  }

  .dandy-pcard-star {
    color: var(--dandy-gold-editorial);
    fill: var(--dandy-gold-editorial);
  }

  .dandy-pcard-reviews {
    color: var(--dandy-ink-muted);
    font-weight: 400;
  }

  .dandy-pcard-title {
    margin: 0;
    font-family: var(--dandy-font-active-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--dandy-ink-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.82em;
  }

  .dandy-pcard-title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dandy-transition-fast);
  }

  .dandy-pcard-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: pointer;
  }

  .dandy-pcard-title a:hover,
  .dandy-pcard-link:hover {
    color: var(--dandy-accent-text);
  }

  .dandy-pcard-link:focus {
    outline: none;
  }

  .dandy-pcard-link:focus-visible {
    outline: 2px solid var(--dandy-accent-primary) !important;
    outline-offset: 2px !important;
    border-radius: var(--dandy-radius-xs);
  }

  @supports selector(:has(*)) {
    .dandy-pcard:has(.dandy-pcard-link:focus-visible) {
      outline: 2px solid var(--dandy-accent-primary);
      outline-offset: 2px;
      border-color: var(--dandy-accent-primary);
      box-shadow: var(--dandy-shadow-sm);
    }

    .dandy-pcard:has(.dandy-pcard-link:focus-visible) .dandy-pcard-link:focus-visible {
      outline: none !important;
      outline-offset: 0 !important;
    }
  }

  .dandy-pcard-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 4px;
  }

  .dandy-pcard-price {
    font-size: 1rem;
    font-weight: 700;
    color: var(--dandy-ink-primary);
  }

  .dandy-pcard-old-price {
    font-size: 0.82rem;
    color: var(--dandy-ink-muted);
    text-decoration: line-through;
  }

  .dandy-pcard-actions {
    margin-top: 6px;
  }

  .dandy-pcard-actions > * {
    position: relative;
    z-index: 2;
  }

  .dandy-pcard-category:focus-visible,
  .dandy-pcard-btn:focus-visible,
  .dandy-wish-remove-btn:focus-visible {
    outline: 2px solid var(--dandy-accent-primary) !important;
    outline-offset: 2px !important;
  }

  .dandy-pcard-btn {
    width: 100%;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: var(--dandy-radius-sm);
    font-family: var(--dandy-font-active-sans);
    font-size: var(--dandy-text-sm);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid var(--dandy-ink-primary);
    background-color: var(--dandy-ink-primary);
    color: var(--dandy-ink-inverse);
    transition:
      background-color var(--dandy-transition-fast),
      border-color var(--dandy-transition-fast),
      color var(--dandy-transition-fast);
  }

  .dandy-pcard-btn.is-add:hover:not(:disabled) {
    background-color: var(--dandy-plum-ink);
    border-color: var(--dandy-plum-ink);
  }

  .dandy-pcard-btn.is-add.is-added {
    background-color: var(--dandy-botanical-deep);
    border-color: var(--dandy-botanical-deep);
    color: #FFFFFF;
  }

  .dandy-pcard-btn.is-variant {
    background-color: transparent;
    border-color: var(--dandy-border-default);
    color: var(--dandy-ink-primary);
  }

  .dandy-pcard-btn.is-variant:hover {
    background-color: var(--dandy-bg-editorial);
    border-color: var(--dandy-ink-primary);
  }

  .dandy-pcard-btn.is-soldout {
    background-color: var(--dandy-bg-stage);
    border-color: var(--dandy-border-subtle);
    color: var(--dandy-ink-muted);
    cursor: not-allowed;
  }

  @media (max-width: 639px) {
    .dandy-pcard-body {
      padding: 12px;
      gap: 6px;
    }

    .dandy-pcard-title {
      font-size: 0.875rem;
    }

    .dandy-pcard-btn {
      font-size: 0.8125rem;
      padding: 9px 10px;
    }
  }
</style>
