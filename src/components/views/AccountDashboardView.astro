---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../ui/Icon.astro';
import EditorialPageHeader from '../editorial/EditorialPageHeader.astro';
import { GOVERNORATES } from '../../scripts/purchase-flow';
import { SITE_URL } from '../../utils/products';
import { buildLocalizedPath } from '../../i18n/routes';
import type { Locale } from '../../i18n/types';

export interface Props {
  locale?: Locale;
}

const { locale = 'ar' } = Astro.props;
const isEn = locale === 'en';
const canonicalUrl = `${SITE_URL}${buildLocalizedPath('/account', locale)}`;
const allProductsHref = buildLocalizedPath('/all-products', locale);

const pageTitle = isEn
  ? 'My Account | Dandy Cosmetics'
  : 'حسابي | Dandy Cosmetics';
const pageDescription = isEn
  ? 'Manage your customer profile, track past orders, update saved delivery addresses, and view your wishlist at Dandy Cosmetics.'
  : 'إدارة حساب العميلة، متابعة الطلبات السابقة، العناوين المحفوظة، وقائمة المفضلة في متجر داندي.';
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  robots="noindex, nofollow"
>
  <EditorialPageHeader
    locale={locale}
    eyebrow={isEn ? 'Customer Account' : 'حساب العميلة'}
    title={isEn ? 'Your Personal DANDY Space' : 'مساحتكِ الخاصة في داندي'}
    description={
      isEn
        ? 'Follow up on your orders, save your preferred delivery addresses, and manage your saved favorites effortlessly.'
        : 'تابعي طلباتكِ، احتفظي بعناوين التوصيل المفضلة، وأديري قائمة منتجاتكِ المحفوظة بسهولة.'
    }
    currentCrumb={isEn ? 'My Account' : 'حسابي'}
  />

  <main class="dandy-page-band" id="accountMainContainer" data-dandy-motion="calm">
    <div class="dandy-container">
      <!-- Initial Auth Guard Loading -->
      <div id="accountLoading" class="dandy-acc-auth-loading" role="status" aria-live="polite">
        <div class="dandy-acc-spinner" aria-hidden="true"></div>
        <p>{isEn ? 'Verifying your account details...' : 'جاري التحقق من بيانات حسابكِ...'}</p>
      </div>

      <!-- Authenticated Account Workspace -->
      <div id="accountContent" class="dandy-acc-shell" hidden>
        <!-- Customer Identity Summary Bar -->
        <section class="dandy-acc-identity" aria-label={isEn ? 'Account summary' : 'ملخص الحساب'}>
          <div class="dandy-acc-user">
            <div class="dandy-acc-avatar" id="customerAvatar" aria-hidden="true">D</div>
            <div class="dandy-acc-user-meta">
              <h2 id="customerGreetingName" class="dandy-acc-greeting dandy-font-ar-display">
                {isEn ? 'Welcome back' : 'مرحباً بكِ'}
              </h2>
              <p id="customerEmailText" class="dandy-acc-email" dir="ltr"></p>
            </div>
          </div>

          <div class="dandy-acc-top-actions">
            <a href={allProductsHref} class="dandy-btn dandy-btn--outline">
              <Icon name="shopping-bag" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Shop Now' : 'تسوقي الآن'}</span>
            </a>
            <button type="button" id="logoutBtn" class="dandy-btn dandy-btn--outline dandy-acc-logout-btn">
              <Icon name="log-out" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Sign Out' : 'تسجيل الخروج'}</span>
            </button>
          </div>
        </section>

        <!-- Semantic Account Tabs -->
        <div class="dandy-acc-tabs-wrap">
          <nav class="dandy-acc-tabs" id="accountTabsBar" role="tablist" aria-label={isEn ? 'Account sections' : 'أقسام الحساب'}>
            <button
              type="button"
              role="tab"
              id="tabOverview"
              aria-selected="true"
              aria-controls="panelOverview"
              data-account-tab="overview"
              class="dandy-acc-tab is-active"
              tabindex="0"
            >
              <Icon name="user" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Overview' : 'نظرة عامة'}</span>
            </button>

            <button
              type="button"
              role="tab"
              id="tabOrders"
              aria-selected="false"
              aria-controls="panelOrders"
              data-account-tab="orders"
              class="dandy-acc-tab"
              tabindex="-1"
            >
              <Icon name="package" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Order History' : 'طلباتي'}</span>
              <span class="dandy-acc-tab-count dandy-tabular" id="ordersCountBadge">0</span>
            </button>

            <button
              type="button"
              role="tab"
              id="tabWishlist"
              aria-selected="false"
              aria-controls="panelWishlist"
              data-account-tab="wishlist"
              class="dandy-acc-tab"
              tabindex="-1"
            >
              <Icon name="heart" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Wishlist' : 'المفضلة'}</span>
              <span class="dandy-acc-tab-count dandy-tabular" id="wishlistCountBadge">0</span>
            </button>

            <button
              type="button"
              role="tab"
              id="tabAddresses"
              aria-selected="false"
              aria-controls="panelAddresses"
              data-account-tab="addresses"
              class="dandy-acc-tab"
              tabindex="-1"
            >
              <Icon name="map-pin" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Saved Addresses' : 'العناوين المحفوظة'}</span>
              <span class="dandy-acc-tab-count dandy-tabular" id="addressesCountBadge">0</span>
            </button>

            <button
              type="button"
              role="tab"
              id="tabProfile"
              aria-selected="false"
              aria-controls="panelProfile"
              data-account-tab="profile"
              class="dandy-acc-tab"
              tabindex="-1"
            >
              <Icon name="pencil" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Profile Details' : 'بياناتي'}</span>
            </button>
          </nav>
        </div>

        <!-- PANEL 1: OVERVIEW -->
        <section
          id="panelOverview"
          role="tabpanel"
          aria-labelledby="tabOverview"
          data-account-panel="overview"
          class="dandy-acc-panel is-active"
        >
          <div class="dandy-ov-stats-grid">
            <button type="button" class="dandy-ov-stat-card" data-jump-tab="orders">
              <span class="dandy-ov-stat-label">{isEn ? 'Total Orders' : 'إجمالي الطلبات'}</span>
              <strong id="overviewOrdersCount" class="dandy-ov-stat-val dandy-tabular">0</strong>
              <span class="dandy-ov-stat-link">{isEn ? 'View History →' : 'عرض السجل ←'}</span>
            </button>

            <button type="button" class="dandy-ov-stat-card" data-jump-tab="wishlist">
              <span class="dandy-ov-stat-label">{isEn ? 'Saved Products' : 'المنتجات المحفوظة'}</span>
              <strong id="overviewWishlistCount" class="dandy-ov-stat-val dandy-tabular">0</strong>
              <span class="dandy-ov-stat-link">{isEn ? 'Browse Wishlist →' : 'تصفح المفضلة ←'}</span>
            </button>

            <button type="button" class="dandy-ov-stat-card" data-jump-tab="addresses">
              <span class="dandy-ov-stat-label">{isEn ? 'Delivery Addresses' : 'عناوين التوصيل'}</span>
              <strong id="overviewAddressesCount" class="dandy-ov-stat-val dandy-tabular">0</strong>
              <span class="dandy-ov-stat-link">{isEn ? 'Manage Addresses →' : 'إدارة العناوين ←'}</span>
            </button>
          </div>

          <div class="dandy-ov-cards-grid">
            <article class="dandy-acc-surface">
              <div class="dandy-acc-surface-head">
                <h3 class="dandy-acc-surface-title">{isEn ? 'Latest Order' : 'أحدث طلب'}</h3>
              </div>
              <div id="overviewLatestOrder" class="dandy-ov-surface-body">
                <p class="dandy-ov-empty">{isEn ? 'Loading...' : 'جاري التحميل...'}</p>
              </div>
            </article>

            <article class="dandy-acc-surface">
              <div class="dandy-acc-surface-head">
                <h3 class="dandy-acc-surface-title">{isEn ? 'Default Shipping Address' : 'عنوان الشحن الافتراضي'}</h3>
              </div>
              <div id="overviewDefaultAddress" class="dandy-ov-surface-body">
                <p class="dandy-ov-empty">{isEn ? 'Loading...' : 'جاري التحميل...'}</p>
              </div>
            </article>
          </div>
        </section>

        <!-- PANEL 2: ORDERS HISTORY -->
        <section
          id="panelOrders"
          role="tabpanel"
          aria-labelledby="tabOrders"
          data-account-panel="orders"
          class="dandy-acc-panel"
          hidden
        >
          <div id="ordersLoading" class="dandy-acc-tab-loading" role="status">
            <div class="dandy-acc-spinner" aria-hidden="true"></div>
            <p>{isEn ? 'Loading your order history...' : 'جاري تحميل سجل طلباتكِ...'}</p>
          </div>

          <div id="ordersContainer" class="dandy-orders-list" hidden></div>

          <div id="ordersEmpty" class="dandy-acc-empty" hidden>
            <div class="dandy-acc-empty-icon" aria-hidden="true">
              <Icon name="package" size={28} strokeWidth={1.6} />
            </div>
            <h3>{isEn ? 'No past orders yet' : 'لا توجد طلبات سابقة حتى الآن'}</h3>
            <p>
              {isEn
                ? 'You have not placed any orders yet. Explore our botanical skin and hair care collection and begin your ritual today.'
                : 'لم تقومي بأي طلبات بعد. استكشفي مستحضرات العناية الطبيعية بالبشرة والشعر وابدئي روتينكِ اليوم.'}
            </p>
            <a href={allProductsHref} class="dandy-btn dandy-btn--editorial">
              <span>{isEn ? 'Explore Products' : 'استكشاف المنتجات'}</span>
              <Icon name="arrow-left" size={16} strokeWidth={1.85} directional={true} />
            </a>
          </div>
        </section>

        <!-- PANEL 3: WISHLIST -->
        <section
          id="panelWishlist"
          role="tabpanel"
          aria-labelledby="tabWishlist"
          data-account-panel="wishlist"
          class="dandy-acc-panel"
          hidden
        >
          <div id="wishlistLoading" class="dandy-acc-tab-loading" role="status">
            <div class="dandy-acc-spinner" aria-hidden="true"></div>
            <p>{isEn ? 'Loading your wishlist...' : 'جاري تحميل قائمة المفضلة...'}</p>
          </div>

          <div id="wishlistContainer" class="dandy-catalog-grid" hidden></div>

          <div id="wishlistEmpty" class="dandy-acc-empty" hidden>
            <div class="dandy-acc-empty-icon" aria-hidden="true">
              <Icon name="heart" size={28} strokeWidth={1.6} />
            </div>
            <h3>{isEn ? 'Your wishlist is currently empty' : 'قائمة المفضلة فارغة حالياً'}</h3>
            <p>
              {isEn
                ? 'Save your favorite formulations while browsing so you can return and add them to your bag anytime.'
                : 'احفظي منتجاتكِ المفضلة أثناء التصفح لتعودي إليها وتضيفيها إلى الحقيبة بسهولة لاحقاً.'}
            </p>
            <a href={allProductsHref} class="dandy-btn dandy-btn--editorial">
              <span>{isEn ? 'Browse Products' : 'تصفح المنتجات'}</span>
              <Icon name="arrow-left" size={16} strokeWidth={1.85} directional={true} />
            </a>
          </div>
        </section>

        <!-- PANEL 4: SAVED ADDRESSES -->
        <section
          id="panelAddresses"
          role="tabpanel"
          aria-labelledby="tabAddresses"
          data-account-panel="addresses"
          class="dandy-acc-panel"
          hidden
        >
          <div class="dandy-acc-section-head">
            <div>
              <h2 class="dandy-acc-section-title">
                {isEn ? 'Saved Delivery Addresses' : 'عناوين التوصيل المحفوظة'}
              </h2>
              <p class="dandy-acc-section-desc">
                {isEn
                  ? 'Saved addresses appear automatically during checkout to speed up your order placement.'
                  : 'تُستدعى هذه العناوين تلقائياً في صفحة إتمام الطلب لتسريع التوصيل.'}
              </p>
            </div>
            <button type="button" id="openAddAddressModalBtn" class="dandy-btn dandy-btn--primary">
              <Icon name="plus" size={16} strokeWidth={1.9} />
              <span>{isEn ? 'Add New Address' : 'إضافة عنوان جديد'}</span>
            </button>
          </div>

          <div id="addressesLoading" class="dandy-acc-tab-loading" role="status">
            <div class="dandy-acc-spinner" aria-hidden="true"></div>
            <p>{isEn ? 'Loading saved addresses...' : 'جاري تحميل العناوين...'}</p>
          </div>

          <div id="addressesContainer" class="dandy-addresses-grid" hidden></div>

          <div id="addressesEmpty" class="dandy-acc-empty" hidden>
            <div class="dandy-acc-empty-icon" aria-hidden="true">
              <Icon name="map-pin" size={28} strokeWidth={1.6} />
            </div>
            <h3>{isEn ? 'No saved addresses yet' : 'لا توجد عناوين محفوظة بعد'}</h3>
            <p>
              {isEn
                ? 'Save your home or office address to autofill delivery details with a single click at checkout.'
                : 'أضيفي عنوان منزلكِ أو مقر عملكِ لتعبئة بيانات الشحن بنقرة واحدة عند إتمام الطلب.'}
            </p>
            <button type="button" id="emptyAddAddressBtn" class="dandy-btn dandy-btn--editorial">
              <Icon name="plus" size={16} strokeWidth={1.9} />
              <span>{isEn ? 'Add Your First Address' : 'إضافة عنوانكِ الأول'}</span>
            </button>
          </div>
        </section>

        <!-- PANEL 5: PERSONAL PROFILE -->
        <section
          id="panelProfile"
          role="tabpanel"
          aria-labelledby="tabProfile"
          data-account-panel="profile"
          class="dandy-acc-panel"
          hidden
        >
          <div class="dandy-acc-profile-grid">
            <article class="dandy-acc-surface">
              <div class="dandy-acc-surface-head">
                <h2 class="dandy-acc-surface-title">{isEn ? 'Personal Details' : 'البيانات الشخصية'}</h2>
                <p class="dandy-acc-section-desc">
                  {isEn
                    ? 'Update the name displayed on your invoices and personal profile.'
                    : 'حدّثي اسمكِ الظاهر في الفواتير وحسابكِ الشخصي.'}
                </p>
              </div>

              <form id="profileForm" class="dandy-acc-form" novalidate>
                <div class="dandy-acc-field">
                  <label for="profName">{isEn ? 'Full Name' : 'الاسم الكامل'}</label>
                  <input type="text" id="profName" name="name" class="dandy-acc-input" required autocomplete="name" />
                </div>

                <div class="dandy-acc-field">
                  <label for="profEmail">{isEn ? 'Email Address' : 'البريد الإلكتروني'}</label>
                  <input type="email" id="profEmail" class="dandy-acc-input is-readonly" dir="ltr" readonly />
                </div>

                <div class="dandy-acc-field">
                  <label for="profPhone">{isEn ? 'Registered Mobile Number' : 'رقم الهاتف المسجل'}</label>
                  <input type="tel" id="profPhone" class="dandy-acc-input is-readonly" dir="ltr" readonly />
                  <small class="dandy-acc-hint">
                    {isEn
                      ? 'Your verified mobile number is linked to your order history and cannot be changed directly.'
                      : 'رقم الهاتف مرتبط بسجل الطلبات ولا يمكن تغييره ذاتياً لأغراض التوثيق.'}
                  </small>
                </div>

                <button type="submit" id="saveProfileBtn" class="dandy-btn dandy-btn--editorial">
                  {isEn ? 'Save Changes' : 'حفظ التغييرات'}
                </button>
              </form>
            </article>

            <article class="dandy-acc-surface">
              <div class="dandy-acc-surface-head">
                <h2 class="dandy-acc-surface-title">
                  {isEn ? 'Account Security & Password' : 'أمان الحساب وكلمة المرور'}
                </h2>
                <p class="dandy-acc-section-desc">
                  {isEn
                    ? 'Request a secure email link anytime to set a new password.'
                    : 'يمكنكِ طلب رابط آمن عبر البريد الإلكتروني لتعيين كلمة مرور جديدة في أي وقت.'}
                </p>
              </div>
              <div class="dandy-acc-security-box">
                <p>
                  {isEn
                    ? 'We will send a direct password reset link to your registered email address.'
                    : 'سيتم إرسال رسالة إلى بريدكِ الإلكتروني المسجل تحتوي على رابط إعادة التعيين المباشر.'}
                </p>
                <button type="button" id="sendResetPasswordBtn" class="dandy-btn dandy-btn--outline">
                  <Icon name="lock" size={16} strokeWidth={1.85} />
                  <span>{isEn ? 'Send Password Reset Link' : 'إرسال رابط تغيير كلمة المرور'}</span>
                </button>
              </div>
            </article>
          </div>
        </section>
      </div>
    </div>
  </main>

  <!-- DIALOG 1: ADD / EDIT ADDRESS -->
  <dialog id="addressDialog" class="dandy-dialog" aria-labelledby="modalTitle">
    <div class="dandy-dialog-card">
      <header class="dandy-dialog-head">
        <h3 id="modalTitle">{isEn ? 'Add New Address' : 'إضافة عنوان جديد'}</h3>
        <button
          type="button"
          id="closeAddressModalBtn"
          class="dandy-dialog-close"
          aria-label={isEn ? 'Close dialog' : 'إغلاق النافذة'}
        >
          <Icon name="x" size={18} strokeWidth={1.9} />
        </button>
      </header>

      <form id="addressForm" class="dandy-acc-form" novalidate>
        <input type="hidden" id="editAddressId" value="" />
        <div id="addressFormError" class="dandy-modal-error" role="alert" hidden></div>

        <div class="dandy-acc-field">
          <label for="addrLabel">
            {isEn ? 'Address Label' : 'تسمية العنوان'} <span class="dandy-req" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="addrLabel"
            class="dandy-acc-input"
            placeholder={isEn ? 'e.g., Home, Office, Family House' : 'مثال: المنزل، العمل، بيت العائلة'}
            required
          />
        </div>

        <div class="dandy-acc-field">
          <label for="addrGov">
            {isEn ? 'Governorate' : 'المحافظة'} <span class="dandy-req" aria-hidden="true">*</span>
          </label>
          <select id="addrGov" class="dandy-acc-input" required>
            <option value="">{isEn ? 'Select governorate' : 'اختر المحافظة'}</option>
            {GOVERNORATES.map((gov) => (
              <option value={gov.value}>{isEn ? gov.value : gov.labelAr}</option>
            ))}
          </select>
        </div>

        <div class="dandy-acc-field">
          <label for="addrCity">
            {isEn ? 'City / District' : 'المدينة / المركز / الحي'}{' '}
            <span class="dandy-req" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="addrCity"
            class="dandy-acc-input"
            placeholder={isEn ? 'e.g., Maadi, Nasr City, Tanta' : 'مثال: المعادي، مدينة نصر، طنطا'}
            required
          />
        </div>

        <div class="dandy-acc-field">
          <label for="addrDetail">
            {isEn ? 'Street Address & Details' : 'العنوان بالتفصيل'}{' '}
            <span class="dandy-req" aria-hidden="true">*</span>
          </label>
          <textarea
            id="addrDetail"
            rows="3"
            class="dandy-acc-input"
            placeholder={
              isEn
                ? 'Street name, building no., floor, apartment, or nearest landmark'
                : 'اسم الشارع، رقم العمارة، الدور، الشقة أو أقرب علامة مميزة'
            }
            required
          ></textarea>
        </div>

        <label class="dandy-acc-checkbox-row" for="addrIsDefault">
          <input type="checkbox" id="addrIsDefault" />
          <span>{isEn ? 'Set as default shipping address' : 'تعيين كعنوان الشحن الافتراضي'}</span>
        </label>

        <div class="dandy-dialog-actions">
          <button type="submit" id="saveAddressBtn" class="dandy-btn dandy-btn--editorial">
            {isEn ? 'Save Address' : 'حفظ العنوان'}
          </button>
          <button type="button" id="cancelAddressBtn" class="dandy-btn dandy-btn--outline">
            {isEn ? 'Cancel' : 'إلغاء'}
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- DIALOG 2: CONFIRM ADDRESS REMOVAL -->
  <dialog id="addressDeleteDialog" class="dandy-dialog" aria-labelledby="deleteDialogTitle">
    <div class="dandy-dialog-card dandy-dialog-card--narrow">
      <header class="dandy-dialog-head">
        <h3 id="deleteDialogTitle">{isEn ? 'Delete Saved Address' : 'تأكيد حذف العنوان'}</h3>
      </header>
      <p class="dandy-dialog-copy">
        {isEn ? (
          <>
            Are you sure you want to remove «<strong id="deleteAddressLabelPreview">selected</strong>» from your saved addresses?
          </>
        ) : (
          <>
            هل ترغبين في حذف العنوان «<strong id="deleteAddressLabelPreview">المحدد</strong>» من قائمتكِ المحفوظة؟
          </>
        )}
      </p>
      <div class="dandy-dialog-actions">
        <button type="button" id="confirmDeleteAddressBtn" class="dandy-btn dandy-btn--primary">
          {isEn ? 'Delete Address' : 'حذف العنوان'}
        </button>
        <button type="button" id="cancelDeleteAddressBtn" class="dandy-btn dandy-btn--outline">
          {isEn ? 'Cancel' : 'إلغاء'}
        </button>
      </div>
    </div>
  </dialog>

  <!-- DIALOG 3: VERIFIED PURCHASE REVIEW -->
  <dialog id="reviewDialog" class="dandy-dialog" aria-labelledby="reviewModalTitle">
    <div class="dandy-dialog-card">
      <header class="dandy-dialog-head">
        <h3 id="reviewModalTitle">{isEn ? 'Review Product' : 'تقييم المنتج'}</h3>
        <button
          type="button"
          id="closeReviewModalBtn"
          class="dandy-dialog-close"
          aria-label={isEn ? 'Close dialog' : 'إغلاق النافذة'}
        >
          <Icon name="x" size={18} strokeWidth={1.9} />
        </button>
      </header>

      <div class="dandy-review-preview">
        <img
          id="reviewProductThumb"
          src="/assets/images/logo.png"
          alt={isEn ? 'Product thumbnail' : 'صورة المنتج'}
          width="54"
          height="54"
          class="dandy-review-thumb"
          onerror="this.onerror=null;this.src='/assets/images/logo.png';"
        />
        <div class="dandy-review-meta">
          <span class="dandy-verified-purchase">
            <Icon name="check-circle" size={13} strokeWidth={2} />
            <span>{isEn ? 'Verified Purchase' : 'شراء مؤكد'}</span>
          </span>
          <h4 id="reviewProductName">{isEn ? 'Product Name' : 'اسم المنتج'}</h4>
          <span id="reviewOrderRef" class="dandy-tabular">{isEn ? 'Order: #...' : 'طلب رقم: #...'}</span>
        </div>
      </div>

      <form id="productReviewForm" class="dandy-acc-form" novalidate>
        <div class="dandy-acc-field dandy-stars-field">
          <label>
            {isEn ? 'Overall Product Rating' : 'تقييمكِ العام للمنتج'}{' '}
            <span class="dandy-req" aria-hidden="true">*</span>
          </label>
          <div class="dandy-star-selector" id="reviewStarsContainer" role="radiogroup" aria-label={isEn ? 'Star rating' : 'التقييم بالنجوم'}>
            {[1, 2, 3, 4, 5].map((val) => (
              <button
                type="button"
                role="radio"
                aria-checked={val === 5 ? 'true' : 'false'}
                class="dandy-star-btn is-active"
                data-val={val}
                aria-label={isEn ? `${val} out of 5` : `${val} من 5`}
              >
                <Icon name="star" size={24} strokeWidth={1.8} />
              </button>
            ))}
          </div>
          <div class="dandy-rating-desc" id="reviewRatingDesc">
            {isEn ? 'Excellent, highly recommended! (5/5)' : 'ممتاز، أنصح به بشدة! (5/5)'}
          </div>
        </div>

        <div class="dandy-acc-field">
          <label for="reviewComment">{isEn ? 'Your Review (Optional)' : 'تعليقكِ وتجربتكِ (اختياري)'}</label>
          <textarea
            id="reviewComment"
            rows="3"
            maxlength="500"
            class="dandy-acc-input"
            placeholder={
              isEn
                ? 'Share your thoughts on the formula, scent, and results...'
                : 'شاركينا رأيكِ في التركيبة والنتيجة بعد الاستخدام...'
            }
          ></textarea>
          <small class="dandy-acc-hint">{isEn ? 'Maximum 500 characters' : 'بحد أقصى 500 حرف'}</small>
        </div>

        <div class="dandy-dialog-actions">
          <button type="submit" id="saveReviewBtn" class="dandy-btn dandy-btn--editorial">
            <Icon name="send" size={15} strokeWidth={1.85} />
            <span id="saveReviewBtnLabel">{isEn ? 'Submit Review' : 'إرسال التقييم'}</span>
          </button>
          <button type="button" id="cancelReviewBtn" class="dandy-btn dandy-btn--outline">
            {isEn ? 'Cancel' : 'إلغاء'}
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <script>
    import { initCustomerAccountPage } from '../../scripts/account-client';
    initCustomerAccountPage();
  </script>
</BaseLayout>

