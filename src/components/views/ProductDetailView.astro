---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../ui/Icon.astro';
import ProductCard from '../product/ProductCard.astro';
import ProductGallery from '../commerce/ProductGallery.astro';
import ProductInfo from '../commerce/ProductInfo.astro';
import ReviewSummaryPanel from '../commerce/ReviewSummaryPanel.astro';
import {
  getAllProducts,
  getProductBySlug,
  getProductById,
  generateProductJsonLd,
  SITE_URL,
  type Product,
} from '../../utils/products';
import {
  getPublishedPinkFridayCampaign,
  calculatePinkFridayPricing,
} from '../../utils/pink-friday-server';
import {
  isProductSoldOut,
  normalizeProductVariants,
  resolveCategoryArabicLabel,
} from '../../scripts/product-card';
import {
  computePdpEffectivePricing,
  computeReviewStats,
  extractProductHighlights,
  normalizeProductGalleryImages,
  resolveLocalizedParsedDescription,
  selectRelatedProducts,
  type ReviewRecordInput,
} from '../../scripts/product-pdp';
import { resolveLocalizedProduct } from '../../i18n/content/adapters';
import { buildLocalizedPath } from '../../i18n/routes';
import type { Locale } from '../../i18n/types';

export interface Props {
  locale?: Locale;
  slug?: string;
}

const { locale = 'ar', slug } = Astro.props;
const isEn = locale === 'en';
const dir = isEn ? 'ltr' : 'rtl';

const RTDB_URL = 'https://dandy-562fc-default-rtdb.europe-west1.firebasedatabase.app';

const allProductsHref = buildLocalizedPath('/all-products', locale);
const homeHref = buildLocalizedPath('/', locale);

if (!slug) {
  return Astro.redirect(allProductsHref, 301);
}

const [livePfCampaign, allProducts] = await Promise.all([
  getPublishedPinkFridayCampaign(),
  getAllProducts(),
]);

// 1. Resolve product by slug
let product: Product | null = await getProductBySlug(slug);

// 2. Legacy ID fallback redirect (301) preserving tracking query params
if (!product) {
  const productById = await getProductById(slug);
  if (productById) {
    const searchParams = new URLSearchParams();
    for (const [k, v] of Astro.url.searchParams.entries()) {
      if (k.startsWith('utm_') || k === 'fbclid' || k === 'gclid') {
        searchParams.set(k, v);
      }
    }
    const qs = searchParams.toString() ? `?${searchParams.toString()}` : '';
    return Astro.redirect(
      `${buildLocalizedPath(`/product/${encodeURIComponent(productById.resolvedSlug)}`, locale)}${qs}`,
      301
    );
  }
}

// 3. Handle 404 when missing or hidden
const isNotFound = !product || product.isHidden;
if (isNotFound) {
  Astro.response.status = 404;
}

// 4. Enforce canonical slug URL (301 redirect for non-canonical alias)
if (product && !product.isHidden) {
  const reqSlug = decodeURIComponent(slug).toLowerCase().trim();
  if (reqSlug !== product.resolvedSlug.toLowerCase()) {
    const searchParams = new URLSearchParams();
    for (const [k, v] of Astro.url.searchParams.entries()) {
      if (k.startsWith('utm_') || k === 'fbclid' || k === 'gclid') {
        searchParams.set(k, v);
      }
    }
    const qs = searchParams.toString() ? `?${searchParams.toString()}` : '';
    return Astro.redirect(
      `${buildLocalizedPath(`/product/${encodeURIComponent(product.resolvedSlug)}`, locale)}${qs}`,
      301
    );
  }
}

// 5. Fetch real reviews SSR from public RTDB endpoint (never fabricated)
let rawReviews: Record<string, ReviewRecordInput> | null = null;
if (product && !isNotFound) {
  try {
    const revRes = await fetch(
      `${RTDB_URL}/reviews/${encodeURIComponent(product.id)}.json`,
      {
        headers: { Accept: 'application/json' },
        signal: AbortSignal.timeout(3500),
      }
    );
    if (revRes.ok) {
      const parsedJson = await revRes.json();
      if (parsedJson && typeof parsedJson === 'object') {
        rawReviews = parsedJson as Record<string, ReviewRecordInput>;
      }
    }
  } catch {
    rawReviews = null;
  }
}

const reviewStats = computeReviewStats(rawReviews, locale);
const localizedProductView =
  product && !isNotFound ? resolveLocalizedProduct(product, locale) : null;

// 6. SEO & Structured Data
const productName =
  localizedProductView?.localization.content.name ||
  product?.name ||
  (isEn ? 'Product Unavailable' : 'المنتج غير متوفر');

const pageTitle =
  product && !isNotFound
    ? isEn
      ? `${productName} | Dandy Cosmetics`
      : `${product.name} | داندي كوزمتكس - Dandy Cosmetics`
    : isEn
      ? 'Product Not Found (404) | Dandy Cosmetics'
      : 'المنتج غير موجود (404) | داندي كوزمتكس';

const rawSourceDesc = isEn
  ? localizedProductView?.localization.content.shortDescription ||
    localizedProductView?.localization.content.description ||
    ''
  : product?.description || '';
const rawDesc = rawSourceDesc.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const metaDescription = rawDesc
  ? rawDesc.length > 155
    ? rawDesc.substring(0, 155) + '...'
    : rawDesc
  : product && !isNotFound
    ? isEn
      ? `${productName} — Natural botanical care by Dandy Cosmetics Egypt.`
      : `${product.name} - مستحضر للعناية بالجمال من داندي كوزمتكس مصر.`
    : isEn
      ? 'The requested product is currently unavailable at Dandy Cosmetics.'
      : 'المنتج المطلوب غير متوفر حالياً في متجر داندي كوزمتكس.';

const canonicalUrl =
  product && !isNotFound
    ? `${SITE_URL}${buildLocalizedPath(`/product/${encodeURIComponent(product.resolvedSlug)}`, locale)}`
    : `${SITE_URL}${allProductsHref}`;

const ogImage =
  product?.image && !product.image.includes('images.unsplash.com')
    ? product.image
    : `${SITE_URL}/assets/images/fav-icons/android-chrome-512x512.png`;

const categoryMeta = product
  ? resolveCategoryArabicLabel(product, locale)
  : {
      slug: 'skin-care',
      labelAr: isEn ? 'Skin Care' : 'العناية بالبشرة',
    };

const categoryHref = buildLocalizedPath(`/category/${categoryMeta.slug}`, locale);

const productForJsonLd =
  product && !isNotFound
    ? {
        ...product,
        ...(reviewStats.count > 0
          ? { avgRating: reviewStats.average, reviewCount: reviewStats.count }
          : {}),
      }
    : null;

const jsonLd = productForJsonLd
  ? generateProductJsonLd(productForJsonLd, canonicalUrl, locale, {
      name: productName,
      description: localizedProductView?.localization.content.description || rawDesc,
      categoryName: categoryMeta.labelAr,
    })
  : null;

const breadcrumbJsonLd =
  product && !isNotFound
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: isEn ? 'Home' : 'الرئيسية',
            item: `${SITE_URL}${homeHref}`,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: categoryMeta.labelAr,
            item: `${SITE_URL}${categoryHref}`,
          },
          { '@type': 'ListItem', position: 3, name: productName, item: canonicalUrl },
        ],
      }
    : null;

// 7. Compute Grounded View Models
const pfPricing =
  product && !isNotFound ? calculatePinkFridayPricing(product, livePfCampaign) : null;
const pricing =
  product && !isNotFound
    ? computePdpEffectivePricing(product, 0, pfPricing)
    : computePdpEffectivePricing({ price: 0, onSale: false }, 0, null);

const isSoldOut = product ? isProductSoldOut(product) : false;
const isAvailable = Boolean(product && !isSoldOut && !isNotFound);

const galleryImages =
  product && !isNotFound ? normalizeProductGalleryImages(product, locale, productName) : [];

const stageBadge = isSoldOut
  ? { text: isEn ? 'Sold Out' : 'نفذت الكمية', tone: 'soldout' as const }
  : pricing.isPinkFriday
    ? { text: pricing.campaignBadgeText || 'Pink Friday', tone: 'campaign' as const }
    : pricing.discountPercent
      ? {
          text: isEn ? `${pricing.discountPercent}% OFF` : `خصم ${pricing.discountPercent}%`,
          tone: 'discount' as const,
        }
      : null;

const rawVariantsList = product ? normalizeProductVariants(product.variants) : [];
const variantsList =
  localizedProductView && localizedProductView.localization.variants.length > 0
    ? localizedProductView.localization.variants.map((v) => ({
        id: v.id,
        name: v.localizedName,
        isAvailable: v.isAvailable,
        ...(v.price !== null ? { price: v.price } : {}),
      }))
    : rawVariantsList;

const hasVariants = Boolean(
  product &&
    (product.hasVariants === true || (product.hasVariants as unknown) === 'true') &&
    variantsList.length > 0
);

const parsedDescription = product
  ? resolveLocalizedParsedDescription(product, locale)
  : resolveLocalizedParsedDescription({ id: '', description: '' }, locale);

const highlights =
  product && !isNotFound ? extractProductHighlights(product, parsedDescription, locale) : [];

const relatedProducts =
  product && !isNotFound ? selectRelatedProducts(allProducts, product, 4) : [];

// 8. WhatsApp & Social Share URLs
const waPhone = '201038941005';
const waMessage = product
  ? isEn
    ? `Hello Dandy, I would like to inquire about this product:\n- Product: ${productName}\n- Link: ${canonicalUrl}`
    : `مرحباً داندي، أود الاستفسار عن هذا المنتج:\n- اسم المنتج: ${product.name}\n- الرابط: ${canonicalUrl}`
  : '';
const waLink = `https://wa.me/${waPhone}?text=${encodeURIComponent(waMessage)}`;
const shareWaLink = product
  ? `https://wa.me/?text=${encodeURIComponent(productName + '\n' + canonicalUrl)}`
  : '#';
const shareFbLink = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`;
const shareIgLink = 'https://www.instagram.com/dandy_skincare_cosmotics';
const shareMessengerLink = 'https://www.facebook.com/profile.php?id=61563039704396';

