---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../ui/Icon.astro';
import CheckoutPageHeader from '../commerce/CheckoutPageHeader.astro';
import CheckoutStepper from '../commerce/CheckoutStepper.astro';
import CartRemoveDialog from '../commerce/CartRemoveDialog.astro';
import { GOVERNORATES } from '../../scripts/purchase-flow';
import { SITE_URL } from '../../utils/products';
import { buildLocalizedPath } from '../../i18n/routes';
import type { Locale } from '../../i18n/types';

export interface Props {
  locale?: Locale;
}

const { locale = 'ar' } = Astro.props;
const isEn = locale === 'en';
const allProductsHref = buildLocalizedPath('/all-products', locale);
const specialOffersHref = buildLocalizedPath('/special-offers', locale);
const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const canonicalUrl = `${SITE_URL}${buildLocalizedPath('/cart', locale)}`;

const pageTitle = isEn
  ? 'Shopping Bag & Checkout | Dandy Cosmetics'
  : 'حقيبة التسوق وإتمام الطلب | Dandy Cosmetics';
const pageDescription = isEn
  ? 'Review your shopping bag, calculate delivery shipping by governorate, and place your natural care order with Cash on Delivery across Egypt.'
  : 'راجعي محتويات حقيبة التسوق، احسبي تكلفة الشحن حسب المحافظة، وأكّدي طلبكِ من منتجات داندي الطبيعية مع الدفع عند الاستلام.';
const zeroPriceText = isEn ? '0 EGP' : '0 ج.م';
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={
    isEn
      ? 'shopping bag, checkout, Dandy Cosmetics, cash on delivery Egypt'
      : 'حقيبة التسوق، إتمام الطلب، داندي للتجميل، الدفع عند الاستلام'
  }
  canonical={canonicalUrl}
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg"
    />
  </Fragment>

  <CheckoutPageHeader
    locale={locale}
    eyebrow={isEn ? 'Secure Checkout' : 'مسار الشراء الآمن'}
    title={isEn ? 'Shopping Bag & Checkout' : 'حقيبة التسوق وإتمام الطلب'}
    description={
      isEn
        ? 'Review your selected formulas and enter your delivery details step by step with Cash on Delivery across all Egyptian governorates.'
        : 'راجعي منتجاتكِ المختارة وأدخلي بيانات التوصيل بخطوات واضحة مع الدفع عند الاستلام لجميع محافظات مصر.'
    }
    currentCrumb={isEn ? 'Shopping Bag' : 'حقيبة التسوق'}
  />

  <main class="dandy-page-band dandy-cart-page" data-dandy-motion="calm">
    <div class="dandy-container">
      <div class="dandy-cart-shell" id="cartCheckoutContainer">
        <!-- Empty Cart State -->
        <section
          id="cartEmptyState"
          class="dandy-cart-empty-card"
          aria-labelledby="emptyCartHeading"
          hidden
        >
          <div class="dandy-cart-empty-icon" aria-hidden="true">
            <Icon name="shopping-bag" size={28} strokeWidth={1.65} />
          </div>
          <h2 id="emptyCartHeading" class="dandy-cart-empty-title dandy-font-ar-display">
            {isEn ? 'Your Shopping Bag is Empty' : 'حقيبة التسوق فارغة حالياً'}
          </h2>
          <p class="dandy-cart-empty-desc">
            {isEn
              ? 'You haven’t added any botanical formulas to your bag yet. Explore Dandy’s natural skin, hair, and body care collection.'
              : 'لم تضيفي أي مستحضرات إلى حقيبتكِ بعد. تصفحي تشكيلة داندي الطبيعية للعناية بالبشرة والشعر والجسم.'}
          </p>
          <div class="dandy-cart-empty-actions">
            <a href={allProductsHref} class="dandy-btn dandy-btn--primary">
              <Icon name="shopping-bag" size={17} strokeWidth={1.85} />
              <span>{isEn ? 'Browse All Products' : 'تصفح جميع المنتجات'}</span>
            </a>
            <a href={specialOffersHref} class="dandy-btn dandy-btn--outline">
              <span>{isEn ? 'Explore Special Offers' : 'اكتشفي العروض الخاصة'}</span>
            </a>
          </div>
        </section>

        <!-- Active Checkout Flow -->
        <div id="checkoutFlowViews">
          <CheckoutStepper locale={locale} />

          <!-- Restrained Unboxed Storefront Guarantees -->
          <div
            class="dandy-cart-trust-strip"
            aria-label={isEn ? 'Dandy purchase guarantees' : 'ضمانات الشراء من داندي'}
            data-dandy-entrance="1"
          >
            <div class="dandy-cart-trust-item">
              <Icon name="truck" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Free shipping over 2,000 EGP' : 'شحن مجاني فوق 2,000 ج.م'}</span>
            </div>
            <div class="dandy-cart-trust-item">
              <Icon name="banknote" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Cash on Delivery (COD)' : 'الدفع عند الاستلام (COD)'}</span>
            </div>
            <div class="dandy-cart-trust-item">
              <Icon name="leaf" size={16} strokeWidth={1.85} />
              <span>{isEn ? '100% Authentic Natural Formulas' : 'تركيبات طبيعية أصلية 100%'}</span>
            </div>
            <div class="dandy-cart-trust-item">
              <Icon name="shield-check" size={16} strokeWidth={1.85} />
              <span>{isEn ? 'Instant Order Tracking' : 'تتبع فوري لحالة الطلب'}</span>
            </div>
          </div>

          <!-- STEP 1: CART REVIEW -->
          <section
            id="step-panel-1"
            class="checkout-step-panel active"
            aria-labelledby="step1Heading"
          >
            <div class="dandy-checkout-grid">
              <div class="dandy-checkout-main-col">
                <!-- Free Shipping Progress Indicator (> 2000 EGP) -->
                <div class="dandy-shipping-meter" id="freeShippingProgressBox">
                  <div class="dandy-shipping-meter-top">
                    <span class="dandy-shipping-meter-label">
                      <Icon name="truck" size={16} strokeWidth={1.85} />
                      <span id="freeShippingText">
                        {isEn
                          ? 'Calculating free shipping progress...'
                          : 'جاري حساب قيمة الشحن المجاني...'}
                      </span>
                    </span>
                    <span class="dandy-shipping-meter-pct dandy-tabular" id="freeShippingPctLabel">
                      0%
                    </span>
                  </div>
                  <div class="dandy-shipping-meter-rail" aria-hidden="true">
                    <div class="dandy-shipping-meter-fill" id="freeShippingFill"></div>
                  </div>
                </div>

                <div class="dandy-checkout-card">
                  <div class="dandy-checkout-card-head">
                    <h2 id="step1Heading" class="dandy-checkout-card-title">
                      <Icon name="shopping-bag" size={18} strokeWidth={1.85} />
                      <span>{isEn ? 'Items in Your Bag' : 'المنتجات في حقيبتكِ'}</span>
                    </h2>
                    <span class="dandy-cart-count-pill dandy-tabular" id="cartItemsCountBadge">
                      {isEn ? '0 items' : '0 منتج'}
                    </span>
                  </div>

                  <ul id="cartItemsList" class="dandy-cart-items-list"></ul>

                  <div class="dandy-cart-continue-row">
                    <a href={allProductsHref} class="dandy-cart-continue-link">
                      <Icon name="arrow-right" size={15} strokeWidth={1.85} directional={true} />
                      <span>
                        {isEn
                          ? 'Continue shopping & add more items'
                          : 'مواصلة التسوق وإضافة منتجات أخرى'}
                      </span>
                    </a>
                  </div>
                </div>
              </div>

              <aside
                class="dandy-checkout-summary-card"
                aria-label={isEn ? 'Bag Summary' : 'ملخص الحقيبة'}
              >
                <h3 class="dandy-summary-heading">
                  <Icon name="receipt" size={17} strokeWidth={1.85} />
                  <span>{isEn ? 'Order Summary' : 'ملخص الحساب'}</span>
                </h3>

                <div class="dandy-summary-rows">
                  <div class="dandy-summary-row">
                    <span class="dandy-sum-label">{isEn ? 'Subtotal' : 'المجموع الفرعي'}</span>
                    <span class="dandy-sum-value dandy-tabular" id="subtotalValSummary">
                      {zeroPriceText}
                    </span>
                  </div>
                  <div class="dandy-summary-row">
                    <span class="dandy-sum-label">{isEn ? 'Shipping Fee' : 'تكلفة الشحن'}</span>
                    <span
                      class="dandy-sum-value dandy-sum-value--muted"
                      id="shippingCostSummary1"
                    >
                      {isEn ? 'Calculated at next step' : 'تُحدد عند اختيار المحافظة'}
                    </span>
                  </div>
                </div>

                <div class="dandy-summary-total-row">
                  <span>{isEn ? 'Estimated Total' : 'الإجمالي التقديري'}</span>
                  <strong class="dandy-summary-grand dandy-tabular" id="grandTotalSummaryValue1">
                    {zeroPriceText}
                  </strong>
                </div>

                <button
                  type="button"
                  id="btnProceedToShipping"
                  class="dandy-btn dandy-btn--primary dandy-btn-full"
                >
                  <span>{isEn ? 'Proceed to Shipping' : 'متابعة لبيانات الشحن'}</span>
                  <Icon name="arrow-left" size={17} strokeWidth={1.9} directional={true} />
                </button>

                <p class="dandy-summary-footnote">
                  <Icon name="shield-check" size={15} strokeWidth={1.85} />
                  <span>
                    {isEn
                      ? 'No account required — guest checkout is fast and secure.'
                      : 'لا يلزم إنشاء حساب — إتمام الطلب متاح كضيفة بأمان كامل.'}
                  </span>
                </p>
              </aside>
            </div>
          </section>

          <!-- STEP 2: SHIPPING DETAILS -->
          <section
            id="step-panel-2"
            class="checkout-step-panel"
            aria-labelledby="step2Heading"
          >
            <div class="dandy-checkout-grid">
              <div class="dandy-checkout-card">
                <div class="dandy-checkout-card-head">
                  <h2 id="step2Heading" class="dandy-checkout-card-title">
                    <Icon name="map-pin" size={18} strokeWidth={1.85} />
                    <span>
                      {isEn ? 'Recipient & Delivery Details' : 'بيانات المستلمة وعنوان التوصيل'}
                    </span>
                  </h2>
                  <span class="dandy-guest-note">
                    {isEn ? 'Express Guest Checkout' : 'طلب ضيفة سريع'}
                  </span>
                </div>

                <!-- Optional Saved Addresses for Authenticated Customers -->
                <div id="savedAddressesSection" class="dandy-saved-addresses" style="display:none;">
                  <div class="dandy-saved-addresses-title">
                    <Icon name="user" size={16} strokeWidth={1.85} />
                    <span>
                      {isEn ? 'Saved Addresses in Your Account' : 'العناوين المحفوظة في حسابكِ'}
                    </span>
                  </div>
                  <div class="dandy-saved-mode-radios">
                    <label class="dandy-radio-choice">
                      <input type="radio" name="addressMode" id="addrModeSaved" value="saved" checked />
                      <span>{isEn ? 'Use saved address' : 'استخدام عنوان محفوظ'}</span>
                    </label>
                    <label class="dandy-radio-choice">
                      <input type="radio" name="addressMode" id="addrModeNew" value="new" />
                      <span>{isEn ? 'Enter new address' : 'إدخال عنوان جديد'}</span>
                    </label>
                  </div>
                  <div id="savedSelectWrap" class="dandy-field">
                    <label for="savedAddressSelect">
                      {isEn ? 'Select a saved address' : 'اختاري العنوان المحفوظ'}
                    </label>
                    <select id="savedAddressSelect" class="dandy-control">
                      <option value="">
                        {isEn ? '-- Select a saved address --' : '-- اختاري عنواناً محفوظاً --'}
                      </option>
                    </select>
                  </div>
                </div>

                <div
                  id="checkoutErrorSummary"
                  class="dandy-inline-alert dandy-inline-alert--error"
                  role="alert"
                  hidden
                ></div>

                <form id="shippingFormElement" class="dandy-checkout-form" novalidate>
                  <div class="dandy-field">
                    <label for="f-name">
                      {isEn ? 'Full Name' : 'الاسم بالكامل'}{' '}
                      <span class="dandy-req" aria-hidden="true">*</span>
                    </label>
                    <input
                      type="text"
                      id="f-name"
                      name="name"
                      autocomplete="name"
                      class="dandy-control"
                      placeholder={
                        isEn
                          ? 'Enter your full name (at least two words)'
                          : 'اكتبي اسمكِ بالكامل (كلمتين على الأقل)'
                      }
                      required
                    />
                    <p id="err-f-name" class="dandy-field-error" hidden></p>
                  </div>

                  <div class="dandy-form-row">
                    <div class="dandy-field">
                      <label for="f-phone">
                        {isEn ? 'Phone Number' : 'رقم الهاتف'}{' '}
                        <span class="dandy-req" aria-hidden="true">*</span>
                      </label>
                      <input
                        type="tel"
                        id="f-phone"
                        name="phone"
                        autocomplete="tel"
                        inputmode="tel"
                        dir="ltr"
                        class="dandy-control dandy-control--ltr dandy-tabular"
                        placeholder="01012345678"
                        required
                      />
                      <p id="err-f-phone" class="dandy-field-error" hidden></p>
                    </div>

                    <div class="dandy-field">
                      <label for="f-email">
                        {isEn ? 'Email Address (Optional)' : 'البريد الإلكتروني (اختياري)'}
                      </label>
                      <input
                        type="email"
                        id="f-email"
                        name="email"
                        autocomplete="email"
                        dir="ltr"
                        class="dandy-control dandy-control--ltr"
                        placeholder="name@example.com"
                      />
                      <p id="err-f-email" class="dandy-field-error" hidden></p>
                    </div>
                  </div>

                  <div class="dandy-form-row">
                    <div class="dandy-field">
                      <label for="f-gov">
                        {isEn ? 'Governorate' : 'المحافظة'}{' '}
                        <span class="dandy-req" aria-hidden="true">*</span>
                      </label>
                      <select id="f-gov" name="governorate" class="dandy-control" required>
                        <option value="">
                          {isEn ? 'Select Governorate' : 'اختاري المحافظة'}
                        </option>
                        {GOVERNORATES.map((gov) => (
                          <option value={gov.value}>{isEn ? gov.value : gov.labelAr}</option>
                        ))}
                      </select>
                      <p id="err-f-gov" class="dandy-field-error" hidden></p>
                    </div>

                    <div class="dandy-field">
                      <label for="f-city">
                        {isEn ? 'City / Area' : 'المدينة / المنطقة'}{' '}
                        <span class="dandy-req" aria-hidden="true">*</span>
                      </label>
                      <input
                        type="text"
                        id="f-city"
                        name="city"
                        autocomplete="address-level2"
                        class="dandy-control"
                        placeholder={
                          isEn
                            ? 'e.g., Nasr City, Dokki, Smouha'
                            : 'مثال: مدينة نصر، الدقي، سموحة'
                        }
                        required
                      />
                      <p id="err-f-city" class="dandy-field-error" hidden></p>
                    </div>
                  </div>

                  <div class="dandy-field">
                    <label for="f-address">
                      {isEn ? 'Detailed Street Address' : 'العنوان بالتفصيل'}{' '}
                      <span class="dandy-req" aria-hidden="true">*</span>
                    </label>
                    <input
                      type="text"
                      id="f-address"
                      name="address"
                      autocomplete="street-address"
                      class="dandy-control"
                      placeholder={
                        isEn
                          ? 'Street name, building number, floor/apartment, and nearest landmark'
                          : 'اسم الشارع، رقم العقار، الدور/الشقة، وعلامة مميزة'
                      }
                      required
                    />
                    <p id="err-f-address" class="dandy-field-error" hidden></p>
                  </div>
                </form>

                <div class="dandy-checkout-actions-bar">
                  <button type="button" id="btnBackToCart" class="dandy-btn dandy-btn--outline">
                    <Icon name="arrow-right" size={16} strokeWidth={1.85} directional={true} />
                    <span>{isEn ? 'Back to Bag' : 'العودة للحقيبة'}</span>
                  </button>
                  <button type="button" id="btnProceedToReview" class="dandy-btn dandy-btn--primary">
                    <span>{isEn ? 'Review Order' : 'الانتقال للمراجعة النهائية'}</span>
                    <Icon name="arrow-left" size={16} strokeWidth={1.85} directional={true} />
                  </button>
                </div>
              </div>

              <aside
                class="dandy-checkout-summary-card"
                aria-label={isEn ? 'Shipping & Order Summary' : 'ملخص الشحن والطلب'}
              >
                <h3 class="dandy-summary-heading">
                  <Icon name="receipt" size={17} strokeWidth={1.85} />
                  <span>{isEn ? 'Order Summary' : 'ملخص الطلب'}</span>
                </h3>

                <div class="dandy-summary-rows">
                  <div class="dandy-summary-row">
                    <span class="dandy-sum-label">{isEn ? 'Subtotal' : 'المجموع الفرعي'}</span>
                    <span class="dandy-sum-value dandy-tabular" id="subtotalValSummary2">
                      {zeroPriceText}
                    </span>
                  </div>
                  <div class="dandy-summary-row">
                    <span class="dandy-sum-label">{isEn ? 'Shipping Fee' : 'مصاريف الشحن'}</span>
                    <span
                      class="dandy-sum-value dandy-sum-value--muted dandy-tabular"
                      id="shippingCostSummary2"
                    >
                      {isEn ? 'Select governorate to calculate' : 'اختاري المحافظة لحساب الشحن'}
                    </span>
                  </div>
                </div>

                <div class="dandy-summary-total-row">
                  <span>{isEn ? 'Grand Total' : 'الإجمالي الكلي'}</span>
                  <strong class="dandy-summary-grand dandy-tabular" id="grandTotalSummaryValue2">
                    {zeroPriceText}
                  </strong>
                </div>

                <div class="dandy-summary-note-box">
                  <Icon name="truck" size={16} strokeWidth={1.8} />
                  <span>
                    {isEn
                      ? 'Shipping is calculated automatically by governorate and becomes free on orders over 2,000 EGP.'
                      : 'تُحسب تكلفة الشحن تلقائياً وفق المحافظة المختارة، وتصبح مجانية عند تجاوز 2,000 ج.م.'}
                  </span>
                </div>
              </aside>
            </div>
          </section>

          <!-- STEP 3: FINAL REVIEW & CONFIRM -->
          <section
            id="step-panel-3"
            class="checkout-step-panel"
            aria-labelledby="step3Heading"
          >
            <div class="dandy-checkout-grid">
              <div class="dandy-checkout-card">
                <div class="dandy-checkout-card-head">
                  <h2 id="step3Heading" class="dandy-checkout-card-title">
                    <Icon name="clipboard-check" size={18} strokeWidth={1.85} />
                    <span>
                      {isEn ? 'Final Review & Confirmation' : 'المراجعة النهائية وتأكيد الطلب'}
                    </span>
                  </h2>
                </div>

                <div class="dandy-review-block">
                  <div class="dandy-review-block-head">
                    <h3>{isEn ? 'Recipient & Delivery Info' : 'بيانات الشحن والمستلمة'}</h3>
                    <button type="button" class="dandy-link-btn" data-step-target="2">
                      {isEn ? 'Edit Details' : 'تعديل البيانات'}
                    </button>
                  </div>
                  <dl class="dandy-review-dl">
                    <div>
                      <dt>{isEn ? 'Recipient Name' : 'اسم المستلمة'}</dt>
                      <dd id="revCustName">—</dd>
                    </div>
                    <div>
                      <dt>{isEn ? 'Phone Number' : 'رقم التواصل'}</dt>
                      <dd id="revCustPhone" dir="ltr" class="dandy-tabular">—</dd>
                    </div>
                    <div>
                      <dt>{isEn ? 'Email Address' : 'البريد الإلكتروني'}</dt>
                      <dd id="revCustEmail" dir="ltr">—</dd>
                    </div>
                    <div>
                      <dt>{isEn ? 'City & Governorate' : 'المدينة والمحافظة'}</dt>
                      <dd id="revCustLocation">—</dd>
                    </div>
                    <div class="dandy-review-dl--full">
                      <dt>{isEn ? 'Detailed Address' : 'العنوان بالتفصيل'}</dt>
                      <dd id="revCustAddress">—</dd>
                    </div>
                  </dl>
                </div>

                <div class="dandy-review-block">
                  <div class="dandy-review-block-head">
                    <h3>{isEn ? 'Ordered Items' : 'المنتجات المطلوبة'}</h3>
                    <button type="button" class="dandy-link-btn" data-step-target="1">
                      {isEn ? 'Edit Bag' : 'تعديل الحقيبة'}
                    </button>
                  </div>
                  <div id="revProductsList"></div>
                </div>

                <!-- Cloudflare Turnstile Security Verification -->
                <div class="dandy-turnstile-wrap">
                  <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
                  <small class="dandy-turnstile-note">
                    <Icon name="lock" size={13} strokeWidth={1.9} />
                    <span>
                      {isEn ? 'Security check to protect your order' : 'تحقق أمني لحماية الطلبات'}
                    </span>
                  </small>
                </div>

                <div
                  id="reviewSubmitError"
                  class="dandy-inline-alert dandy-inline-alert--error"
                  role="alert"
                  hidden
                ></div>

                <div class="dandy-checkout-actions-bar">
                  <button type="button" id="btnBackToShipping" class="dandy-btn dandy-btn--outline">
                    <Icon name="arrow-right" size={16} strokeWidth={1.85} directional={true} />
                    <span>{isEn ? 'Back to Shipping' : 'العودة لبيانات الشحن'}</span>
                  </button>
                  <button type="button" id="finalPlaceOrderBtn" class="dandy-btn dandy-btn--botanical">
                    <Icon name="check" size={17} strokeWidth={2.1} />
                    <span>{isEn ? 'Confirm & Place Order' : 'تأكيد وإتمام الطلب'}</span>
                  </button>
                </div>
              </div>

              <aside
                class="dandy-checkout-summary-card"
                aria-label={isEn ? 'Payment & Grand Total' : 'طريقة الدفع والإجمالي'}
              >
                <h3 class="dandy-summary-heading">
                  <Icon name="banknote" size={17} strokeWidth={1.85} />
                  <span>{isEn ? 'Payment Method' : 'طريقة الدفع'}</span>
                </h3>

                <div class="dandy-cod-box">
                  <div class="dandy-cod-title">
                    <Icon name="banknote" size={17} strokeWidth={1.85} />
                    <strong>{isEn ? 'Cash on Delivery (COD)' : 'الدفع عند الاستلام (COD)'}</strong>
                  </div>
                  <p>
                    {isEn
                      ? 'You can inspect your products upon delivery before making payment.'
                      : 'يمكنكِ مراجعة المنتجات والتأكد منها عند استلام الشحنة قبل الدفع.'}
                  </p>
                </div>

                <div class="dandy-summary-rows">
                  <div class="dandy-summary-row">
                    <span class="dandy-sum-label">{isEn ? 'Subtotal' : 'المجموع الفرعي'}</span>
                    <span class="dandy-sum-value dandy-tabular" id="summSubtotal">
                      {zeroPriceText}
                    </span>
                  </div>
                  <div class="dandy-summary-row">
                    <span class="dandy-sum-label">{isEn ? 'Shipping Fee' : 'مصاريف الشحن'}</span>
                    <span class="dandy-sum-value dandy-tabular" id="summShipping">
                      {zeroPriceText}
                    </span>
                  </div>
                </div>

                <div class="dandy-summary-total-row">
                  <span>{isEn ? 'Total Due' : 'الإجمالي المستحق'}</span>
                  <strong class="dandy-summary-grand dandy-tabular" id="finalSummaryTotal">
                    {zeroPriceText}
                  </strong>
                </div>

                <p class="dandy-summary-footnote" id="savingTextLoader">
                  <Icon name="lock" size={14} strokeWidth={1.9} />
                  <span>
                    {isEn
                      ? 'Confirming saves your invoice and gives you an instant tracking code.'
                      : 'تأكيد الطلب يحفظ فاتورتكِ ويمنحكِ كود تتبع فوري.'}
                  </span>
                </p>
              </aside>
            </div>
          </section>
        </div>

        <CartRemoveDialog locale={locale} />
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      try {
        var primary = JSON.parse(localStorage.getItem('cart') || '[]');
        var legacy = JSON.parse(localStorage.getItem('dandy_cart') || '[]');
        var hasItems =
          (Array.isArray(primary) && primary.length > 0) ||
          (Array.isArray(legacy) && legacy.length > 0);
        if (!hasItems) {
          var flow = document.getElementById('checkoutFlowViews');
          var empty = document.getElementById('cartEmptyState');
          if (flow) flow.hidden = true;
          if (empty) empty.hidden = false;
        }
      } catch (_err) {}
    })();
  </script>

  <script>
    import { initCartCheckoutPage } from '../../scripts/cart-client';
    initCartCheckoutPage();
  </script>
</BaseLayout>

