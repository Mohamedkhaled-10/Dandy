---
// src/components/ConsentBanner.astro
// User privacy and marketing cookie consent banner for Dandy Cosmetics
import Icon from './ui/Icon.astro';
import type { Locale } from '../i18n/types';
import { getLocaleDirection } from '../i18n/config';
import { buildLocalizedPath } from '../i18n/routes';
import { t } from '../i18n/translator';

export interface Props {
  locale?: Locale;
}

const { locale = 'ar' } = Astro.props;
const dir = getLocaleDirection(locale);
const privacyHref = buildLocalizedPath('/privacy-policy', locale);
---

<div
  id="dandy-consent-banner"
  class="dandy-consent-banner"
  style="display: none;"
  dir={dir}
  role="dialog"
  aria-live="polite"
  aria-label={t(locale, 'consent.bannerTitle')}
>
  <div class="consent-container">
    <div class="consent-content">
      <div class="consent-icon-box" aria-hidden="true">
        <Icon name="shield-check" size={20} strokeWidth={1.8} />
      </div>
      <div class="consent-text-wrap">
        <h4 class="consent-title">{t(locale, 'consent.bannerTitle')}</h4>
        <p class="consent-desc">
          {t(locale, 'consent.bannerDesc')}{' '}
          <a href={privacyHref} target="_blank" rel="noopener noreferrer" class="consent-link">
            {t(locale, 'navigation.privacyPolicy')}
          </a>.
        </p>
      </div>
    </div>
    <div class="consent-actions">
      <button type="button" id="dandy-consent-accept-btn" class="consent-btn consent-btn-accept">
        <Icon name="check" size={16} strokeWidth={2.1} />
        <span>{t(locale, 'consent.acceptMarketing')}</span>
      </button>
      <button type="button" id="dandy-consent-reject-btn" class="consent-btn consent-btn-reject">
        <span>{t(locale, 'consent.essentialOnly')}</span>
      </button>
    </div>
  </div>
</div>

<style is:global>
  .dandy-consent-banner {
    position: fixed;
    bottom: 20px;
    inset-inline: 20px;
    max-width: 1080px;
    margin-inline: auto;
    background: var(--dandy-bg-elevated, #ffffff);
    border: 1px solid var(--dandy-border-default, #d9d2c9);
    border-radius: var(--dandy-radius-lg, 18px);
    box-shadow: var(--dandy-shadow-lg, 0 18px 40px -12px rgba(26, 23, 21, 0.2));
    z-index: 2147483645;
    padding: 18px 22px;
    animation: consentSlideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    font-family: var(--dandy-font-active-sans, inherit);
  }

  @keyframes consentSlideUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dandy-consent-banner {
      animation: none;
    }
  }

  .consent-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .consent-content {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    flex: 1 1 520px;
    min-width: 0;
  }

  .consent-icon-box {
    width: 42px;
    height: 42px;
    border-radius: var(--dandy-radius-sm, 10px);
    background: var(--dandy-bg-stage, #f5f4f1);
    color: var(--dandy-botanical-deep, #2e4a38);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--dandy-border-subtle, #ede9e3);
  }

  .consent-text-wrap {
    flex: 1;
    min-width: 0;
  }

  .consent-title {
    margin: 0 0 4px 0;
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--dandy-ink-primary, #1a1715);
    line-height: 1.4;
  }

  .consent-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--dandy-ink-secondary, #4a4540);
  }

  .consent-link {
    color: var(--dandy-accent-text, #9d1b4d);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .consent-link:hover {
    opacity: 0.8;
  }

  .consent-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .consent-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 20px;
    min-height: 42px;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--dandy-radius-sm, 10px);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
    border: 1px solid transparent;
    font-family: inherit;
    white-space: nowrap;
  }

  .consent-btn:focus-visible,
  .consent-link:focus-visible {
    outline: 2px solid var(--dandy-ink-primary, #1a1715);
    outline-offset: 2px;
  }

  .consent-btn-accept {
    background-color: var(--dandy-ink-primary, #1a1715);
    color: #ffffff;
  }

  .consent-btn-accept:hover {
    background-color: var(--dandy-accent-primary, #c83269);
    transform: translateY(-1px);
  }

  .consent-btn-reject {
    background: var(--dandy-bg-stage, #f5f4f1);
    color: var(--dandy-ink-primary, #1a1715);
    border-color: var(--dandy-border-default, #d9d2c9);
  }

  .consent-btn-reject:hover {
    background: var(--dandy-bg-editorial, #faf8f6);
    border-color: var(--dandy-ink-secondary, #4a4540);
  }

  @media (max-width: 767px) {
    .dandy-consent-banner {
      bottom: 66px; /* clear above 60px fixed bottom navigation on mobile */
      inset-inline: 10px;
      padding: 12px;
      border-radius: var(--dandy-radius-md, 14px);
    }

    .consent-container {
      gap: 10px;
    }

    .consent-content {
      gap: 10px;
      flex: 1 1 100%;
      align-items: center;
    }

    .consent-icon-box {
      width: 34px;
      height: 34px;
      border-radius: var(--dandy-radius-xs, 8px);
    }

    .consent-title {
      font-size: 0.84rem;
      margin-bottom: 2px;
    }

    .consent-desc {
      font-size: 0.74rem;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .consent-actions {
      width: 100%;
      gap: 8px;
    }

    .consent-btn {
      flex: 1 1 calc(50% - 4px);
      justify-content: center;
      gap: 6px;
      padding: 8px 10px;
      font-size: 0.76rem;
      min-height: 38px;
      border-radius: var(--dandy-radius-xs, 8px);
    }
  }
</style>

<script is:inline>
  (function() {
    function initBanner() {
      var banner = document.getElementById('dandy-consent-banner');
      if (!banner) return;

      // Do not display on excluded admin/internal pages
      if (window.DandyMeta && typeof window.DandyMeta.isExcludedRoute === 'function') {
        if (window.DandyMeta.isExcludedRoute()) {
          banner.style.display = 'none';
          return;
        }
      }

      var currentConsent = 'unset';
      if (window.DandyMeta && typeof window.DandyMeta.getConsent === 'function') {
        currentConsent = window.DandyMeta.getConsent();
      } else {
        try {
          currentConsent = localStorage.getItem('dandy_marketing_consent') || 'unset';
        } catch(e) {}
      }

      // If user hasn't made a choice yet, show the banner
      if (currentConsent === 'unset') {
        banner.style.display = 'block';
      } else {
        banner.style.display = 'none';
      }

      var acceptBtn = document.getElementById('dandy-consent-accept-btn');
      var rejectBtn = document.getElementById('dandy-consent-reject-btn');

      if (acceptBtn) {
        acceptBtn.addEventListener('click', function() {
          if (window.DandyMeta && typeof window.DandyMeta.setConsent === 'function') {
            window.DandyMeta.setConsent('granted');
          } else {
            try {
              localStorage.setItem('dandy_marketing_consent', 'granted');
              localStorage.setItem('dandy_consent_choice', 'all');
            } catch(e) {}
          }
          banner.style.display = 'none';
        });
      }

      if (rejectBtn) {
        rejectBtn.addEventListener('click', function() {
          if (window.DandyMeta && typeof window.DandyMeta.setConsent === 'function') {
            window.DandyMeta.setConsent('denied');
          } else {
            try {
              localStorage.setItem('dandy_marketing_consent', 'denied');
              localStorage.setItem('dandy_consent_choice', 'essential');
            } catch(e) {}
          }
          banner.style.display = 'none';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBanner);
    } else {
      initBanner();
    }
  })();
</script>
