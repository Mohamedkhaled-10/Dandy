---
// Header.astro
// Phase 02: Modern Minimal E-commerce Header & Navigation
---

<!-- 1. Announcement Bar: Clean, subtle, non-intrusive -->
<div class="announce-bar" id="site-announce-bar">
  <div class="announce-track">
    <span>Enjoy Free Shipping on orders above 2000 LE</span>
    <span>•</span>
    <span>توصيل مجاني لجميع الطلبات فوق 2000 جنيه</span>
    <span>•</span>
    <span>Enjoy Free Shipping on orders above 2000 LE</span>
    <span>•</span>
    <span>توصيل مجاني لجميع الطلبات فوق 2000 جنيه</span>
  </div>
</div>

<!-- 2. Main Header: Modern Minimal Composition -->
<header class="site-header" id="site-header">
  <div class="header-container">
    
    <!-- LEFT ZONE (Desktop: Menu trigger + Nav Links | Mobile: Hamburger Menu) -->
    <div class="header-left">
      <!-- Mobile / Compact Hamburger Trigger -->
      <button 
        type="button" 
        class="header-icon-btn mobile-menu-btn" 
        id="mobile-menu-trigger" 
        aria-label="القائمة الرئيسية" 
        onclick="window.toggleNav()"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <!-- Desktop Primary Navigation Links (Restrained, doesn't overpower branding) -->
      <nav class="desktop-nav" aria-label="التنقل الرئيسي" id="desktop-primary-nav">
        <a href="/" class="nav-link">الرئيسية</a>
        <a href="/all-products" class="nav-link">جميع المنتجات</a>
        <a href="/special-offers" class="nav-link badge-link">
          العروض
          <span class="nav-badge">خاص</span>
        </a>
        <a href="/track-order" class="nav-link">تتبع طلبك</a>
        <a href="/about-us" class="nav-link">عن داندي</a>
      </nav>
    </div>

    <!-- CENTER ZONE: Clean, balanced Brand Logo -->
    <div class="header-center">
      <a href="/" class="brand-logo" title="Dandy Cosmetics - الصفحة الرئيسية" id="header-brand-logo">
        <img 
          src="/assets/images/logo.png" 
          alt="Dandy Cosmetics" 
          width="130" 
          height="40" 
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <!-- RIGHT ZONE: Discoverable Search, Account & Cart -->
    <div class="header-right">
      
      <!-- Desktop Quick Search Pill Button (Highly discoverable as in modern commerce) -->
      <button 
        type="button" 
        class="desktop-search-trigger" 
        id="desktop-search-btn"
        onclick="window.toggleSearchPanel()" 
        aria-label="البحث عن منتجات"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="search-label">ابحثي عن منتج...</span>
        <kbd class="search-kbd">/</kbd>
      </button>

      <!-- Mobile Search Icon Button -->
      <button 
        type="button" 
        class="header-icon-btn mobile-search-btn" 
        id="mobile-search-trigger" 
        aria-label="بحث" 
        onclick="window.toggleSearchPanel()"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <!-- Divider -->
      <span class="header-divider" aria-hidden="true"></span>

      <!-- Auth State: Guest Login -->
      <a 
        href="/account-login" 
        id="header-auth-guest" 
        class="header-account-btn" 
        title="تسجيل الدخول" 
        aria-label="تسجيل الدخول"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span class="account-btn-text">دخول</span>
      </a>

      <!-- Auth State: Authenticated Customer -->
      <div id="header-auth-user" class="header-auth-user-wrap" style="display:none;">
        <a 
          href="/account" 
          class="header-account-btn active-user" 
          title="حسابي" 
          aria-label="حسابي الشخصي"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span class="account-btn-text">حسابي</span>
        </a>
        <button 
          type="button" 
          class="header-icon-btn logout-btn" 
          onclick="window.headerSignOut()" 
          title="تسجيل خروج" 
          aria-label="تسجيل خروج"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </button>
      </div>

      <!-- Cart Button with Shared Dynamic Counter -->
      <a href="/cart" class="header-cart-btn" id="header-cart-link" aria-label="سلة التسوق" title="سلة التسوق">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <path d="M3 6h18"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <span class="cart-count-badge" id="cart-count">0</span>
      </a>

    </div>

  </div>
</header>

<!-- 3. Side Navigation Drawer: Modern Minimal Polish -->
<div class="menu-overlay" id="menu-overlay" onclick="window.toggleNav()" aria-hidden="true"></div>

<aside class="menubar" id="menubar" aria-label="القائمة الجانبية" role="dialog" aria-modal="true">
  <!-- Drawer Header -->
  <div class="menubar-header">
    <div class="drawer-logo">
      <img src="/assets/images/logo.png" alt="Dandy Cosmetics" height="32" />
    </div>
    <button 
      type="button" 
      class="close-menu-btn" 
      id="close-menu-trigger" 
      onclick="window.toggleNav()" 
      aria-label="إغلاق القائمة"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Drawer Body -->
  <div class="menubar-content">
    
    <!-- Quick Search In Mobile Drawer -->
    <div class="drawer-search-box" onclick="window.toggleNav(); window.toggleSearchPanel();">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <span>ابحثي في المتجر...</span>
    </div>

    <!-- User Account Status Block -->
    <div class="drawer-auth-block">
      <div id="menu-auth-guest">
        <a href="/account-login" class="drawer-auth-btn">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <div class="auth-text">
            <strong>تسجيل الدخول / إنشاء حساب</strong>
            <small>تابعي طلباتك وحصلي على عروض حصرية</small>
          </div>
        </a>
      </div>

      <div id="menu-auth-user" style="display:none;">
        <div class="drawer-user-info">
          <a href="/account" class="drawer-auth-btn">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <div class="auth-text">
              <strong>حسابي الشخصي</strong>
              <small>إدارة الطلبات والعناوين</small>
            </div>
          </a>
          <button type="button" class="drawer-logout-btn" onclick="window.headerSignOut()" title="تسجيل خروج">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            <span>خروج</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Navigation Links -->
    <div class="drawer-section-title">التنقل</div>
    <ul class="drawer-nav-list">
      <li>
        <a href="/" class="drawer-nav-item">
          <span>الرئيسية</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </li>
      <li>
        <a href="/all-products" class="drawer-nav-item">
          <span>جميع المنتجات</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </li>
      <li>
        <a href="/special-offers" class="drawer-nav-item highlight-item">
          <span class="with-badge">
            العروض الخاصة
            <span class="special-tag">خصومات</span>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </li>
      <li>
        <a href="/track-order" class="drawer-nav-item">
          <span>تتبع حالة طلبك</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </li>
      <li>
        <a href="/help" class="drawer-nav-item">
          <span>المساعدة ودليل الهدايا</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </li>
      <li>
        <a href="/client-reviews" class="drawer-nav-item">
          <span>آراء وتجارب العميلات</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </li>
      <li>
        <a href="/blog" class="drawer-nav-item">
          <span>مقالات العناية والجمال</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </li>
      <li>
        <a href="/about-us" class="drawer-nav-item">
          <span>عن داندي Dandy</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </li>
      <li>
        <a href="/contact-us" class="drawer-nav-item">
          <span>تواصل معنا</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </li>
    </ul>

    <!-- Drawer Footer Links -->
    <div class="drawer-footer-links">
      <a href="/privacy-policy">سياسة الخصوصية</a>
      <span class="dot">•</span>
      <a href="/terms">الشروط والأحكام</a>
      <span class="dot">•</span>
      <a href="/contact-us">الدعم الفني</a>
    </div>

  </div>
</aside>

<!-- 4. Live Search Drawer Modal: Modern Minimal Polish -->
<div class="search-overlay" id="search-overlay" onclick="window.toggleSearchPanel()" aria-hidden="true"></div>

<div class="search-panel" id="search-panel" role="dialog" aria-modal="true" aria-label="البحث عن منتجات">
  <!-- Search Drawer Header -->
  <div class="search-drawer-header">
    <div class="search-header-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <span>البحث في المنتجات</span>
    </div>
    <button 
      type="button" 
      class="close-search-panel" 
      id="close-search-trigger"
      onclick="window.toggleSearchPanel()" 
      aria-label="إغلاق البحث"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Search Input Area -->
  <div class="search-input-section">
    <div class="search-input-wrap">
      <input 
        type="text" 
        id="live-search-input" 
        placeholder="اكتبي اسم المنتج، التصنيف، أو المكونات..." 
        autocomplete="off"
        oninput="window.handleLiveSearch(this.value)"
      />
      <svg class="search-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <button 
        type="button" 
        class="search-clear-btn" 
        id="search-clear-btn" 
        style="display:none;" 
        onclick="document.getElementById('live-search-input').value=''; window.handleLiveSearch(''); this.style.display='none';" 
        aria-label="مسح النص"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Search Results / Suggestions Scrollable Container -->
  <div id="live-search-results" class="search-results-area">
    <div class="search-suggestions-container">
      <div class="suggestions-heading">الأكثر بحثاً:</div>
      <div class="suggestions-chips">
        <button type="button" class="search-chip" onclick="document.getElementById('live-search-input').value='عناية'; window.handleLiveSearch('عناية')">
          <span>✨ عناية</span>
        </button>
        <button type="button" class="search-chip" onclick="document.getElementById('live-search-input').value='شعر'; window.handleLiveSearch('شعر')">
          <span>🌿 شعر</span>
        </button>
        <button type="button" class="search-chip" onclick="document.getElementById('live-search-input').value='بشرة'; window.handleLiveSearch('بشرة')">
          <span>🌸 بشرة</span>
        </button>
        <button type="button" class="search-chip" onclick="document.getElementById('live-search-input').value='سيروم'; window.handleLiveSearch('سيروم')">
          <span>💧 سيروم</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Scripts (Preserving ALL Search and Auth Logic) -->
<script is:inline>
  // Keyboard Shortcut: Press '/' to trigger search
  window.addEventListener('keydown', function(e) {
    if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
      e.preventDefault();
      window.toggleSearchPanel();
    }
  });

  window.toggleNav = function() {
    const menubar = document.getElementById("menubar");
    const overlay = document.getElementById("menu-overlay");
    
    if (menubar && !menubar.classList.contains("active")) {
      const searchPanel = document.getElementById("search-panel");
      const searchOverlay = document.getElementById("search-overlay");
      if (searchPanel) searchPanel.classList.remove("active");
      if (searchOverlay) searchOverlay.classList.remove("active");
    }
    
    if (menubar) menubar.classList.toggle("active");
    if (overlay) overlay.classList.toggle("active");
  };

  window.toggleSearchPanel = function() {
    const panel = document.getElementById("search-panel");
    const overlay = document.getElementById("search-overlay");
    const menubar = document.getElementById("menubar");
    const menuOverlay = document.getElementById("menu-overlay");
    
    if (panel) {
      const isActive = panel.classList.contains("active");
      if (!isActive) {
        panel.classList.add("active");
        if (overlay) overlay.classList.add("active");
        if (menubar) menubar.classList.remove("active");
        if (menuOverlay) menuOverlay.classList.remove("active");
        
        setTimeout(() => {
          const inp = document.getElementById("live-search-input");
          if (inp) {
            inp.focus();
            if (inp.value) {
              const clearBtn = document.getElementById('search-clear-btn');
              if (clearBtn) clearBtn.style.display = 'flex';
            }
          }
        }, 250);
      } else {
        panel.classList.remove("active");
        if (overlay) overlay.classList.remove("active");
      }
    }
  };

  window.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const panel = document.getElementById("search-panel");
      const overlay = document.getElementById("search-overlay");
      if (panel && panel.classList.contains("active")) {
        panel.classList.remove("active");
        if (overlay) overlay.classList.remove("active");
      }
      const menubar = document.getElementById("menubar");
      const menuOverlay = document.getElementById("menu-overlay");
      if (menubar && menubar.classList.contains("active")) {
        menubar.classList.remove("active");
        if (menuOverlay) menuOverlay.classList.remove("active");
      }
    }
  });

  let liveSearchTimeout = null;
  window.handleLiveSearch = function(query) {
    const clearBtn = document.getElementById('search-clear-btn');
    if (clearBtn) {
      clearBtn.style.display = (query && query.trim()) ? 'flex' : 'none';
    }

    clearTimeout(liveSearchTimeout);
    liveSearchTimeout = setTimeout(() => {
      performSearch(query);
    }, 280);
  };

  function performSearch(query) {
    const resultsContainer = document.getElementById("live-search-results");
    if (!resultsContainer) return;
    
    query = (query || "").trim().toLowerCase();
    if (!query) {
      resultsContainer.innerHTML = `
        <div class="search-suggestions-container">
          <div class="suggestions-heading">الأكثر بحثاً:</div>
          <div class="suggestions-chips">
            <button type="button" class="search-chip" onclick="document.getElementById('live-search-input').value='عناية'; window.handleLiveSearch('عناية')"><span>✨ عناية</span></button>
            <button type="button" class="search-chip" onclick="document.getElementById('live-search-input').value='شعر'; window.handleLiveSearch('شعر')"><span>🌿 شعر</span></button>
            <button type="button" class="search-chip" onclick="document.getElementById('live-search-input').value='بشرة'; window.handleLiveSearch('بشرة')"><span>🌸 بشرة</span></button>
            <button type="button" class="search-chip" onclick="document.getElementById('live-search-input').value='سيروم'; window.handleLiveSearch('سيروم')"><span>💧 سيروم</span></button>
          </div>
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = `
      <div class="search-loading-state">
        <div class="search-spinner"></div>
        <span>جاري البحث في المتجر...</span>
      </div>
    `;

    if (typeof window.db === 'undefined' && typeof firebase !== 'undefined') {
      window.db = firebase.database();
    }

    if (typeof window.db === 'undefined') {
      fetch("https://dandy-562fc-default-rtdb.europe-west1.firebasedatabase.app/products.json")
      .then(res => res.json())
      .then(data => {
        renderSearchResults(data, query, resultsContainer);
      })
      .catch(err => {
        console.error(err);
        resultsContainer.innerHTML = '<p class="search-error-msg">حدث خطأ أثناء البحث. يرجى المحاولة مرة أخرى.</p>';
      });
    } else {
      window.db.ref('products').once('value').then(snap => {
        renderSearchResults(snap.val(), query, resultsContainer);
      }).catch(err => {
        console.error(err);
        resultsContainer.innerHTML = '<p class="search-error-msg">حدث خطأ أثناء البحث. يرجى المحاولة مرة أخرى.</p>';
      });
    }
  }

  function renderSearchResults(data, query, container) {
    if (!data) {
      container.innerHTML = '<div class="search-empty-state"><p>عذراً، لم نتمكن من جلب المنتجات حالياً.</p></div>';
      return;
    }
    
    let products = [];
    Object.keys(data).forEach(k => {
      let p = data[k];
      p.id = k;
      if (p.name) products.push(p);
    });
    
    products.forEach(p => {
      let score = 0;
      let n = (p.name || "").toLowerCase();
      let c = (p.category || "").toLowerCase();
      
      if (n === query) score = 100;
      else if (n.startsWith(query)) score = 80;
      else if (n.includes(query)) score = 50;
      
      if (c === query) score += 30;
      else if (c.includes(query)) score += 10;
      
      p._score = score;
    });
    
    products = products.filter(p => p._score > 0).sort((a,b) => b._score - a._score);
    
    if (products.length === 0) {
      container.innerHTML = `
        <div class="search-empty-state">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="1.5">
            <circle cx="11" cy="11" r="7"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <p>لا توجد نتائج مطابقة لـ "<strong>${escapeHtml(query)}</strong>"</p>
          <small>جربي البحث بكلمات عامة مثل (بشرة، شعر، سيروم، صابون)</small>
        </div>
      `;
      return;
    }
    
    let html = '<div class="search-results-list">';
    products.forEach(p => {
      let priceHtml = '';
      if (p.onSale && p.discount) {
        let priceRaw = parseFloat(p.price);
        let discountPercent = parseFloat(p.discount) || 0;
        let oldPrice = priceRaw / (1 - (discountPercent/100));
        priceHtml = `<span class="old-price">${oldPrice.toFixed(0)} ج.م</span> <span class="current-price">${priceRaw} ج.م</span>`;
      } else if (p.originalPrice) {
        priceHtml = `<span class="old-price">${p.originalPrice} ج.م</span> <span class="current-price">${p.price} ج.م</span>`;
      } else {
        priceHtml = `<span class="current-price">${p.price} ج.م</span>`;
      }
      
      const pLink = p.slug ? `/product/${encodeURIComponent(p.slug)}` : `/product?id=${p.id}`;
      html += `
        <a href="${pLink}" class="search-result-card" onclick="window.toggleSearchPanel()">
          <img src="${p.image || '/assets/images/logo.png'}" alt="${escapeHtml(p.name)}" loading="lazy" />
          <div class="result-details">
            <h4 class="result-name">${escapeHtml(p.name)}</h4>
            <div class="result-price">${priceHtml}</div>
            ${p.category ? `<span class="result-category">${escapeHtml(p.category)}</span>` : ''}
          </div>
          <svg class="result-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </a>
      `;
    });
    html += '</div>';
    
    container.innerHTML = html;
  }

  function escapeHtml(string) {
    if (!string) return '';
    return String(string)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // --- Auth state check (Customer vs Guest) ---
  window.headerSignOut = async function() {
    const auth = window.auth || (typeof firebase !== 'undefined' && firebase.auth ? firebase.auth() : null);
    if (auth) {
      try {
        await auth.signOut();
        window.location.href = '/';
      } catch (err) {
        console.error('Sign out error:', err);
        window.location.reload();
      }
    }
  };

  function initHeaderAuth() {
    function handleUserState(user) {
      const isClient = user && (!user.email || user.email.toLowerCase() !== 'admin@dandy.com');

      const guestHeader = document.getElementById('header-auth-guest');
      const userHeader = document.getElementById('header-auth-user');
      const guestMenu = document.getElementById('menu-auth-guest');
      const userMenu = document.getElementById('menu-auth-user');

      if (isClient) {
        if (guestHeader) guestHeader.style.display = 'none';
        if (userHeader) userHeader.style.display = 'inline-flex';
        if (guestMenu) guestMenu.style.display = 'none';
        if (userMenu) userMenu.style.display = 'block';
      } else {
        if (guestHeader) guestHeader.style.display = 'inline-flex';
        if (userHeader) userHeader.style.display = 'none';
        if (guestMenu) guestMenu.style.display = 'block';
        if (userMenu) userMenu.style.display = 'none';
      }
    }

    const auth = window.auth || (typeof firebase !== 'undefined' && firebase.auth ? firebase.auth() : null);
    if (auth && typeof auth.onAuthStateChanged === 'function') {
      auth.onAuthStateChanged(handleUserState);
    } else {
      let attempts = 0;
      const pollInterval = setInterval(() => {
        attempts++;
        const a = window.auth || (typeof firebase !== 'undefined' && firebase.auth ? firebase.auth() : null);
        if (a && typeof a.onAuthStateChanged === 'function') {
          clearInterval(pollInterval);
          a.onAuthStateChanged(handleUserState);
        } else if (attempts > 30) {
          clearInterval(pollInterval);
        }
      }, 100);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderAuth);
  } else {
    initHeaderAuth();
  }
</script>

