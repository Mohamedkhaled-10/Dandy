---
// src/components/DashboardNav.astro
const currentPath = (Astro.url.pathname || '').replace(/\/$/, '') || '/';

const navItems = [
  { href: '/dashboard', label: 'الرئيسية', icon: 'fa-tachometer-alt' },
  { href: '/dashboard-order', label: 'الطلبات', icon: 'fa-shopping-bag' },
  { href: '/dashboard-product', label: 'المنتجات', icon: 'fa-boxes' },
  { href: '/dashboard-blog', label: 'المدونة', icon: 'fa-newspaper' },
  { href: '/dashboard-index', label: 'تخصيص الواجهة', icon: 'fa-sliders-h' },
  { href: '/statues', label: 'الإحصائيات', icon: 'fa-chart-line' },
];

function isItemActive(itemHref: string) {
  const normHref = itemHref.replace(/\/$/, '');
  if (normHref === '/dashboard') {
    return currentPath === '/dashboard';
  }
  return currentPath === normHref || currentPath.startsWith(normHref + '/');
}
---

<header class="admin-top-nav" aria-label="شريط إدارة العمليات" dir="rtl">
  <div class="admin-nav-inner">
    <!-- Brand / Status -->
    <div class="admin-brand-group">
      <a href="/dashboard" class="admin-logo-link">
        <span class="admin-brand-name">DANDY</span>
        <span class="admin-env-pill">الإدارة</span>
      </a>
    </div>
    
    <!-- Navigation Tabs -->
    <nav class="admin-nav-tabs-wrap">
      <ul class="admin-nav-tabs">
        {navItems.map((item) => {
          const active = isItemActive(item.href);
          return (
            <li>
              <a 
                href={item.href} 
                class:list={['admin-tab-link', { 'active': active }]}
                aria-current={active ? 'page' : undefined}
              >
                <i class:list={['fas', item.icon, 'admin-tab-icon']}></i>
                <span>{item.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Utility Actions -->
    <div class="admin-nav-actions">
      <a href="/" target="_blank" class="admin-btn-preview" title="معاينة المتجر المباشر">
        <i class="fas fa-external-link-alt"></i>
        <span>عرض المتجر</span>
      </a>
      <button type="button" class="admin-btn-logout" id="dashGlobalLogoutBtn" title="تسجيل الخروج">
        <i class="fas fa-sign-out-alt"></i>
        <span>خروج</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('dashGlobalLogoutBtn')?.addEventListener('click', async () => {
    const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
    if (auth) {
      try {
        await auth.signOut();
        window.location.href = '/login';
      } catch (err) {
        console.error('Logout error:', err);
      }
    } else {
      window.location.href = '/login';
    }
  });
</script>

<style>
  .admin-top-nav {
    background: #ffffff;
    border-bottom: 1px solid var(--border-light, #e5e7eb);
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    font-family: 'Cairo', sans-serif;
  }

  .admin-nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .admin-brand-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .admin-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .admin-brand-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-primary, #111827);
  }

  .admin-env-pill {
    background: var(--color-surface-soft, #f3f4f6);
    color: var(--color-primary, #374151);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--border-radius-xs, 4px);
    border: 1px solid var(--border-light, #e5e7eb);
  }

  .admin-nav-tabs-wrap {
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
    display: flex;
    justify-content: flex-start;
  }
  .admin-nav-tabs-wrap::-webkit-scrollbar {
    display: none;
  }

  .admin-nav-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
    white-space: nowrap;
  }

  .admin-tab-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: var(--border-radius-sm, 6px);
    color: var(--color-muted, #6b7280);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: var(--transition-fast, 0.15s ease);
    border: 1px solid transparent;
  }

  .admin-tab-link:hover {
    color: var(--color-primary, #111827);
    background: var(--color-surface-soft, #f9fafb);
  }

  .admin-tab-link.active {
    background: var(--color-primary, #111827);
    color: #ffffff;
    font-weight: 700;
  }

  .admin-tab-icon {
    font-size: 0.82rem;
  }

  .admin-nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .admin-btn-preview {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--border-radius-sm, 6px);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary, #374151);
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--border-light, #e5e7eb);
    text-decoration: none;
    transition: var(--transition-fast, 0.15s ease);
  }

  .admin-btn-preview:hover {
    border-color: var(--color-primary, #111827);
    color: var(--color-primary, #111827);
  }

  .admin-btn-logout {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--border-radius-sm, 6px);
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
    background: #fef2f2;
    border: 1px solid #fee2e2;
    cursor: pointer;
    font-family: inherit;
    transition: var(--transition-fast, 0.15s ease);
  }

  .admin-btn-logout:hover {
    background: #dc2626;
    color: #ffffff;
    border-color: #dc2626;
  }

  @media (max-width: 768px) {
    .admin-nav-inner {
      padding: 0 12px;
      height: 52px;
    }
    .admin-brand-name {
      display: none;
    }
    .admin-tab-link {
      padding: 5px 8px;
      font-size: 0.8rem;
    }
    .admin-btn-preview span,
    .admin-btn-logout span {
      display: none;
    }
  }
</style>
