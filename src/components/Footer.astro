---
// Footer.astro
// Clean, Full-Width Luxury Silhouette Footer in Dandy's Core Color Palette
---

<footer class="dandy-custom-footer" id="site-footer" dir="rtl" aria-label="تذييل الموقع">
  
  <!-- Curved Skyline & Beauty Silhouette Top Graphic -->
  <div class="footer-silhouette-wrapper" aria-hidden="true">
    <svg class="footer-curve-svg" viewBox="0 0 1440 180" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <!-- Rolling Hills Curves with Dandy Core Brand Charcoal Tone -->
      <path d="M0,80 C180,140 320,10 500,45 C680,80 820,135 1020,70 C1200,10 1320,80 1440,55 L1440,180 L0,180 Z" fill="#2c2828" />
    </svg>

    <!-- Silhouette Elements Layer (Natural Botanical Florals, Perfume & Serum Silhouettes, Hot Air Balloon, Cityline & Stars) -->
    <div class="silhouette-decorations-container">
      <svg class="silhouette-art-svg" viewBox="0 0 1440 140" fill="none" xmlns="http://www.w3.org/2000/svg">
        
        <!-- Left Luxury Cosmetics Silhouette (Perfume & Serum Bottles) -->
        <g class="silhouette-beauty-left" fill="#2c2828" opacity="0.98">
          <!-- Serum Dropper Bottle -->
          <rect x="80" y="55" width="34" height="48" rx="8" />
          <rect x="91" y="44" width="12" height="12" rx="3" />
          <path d="M94 44 C94 36 100 36 100 44 Z" />
          <!-- Luxury Perfume Flacon -->
          <path d="M125 65 C125 55 135 48 148 48 C161 48 171 55 171 65 L175 95 C175 101 170 106 164 106 L132 106 C126 106 121 101 121 95 Z" />
          <rect x="142" y="38" width="12" height="10" rx="2" />
          <rect x="139" y="30" width="18" height="8" rx="3" />
        </g>

        <!-- Botanical Trees & Foliage (Left Side) -->
        <g class="silhouette-flora-left" fill="#2c2828">
          <circle cx="210" cy="58" r="14" />
          <line x1="210" y1="72" x2="210" y2="95" stroke="#2c2828" stroke-width="3" />
          <circle cx="232" cy="68" r="10" />
          <line x1="232" y1="78" x2="232" y2="100" stroke="#2c2828" stroke-width="2.5" />
          <circle cx="250" cy="76" r="8" />
          <line x1="250" y1="84" x2="250" y2="102" stroke="#2c2828" stroke-width="2" />
        </g>

        <!-- Center Landmarks: Ferris Wheel & Elegant Boutique Architecture -->
        <g class="silhouette-city-center" fill="#2c2828" stroke="#2c2828">
          <!-- Ferris wheel -->
          <circle cx="730" cy="62" r="24" fill="none" stroke-width="2.2" />
          <circle cx="730" cy="62" r="5" fill="#2c2828" />
          <line x1="730" y1="38" x2="730" y2="86" stroke-width="1.8" />
          <line x1="706" y1="62" x2="754" y2="62" stroke-width="1.8" />
          <line x1="713" y1="45" x2="747" y2="79" stroke-width="1.8" />
          <line x1="713" y1="79" x2="747" y2="45" stroke-width="1.8" />
          <line x1="730" y1="86" x2="718" y2="110" stroke-width="3" />
          <line x1="730" y1="86" x2="742" y2="110" stroke-width="3" />

          <!-- Dandy Boutique Buildings -->
          <rect x="670" y="65" width="18" height="42" stroke="none" />
          <rect x="692" y="72" width="22" height="36" stroke="none" />
          <rect x="765" y="70" width="20" height="38" stroke="none" />
          <rect x="790" y="60" width="16" height="50" stroke="none" />
          <polygon points="790,60 798,46 806,60" stroke="none" />
          <rect x="812" y="75" width="24" height="35" stroke="none" />
        </g>

        <!-- Hot Air Balloon Floating Over Hills -->
        <g class="silhouette-balloon" fill="#2c2828">
          <path d="M890 28 C876 28 866 38 866 50 C866 62 876 72 884 82 L896 82 C904 72 914 62 914 50 C914 38 904 28 890 28 Z" />
          <line x1="886" y1="82" x2="888" y2="88" stroke="#2c2828" stroke-width="1.5" />
          <line x1="894" y1="82" x2="892" y2="88" stroke="#2c2828" stroke-width="1.5" />
          <rect x="886" y="88" width="8" height="5" rx="1" stroke="none" />
        </g>

        <!-- Right Botanical Trees & Cosmetics Silhouette -->
        <g class="silhouette-flora-right" fill="#2c2828">
          <circle cx="1060" cy="74" r="9" />
          <line x1="1060" y1="83" x2="1060" y2="105" stroke="#2c2828" stroke-width="2" />
          <circle cx="1080" cy="62" r="14" />
          <line x1="1080" y1="76" x2="1080" y2="108" stroke="#2c2828" stroke-width="2.5" />
          <circle cx="1105" cy="70" r="11" />
          <line x1="1105" y1="81" x2="1105" y2="112" stroke="#2c2828" stroke-width="2" />
        </g>

        <!-- Right Side: Luxury Compact Powder & Lipstick Silhouette -->
        <g class="silhouette-beauty-right" fill="#2c2828" opacity="0.98">
          <!-- Lipstick -->
          <rect x="1220" y="60" width="16" height="42" rx="3" />
          <rect x="1222" y="48" width="12" height="12" rx="2" />
          <path d="M1223 48 L1233 40 L1233 48 Z" />
          <!-- Cream Jar -->
          <rect x="1248" y="68" width="46" height="34" rx="8" />
          <rect x="1244" y="62" width="54" height="9" rx="4" />
        </g>
      </svg>
    </div>
  </div>

  <!-- Full-Width Core Dark Canvas Content Container -->
  <div class="footer-core-content">
    <div class="footer-main-container">

      <!-- 3 Columns Section (Focused & Clean) -->
      <div class="footer-primary-grid">
        
        <!-- Column 1: Terms & Advantages -->
        <div class="footer-col-box">
          <h3 class="footer-heading">الشروط والمزايا</h3>
          <ul class="footer-plain-list">
            <li><a href="/all-products">منتجات أصلية وطبيعية 100%</a></li>
            <li><a href="/special-offers">شحن سريع ومجاني للطلبات المؤهلة</a></li>
            <li><a href="/terms">سياسة استرجاع مرنة</a></li>
            <li><a href="/all-products">جميع المنتجات متوفرة في المخزون</a></li>
          </ul>

          <div class="footer-social-inline" id="footer-social-links">
            <span class="social-label">تابعي داندي</span>
            <div class="social-icons-row">
              <a id="footer-social-facebook" href="https://www.facebook.com/profile.php?id=61563039704396" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99h-2.54V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/></svg>
              </a>
              <a id="footer-social-instagram" href="https://www.instagram.com/dandy_skincare_cosmotics" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
              <a href="https://wa.me/201038941005" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.2-.4.1-.2 0-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2 1 2.4c.1.2 1.6 2.5 4 3.4.5.2 1 .3 1.3.5.6.2 1.1.1 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.2-.2-.4-.3z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Column 2: Information & Help -->
        <div class="footer-col-box">
          <h3 class="footer-heading">معلومات المتجر</h3>
          <ul class="footer-plain-list" id="footer-menu-links">
            <li><a href="/help">الأسئلة الشائعة والمساعدة</a></li>
            <li><a href="/about-us">عن متجر داندي</a></li>
            <li><a href="/privacy-policy">سياسة الخصوصية</a></li>
            <li><a href="/terms">الشروط والأحكام</a></li>
            <li><a href="/blog">مدونة داندي للجمال</a></li>
            <li><a href="/track-order">تتبع الطلبات</a></li>
          </ul>

          <div class="footer-contact-details">
            <a href="tel:01038941005" dir="ltr">01038941005</a>
          </div>
        </div>

        <!-- Column 3: Contact & Brand Identity -->
        <div class="footer-col-box brand-contact-col">
          <h3 class="footer-heading">تواصل معنا</h3>
          
          <div class="brand-company-info">
            <h4 class="brand-title">Dandy Cosmetics</h4>
            <p class="company-desc">علامة تجارية رائدة ومتخصصة في ابتكار أرقى مستحضرات العناية بالبشرة والجمال الطبيعي.</p>
            
            <div class="head-office-block">
              <strong>المقر الرئيسي:</strong>
              <p>القاهرة، جمهورية مصر العربية</p>
              <p>خدمة التوصيل تغطي كافة المحافظات</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Clean Copyright Strip -->
      <div class="footer-clean-bottom">
        <p class="copyright-year" id="footer-copyright">
          © {new Date().getFullYear()} Dandy Cosmetics. جميع الحقوق محفوظة.
        </p>
      </div>

    </div>
  </div>
</footer>

