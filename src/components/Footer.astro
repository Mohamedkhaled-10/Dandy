    <div class="footer-menu-item"><a href="/special-offers">Special Offers</a></div>
    <div class="footer-menu-item"><a href="/blog">Our Blog</a></div>
    <div class="footer-menu-item"><a href="/help">Help Guide</a></div>
    <div class="footer-menu-item"><a href="/about-us">About Us</a></div>
    <div class="footer-menu-item"><a href="/contact-us">Contact Us</a></div>
