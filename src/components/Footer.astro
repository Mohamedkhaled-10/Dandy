<style is:global>
  /* ==========================================================================
     DANDY FULL-WIDTH CORE FOOTER
     ========================================================================== */

  footer.dandy-custom-footer {
    position: relative !important;
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
    left: 0 !important;
    right: 0 !important;
    background-color: transparent !important;
    color: #ffffff !important;
    font-family: inherit !important;
    margin-top: 80px !important;
    margin-bottom: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }

  /* 1. Silhouette & Wave Banner */
  .footer-silhouette-wrapper {
    position: relative;
    width: 100%;
    height: 120px;
    overflow: hidden;
    line-height: 0;
  }

  .footer-curve-svg {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .silhouette-decorations-container {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .silhouette-art-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 2. Dandy Core Brand Dark Grey Body (#2c2828) */
  .footer-core-content {
    background-color: var(--color-dust-grey-100, #2c2828);
    padding: 24px 24px 44px;
    position: relative;
    z-index: 3;
    width: 100%;
    box-sizing: border-box;
  }

  .footer-main-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .footer-primary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: 48px;
    padding-bottom: 36px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-heading {
    font-size: 1.08rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 18px 0;
    letter-spacing: -0.01em;
  }

  /* Lists */
  .footer-plain-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
  }

  .footer-plain-list li {
    margin-bottom: 12px;
  }

  .footer-plain-list a {
    color: var(--color-dust-grey-700, #e6e4e4);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.6;
    transition: color 0.2s ease;
  }

  .footer-plain-list a:hover {
    color: var(--color-rose-kiss-400, #fe7db3);
    text-decoration: underline;
  }

  /* Social Links Row */
  .footer-social-inline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
  }

  .social-label {
    font-size: 0.85rem;
    color: var(--color-dust-grey-700, #e6e4e4);
    font-weight: 600;
  }

  .social-icons-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .social-icons-row a {
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s ease;
  }

  .social-icons-row a:hover {
    background: var(--color-rose-kiss-500, #fe5d9f);
    border-color: var(--color-rose-kiss-500, #fe5d9f);
    transform: translateY(-2px);
  }

  /* Contact & Company Information */
  .footer-contact-details {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 14px;
  }

  .footer-contact-details a {
    color: var(--color-dust-grey-700, #e6e4e4);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-contact-details a:hover {
    color: var(--color-rose-kiss-400, #fe7db3);
  }

  .brand-company-info .brand-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 8px 0;
  }

  .company-desc {
    font-size: 0.88rem;
    color: var(--color-dust-grey-700, #e6e4e4);
    line-height: 1.6;
    margin: 0 0 16px 0;
  }

  .head-office-block strong {
    display: block;
    color: #ffffff;
    font-size: 0.88rem;
    margin-bottom: 4px;
  }

  .head-office-block p {
    font-size: 0.84rem;
    color: var(--color-dust-grey-400, #aea5a5);
    margin: 0 0 4px 0;
    line-height: 1.5;
  }

  /* 3. Clean Centered Bottom Bar */
  .footer-clean-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 24px;
    text-align: center;
  }

  .copyright-year {
    font-size: 0.85rem;
    color: var(--color-dust-grey-400, #aea5a5);
    margin: 0;
  }

  /* ==========================================================================
     RESPONSIVE RULES
     ========================================================================== */
  @media (max-width: 900px) {
    .footer-primary-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 768px) {
    .footer-silhouette-wrapper {
      height: 90px;
    }

    .footer-core-content {
      padding: 20px 16px 36px;
    }
  }

  /* Mobile Bottom Navigation Visibility */
  nav.bottom-nav {
    display: none;
  }

  @media (min-width: 768px) {
    nav.bottom-nav {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
      position: absolute !important;
      top: -9999px !important;
      left: -9999px !important;
      height: 0 !important;
      width: 0 !important;
      opacity: 0 !important;
      z-index: -1 !important;
    }
  }

  @media (max-width: 767px) {
    body {
      padding-bottom: calc(60px + env(safe-area-inset-bottom, 0px)) !important;
    }

    nav.bottom-nav {
      display: flex !important;
      position: fixed !important;
      top: auto !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      height: 60px !important;
      background: rgba(255, 255, 255, 0.98) !important;
      backdrop-filter: blur(12px) !important;
      -webkit-backdrop-filter: blur(12px) !important;
      border-top: 1px solid var(--border-subtle, #e6e4e4) !important;
      border-bottom: none !important;
      border-left: none !important;
      border-right: none !important;
      justify-content: space-around !important;
      align-items: center !important;
      padding: 0 0 env(safe-area-inset-bottom, 0px) !important;
      margin: 0 !important;
      z-index: 1000 !important;
      box-shadow: 0 -2px 10px rgba(44, 40, 40, 0.06) !important;
      transform: translateY(100%) !important;
      opacity: 0 !important;
      pointer-events: none !important;
      transition: transform 0.3s ease, opacity 0.3s ease !important;
    }
    
    nav.bottom-nav.is-visible {
      transform: translateY(0) !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }
  }

  body.menu-open nav.bottom-nav,
  html.menu-open nav.bottom-nav {
    transform: translateY(100%) !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
  body.menu-open .whatsapp-widget,
  html.menu-open .whatsapp-widget {
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>

<script is:inline>
  // Shared Cart Counter
  if (typeof window.updateSharedCartCount !== 'function') {
    window.updateSharedCartCount = function() {
      window.updateCartCount = window.updateSharedCartCount;
      try {
        const raw = localStorage.getItem('cart') || '[]';
        const cart = JSON.parse(raw);
        const count = Array.isArray(cart) ? cart.reduce((s, i) => s + (i.quantity ? Number(i.quantity) : 1), 0) : 0;
        const countEls = document.querySelectorAll('#shared-cart-count, #cart-count');
        countEls.forEach(el => el.textContent = count);
      } catch(e) {}
    };
    window.addEventListener('storage', (e) => {
      if (e.key === 'cart') window.updateSharedCartCount();
    });
  }
  window.updateSharedCartCount();

  window.updateCartCount = function() {
    if (typeof window.updateSharedCartCount === "function") window.updateSharedCartCount();
  };

  window.addEventListener('DOMContentLoaded', () => {
    if (typeof window.updateSharedCartCount === 'function') window.updateSharedCartCount();
  });
  window.addEventListener('cart-updated', () => {
    if (typeof window.updateSharedCartCount === 'function') window.updateSharedCartCount();
  });

  // Show bottom nav on scroll
  window.addEventListener('scroll', () => {
    const bottomNav = document.getElementById('global-mobile-bottom-nav');
    if (bottomNav) {
      if (window.scrollY > 150) {
        bottomNav.classList.add('is-visible');
      } else {
        bottomNav.classList.remove('is-visible');
      }
    }
  }, { passive: true });
</script>
