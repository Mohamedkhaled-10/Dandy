---
/**
 * DANDY COSMETICS — GLOBAL STOREFRONT HEADER (PHASE 2)
 * 3-zone RTL top bar: Logo (start) | 5 concise nav groups (center) | Search/Account/Bag (end).
 * Preserves legacy DOM IDs, Firebase Auth state handling, cart sync, and Pink Friday integration.
 */
import Icon from '../ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getPublishedPinkFridayCampaign, shouldDisplayCampaignToCustomers } from '../../utils/pink-friday-server';
import { isNavHrefActive } from '../../scripts/shell';
import { getLocaleDirection } from '../../i18n/config';
import { buildLocalizedPath } from '../../i18n/routes';
import { t } from '../../i18n/translator';
import type { CounterpartAvailability, Locale } from '../../i18n/types';

export interface Props {
  locale?: Locale;
  counterpartAvailability?: CounterpartAvailability;
}

const { locale = 'ar', counterpartAvailability } = Astro.props;
const dir = getLocaleDirection(locale);
const publishedCampaign = await getPublishedPinkFridayCampaign();
const showPinkFriday = shouldDisplayCampaignToCustomers(publishedCampaign);
const currentPath = Astro.url.pathname || '/';

const homeHref = buildLocalizedPath('/', locale);
const allProductsHref = buildLocalizedPath('/all-products', locale);
const categoryPrefix = buildLocalizedPath('/category', locale);
const offersHref = buildLocalizedPath('/special-offers', locale);
const pinkFridayHref = buildLocalizedPath('/pink-friday', locale);
const aboutHref = buildLocalizedPath('/about-us', locale);
const trackHref = buildLocalizedPath('/track-order', locale);
const loginHref = buildLocalizedPath('/account-login', locale);
const accountHref = buildLocalizedPath('/account', locale);
const cartHref = buildLocalizedPath('/cart', locale);

const shopActive = isNavHrefActive(currentPath, allProductsHref);
const categoriesActive = isNavHrefActive(currentPath, categoryPrefix, [categoryPrefix]);
const offersActive = isNavHrefActive(currentPath, offersHref, [pinkFridayHref]);
const aboutActive = isNavHrefActive(currentPath, aboutHref);
const trackActive = isNavHrefActive(currentPath, trackHref);

const CATEGORY_LINKS =
  locale === 'en'
    ? [
        { href: '/en/category/skin-care', label: 'Skin Care', desc: 'Serums, creams & gentle cleansers' },
        { href: '/en/category/hair-care', label: 'Hair Care', desc: 'Botanical oils & daily scalp care' },
        { href: '/en/category/body-care', label: 'Body Care', desc: 'Deep hydration & silky butters' },
        { href: '/en/category/fragrance', label: 'Fragrance', desc: 'Soft mists & lasting solid perfumes' },
      ]
    : [
        { href: '/category/skin-care', label: 'العناية بالبشرة', desc: 'سيروم، كريمات، وتنظيف لطيف' },
        { href: '/category/hair-care', label: 'العناية بالشعر', desc: 'زيوت مغذية وعناية يومية' },
        { href: '/category/body-care', label: 'العناية بالجسم', desc: 'ترطيب عميق وملمس ناعم' },
        { href: '/category/fragrance', label: 'العطور والمعطرات', desc: 'روائح ناعمة وثبات متوازن' },
      ];
---

<header class="dandy-header" id="site-header" dir={dir}>
  <div class="dandy-header-inner">
    <!-- START ZONE: Mobile Hamburger (below 1024px) & Brand Logo (Desktop) -->
    <div class="dandy-header-start">
      <button
        type="button"
        class="dandy-utility-btn dandy-mobile-menu-trigger"
        id="mobile-menu-trigger"
        aria-label={t(locale, 'header.menuTriggerLabel')}
        aria-expanded="false"
        aria-controls="menubar"
        onclick="window.toggleNav()"
      >
        <Icon name="menu" size={21} strokeWidth={1.75} />
      </button>

      <a
        href={homeHref}
        class="dandy-brand-logo dandy-brand-logo--desktop"
        title={`Dandy Cosmetics - ${t(locale, 'navigation.home')}`}
        id="header-brand-logo"
      >
        <img
          src="/assets/images/logo.png"
          alt="Dandy Cosmetics"
          width="124"
          height="36"
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <!-- CENTER ZONE: 5 Concise Navigation Groups (Desktop) | Centered Logo (< 1024px) -->
    <div class="dandy-header-center">
      <a
        href={homeHref}
        class="dandy-brand-logo dandy-brand-logo--compact"
        title={`Dandy Cosmetics - ${t(locale, 'navigation.home')}`}
        aria-label={`Dandy Cosmetics - ${t(locale, 'navigation.home')}`}
      >
        <img
          src="/assets/images/logo.png"
          alt="Dandy Cosmetics"
          width="110"
          height="32"
          loading="eager"
          decoding="async"
        />
      </a>

      <nav class="dandy-desktop-nav" aria-label={locale === 'en' ? 'Primary navigation' : 'التنقل الرئيسي'} id="desktop-primary-nav">
        <a
          href={allProductsHref}
          class:list={['dandy-nav-link', shopActive && 'active']}
          data-nav-href={allProductsHref}
          aria-current={shopActive ? 'page' : undefined}
        >
          {t(locale, 'navigation.shop')}
        </a>

        <div class="dandy-nav-dropdown" data-dandy-dropdown="categories">
          <button
            type="button"
            class:list={['dandy-nav-trigger', categoriesActive && 'active']}
            id="nav-categories-trigger"
            aria-expanded="false"
            aria-controls="desktop-categories-menu"
            data-nav-prefix={categoryPrefix}
          >
            <span>{t(locale, 'navigation.categories')}</span>
            <Icon name="chevron-down" size={14} strokeWidth={1.9} class="dandy-nav-chevron" />
          </button>

          <div
            class="dandy-nav-popover"
            id="desktop-categories-menu"
            role="region"
            aria-label={locale === 'en' ? 'Store categories' : 'تصنيفات المتجر'}
            hidden
          >
            <div class="dandy-popover-list">
              {CATEGORY_LINKS.map((cat) => (
                <a
                  href={cat.href}
                  class:list={[
                    'dandy-popover-item',
                    isNavHrefActive(currentPath, cat.href) && 'is-active',
                  ]}
                  data-nav-href={cat.href}
                >
                  <span class="dandy-popover-title">{cat.label}</span>
                  <span class="dandy-popover-desc">{cat.desc}</span>
                </a>
              ))}
            </div>
            <div class="dandy-popover-footer">
              <a href={allProductsHref} class="dandy-popover-all">
                <span>{locale === 'en' ? 'Browse All Products' : 'تصفح جميع المنتجات'}</span>
                <Icon name={locale === 'en' ? 'chevron-right' : 'chevron-left'} size={14} strokeWidth={1.9} />
              </a>
            </div>
          </div>
        </div>

        {showPinkFriday ? (
          <div class="dandy-nav-dropdown" data-dandy-dropdown="offers">
            <button
              type="button"
              class:list={['dandy-nav-trigger', offersActive && 'active']}
              id="nav-offers-trigger"
              aria-expanded="false"
              aria-controls="desktop-offers-menu"
              data-nav-href={offersHref}
              data-nav-prefix={pinkFridayHref}
            >
              <span>{t(locale, 'navigation.offers')}</span>
              <Icon name="chevron-down" size={14} strokeWidth={1.9} class="dandy-nav-chevron" />
            </button>

            <div
              class="dandy-nav-popover dandy-nav-popover--compact"
              id="desktop-offers-menu"
              role="region"
              aria-label={locale === 'en' ? 'Available offers' : 'العروض المتاحة'}
              hidden
            >
              <div class="dandy-popover-list">
                <a
                  href={offersHref}
                  class:list={['dandy-popover-item', isNavHrefActive(currentPath, offersHref) && 'is-active']}
                  data-nav-href={offersHref}
                >
                  <span class="dandy-popover-title">{t(locale, 'navigation.specialOffers')}</span>
                  <span class="dandy-popover-desc">
                    {locale === 'en' ? 'Curated sets & seasonal markdowns' : 'مجموعات وتخفيضات متجددة'}
                  </span>
                </a>
                <a
                  href={pinkFridayHref}
                  class:list={['dandy-popover-item dandy-popover-item--accent', isNavHrefActive(currentPath, pinkFridayHref) && 'is-active']}
                  data-nav-href={pinkFridayHref}
                >
                  <span class="dandy-popover-title">{t(locale, 'navigation.pinkFriday')}</span>
                  <span class="dandy-popover-desc">
                    {locale === 'en' ? 'Limited-time seasonal campaign' : 'عروض الحملة الموسمية الحالية'}
                  </span>
                </a>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={offersHref}
            class:list={['dandy-nav-link', offersActive && 'active']}
            data-nav-href={offersHref}
            aria-current={offersActive ? 'page' : undefined}
          >
            {t(locale, 'navigation.offers')}
          </a>
        )}

        <a
          href={aboutHref}
          class:list={['dandy-nav-link', aboutActive && 'active']}
          data-nav-href={aboutHref}
          aria-current={aboutActive ? 'page' : undefined}
        >
          {t(locale, 'navigation.aboutUs')}
        </a>

        <a
          href={trackHref}
          class:list={['dandy-nav-link', trackActive && 'active']}
          data-nav-href={trackHref}
          aria-current={trackActive ? 'page' : undefined}
        >
          {t(locale, 'navigation.trackOrder')}
        </a>
      </nav>
    </div>

    <!-- END ZONE: Language Switcher, Search, Account & Shopping Bag -->
    <div class="dandy-header-end">
      <LanguageSwitcher locale={locale} availability={counterpartAvailability} variant="header" />

      <button
        type="button"
        class="dandy-utility-btn"
        id="desktop-search-btn"
        onclick="window.toggleSearchPanel()"
        aria-label={t(locale, 'header.searchTriggerLabel')}
        title={t(locale, 'header.searchTriggerLabel')}
      >
        <Icon name="search" size={19} strokeWidth={1.75} />
      </button>

      <a
        href={loginHref}
        id="header-auth-guest"
        class="dandy-utility-btn dandy-desktop-only-utility"
        title={t(locale, 'header.loginTitle')}
        aria-label={t(locale, 'header.loginTitle')}
      >
        <Icon name="user" size={19} strokeWidth={1.75} />
      </a>

      <div id="header-auth-user" class="dandy-header-auth-user dandy-desktop-only-utility" style="display:none;">
        <a
          href={accountHref}
          class="dandy-utility-btn dandy-utility-btn--active-user"
          title={t(locale, 'header.accountTitle')}
          aria-label={t(locale, 'header.accountTitle')}
        >
          <Icon name="user" size={19} strokeWidth={1.85} />
        </a>
        <button
          type="button"
          class="dandy-utility-btn dandy-utility-btn--logout"
          onclick="window.headerSignOut()"
          title={t(locale, 'header.logoutTitle')}
          aria-label={t(locale, 'header.logoutTitle')}
        >
          <Icon name="log-out" size={17} strokeWidth={1.75} />
        </button>
      </div>

      <a
        href={cartHref}
        class="dandy-utility-btn dandy-header-cart-btn"
        id="header-cart-link"
        aria-label={t(locale, 'header.cartLabel')}
        title={t(locale, 'header.cartLabel')}
      >
        <Icon name="shopping-bag" size={19} strokeWidth={1.75} />
        <span class="dandy-cart-badge dandy-tabular" id="cart-count">0</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Shared Cart Counter (Idempotent across pages & components)
  if (typeof window.updateSharedCartCount !== 'function') {
    window.updateSharedCartCount = function () {
      window.updateCartCount = window.updateSharedCartCount;
      try {
        const raw = localStorage.getItem('cart') || '[]';
        const cart = JSON.parse(raw);
        const count = Array.isArray(cart)
          ? cart.reduce(function (sum, item) {
              if (!item || typeof item !== 'object') return sum;
              const qty = Number(item.quantity ?? 1);
              return Number.isFinite(qty) && qty > 0 ? sum + Math.floor(qty) : sum;
            }, 0)
          : 0;
        const countEls = document.querySelectorAll('#shared-cart-count, #cart-count');
        countEls.forEach(function (el) {
          el.textContent = String(count);
        });
      } catch (_err) {}
    };

    window.addEventListener('storage', function (e) {
      if (e.key === 'cart') window.updateSharedCartCount();
    });
    window.addEventListener('cart-updated', function () {
      window.updateSharedCartCount();
    });
  }

  window.updateCartCount = window.updateSharedCartCount;
  window.updateSharedCartCount();

  // Sign out helper (locale-aware home redirect)
  window.headerSignOut = async function () {
    const auth = window.auth || (typeof firebase !== 'undefined' && firebase.auth ? firebase.auth() : null);
    const isEn = (document.documentElement.lang || '').toLowerCase().startsWith('en') || (window.location.pathname || '').startsWith('/en');
    if (auth) {
      try {
        await auth.signOut();
        window.location.href = isEn ? '/en/' : '/';
      } catch (err) {
        console.error('Sign out error:', err);
        window.location.reload();
      }
    }
  };

  (function () {
    function initHeaderAuth() {
      function handleUserState(user) {
        const isClient = Boolean(user && (!user.email || user.email.toLowerCase() !== 'admin@dandy.com'));
        const guestHeader = document.getElementById('header-auth-guest');
        const userHeader = document.getElementById('header-auth-user');
        const guestMenu = document.getElementById('menu-auth-guest');
        const userMenu = document.getElementById('menu-auth-user');

        if (isClient) {
          if (guestHeader) guestHeader.style.display = 'none';
          if (userHeader) userHeader.style.display = 'inline-flex';
          if (guestMenu) guestMenu.style.display = 'none';
          if (userMenu) userMenu.style.display = 'block';
        } else {
          if (guestHeader) guestHeader.style.display = 'inline-flex';
          if (userHeader) userHeader.style.display = 'none';
          if (guestMenu) guestMenu.style.display = 'block';
          if (userMenu) userMenu.style.display = 'none';
        }
      }

      const auth = window.auth || (typeof firebase !== 'undefined' && firebase.auth ? firebase.auth() : null);
      if (auth && typeof auth.onAuthStateChanged === 'function') {
        auth.onAuthStateChanged(handleUserState);
      } else {
        let attempts = 0;
        const pollInterval = setInterval(function () {
          attempts += 1;
          const a = window.auth || (typeof firebase !== 'undefined' && firebase.auth ? firebase.auth() : null);
          if (a && typeof a.onAuthStateChanged === 'function') {
            clearInterval(pollInterval);
            a.onAuthStateChanged(handleUserState);
          } else if (attempts > 30) {
            clearInterval(pollInterval);
          }
        }, 100);
      }
    }

    function initHeaderDropdowns() {
      const dropdowns = Array.from(document.querySelectorAll('[data-dandy-dropdown]'));
      if (!dropdowns.length) return;

      const hoverCapable = window.matchMedia && window.matchMedia('(hover: hover)').matches;
      let closeTimer = null;
      const hoverOpenedAt = new WeakMap();

      function setOpen(dropdown, open) {
        const trigger = dropdown.querySelector('.dandy-nav-trigger');
        const menu = dropdown.querySelector('.dandy-nav-popover');
        if (!trigger || !menu) return;
        dropdown.classList.toggle('is-open', open);
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        menu.hidden = !open;
      }

      function closeAll(except) {
        dropdowns.forEach(function (dd) {
          if (dd !== except) setOpen(dd, false);
        });
      }

      dropdowns.forEach(function (dropdown) {
        const trigger = dropdown.querySelector('.dandy-nav-trigger');
        const menu = dropdown.querySelector('.dandy-nav-popover');
        if (!trigger || !menu) return;

        trigger.addEventListener('click', function (e) {
          e.stopPropagation();
          const openedAt = hoverOpenedAt.get(dropdown) || 0;
          const justOpenedByHover = hoverCapable && !menu.hidden && Date.now() - openedAt < 500;
          hoverOpenedAt.delete(dropdown);
          if (justOpenedByHover) {
            closeAll(dropdown);
            setOpen(dropdown, true);
            return;
          }
          const willOpen = menu.hidden;
          closeAll(dropdown);
          setOpen(dropdown, willOpen);
        });

        if (hoverCapable) {
          dropdown.addEventListener('mouseenter', function () {
            clearTimeout(closeTimer);
            const wasClosed = menu.hidden;
            closeAll(dropdown);
            setOpen(dropdown, true);
            if (wasClosed) {
              hoverOpenedAt.set(dropdown, Date.now());
            }
          });
          dropdown.addEventListener('mouseleave', function () {
            hoverOpenedAt.delete(dropdown);
            closeTimer = setTimeout(function () {
              setOpen(dropdown, false);
            }, 140);
          });
        }

        dropdown.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !menu.hidden) {
            e.stopPropagation();
            setOpen(dropdown, false);
            trigger.focus();
          }
        });

        menu.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', function () {
            setOpen(dropdown, false);
          });
        });
      });

      window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          const openDropdown = dropdowns.find(function (dd) {
            return dd.classList.contains('is-open');
          });
          if (openDropdown) {
            const trigger = openDropdown.querySelector('.dandy-nav-trigger');
            closeAll(null);
            if (trigger) trigger.focus();
          }
        }
      });

      document.addEventListener('click', function (e) {
        if (!e.target || !(e.target instanceof Element) || !e.target.closest('[data-dandy-dropdown]')) {
          closeAll(null);
        }
      });

      window.closeHeaderDropdowns = function () {
        closeAll(null);
      };
    }

    function initHeaderScrollElevation() {
      const header = document.getElementById('site-header');
      if (!header) return;
      let ticking = false;
      function update() {
        const y = window.scrollY || window.pageYOffset || 0;
        header.classList.toggle('is-scrolled', y > 12);
        ticking = false;
      }
      window.addEventListener(
        'scroll',
        function () {
          if (!ticking) {
            window.requestAnimationFrame(update);
            ticking = true;
          }
        },
        { passive: true }
      );
      update();
    }

    function initActiveNavState() {
      const current = (window.location.pathname || '/').replace(/\/+$/, '') || '/';
      document.querySelectorAll('#desktop-primary-nav [data-nav-href], #desktop-primary-nav [data-nav-prefix]').forEach(function (el) {
        const href = el.getAttribute('data-nav-href');
        const prefix = el.getAttribute('data-nav-prefix');
        let active = false;
        if (href) {
          const cleanHref = href.replace(/\/+$/, '') || '/';
          active =
            cleanHref === '/' || cleanHref === '/en'
              ? current === cleanHref
              : current === cleanHref || current.startsWith(cleanHref + '/');
        }
        if (!active && prefix) {
          const cleanPrefix = prefix.replace(/\/+$/, '') || '/';
          active = current === cleanPrefix || current.startsWith(cleanPrefix + '/');
        }
        el.classList.toggle('active', active);
      });
    }

    function boot() {
      window.updateSharedCartCount();
      initHeaderAuth();
      initHeaderDropdowns();
      initHeaderScrollElevation();
      initActiveNavState();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>

<style>
  .dandy-header {
    position: sticky;
    top: 0;
    z-index: var(--dandy-z-header);
    width: 100%;
    height: 72px;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--dandy-border-subtle);
    transition: box-shadow var(--dandy-transition-base), border-color var(--dandy-transition-base);
    font-family: var(--dandy-font-active-sans);
  }

  .dandy-header.is-scrolled {
    box-shadow: var(--dandy-shadow-sm);
    border-bottom-color: var(--dandy-border-default);
  }

  .dandy-header-inner {
    width: 100%;
    max-width: var(--dandy-container-max);
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--dandy-container-px);
    display: grid;
    grid-template-columns: minmax(140px, 1fr) auto minmax(140px, 1fr);
    align-items: center;
    gap: 16px;
  }

  .dandy-header-start {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    min-width: 0;
  }

  .dandy-header-center {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .dandy-header-end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    min-width: 0;
  }

  .dandy-brand-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    line-height: 1;
    flex-shrink: 0;
    transition: opacity var(--dandy-transition-fast);
  }

  .dandy-brand-logo:hover {
    opacity: 0.85;
  }

  .dandy-brand-logo img {
    height: 36px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .dandy-brand-logo--compact {
    display: none;
  }

  .dandy-utility-btn.dandy-mobile-menu-trigger {
    display: none;
  }

  /* Desktop Navigation (5 concise groups, strictly single-line) */
  .dandy-desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 2.2vw, 30px);
    white-space: nowrap;
  }

  .dandy-nav-link,
  .dandy-nav-trigger {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 8px 2px;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--dandy-font-active-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--dandy-ink-secondary);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    position: relative;
    transition: color var(--dandy-transition-fast);
  }

  .dandy-nav-link::after,
  .dandy-nav-trigger::after {
    content: '';
    position: absolute;
    bottom: 2px;
    inset-inline: 0;
    height: 1.5px;
    background-color: var(--dandy-ink-primary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dandy-transition-base);
  }

  .dandy-nav-link:hover,
  .dandy-nav-trigger:hover,
  .dandy-nav-dropdown.is-open .dandy-nav-trigger {
    color: var(--dandy-ink-primary);
  }

  .dandy-nav-link.active,
  .dandy-nav-trigger.active {
    color: var(--dandy-ink-primary);
    font-weight: 600;
  }

  .dandy-nav-link:hover::after,
  .dandy-nav-trigger:hover::after,
  .dandy-nav-link.active::after,
  .dandy-nav-trigger.active::after,
  .dandy-nav-dropdown.is-open .dandy-nav-trigger::after {
    transform: scaleX(1);
  }

  .dandy-nav-chevron {
    transition: transform var(--dandy-transition-fast);
    color: var(--dandy-ink-muted);
  }

  .dandy-nav-dropdown.is-open .dandy-nav-chevron {
    transform: rotate(180deg);
    color: var(--dandy-ink-primary);
  }

  /* Dropdown Popover */
  .dandy-nav-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .dandy-nav-popover {
    position: absolute;
    top: calc(100% + 10px);
    inset-inline-start: 0;
    width: 280px;
    background-color: var(--dandy-bg-elevated);
    border: 1px solid var(--dandy-border-default);
    border-radius: var(--dandy-radius-md);
