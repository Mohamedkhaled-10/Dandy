---
/**
 * DANDY COSMETICS — EDITORIAL LUXURY SITE FOOTER (PHASE 2)
 * Dark editorial charcoal canvas (--dandy-bg-dark), balanced 4-column desktop /
 * 2-column tablet / stacked mobile architecture. Removes legacy illustration clutter.
 * Renders strictly verified repository routes only (no fake newsletter forms).
 */
import Icon from '../ui/Icon.astro';
import { getPublishedPinkFridayCampaign, shouldDisplayCampaignToCustomers } from '../../utils/pink-friday-server';
import { getLocaleDirection } from '../../i18n/config';
import { buildLocalizedPath } from '../../i18n/routes';
import { t } from '../../i18n/translator';
import type { Locale } from '../../i18n/types';

export interface Props {
  locale?: Locale;
}

const { locale = 'ar' } = Astro.props;
const dir = getLocaleDirection(locale);
const publishedCampaign = await getPublishedPinkFridayCampaign();
const showPinkFriday = shouldDisplayCampaignToCustomers(publishedCampaign);
const currentYear = new Date().getFullYear();
---

<footer
  class="dandy-footer"
  id="site-footer"
  dir={dir}
  aria-label={t(locale, 'footer.regionLabel')}
>
  <div class="dandy-footer-container">
    <div class="dandy-footer-grid">
      <!-- Column 1: Brand Identity, Editorial Statement & Social Links -->
      <div class="dandy-footer-brand">
        <a
          href={buildLocalizedPath('/', locale)}
          class="dandy-footer-logo"
          aria-label={`Dandy Cosmetics - ${t(locale, 'navigation.home')}`}
        >
          <img
            src="/assets/bab/images/dandy-logo-white.svg"
            alt="Dandy Cosmetics"
            width="132"
            height="44"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="dandy-footer-desc">
          {t(locale, 'footer.editorialDesc')}
        </p>

        <div class="dandy-footer-meta">
          <span class="dandy-footer-meta-item">
            <Icon name="map-pin" size={15} strokeWidth={1.75} />
            <span>{t(locale, 'footer.locationLabel')}</span>
          </span>
          <a href="tel:01038941005" class="dandy-footer-meta-item" dir="ltr">
            <Icon name="phone" size={15} strokeWidth={1.75} />
            <span>01038941005</span>
          </a>
        </div>

        <div
          class="dandy-footer-social"
          id="footer-social-links"
          aria-label={locale === 'en' ? 'Social Media Channels' : 'حسابات التواصل الاجتماعي'}
        >
          <a
            id="footer-social-facebook"
            href="https://www.facebook.com/profile.php?id=61563039704396"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={locale === 'en' ? 'Facebook' : 'فيسبوك'}
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99h-2.54V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z" />
            </svg>
          </a>
          <a
            id="footer-social-instagram"
            href="https://www.instagram.com/dandy_skincare_cosmotics"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={locale === 'en' ? 'Instagram' : 'إنستغرام'}
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            id="footer-social-whatsapp"
            href="https://wa.me/201038941005"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={locale === 'en' ? 'WhatsApp' : 'واتساب'}
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.2-.4.1-.2 0-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2 1 2.4c.1.2 1.6 2.5 4 3.4.5.2 1 .3 1.3.5.6.2 1.1.1 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.2-.2-.4-.3z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Shopping & Categories -->
      <div class="dandy-footer-col">
        <h3 class="dandy-footer-heading">{t(locale, 'footer.colShopping')}</h3>
        <ul class="dandy-footer-list">
          <li><a href={buildLocalizedPath('/all-products', locale)}>{t(locale, 'navigation.allProducts')}</a></li>
          <li><a href={buildLocalizedPath('/category/skin-care', locale)}>{t(locale, 'categories.skinCare')}</a></li>
          <li><a href={buildLocalizedPath('/category/hair-care', locale)}>{t(locale, 'categories.hairCare')}</a></li>
          <li><a href={buildLocalizedPath('/category/body-care', locale)}>{t(locale, 'categories.bodyCare')}</a></li>
          <li><a href={buildLocalizedPath('/category/fragrance', locale)}>{t(locale, 'categories.fragrance')}</a></li>
          <li><a href={buildLocalizedPath('/special-offers', locale)}>{t(locale, 'navigation.specialOffers')}</a></li>
          {showPinkFriday && (
            <li>
              <a href={buildLocalizedPath('/pink-friday', locale)} class="dandy-footer-accent-link">
                {locale === 'en' ? 'Pink Friday Offers' : 'عروض Pink Friday'}
              </a>
            </li>
          )}
        </ul>
      </div>

      <!-- Column 3: Customer Support -->
      <div class="dandy-footer-col">
        <h3 class="dandy-footer-heading">{t(locale, 'footer.colSupport')}</h3>
        <ul class="dandy-footer-list">
          <li><a href={buildLocalizedPath('/track-order', locale)}>{t(locale, 'navigation.trackOrder')}</a></li>
          <li><a href={buildLocalizedPath('/help', locale)}>{locale === 'en' ? 'FAQs & Gift Guide' : 'الأسئلة الشائعة والمساعدة'}</a></li>
          <li><a href={buildLocalizedPath('/client-reviews', locale)}>{t(locale, 'navigation.reviews')}</a></li>
          <li><a href={buildLocalizedPath('/contact-us', locale)}>{t(locale, 'navigation.contactUs')}</a></li>
          <li><a href={buildLocalizedPath('/cart', locale)}>{t(locale, 'navigation.cart')}</a></li>
          <li><a href={buildLocalizedPath('/account', locale)}>{t(locale, 'navigation.account')}</a></li>
        </ul>
      </div>

      <!-- Column 4: Brand & Policies -->
      <div class="dandy-footer-col">
        <h3 class="dandy-footer-heading">{t(locale, 'footer.colBrand')}</h3>
        <ul class="dandy-footer-list" id="footer-menu-links">
          <li><a href={buildLocalizedPath('/about-us', locale)}>{t(locale, 'navigation.aboutUs')}</a></li>
          <li><a href={buildLocalizedPath('/blog', locale)}>{t(locale, 'navigation.blog')}</a></li>
          <li><a href={buildLocalizedPath('/privacy-policy', locale)}>{t(locale, 'navigation.privacyPolicy')}</a></li>
          <li><a href={buildLocalizedPath('/terms', locale)}>{t(locale, 'navigation.terms')}</a></li>
        </ul>
      </div>
    </div>

    <div class="dandy-footer-bottom">
      <p class="dandy-footer-copyright" id="footer-copyright">
        © {currentYear} Dandy Cosmetics. {t(locale, 'footer.copyrightSuffix')}
      </p>
      <div class="dandy-footer-bottom-links">
        <a href={buildLocalizedPath('/privacy-policy', locale)}>{locale === 'en' ? 'Privacy' : 'الخصوصية'}</a>
        <a href={buildLocalizedPath('/terms', locale)}>{t(locale, 'navigation.terms')}</a>
        <a href={buildLocalizedPath('/contact-us', locale)}>{locale === 'en' ? 'Support' : 'الدعم'}</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  footer.dandy-footer {
    width: 100%;
    background-color: var(--dandy-bg-dark);
    color: var(--dandy-ink-inverse);
    border-top: 1px solid rgba(250, 248, 246, 0.08);
    margin-top: clamp(56px, 7vw, 88px);
    font-family: var(--dandy-font-active-sans);
  }

  .dandy-footer-container {
    width: 100%;
    max-width: var(--dandy-container-max);
    margin-inline: auto;
    padding-block: clamp(44px, 5vw, 64px) 28px;
    padding-inline: var(--dandy-container-px);
  }

  .dandy-footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: clamp(28px, 3.5vw, 48px);
    padding-bottom: clamp(32px, 4vw, 44px);
    border-bottom: 1px solid rgba(250, 248, 246, 0.12);
  }

  .dandy-footer-logo {
    display: inline-flex;
    align-items: center;
    margin-bottom: 14px;
    text-decoration: none;
  }

  .dandy-footer-logo img {
    height: 40px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .dandy-footer-desc {
    margin: 0 0 18px 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #CBC4BC;
    max-width: 34ch;
  }

  .dandy-footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 20px;
  }

  .dandy-footer-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: #D7D0C8;
    text-decoration: none;
    transition: color var(--dandy-transition-fast);
  }

  a.dandy-footer-meta-item:hover {
    color: #FFFFFF;
  }

  .dandy-footer-social {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dandy-footer-social a {
    width: 38px;
    height: 38px;
    border-radius: var(--dandy-radius-pill);
    border: 1px solid rgba(250, 248, 246, 0.18);
    background-color: rgba(250, 248, 246, 0.04);
    color: var(--dandy-ink-inverse);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background-color var(--dandy-transition-fast), border-color var(--dandy-transition-fast), color var(--dandy-transition-fast);
  }

  .dandy-footer-social a:hover {
    background-color: var(--dandy-accent-primary);
    border-color: var(--dandy-accent-primary);
    color: #FFFFFF;
  }

  .dandy-footer-heading {
    margin: 0 0 16px 0;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .dandy-footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .dandy-footer-list a {
    display: inline-block;
    font-size: 0.875rem;
    line-height: 1.55;
    color: #CBC4BC;
    text-decoration: none;
    transition: color var(--dandy-transition-fast);
  }

  .dandy-footer-list a:hover {
    color: #FFFFFF;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .dandy-footer-list a.dandy-footer-accent-link {
    color: #F49BB9;
    font-weight: 600;
  }

  .dandy-footer-bottom {
    padding-top: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .dandy-footer-copyright {
    margin: 0;
    font-size: 0.8125rem;
    color: #A79F97;
  }

  .dandy-footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .dandy-footer-bottom-links a {
    font-size: 0.8125rem;
    color: #A79F97;
    text-decoration: none;
    transition: color var(--dandy-transition-fast);
  }

  .dandy-footer-bottom-links a:hover {
    color: #FFFFFF;
  }

  @media (max-width: 1023px) {
    .dandy-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 28px;
    }
  }

  @media (max-width: 639px) {
    .dandy-footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .dandy-footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
