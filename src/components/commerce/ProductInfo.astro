---
/**
 * DANDY COSMETICS — PDP STRUCTURED PRODUCT INFORMATION & PURCHASE MODULE (PHASE 4)
 * Botanical Editorial hierarchy: clean metadata row, H1 title, genuine rating link,
 * consistent pricing, scent selector, quantity + primary CTA, secondary actions, & verified highlights.
 */
import Icon from '../ui/Icon.astro';
import VariantSwatches from './VariantSwatches.astro';
import QuantityStepper from './QuantityStepper.astro';
import BotanicalFeatureGrid from './BotanicalFeatureGrid.astro';
import { formatEgpPrice } from '../../scripts/product-card';
import type { Locale } from '../../i18n/types';
import { buildLocalizedPath } from '../../i18n/index';
import type {
  ParsedDescriptionResult,
  PdpEffectivePricing,
  ProductHighlightItem,
  ReviewStatsResult,
} from '../../scripts/product-pdp';
import type { VariantItem } from '../../utils/products';

export interface Props {
  productId: string;
  productName: string;
  categorySlug: string;
  categoryLabelAr: string;
  isSoldOut: boolean;
  pricing: PdpEffectivePricing;
  hasVariants: boolean;
  variants: VariantItem[];
  parsedDescription: ParsedDescriptionResult;
  highlights: ProductHighlightItem[];
  reviewStats: ReviewStatsResult;
  waLink: string;
  shareWaLink: string;
  shareFbLink: string;
  shareIgLink: string;
  shareMessengerLink: string;
  canonicalUrl: string;
  locale?: Locale;
}

const {
  productId,
  productName,
  categorySlug,
  categoryLabelAr,
  isSoldOut,
  pricing,
  hasVariants,
  variants,
  parsedDescription,
  highlights,
  reviewStats,
  waLink,
  shareWaLink,
  shareFbLink,
  shareIgLink,
  shareMessengerLink,
  canonicalUrl,
  locale = 'ar',
} = Astro.props;

const isEn = locale === 'en';
const categoryHref = buildLocalizedPath(`/category/${categorySlug}`, locale);

function truncateLead(text: string, maxLen = 148): string {
  const clean = (text || '').trim();
  if (!clean) return '';
  if (clean.length <= maxLen) return clean;
  const sliced = clean.slice(0, maxLen);
  const lastSpace = sliced.lastIndexOf(' ');
  return `${(lastSpace > 40 ? sliced.slice(0, lastSpace) : sliced).trim()}...`;
}

const shortLead = parsedDescription.hasCustomDescription
  ? truncateLead(parsedDescription.leadIntro)
  : '';
const hasReviews = reviewStats.count > 0;
---

<div class="dandy-pdp-info">
  <!-- 1. Clean Unboxed Category + Availability Metadata -->
  <div class="dandy-pdp-meta-row" id="product-category" data-dandy-entrance="1">
    <a href={categoryHref} class="dandy-pdp-cat-link">
      {categoryLabelAr}
    </a>
    <span class="dandy-pdp-meta-sep" aria-hidden="true">·</span>
    <span class:list={['dandy-pdp-stock-text', { 'is-soldout': isSoldOut }]}>
      {isSoldOut
        ? isEn
          ? 'Currently out of stock'
          : 'نفدت الكمية حالياً'
        : isEn
          ? 'In stock & ready to ship'
          : 'متوفر للطلب'}
    </span>
  </div>

  <!-- 2. Editorial H1 Product Title -->
  <h1 class="dandy-pdp-title" id="product-title" data-dandy-entrance="2">{productName}</h1>

  <!-- 3. Genuine Rating Summary (never fabricated) -->
  <a
    href="#product-reviews-container"
    class:list={['dandy-pdp-rating-link', { 'has-reviews': hasReviews }]}
    id="product-rating-header"
    data-dandy-entrance="3"
    aria-label={
      hasReviews
        ? isEn
          ? `Rated ${reviewStats.averageFormatted} out of 5 based on ${reviewStats.count} ${reviewStats.count === 1 ? 'review' : 'reviews'}`
          : `تقييم المنتج ${reviewStats.averageFormatted} من 5 بناءً على ${reviewStats.count} تقييم`
        : isEn
          ? 'No reviews yet for this product'
          : 'لا توجد تقييمات بعد لهذا المنتج'
    }
  >
    <span class="dandy-pdp-rating-stars" id="header-rating-stars" aria-hidden="true">
      {hasReviews ? (
        Array.from({ length: 5 }).map((_, idx) => (
          <Icon
            name="star"
            size={15}
            strokeWidth={1.8}
            class={idx + 1 <= Math.round(reviewStats.average) ? 'dandy-star-filled' : 'dandy-star-empty'}
          />
        ))
      ) : (
        <Icon name="star" size={14} strokeWidth={1.8} class="dandy-star-empty" />
      )}
    </span>
    <span class="dandy-pdp-rating-text dandy-tabular" id="header-rating-text">
      {hasReviews ? (
        <>
          <strong>{reviewStats.averageFormatted}</strong>
          <span class="dandy-pdp-rating-count">
            {isEn
              ? `(${reviewStats.count} ${reviewStats.count === 1 ? 'review' : 'reviews'})`
              : `(${reviewStats.count} تقييم)`}
          </span>
        </>
      ) : (
        <span class="p-rating-no-reviews">
          {isEn ? 'No reviews yet' : 'لا توجد تقييمات بعد'}
        </span>
      )}
    </span>
  </a>

  {shortLead && (
    <p class="dandy-pdp-lead">{shortLead}</p>
  )}

  <!-- 4. Pricing & Verified Discount Display -->
  <div class="dandy-pdp-price-block" id="product-price-section">
    <div class="dandy-pdp-price-row">
      <span class="dandy-pdp-price-current dandy-tabular" id="product-price">
        {formatEgpPrice(pricing.effectiveUnitPrice, locale)}
      </span>

      <del
        class="dandy-pdp-price-old dandy-tabular"
        id="product-old-price"
        hidden={pricing.effectiveOldPrice === null}
        aria-label={
          pricing.effectiveOldPrice !== null
            ? isEn
              ? `Original price ${formatEgpPrice(pricing.effectiveOldPrice, locale)}`
              : `السعر قبل الخصم ${formatEgpPrice(pricing.effectiveOldPrice)}`
            : undefined
        }
      >
        {pricing.effectiveOldPrice !== null ? formatEgpPrice(pricing.effectiveOldPrice, locale) : ''}
      </del>

      {(pricing.isPinkFriday || pricing.discountPercent || pricing.savingsAmount) && (
        <span
          class:list={['dandy-pdp-discount-note dandy-tabular', { 'is-campaign': pricing.isPinkFriday }]}
          id="product-discount-note"
        >
          {pricing.isPinkFriday
            ? `${pricing.campaignBadgeText || 'Pink Friday'}${pricing.savingsAmount ? (isEn ? ` · Save ${formatEgpPrice(pricing.savingsAmount, locale)}` : ` · توفير ${formatEgpPrice(pricing.savingsAmount)}`) : ''}`
            : pricing.savingsAmount && pricing.discountPercent
              ? isEn
                ? `${pricing.discountPercent}% OFF · Save ${formatEgpPrice(pricing.savingsAmount, locale)}`
                : `خصم ${pricing.discountPercent}% · توفير ${formatEgpPrice(pricing.savingsAmount)}`
              : pricing.discountPercent
                ? isEn
                  ? `${pricing.discountPercent}% OFF`
                  : `خصم ${pricing.discountPercent}%`
                : pricing.savingsAmount
                  ? isEn
                    ? `Save ${formatEgpPrice(pricing.savingsAmount, locale)}`
                    : `توفير ${formatEgpPrice(pricing.savingsAmount)}`
                  : ''}
        </span>
      )}
    </div>

    <p
      class="dandy-pdp-multi-scent-note dandy-tabular"
      id="multi-scent-price-note"
      hidden
      aria-live="polite"
    ></p>
  </div>

  <!-- 5. Variant / Scent Selector (only shown for multi-scent products) -->
  <VariantSwatches variants={variants} hasVariants={hasVariants} locale={locale} />

  <!-- 6. Quantity + Primary Add-to-Cart Action -->
  <div class="dandy-pdp-purchase-row">
    <QuantityStepper disabled={isSoldOut} locale={locale} />

    <button
      type="button"
      class:list={['dandy-pdp-add-btn', { 'is-soldout': isSoldOut }]}
      id="add-to-cart-btn"
      disabled={isSoldOut}
      aria-disabled={isSoldOut ? 'true' : undefined}
    >
      {isSoldOut ? (
        <>
          <Icon name="ban" size={18} strokeWidth={1.9} />
          <span data-add-label>{isEn ? 'Sold Out' : 'نفذت الكمية'}</span>
        </>
      ) : (
        <>
          <Icon name="shopping-bag" size={18} strokeWidth={1.9} />
          <span data-add-label>{isEn ? 'Add to Bag' : 'أضيفي للسلة'}</span>
        </>
      )}
    </button>
  </div>

  <!-- 7. Secondary Utility Actions: Wishlist, WhatsApp Inquiry, Share -->
  <div class="dandy-pdp-utility-row">
    <button
      type="button"
      class="dandy-pdp-utility-btn"
      id="actionWishlistBtn"
      data-product-id={productId}
      aria-label={isEn ? 'Add to Wishlist' : 'إضافة إلى المفضلة'}
      aria-pressed="false"
    >
      <Icon name="heart" size={16} strokeWidth={1.85} />
      <span id="actionWishlistText">{isEn ? 'Add to Wishlist' : 'إضافة إلى المفضلة'}</span>
    </button>

    <a
      class="dandy-pdp-utility-btn is-whatsapp"
      id="whatsapp-link"
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={isEn ? 'Inquire on WhatsApp' : 'استفسار عن المنتج عبر واتساب'}
    >
      <Icon name="message-circle" size={16} strokeWidth={1.85} />
      <span>{isEn ? 'Ask on WhatsApp' : 'استفسار عبر واتساب'}</span>
    </a>

    <div class="dandy-pdp-share-wrap">
      <button
        type="button"
        class="dandy-pdp-utility-btn is-icon-label"
        id="share-toggle"
        aria-expanded="false"
        aria-controls="share-popover-menu"
      >
        <Icon name="share-2" size={16} strokeWidth={1.85} />
        <span>{isEn ? 'Share' : 'مشاركة'}</span>
      </button>

      <div
        class="dandy-pdp-share-popover"
        id="share-popover-menu"
        role="region"
        aria-label={isEn ? 'Product share options' : 'خيارات مشاركة المنتج'}
        hidden
      >
        <button
          type="button"
          class="dandy-pdp-share-item"
          id="copy-product-link"
          data-copy-url={canonicalUrl}
        >
          <Icon name="copy" size={15} strokeWidth={1.8} />
          <span>{isEn ? 'Copy link' : 'نسخ الرابط'}</span>
        </button>

        <a
          id="share-whatsapp"
          href={shareWaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="dandy-pdp-share-item"
        >
          <Icon name="message-circle" size={15} strokeWidth={1.8} />
          <span>{isEn ? 'WhatsApp' : 'واتساب'}</span>
        </a>

        <a
          id="share-facebook"
          href={shareFbLink}
          target="_blank"
          rel="noopener noreferrer"
          class="dandy-pdp-share-item"
        >
          <Icon name="share-2" size={15} strokeWidth={1.8} />
          <span>{isEn ? 'Facebook' : 'فيسبوك'}</span>
        </a>

        <a
          id="facebook-link"
          href={shareMessengerLink}
          target="_blank"
          rel="noopener noreferrer"
          class="dandy-pdp-share-item"
        >
          <Icon name="message-circle" size={15} strokeWidth={1.8} />
          <span>{isEn ? 'Messenger' : 'ماسنجر'}</span>
        </a>

        <a
          id="instagram-link"
          href={shareIgLink}
          target="_blank"
          rel="noopener noreferrer"
          class="dandy-pdp-share-item"
        >
          <Icon name="sparkles" size={15} strokeWidth={1.8} />
          <span>{isEn ? 'Instagram' : 'انستجرام'}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 8. Verified Product Specifications Grid -->
  <BotanicalFeatureGrid items={highlights} locale={locale} />
</div>

<style>
  .dandy-pdp-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  /* Unboxed metadata row */
  .dandy-pdp-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: var(--dandy-text-sm);
    color: var(--dandy-ink-muted);
    line-height: 1.4;
  }

  .dandy-pdp-cat-link {
    color: var(--dandy-botanical-deep);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--dandy-transition-fast);
  }

  .dandy-pdp-cat-link:hover {
    color: var(--dandy-accent-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .dandy-pdp-meta-sep {
    color: var(--dandy-border-default);
  }

  .dandy-pdp-stock-text {
    color: var(--dandy-botanical-deep);
    font-weight: 500;
  }

  .dandy-pdp-stock-text.is-soldout {
    color: var(--dandy-danger);
    font-weight: 600;
  }

  /* Title */
  .dandy-pdp-title {
    margin: 0;
    font-family: var(--dandy-font-active-sans);
    font-size: clamp(1.5rem, 2.5vw, 2.125rem);
    font-weight: 700;
    line-height: var(--dandy-leading-heading-ar);
    color: var(--dandy-ink-primary);
    letter-spacing: 0;
    text-wrap: balance;
  }

  /* Rating Row */
  .dandy-pdp-rating-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    text-decoration: none;
    color: var(--dandy-ink-secondary);
    font-size: var(--dandy-text-sm);
    padding-block: 2px;
  }

  .dandy-pdp-rating-link.has-reviews:hover {
    color: var(--dandy-ink-primary);
  }

  .dandy-pdp-rating-stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  :global(.dandy-star-filled) {
    color: var(--dandy-gold-editorial);
    fill: var(--dandy-gold-editorial);
  }

  :global(.dandy-star-empty) {
    color: var(--dandy-border-default);
  }

  .dandy-pdp-rating-text {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .dandy-pdp-rating-count,
  .p-rating-no-reviews {
    color: var(--dandy-ink-muted);
    font-size: var(--dandy-text-xs);
  }

  .dandy-pdp-lead {
    margin: 0;
    font-size: var(--dandy-text-base);
    line-height: var(--dandy-leading-body-ar);
    color: var(--dandy-ink-secondary);
    max-width: 58ch;
  }

  /* Price Block */
  .dandy-pdp-price-block {
    padding-block: 14px;
    border-top: 1px solid var(--dandy-border-subtle);
    border-bottom: 1px solid var(--dandy-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dandy-pdp-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
  }

  .dandy-pdp-price-current {
    font-size: clamp(1.5rem, 2.3vw, 1.9rem);
    font-weight: 700;
    color: var(--dandy-ink-primary);
    line-height: 1.2;
  }

  .dandy-pdp-price-old {
    font-size: 1rem;
    color: var(--dandy-ink-muted);
    text-decoration: line-through;
  }

  .dandy-pdp-discount-note {
    font-size: var(--dandy-text-xs);
    font-weight: 700;
    color: var(--dandy-accent-text);
    background-color: var(--dandy-accent-soft);
    border: 1px solid var(--dandy-border-accent);
    padding: 3px 9px;
    border-radius: var(--dandy-radius-xs);
  }

  .dandy-pdp-discount-note.is-campaign {
    background-color: var(--dandy-plum-ink);
    border-color: var(--dandy-plum-ink);
    color: var(--dandy-ink-inverse);
  }

  .dandy-pdp-multi-scent-note {
    margin: 0;
    font-size: var(--dandy-text-xs);
    color: var(--dandy-botanical-deep);
    font-weight: 600;
  }

  /* Primary Purchase Row */
  .dandy-pdp-purchase-row {
    display: flex;
    align-items: stretch;
    gap: 12px;
    padding-top: 2px;
  }

  .dandy-pdp-add-btn {
    flex: 1 1 auto;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid var(--dandy-accent-primary);
    border-radius: var(--dandy-radius-pill);
    background-color: var(--dandy-accent-primary);
    color: #FFFFFF;
    font-family: var(--dandy-font-active-sans);
    font-size: var(--dandy-text-base);
    font-weight: 700;
    line-height: 1.3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--dandy-transition-fast),
      border-color var(--dandy-transition-fast),
      transform var(--dandy-transition-fast);
  }

  .dandy-pdp-add-btn:hover:not(:disabled) {
    background-color: var(--dandy-accent-hover);
    border-color: var(--dandy-accent-hover);
  }

  .dandy-pdp-add-btn.is-added {
    background-color: var(--dandy-botanical-deep);
    border-color: var(--dandy-botanical-deep);
  }

  .dandy-pdp-add-btn:disabled,
  .dandy-pdp-add-btn.is-soldout {
    background-color: var(--dandy-bg-stage);
    border-color: var(--dandy-border-default);
    color: var(--dandy-ink-muted);
    cursor: not-allowed;
  }

  /* Secondary Utility Row */
  .dandy-pdp-utility-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .dandy-pdp-utility-btn {
    appearance: none;
    flex: 1 1 150px;
    min-height: 44px;
    padding: 9px 14px;
    border-radius: var(--dandy-radius-sm);
    border: 1px solid var(--dandy-border-default);
    background-color: var(--dandy-bg-page);
    color: var(--dandy-ink-primary);
    font-family: var(--dandy-font-active-sans);
    font-size: var(--dandy-text-sm);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dandy-transition-fast),
      border-color var(--dandy-transition-fast),
      color var(--dandy-transition-fast);
  }

  .dandy-pdp-utility-btn:hover {
    background-color: var(--dandy-bg-editorial);
    border-color: var(--dandy-ink-primary);
  }

  .dandy-pdp-utility-btn.active {
    background-color: var(--dandy-accent-soft);
    border-color: var(--dandy-border-accent);
    color: var(--dandy-accent-text);
  }

  .dandy-pdp-utility-btn.active :global(svg) {
    fill: currentColor;
  }

  .dandy-pdp-utility-btn.is-whatsapp {
    color: var(--dandy-botanical-deep);
  }

  .dandy-pdp-share-wrap {
    position: relative;
    flex: 0 1 auto;
  }

  .dandy-pdp-utility-btn.is-icon-label {
    flex: 0 1 auto;
    padding-inline: 16px;
  }

  .dandy-pdp-share-popover {
    position: absolute;
    top: calc(100% + 8px);
    inset-inline-end: 0;
    z-index: 30;
    min-width: 196px;
    padding: 8px;
    background-color: var(--dandy-bg-page);
    border: 1px solid var(--dandy-border-default);
    border-radius: var(--dandy-radius-md);
    box-shadow: var(--dandy-shadow-md);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dandy-pdp-share-popover[hidden] {
    display: none;
  }

  .dandy-pdp-share-item {
    appearance: none;
    background: transparent;
    border: 0;
    width: 100%;
    min-height: 40px;
    padding: 8px 10px;
    border-radius: var(--dandy-radius-sm);
    color: var(--dandy-ink-primary);
    font-family: var(--dandy-font-active-sans);
    font-size: var(--dandy-text-sm);
    font-weight: 500;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    text-align: start;
    transition: background-color var(--dandy-transition-fast);
  }

  .dandy-pdp-share-item:hover {
    background-color: var(--dandy-bg-editorial);
  }

  @media (max-width: 480px) {
    .dandy-pdp-purchase-row {
      gap: 10px;
    }

    .dandy-pdp-add-btn {
      padding-inline: 16px;
      font-size: var(--dandy-text-sm);
    }

    .dandy-pdp-utility-btn {
      flex: 1 1 calc(50% - 5px);
      font-size: var(--dandy-text-xs);
      padding-inline: 10px;
    }

    .dandy-pdp-share-wrap {
      flex: 1 1 100%;
    }

    .dandy-pdp-utility-btn.is-icon-label {
      width: 100%;
    }

    .dandy-pdp-share-popover {
      inset-inline: 0;
    }
  }
</style>
