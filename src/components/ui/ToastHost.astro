---
/**
 * DANDY COSMETICS — GLOBAL TOAST HOST COMPONENT (PHASE 1 / PHASE 11)
 * Provides accessible live-regions and visible toast container.
 */
import type { Locale } from '../../i18n/types';

export interface Props {
  locale?: Locale;
}

const { locale = 'ar' } = Astro.props;
const notificationsLabel = locale === 'en' ? 'Notifications' : 'الإشعارات';
---

<div class="dandy-sr-only" id="dandy-toast-live-polite" aria-live="polite" aria-atomic="true"></div>
<div class="dandy-sr-only" id="dandy-toast-live-assertive" aria-live="assertive" aria-atomic="true"></div>
<div
  id="dandy-toast-host"
  class="dandy-toast-host"
  aria-label={notificationsLabel}
></div>

<script>
  import { initDandyToast } from '../../scripts/toast';
  initDandyToast();
</script>
