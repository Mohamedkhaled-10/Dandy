---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="حسابي | Dandy"
  description="إدارة حساب العميل، متابعة الطلبات السابقة، إدارة العناوين المحفوظة، واستعراض قائمة المفضلة في متجر داندي."
  robots="noindex, nofollow"
>
  <slot name="head" slot="head">
    <style is:global>
      .account-page-wrapper {
        padding-top: 110px;
        padding-bottom: 70px;
        min-height: 85vh;
      }

      /* Hero Header */
      .account-hero-card {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        padding: 24px 28px;
        margin-bottom: 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
      }

      .account-user-meta {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .account-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: var(--color-surface-soft);
        border: 1px solid var(--border-light);
        color: var(--color-blush);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: 800;
      }

      .account-greeting h1 {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 0 0 4px;
      }

      .account-greeting p {
        color: var(--color-muted);
        font-size: 0.88rem;
        margin: 0;
        direction: ltr;
        text-align: right;
      }

      .account-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .btn-account-logout {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        color: #dc2626;
        border: 1px solid #fee2e2;
        padding: 8px 16px;
        border-radius: 99px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
      }

      .btn-account-logout:hover {
        background: #fef2f2;
        border-color: #fca5a5;
      }

      /* Tabs Navigation */
      .account-nav-tabs {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid var(--border-light);
        margin-bottom: 28px;
        overflow-x: auto;
        padding-bottom: 0;
      }

      .account-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: none;
        border: none;
        padding: 12px 18px;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-muted);
        cursor: pointer;
        position: relative;
        transition: all 0.2s;
        white-space: nowrap;
        font-family: inherit;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
      }

      .account-tab-btn i {
        font-size: 1rem;
      }

      .account-tab-btn .badge-counter {
        background: var(--color-surface-soft);
        color: var(--color-muted);
        font-size: 0.75rem;
        font-weight: 700;
        padding: 1px 7px;
        border-radius: 99px;
        transition: all 0.2s;
        border: 1px solid var(--border-light);
      }

      .account-tab-btn:hover {
        color: var(--color-primary);
      }

      .account-tab-btn.active {
        color: var(--color-blush);
        border-bottom-color: var(--color-blush);
      }

      .account-tab-btn.active .badge-counter {
        background: var(--color-blush);
        color: #fff;
        border-color: var(--color-blush);
      }

      /* Tab Panels */
      .account-tab-content {
        display: none;
      }

      .account-tab-content.active {
        display: block;
      }

      /* Orders Section */
      .orders-grid {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .order-history-card {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        padding: 20px 24px;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .order-history-card:hover {
        border-color: var(--color-blush);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
      }

      .order-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-light);
        margin-bottom: 16px;
      }

      .order-code-badge {
        font-weight: 800;
        font-size: 0.98rem;
        color: var(--color-primary);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        direction: ltr;
      }

      .order-date-text {
        font-size: 0.82rem;
        color: var(--color-muted);
      }

      .order-card-body {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        align-items: center;
        margin-bottom: 16px;
      }

      .order-info-item {
        font-size: 0.88rem;
      }

      .order-info-item .label {
        color: var(--color-muted);
        margin-bottom: 2px;
        font-size: 0.78rem;
      }

      .order-info-item .val {
        font-weight: 700;
        color: var(--color-primary);
      }

      .order-status-pill {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 99px;
        font-size: 0.8rem;
        font-weight: 700;
      }

      .status-new { background: #eff6ff; color: #1e40af; }
      .status-processing { background: #fff7ed; color: #9a3412; }
      .status-shipped { background: #faf5ff; color: #6b21a8; }
      .status-delivered { background: #f0fdf4; color: #166534; }
      .status-cancelled { background: #fef2f2; color: #991b1b; }

      .order-card-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        border-top: 1px dashed var(--border-light);
        padding-top: 14px;
      }

      .btn-order-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 99px;
        font-size: 0.85rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s;
        font-family: inherit;
      }

      .btn-order-action.primary {
        background: var(--color-blush);
        color: #fff;
      }

      .btn-order-action.primary:hover {
        background: var(--color-primary);
      }

      .btn-order-action.secondary {
        background: var(--color-surface-soft);
        color: var(--color-primary);
        border: 1px solid var(--border-light);
      }

      .btn-order-action.secondary:hover {
        background: #f3f4f6;
      }

      /* Addresses Section */
      .addresses-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
      }

      .btn-add-address {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--color-blush);
        color: #fff;
        font-weight: 700;
        padding: 9px 18px;
        border-radius: 99px;
        border: none;
        cursor: pointer;
        font-size: 0.88rem;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(219, 39, 119, 0.15);
        font-family: inherit;
      }

      .btn-add-address:hover {
        background: var(--color-primary);
      }

      .addresses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
      }

      .address-card {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        padding: 20px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .address-card.is-default {
        border-color: var(--color-blush);
        background: #fffafa;
      }

      .address-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
      }

      .address-label {
        font-size: 1rem;
        font-weight: 800;
        color: var(--color-primary);
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .badge-default-address {
        background: var(--color-blush);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 99px;
      }

      .address-details {
        color: var(--color-muted);
        font-size: 0.88rem;
        line-height: 1.6;
        margin-bottom: 16px;
      }

      .address-details strong {
        color: var(--color-primary);
        font-weight: 700;
      }

      .address-card-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        border-top: 1px solid var(--border-light);
        padding-top: 12px;
        flex-wrap: wrap;
      }

      .btn-addr-action {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 5px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: background 0.2s, color 0.2s;
        font-family: inherit;
      }

      .btn-addr-action.edit {
        color: #2563eb;
        background: #eff6ff;
      }
      .btn-addr-action.edit:hover { background: #dbeafe; }

      .btn-addr-action.delete {
        color: #dc2626;
        background: #fef2f2;
      }
      .btn-addr-action.delete:hover { background: #fee2e2; }

      .btn-addr-action.set-default {
        color: var(--color-blush);
        background: #fdf2f8;
        margin-right: auto;
      }
      .btn-addr-action.set-default:hover { background: #fce7f3; }

      /* Wishlist Grid & Product Card */
      .wishlist-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
      }

      .wishlist-product-card {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color 0.2s, box-shadow 0.2s;
        position: relative;
      }

      .wishlist-product-card:hover {
        border-color: var(--color-blush);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
      }

      .wishlist-img-wrap {
        position: relative;
        aspect-ratio: 1/1;
        background: var(--color-surface-soft);
        overflow: hidden;
        cursor: pointer;
      }

      .wishlist-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s;
      }

      .wishlist-product-card:hover .wishlist-img-wrap img {
        transform: scale(1.04);
      }

      .wishlist-sale-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        background: var(--color-blush);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 6px;
        border-radius: 4px;
        z-index: 2;
      }

      .wishlist-card-content {
        padding: 14px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }

      .wishlist-product-title {
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--color-primary);
        margin: 0 0 6px;
        cursor: pointer;
        line-height: 1.4;
      }

      .wishlist-product-title:hover {
        color: var(--color-blush);
      }

      .wishlist-price-row {
        margin-bottom: 12px;
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--color-primary);
      }

      .wishlist-price-row .old-price {
        font-size: 0.8rem;
        color: var(--color-muted);
        text-decoration: line-through;
        margin-left: 6px;
        font-weight: 500;
      }

      .wishlist-actions {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .btn-wishlist-add-cart {
        background: var(--color-primary);
        color: #fff;
        border: none;
        padding: 9px 12px;
        border-radius: 99px;
        font-weight: 700;
        font-size: 0.82rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: background 0.2s;
        font-family: inherit;
      }

      .btn-wishlist-add-cart:hover {
        background: var(--color-blush);
      }

      .btn-wishlist-remove {
        background: transparent;
        color: var(--color-muted);
        border: 1px solid var(--border-light);
        padding: 6px 10px;
        border-radius: 99px;
        font-weight: 700;
        font-size: 0.78rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        transition: all 0.2s;
        font-family: inherit;
      }

      .btn-wishlist-remove:hover {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fee2e2;
      }

      /* Empty State */
      .account-empty-state {
        text-align: center;
        padding: 48px 20px;
        background: var(--color-surface);
        border: 1px dashed var(--border-light);
        border-radius: var(--border-radius-md);
      }

      .account-empty-state i {
        font-size: 2.8rem;
        color: var(--color-muted);
        opacity: 0.6;
        margin-bottom: 12px;
        display: inline-block;
      }

      .account-empty-state h3 {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--color-primary);
        margin-bottom: 6px;
      }

      .account-empty-state p {
        color: var(--color-muted);
        font-size: 0.88rem;
        max-width: 400px;
        margin: 0 auto 20px;
        line-height: 1.5;
      }

      .btn-empty-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--color-blush);
        color: #fff;
        font-weight: 700;
        padding: 10px 22px;
        border-radius: 99px;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(219, 39, 119, 0.2);
        transition: background 0.2s;
        font-size: 0.88rem;
      }

      .btn-empty-action:hover {
        background: var(--color-primary);
      }

      /* Address Modal */
      .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        padding: 20px;
        backdrop-filter: blur(4px);
      }

      .modal-overlay.active {
        display: flex;
      }

      .modal-card {
        background: #fff;
        border-radius: var(--border-radius-md);
        width: 100%;
        max-width: 460px;
        padding: 24px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
        max-height: 90vh;
        overflow-y: auto;
      }

      .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border-light);
      }

      .modal-header h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--color-primary);
      }

      .btn-modal-close {
        background: none;
        border: none;
        font-size: 1.2rem;
        color: var(--color-muted);
        cursor: pointer;
      }

      .modal-form-group {
        margin-bottom: 14px;
        text-align: right;
      }

      .modal-form-group label {
        display: block;
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--color-primary);
        margin-bottom: 5px;
      }

      .modal-form-group input,
      .modal-form-group select,
      .modal-form-group textarea {
        width: 100%;
        padding: 9px 12px;
        border: 1px solid var(--border-light);
        border-radius: 8px;
        font-size: 0.9rem;
        font-family: inherit;
        background: var(--color-surface-soft);
        box-sizing: border-box;
      }

      .modal-form-group select {
        background: var(--color-surface-soft);
      }

      .modal-form-group input:focus,
      .modal-form-group select:focus,
      .modal-form-group textarea:focus {
        border-color: var(--color-blush);
        background: #fff;
        outline: none;
      }

      .modal-checkbox-row {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        margin-top: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-primary);
      }

      .modal-checkbox-row input {
        width: 16px;
        height: 16px;
        accent-color: var(--color-blush);
      }

      .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
      }

      .btn-modal-save {
        flex: 1;
        background: var(--color-blush);
        color: #fff;
        border: none;
        padding: 10px 16px;
        border-radius: 99px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        font-family: inherit;
      }

      .btn-modal-save:hover {
        background: var(--color-primary);
      }

      .btn-modal-cancel {
        background: var(--color-surface-soft);
        color: var(--color-muted);
        border: 1px solid var(--border-light);
        padding: 10px 18px;
        border-radius: 99px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s ease;
      }

      .btn-modal-cancel:hover {
        background: #e5e7eb;
        color: var(--color-primary);
      }

      /* Order Products Breakdown inside Card */
      .order-products-section {
        border-top: 1px dashed var(--border-light);
        padding-top: 14px;
        margin-top: 14px;
        margin-bottom: 14px;
      }

      .order-products-title {
        font-size: 0.84rem;
        font-weight: 700;
        color: var(--color-muted);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .order-products-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .order-product-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: var(--color-surface-soft, #faf8f7);
        border: 1px solid var(--border-light, #ede7e4);
        border-radius: 8px;
        padding: 10px 14px;
        flex-wrap: wrap;
      }

      .order-product-info {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        min-width: 200px;
      }

      .order-product-thumb {
        width: 44px;
        height: 44px;
        border-radius: 6px;
        object-fit: cover;
        background: #fff;
        border: 1px solid var(--border-light);
        flex-shrink: 0;
      }

      .order-product-details {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .order-product-name {
        font-weight: 700;
        font-size: 0.88rem;
        color: var(--color-primary);
        line-height: 1.4;
      }

      .order-product-meta {
        font-size: 0.78rem;
        color: var(--color-muted);
      }

      .btn-review-product {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff;
        border: 1px solid rgba(254, 93, 159, 0.4);
        color: var(--color-rose-kiss-600, #df3f85);
        padding: 6px 14px;
        border-radius: 99px;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
        white-space: nowrap;
      }

      .btn-review-product:hover {
        background: var(--color-rose-kiss-500, #fe5d9f);
        color: #fff;
        border-color: var(--color-rose-kiss-500, #fe5d9f);
      }

      .btn-review-product.has-review {
        border-color: #f59e0b;
        color: #b45309;
        background: #fffbeb;
      }

      .btn-review-product.has-review:hover {
        background: #f59e0b;
        color: #fff;
      }

      /* Review Modal Specifics */
      .review-modal-card {
        max-width: 480px;
      }

      .review-product-preview {
        display: flex;
        align-items: center;
        gap: 12px;
        background: var(--color-surface-soft);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 12px 14px;
        margin-bottom: 18px;
      }

      .review-preview-thumb {
        width: 52px;
        height: 52px;
        border-radius: 8px;
        object-fit: cover;
        background: #fff;
        border: 1px solid var(--border-light);
        flex-shrink: 0;
      }

      .review-preview-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
        flex: 1;
        min-width: 0;
      }

      .verified-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #dcfce7;
        color: #15803d;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 99px;
        width: fit-content;
        margin-bottom: 2px;
      }

      .review-preview-title {
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--color-primary);
        margin: 0;
        line-height: 1.35;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .review-preview-order {
        font-size: 0.76rem;
        color: var(--color-muted);
      }

      .star-rating-selector {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin: 8px 0;
        direction: ltr;
      }

      .star-rating-selector .star-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.9rem;
        padding: 4px;
        line-height: 1;
        transition: transform 0.15s ease;
      }

