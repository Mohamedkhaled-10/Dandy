              <div style="background:var(--color-surface-soft); font-size:0.8rem; padding:12px; border-radius:8px; margin-top:14px; border:1px solid var(--border-light); color:var(--color-text); line-height:1.5;">
                <i class="fas fa-shipping-fast" style="color:var(--color-blush); margin-left:4px;"></i> يصلكِ الطلب خلال 2 إلى 5 أيام عمل من تاريخ التأكيد.
              </div>
            </div>

          </div>
        </div>

        <div id="step-panel-3" class="checkout-step-panel" dir="rtl">
          <div class="catalog-checkout-grid">
            
            <div class="panel-main-card">
              <h2 style="font-size:1.15rem; font-weight:800; border-bottom:1px solid var(--border-light); padding-bottom:12px; margin-bottom:18px; color:var(--color-primary);">
                <i class="fas fa-clipboard-check" style="color:var(--color-blush); margin-left:8px;"></i> المراجعة وتأكيد الطلب
              </h2>
              
              <div class="final-review-section-header">
                <i class="fas fa-user-check" style="color:var(--color-blush);"></i> تفاصيل الشحن والمستلم
              </div>
              <div class="final-review-block">
                <p>اسم المستلم: <strong id="revCustName">...</strong></p>
                <p>رقم التواصل: <strong id="revCustPhone" style="direction:ltr; display:inline-block;">...</strong></p>
                <p>البريد الإلكتروني: <span id="revCustEmail">...</span></p>
                <p style="margin-top:8px; border-top:1px solid var(--border-light); padding-top:8px;">المدينة والمحافظة: <strong id="revCustLocation">...</strong></p>
                <p>العنوان بالتفصيل: <strong id="revCustAddress">...</strong></p>
              </div>

              <div class="final-review-section-header">
                <i class="fas fa-shopping-bag" style="color:var(--color-blush);"></i> المنتجات المطلوبة
              </div>
              <div id="revProductsList" style="margin-bottom:24px;">
              </div>

              <!-- التحقق الأمني التلقائي عبر Cloudflare Turnstile -->
              <div class="cart-turnstile-wrap" style="margin: 20px 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;">
                <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
                <small style="color:var(--color-muted); font-size:0.75rem;">حماية أمنية مشددة لمنع الطلبات الوهمية</small>
              </div>

              <div class="checkout-nav-row">
                <button class="btn-checkout-secondary" onclick="goToStep(2)">
                  <i class="fas fa-arrow-right"></i>
                  <span>تعديل العنوان</span>
                </button>
                <button class="btn-checkout-primary" style="background:#059669; box-shadow: 0 4px 14px rgba(5, 150, 105, 0.25);" id="finalPlaceOrderBtn" onclick="submitFinalOrder()">
                  <i class="fas fa-check"></i>
                  <span>تأكيد وإتمام الطلب</span>
                </button>
              </div>
            </div>

            <div class="panel-side-summary">
              <h3 style="font-size:1.05rem; font-weight:800; margin-bottom:14px; color:var(--color-primary); text-align: right;" dir="rtl">
                <i class="fas fa-money-bill-wave" style="color:#059669; margin-left:6px;"></i> طريقة الدفع
              </h3>
              
              <div style="background:rgba(5, 150, 105, 0.06); color:#065f46; padding:14px; border-radius:8px; font-weight:700; font-size:0.88rem; line-height:1.6; margin-bottom:18px; border:1px solid rgba(5, 150, 105, 0.15);">
                <i class="fas fa-hand-holding-usd"></i> الدفع عند الاستلام (COD)
                <p style="font-weight:normal; font-size:0.8rem; color:var(--color-text); margin-top:4px; margin-bottom:0;">يمكنكِ فحص وتأكيد المنتجات عند استلام الشحنة قبل الدفع.</p>
              </div>

              <div style="margin-bottom:12px; line-height:1.6;">
                <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size: 0.9rem;">
                  <span style="color:var(--color-muted);">المجموع الفرعي:</span>
                  <span id="summSubtotal" style="font-weight:700; color:var(--color-primary);">00 ج.م</span>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size: 0.9rem;">
                  <span style="color:var(--color-muted);">مصاريف الشحن:</span>
                  <span id="summShipping" style="font-weight:700; color:#059669;">00 ج.م</span>
                </div>
                <div style="border-top:1px solid var(--border-light); margin-top:10px; padding-top:10px; display:flex; justify-content:space-between; align-items:center;">
                  <span style="color:var(--color-primary); font-size:0.92rem; font-weight:800;">الإجمالي الكلي:</span>
                  <strong style="font-size: 1.4rem; color:var(--color-blush);" id="finalSummaryTotal">00 ج.م</strong>
                </div>
              </div>
              
              <p style="font-size:0.78rem; color:var(--color-muted); margin-top:10px; margin-bottom:0;" id="savingTextLoader">
                <i class="fas fa-lock" style="color:#059669; margin-left:4px;"></i> تأكيد الطلب يسجله بأمان ويوفر لك كود تتبع فوري.
              </p>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <script is:inline>
    const db = firebase.database();

    let cart = JSON.parse(localStorage.getItem('cart')) || [];
    let currentStep = 1;

    // English shipping fees mapped to Egyptian governorate zones
    const shippingRates = {
      "Gharbia": 70,
      "Dakahlia": 85,
      "Sharqia": 85,
      "Kafr El Sheikh": 85,
      "Qalyubia": 85,
      "Port Said": 85,
      "Damietta": 85,
      "Suez": 85,
      "Ismailia": 85,
      "Cairo": 85,
      "Giza": 85,
      "Beheira": 85,
      "Monufia": 85,
      "Alexandria": 85,
      "Fayoum": 100,
      "Beni Suef": 100,
      "Minya": 100,
      "Luxor": 120,
      "Aswan": 120,
      "Assiut": 120,
      "Sohag": 120,
      "North Sinai": 120,
      "South Sinai": 120,
      "Qena": 120,
      "New Valley": 120,
      "Red Sea": 120,
      "Matrouh": 120
    };

    function getShippingFeeForGov(govName) {
      if (!govName) return null;
      return shippingRates[govName] || 120;
    }

    // Render elements references
    const cartItemsList = document.getElementById('cartItemsList');
    const subtotalValSummary = document.getElementById('subtotalValSummary');
    const subtotalValSummary2 = document.getElementById('subtotalValSummary2');
    const grandTotalSummaryValue1 = document.getElementById('grandTotalSummaryValue1');
    const grandTotalSummaryValue2 = document.getElementById('grandTotalSummaryValue2');
    const finalSummaryTotal = document.getElementById('finalSummaryTotal');

    const shippingCostSummary2 = document.getElementById('shippingCostSummary2');

    // Final review text references
    const revCustName = document.getElementById('revCustName');
    const revCustPhone = document.getElementById('revCustPhone');
    const revCustEmail = document.getElementById('revCustEmail');
    const revCustLocation = document.getElementById('revCustLocation');
    const revCustAddress = document.getElementById('revCustAddress');
    const revProductsList = document.getElementById('revProductsList');

    const summSubtotal = document.getElementById('summSubtotal');
    const summShipping = document.getElementById('summShipping');

    function calculateCartSubtotal() {
      let subtotal = 0;
      cart.forEach(item => {
        const unitPrice = typeof getEffectiveUnitPrice === 'function'
          ? getEffectiveUnitPrice(item)
          : (Number(item.price) || 0);
        const qtyVal = parseInt(item.quantity) || 1;
        subtotal += unitPrice * qtyVal;
      });
      return subtotal;
    }

    // Handle live updates on Governorates dropdown change
    window.handleGovChange = function() {
      const govDropdown = document.getElementById('f-gov');
      if (!govDropdown) return; // Prevent TypeError if the cart is empty and the DOM is replaced

      const selectedGov = govDropdown.value;
      const subtotal = calculateCartSubtotal();
      
      if (selectedGov) {
        let fee = getShippingFeeForGov(selectedGov);
        if (subtotal > 2000) {
          fee = 0;
          shippingCostSummary2.textContent = "شحن مجاني";
          shippingCostSummary2.style.color = "var(--color-success)";
        } else {
          shippingCostSummary2.textContent = fee + " ج.م";
          shippingCostSummary2.style.color = "var(--color-primary)";
        }
        grandTotalSummaryValue2.textContent = (subtotal + fee).toFixed(0) + " ج.م";
      } else {
        if (subtotal > 2000) {
          shippingCostSummary2.textContent = "شحن مجاني";
          shippingCostSummary2.style.color = "var(--color-success)";
        } else {
          shippingCostSummary2.textContent = "شحن مجاني عندما تتخطى القيمة 2000 جنيه";
          shippingCostSummary2.style.color = "var(--color-blush)";
        }
        grandTotalSummaryValue2.textContent = subtotal.toFixed(0) + " ج.م";
      }
    };

    // Update Cart Badge inside Navbar
    function updateCartBadge() {
      if (typeof window.updateSharedCartCount === 'function') {
        window.updateSharedCartCount();
      } else {
        const badge = document.getElementById('cart-count');
        if (badge) {
          const totalQty = cart.reduce((sum, item) => sum + item.quantity, 0);
          badge.textContent = totalQty;
        }
      }
    }

    function renderStep1CartItems() {
      updateCartBadge(); // Ensure badge is always up to date

      if (cart.length === 0) {
        document.getElementById('cartCheckoutContainer').innerHTML = `
          <div style="text-align:center; padding:64px 24px; background:var(--color-surface); border:1px solid var(--border-light); border-radius:var(--border-radius-md); margin:0 auto; max-width:540px;" dir="rtl">
            <div style="width:64px; height:64px; border-radius:50%; background:var(--color-surface-soft); display:flex; align-items:center; justify-content:center; margin:0 auto 18px; color:var(--color-blush); font-size:1.6rem; border:1px solid var(--border-light);">
              <i class="fas fa-shopping-bag"></i>
            </div>
            <h2 style="font-size:1.35rem; font-weight:800; margin-bottom:8px; color:var(--color-primary);">حقيبة التسوق فارغة</h2>
            <p style="color:var(--color-muted); font-size:0.92rem; margin-bottom:24px; line-height:1.6;">لم تقومي بإضافة أي منتجات إلى حقيبتكِ بعد. تصفحي مجموعاتنا الطبيعية الآن!</p>
            <a href="/all-products" class="btn-checkout-primary" style="display:inline-flex; border-radius:99px; text-decoration:none;">
              <i class="fas fa-shopping-bag"></i>
              <span>تصفح جميع المنتجات</span>
            </a>
          </div>
        `;
        return;
      }

      cartItemsList.innerHTML = '';
      cart.forEach((item, index) => {
        const qtyVal = parseInt(item.quantity) || 1;
        const unitPrice = typeof getEffectiveUnitPrice === 'function'
          ? getEffectiveUnitPrice(item)
          : (Number(item.price) || 0);
        const rowSubtotal = unitPrice * qtyVal;
        
        const varInfo = typeof getVariantsDisplayInfo === 'function' 
          ? getVariantsDisplayInfo(item) 
          : (item.selectedVariant && item.selectedVariant.name ? { count: 1, label: 'الرائحة', text: item.selectedVariant.name } : null);
        
        // إذا كان المنتج لا يحتوي variants: لا تعرض أي سطر متعلق بالرائحة
        const variantHtml = (varInfo && varInfo.text)
          ? `<div class="cart-item-scent-badge">
               <i class="fas fa-sparkles"></i>
               <span>${varInfo.label}: <strong>${varInfo.text}</strong></span>
             </div>`
          : '';

        const itemCard = document.createElement('div');
        itemCard.className = 'cart-product-list-item';
        itemCard.innerHTML = `
          <div class="cart-item-info">
            <img loading="lazy" src="${item.image}" alt="${item.name}" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=100&q=80';">
            <div class="cart-item-meta">
              <h3>${item.name}</h3>
              ${variantHtml}
              <div class="cart-item-unit-price">${Number(unitPrice).toFixed(0)} ج.م للقطعة</div>
            </div>
          </div>

          <div class="cart-item-actions">
            <div class="qty-tactile-selector">
              <button type="button" class="qty-btn-adjust" onclick="changeQty(${index}, -1)" aria-label="تقليل الكمية">−</button>
              <span class="qty-display-box" aria-label="الكمية">${qtyVal}</span>
              <button type="button" class="qty-btn-adjust" onclick="changeQty(${index}, 1)" aria-label="زيادة الكمية">+</button>
            </div>

            <div class="cart-item-actions-left">
              <div class="cart-item-subtotal">
                ${Number(rowSubtotal).toFixed(0)} ج.م
              </div>

              <button type="button" class="action-btn-delete" onclick="removeItemFromCart(${index})" title="حذف من السلة" aria-label="حذف المنتج">
                <i class="fas fa-trash-alt"></i>
              </button>
            </div>
          </div>
        `;
        cartItemsList.appendChild(itemCard);
      });

      const sub = calculateCartSubtotal();
      subtotalValSummary.textContent = sub.toFixed(0) + ' ج.م';
      subtotalValSummary2.textContent = sub.toFixed(0) + ' ج.م';
      grandTotalSummaryValue1.textContent = sub.toFixed(0) + ' ج.م';
      grandTotalSummaryValue2.textContent = sub.toFixed(0) + ' ج.م';

      const shippingCostSummary1 = document.getElementById('shippingCostSummary1');
      if (shippingCostSummary1) {
        if (sub > 2000) {
          shippingCostSummary1.textContent = 'شحن مجاني';
          shippingCostSummary1.style.color = 'var(--color-success)';
          shippingCostSummary1.style.fontWeight = 'bold';
        } else {
          shippingCostSummary1.textContent = 'تُحدد في الخطوة التالية';
          shippingCostSummary1.style.color = 'var(--color-muted)';
          shippingCostSummary1.style.fontWeight = 'normal';
        }
      }
    }

    window.changeQty = function(index, delta) {
      if (cart[index]) {
        cart[index].quantity = (parseInt(cart[index].quantity) || 1) + delta;
        if (cart[index].quantity < 1) cart[index].quantity = 1;
        localStorage.setItem('cart', JSON.stringify(cart));
        renderStep1CartItems();
        handleGovChange();
        if (typeof window.updateSharedCartCount === 'function') window.updateSharedCartCount();
      }
    };

    window.removeItemFromCart = function(index) {
      cart.splice(index, 1);
      localStorage.setItem('cart', JSON.stringify(cart));
      renderStep1CartItems();
      handleGovChange();
      if (typeof window.updateSharedCartCount === 'function') window.updateSharedCartCount();
    };

    // --- تكامل حساب العميل والعناوين المحفوظة في الـ Checkout ---
    let customerSavedAddresses = {};

    function initCustomerCheckoutAddresses() {
      const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
      if (!auth) return;

      auth.onAuthStateChanged(async (user) => {
        const sec = document.getElementById('savedAddressesSection');
        if (!user) {
          if (sec) sec.style.display = 'none';
          return;
        }

        try {
          const snap = await db.ref('customers/' + user.uid + '/addresses').once('value');
          if (snap.exists()) {
            customerSavedAddresses = snap.val() || {};
            const keys = Object.keys(customerSavedAddresses);
            if (keys.length > 0) {
              const select = document.getElementById('savedAddressSelect');
              if (sec) sec.style.display = 'block';

              if (select) {
                select.innerHTML = '<option value="">-- اختاري عنواناً محفوظاً --</option>';
                let defaultKey = null;

                const govSelect = document.getElementById('f-gov');
                keys.forEach(k => {
                  const addr = customerSavedAddresses[k];
                  let govArabic = addr.governorate || '';
                  if (govSelect) {
                    const opt = Array.from(govSelect.options).find(o => o.value === addr.governorate);
                    if (opt) govArabic = opt.text;
                  }

                  const opt = document.createElement('option');
                  opt.value = k;
                  opt.textContent = `${addr.label || 'عنوان'} (${govArabic} - ${addr.city || ''}) ${addr.isDefault ? '★ (افتراضي)' : ''}`;
                  select.appendChild(opt);
                  if (addr.isDefault) defaultKey = k;
                });

                // تطبيق العنوان الافتراضي تلقائياً إن وجد
                const targetKey = defaultKey || keys[0];
                select.value = targetKey;
                window.applySavedAddress(targetKey);
              }
            } else {
              if (sec) sec.style.display = 'none';
            }
          } else {
            if (sec) sec.style.display = 'none';
          }

          // ملء الاسم ورقم الهاتف والبريد من بروفايل العميل إن كانا فارغين
          const custSnap = await db.ref('customers/' + user.uid).once('value');
          if (custSnap.exists()) {
            const cData = custSnap.val();
            const nameInput = document.getElementById('f-name');
            const phoneInput = document.getElementById('f-phone');
            const emailInput = document.getElementById('f-email');
            if (nameInput && !nameInput.value && cData.name) nameInput.value = cData.name;
            if (phoneInput && !phoneInput.value && cData.phone) phoneInput.value = cData.phone;
            if (emailInput && !emailInput.value && (cData.email || user.email)) emailInput.value = cData.email || user.email;
          }
        } catch (e) {
          console.warn('Error loading customer checkout addresses:', e);
        }
      });
    }

    window.toggleAddressMode = function(mode) {
      const selectWrap = document.getElementById('savedSelectWrap');
      const govInput = document.getElementById('f-gov');
      const cityInput = document.getElementById('f-city');
      const addrInput = document.getElementById('f-address');

      if (mode === 'saved') {
        if (selectWrap) selectWrap.style.display = 'block';
        const select = document.getElementById('savedAddressSelect');
        if (select && select.value) {
          window.applySavedAddress(select.value);
        }
      } else {
        if (selectWrap) selectWrap.style.display = 'none';
        if (govInput) govInput.value = '';
        if (cityInput) cityInput.value = '';
        if (addrInput) addrInput.value = '';
        if (typeof handleGovChange === 'function') handleGovChange();
      }
    };

    window.applySavedAddress = function(key) {
      if (!key || !customerSavedAddresses[key]) return;
      const addr = customerSavedAddresses[key];
      const govInput = document.getElementById('f-gov');
      const cityInput = document.getElementById('f-city');
      const addrInput = document.getElementById('f-address');

      if (govInput && addr.governorate) {
        govInput.value = addr.governorate;
      }
      if (cityInput && addr.city) {
        cityInput.value = addr.city;
      }
      if (addrInput && addr.address) {
        addrInput.value = addr.address;
      }
      if (typeof handleGovChange === 'function') handleGovChange();
    };

    initCustomerCheckoutAddresses();

    window.goToStep = function(step) {
      currentStep = step;

      document.querySelectorAll('.checkout-step-panel').forEach(panel => panel.classList.remove('active'));
      document.querySelectorAll('.stepper-step').forEach((s, idx) => {
        s.classList.remove('active', 'completed');
        if (idx + 1 < step) {
          s.classList.add('completed');
        } else if (idx + 1 === step) {
          s.classList.add('active');
        }
      });

      const pct = ((step - 1) / 2) * 100;
      document.getElementById('stepperLineProgress').style.width = pct + '%';
      document.getElementById(`step-panel-${step}`).classList.add('active');
      
      window.scrollTo({ top: 40, behavior: 'smooth' });
    };

    window.validateAndGoToReview = function() {
      const name = document.getElementById('f-name').value.trim();
      const phone = document.getElementById('f-phone').value.trim();
      const email = document.getElementById('f-email').value.trim();
      
      const govSelect = document.getElementById('f-gov');
      const governorate = govSelect.value;
      const govText = governorate ? govSelect.options[govSelect.selectedIndex].text : '';
      
      const city = document.getElementById('f-city').value.trim();
      const address = document.getElementById('f-address').value.trim();

      if (!name || name.length < 5) {
        alert('يرجى إدخال الاسم بالكامل (كلمتين على الأقل) لضمان دقة الشحن.');
        return;
      }
      if (!/^01[0125][0-9]{8}$/.test(phone)) {
        alert('يرجى كتابة رقم هاتف مصري صحيح (11 رقم، يبدأ بـ 010, 011, 012, أو 015)');
        return;
      }
      if (!governorate || !city || !address) {
        alert('يرجى ملء جميع التفاصيل، واختيار المحافظة، والمدينة، وعنوان الشارع بدقة.');
        return;
      }

      const subtotal = calculateCartSubtotal();
      let fee = getShippingFeeForGov(governorate);
      if (subtotal > 2000) fee = 0;
      const orderTotal = subtotal + fee;

      revCustName.textContent = name;
      revCustPhone.textContent = phone;
      revCustEmail.textContent = email || 'لا يوجد';
      revCustLocation.textContent = city + '، محافظة ' + govText;
      revCustAddress.textContent = address;

      revProductsList.innerHTML = '';
      const revContainer = document.createElement('div');
      revContainer.className = 'rev-products-container';

      cart.forEach(item => {
        const qtyVal = parseInt(item.quantity) || 1;
        const unitPrice = typeof getEffectiveUnitPrice === 'function'
          ? getEffectiveUnitPrice(item)
          : (Number(item.price) || 0);
        const sub = unitPrice * qtyVal;
        
        const varInfo = typeof getVariantsDisplayInfo === 'function'
          ? getVariantsDisplayInfo(item)
          : (item.selectedVariant && item.selectedVariant.name ? { count: 1, label: 'الرائحة', text: item.selectedVariant.name } : null);

        const divItem = document.createElement('div');
        divItem.className = 'rev-product-item';

        const variantBadgeHtml = (varInfo && varInfo.text)
          ? `<span class="rev-product-variant"><i class="fas fa-sparkles" style="font-size:0.7rem;"></i> ${varInfo.label}: <strong>${varInfo.text}</strong></span>`
          : '';

        divItem.innerHTML = `
          <div class="rev-product-start">
            <img class="rev-product-img" loading="lazy" src="${item.image}" alt="${item.name}" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=100&q=80';">
            <div class="rev-product-details">
              <h4 class="rev-product-name">${item.name}</h4>
              <div class="rev-product-meta-row">
                ${variantBadgeHtml}
                <span class="rev-product-qty-badge">الكمية: <strong>${qtyVal}</strong> × ${unitPrice.toFixed(0)} ج.م</span>
              </div>
            </div>
          </div>
          <div class="rev-product-subtotal">
            ${sub.toFixed(0)} ج.م
          </div>
        `;
        revContainer.appendChild(divItem);
      });
      revProductsList.appendChild(revContainer);

      summSubtotal.textContent = subtotal.toFixed(0) + " ج.م";
      summShipping.textContent = fee === 0 ? "شحن مجاني" : fee.toFixed(0) + " ج.م";
      finalSummaryTotal.textContent = orderTotal.toFixed(0) + " ج.م";

      goToStep(3);
    };

    window.submitFinalOrder = async function() {
      const finalBtn = document.getElementById('finalPlaceOrderBtn');
      const savingTextLoader = document.getElementById('savingTextLoader');

      finalBtn.disabled = true;
      finalBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تنفيذ طلبك...';
      savingTextLoader.innerHTML = '<span style="color:var(--color-blush); font-weight:700;"><i class="fas fa-cloud-upload-alt"></i> جاري رفع تفاصيل الفاتورة وحجز منتجاتك...</span>';

      const name = document.getElementById('f-name').value.trim();
      const phone = document.getElementById('f-phone').value.trim();
      const email = document.getElementById('f-email').value.trim();
      const governorate = document.getElementById('f-gov').value;
      const city = document.getElementById('f-city').value.trim();
      const address = document.getElementById('f-address').value.trim();

      // تجهيز قائمة المنتجات والكميات والروائح فقط دون إرسال أي أسعار من المتصفح
      const items = cart.map(item => {
        const rawVariants = (Array.isArray(item.selectedVariants) && item.selectedVariants.length > 0)
          ? item.selectedVariants
          : (item.selectedVariant ? [item.selectedVariant] : (item.variantName ? [{ id: item.variantId || 'scent-variant', name: item.variantName }] : []));

        return {
          productId: item.productId || String(item.id).split('::')[0],
          name: item.name,
          image: item.image || '',
          quantity: parseInt(item.quantity) || 1,
          selectedVariants: rawVariants.map(v => ({
            id: v.id || 'scent-variant',
            name: v.name || String(v)
          }))
        };
      });

      // جلب توكن العميل إن كان مسجل دخول لربط الطلب بحسابه بأمان عبر السيرفر
      let idToken = null;
      const currentAuthUser = (typeof firebase !== 'undefined' && firebase.auth) ? firebase.auth().currentUser : null;
      if (currentAuthUser) {
        try {
          idToken = await currentAuthUser.getIdToken();
        } catch(e) {
          console.warn('Could not retrieve idToken:', e);
        }
      }

      // جلب توكن التحقق الأمني من كابتشا Cloudflare Turnstile
      let turnstileToken = '';
      if (typeof turnstile !== 'undefined') {
        try {
          turnstileToken = turnstile.getResponse() || '';
        } catch(e) {}
      }
      if (!turnstileToken) {
        const turnstileInput = document.querySelector('[name="cf-turnstile-response"]');
        if (turnstileInput) turnstileToken = turnstileInput.value;
      }

      if (!turnstileToken) {
        alert('يرجى إكمال اختبار التحقق الأمني (CAPTCHA) قبل تأكيد الطلب.');
        finalBtn.disabled = false;
        finalBtn.innerHTML = '<i class="fas fa-check"></i> تأكيد وإتمام الطلب';
        return;
      }

      try {
        const response = await fetch('/api/create-order', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            customer: {
              name,
              phone,
              email: email || 'N/A',
              governorate,
              city,
              address
            },
            items,
            idToken,
            turnstileToken
          })
        });

        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) {
          if (typeof turnstile !== 'undefined') {
            try { turnstile.reset(); } catch(e) {}
          }
          throw new Error(result.message || 'حدث خطأ أثناء معالجة الطلب.');
        }

        const generatedKey = result.orderId;
        const invoiceCode = result.invoiceCode;

        localStorage.removeItem('cart');

        let recent = JSON.parse(localStorage.getItem('dandy_recent_lookups')) || [];
        recent.unshift({ code: invoiceCode, phone: phone, time: new Date().getTime() });
        localStorage.setItem('dandy_recent_lookups', JSON.stringify(recent));

        window.location.href = `/invoice?id=${encodeURIComponent(generatedKey)}&invoice=${encodeURIComponent(invoiceCode)}`;

      } catch(err) {
        console.error('Order submission error:', err);
        if (typeof turnstile !== 'undefined') {
          try { turnstile.reset(); } catch(e) {}
        }
        alert(err.message || 'حدث خطأ أثناء الاتصال بقاعدة البيانات. يرجى المحاولة مرة أخرى.');
        finalBtn.disabled = false;
        finalBtn.innerHTML = '<i class="fas fa-check"></i> تأكيد وإتمام الطلب';
        savingTextLoader.innerHTML = '<i class="fas fa-exclamation-circle" style="color:var(--color-danger);"></i> حدث خطأ. يرجى المحاولة مرة أخرى.';
      }
    };

    renderStep1CartItems();

    // --- Meta Pixel: InitiateCheckout Event ---
    if (cart && cart.length > 0) {
      const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
      const cartValue = calculateCartSubtotal();
      
      if (typeof fbq === 'function') {
        fbq('track', 'InitiateCheckout', {
          value: cartValue,
          currency: 'EGP',
          num_items: totalItems
        });
      }
    }
  </script>
</BaseLayout>
