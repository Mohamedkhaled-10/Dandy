                      <option value="Assiut">أسيوط</option>
                      <option value="Sohag">سوهاج</option>
                      <option value="Qena">قنا</option>
                      <option value="North Sinai">شمال سيناء</option>
                      <option value="South Sinai">جنوب سيناء</option>
                      <option value="New Valley">الوادي الجديد</option>
                      <option value="Red Sea">البحر الأحمر</option>
                      <option value="Matrouh">مطروح</option>
                    </select>
                  </div>
                  <div class="form-group-checkout">
                    <label for="f-city">المدينة / المنطقة <span style="color:var(--color-blush);">*</span></label>
                    <input type="text" id="f-city" placeholder="مثال: مدينة نصر، الدقي، سموحة" required>
                  </div>
                </div>

                <div class="form-group-checkout">
                  <label for="f-address">العنوان بالتفصيل (اسم الشارع، رقم العقار، الشقة، علامة مميزة) <span style="color:var(--color-blush);">*</span></label>
                  <input type="text" id="f-address" placeholder="اكتب العنوان بالتفصيل لسرعة الوصول..." required>
                </div>
              </form>

              <div class="checkout-nav-row">
                <button class="btn-checkout-secondary" onclick="goToStep(1)">
                  <i class="fas fa-arrow-right"></i>
