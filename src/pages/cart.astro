          </div>
        `;
        cartItemsList.appendChild(itemCard);
      });

      syncAllShippingAndOrderSummaries();
    }

    function revalidateActiveCouponOnCartChange() {
      const codeToCheck = (activeCouponState && activeCouponState.code) || pendingCouponCode;
      if (!codeToCheck || !Array.isArray(cart) || cart.length === 0) {
        couponPreviewSeq += 1;
        isValidatingCoupon = false;
        activeCouponState = null;
        pendingCouponCode = null;
        clearStoredCouponCode();
        renderCouponUiState({ loading: false, feedbackMessage: '' });
        syncAllShippingAndOrderSummaries();
        return;
      }
      // Clear active discount immediately until server confirms new cart totals
      activeCouponState = null;
      syncAllShippingAndOrderSummaries();
      validateCouponWithServer(codeToCheck, { isRevalidation: true });
    }

    window.changeQty = function(index, delta) {
      if (cart[index]) {
        const current = parseInt(cart[index].quantity, 10) || 1;
        cart[index].quantity = Math.max(1, current + delta);
        localStorage.setItem('cart', JSON.stringify(cart));
        renderStep1CartItems();
        handleGovChange();
        if (typeof window.updateSharedCartCount === 'function') window.updateSharedCartCount();
        window.dispatchEvent(new CustomEvent('cart-updated'));
        if ((activeCouponState && activeCouponState.code) || pendingCouponCode) {
          revalidateActiveCouponOnCartChange();
        }
      }
    };

    window.removeItemFromCart = function(index) {
      cart.splice(index, 1);
      localStorage.setItem('cart', JSON.stringify(cart));
      renderStep1CartItems();
      handleGovChange();
      if (typeof window.updateSharedCartCount === 'function') window.updateSharedCartCount();
      window.dispatchEvent(new CustomEvent('cart-updated'));
      if (cart.length === 0) {
        couponPreviewSeq += 1;
        isValidatingCoupon = false;
        activeCouponState = null;
        pendingCouponCode = null;
        clearStoredCouponCode();
      } else if ((activeCouponState && activeCouponState.code) || pendingCouponCode) {
        revalidateActiveCouponOnCartChange();
      }
    };

    // --- تكامل حساب العميل والعناوين المحفوظة في الـ Checkout ---
    let customerSavedAddresses = {};

    function initCustomerCheckoutAddresses() {
      let auth = null;
      try {
        auth = window.auth || (typeof firebase !== 'undefined' && typeof firebase.auth === 'function' ? firebase.auth() : null);
      } catch (authInitErr) {
        console.warn('Firebase auth unavailable in cart checkout:', authInitErr?.code || authInitErr?.message || authInitErr);
        return;
      }
      if (!auth) return;

      auth.onAuthStateChanged(async (user) => {
        const sec = document.getElementById('savedAddressesSection');
        if (!user) {
          if (sec) sec.style.display = 'none';
          return;
        }

        try {
          const snap = await db.ref('customers/' + user.uid + '/addresses').once('value');
          if (snap.exists()) {
            customerSavedAddresses = snap.val() || {};
            const keys = Object.keys(customerSavedAddresses);
            if (keys.length > 0) {
              const select = document.getElementById('savedAddressSelect');
              if (sec) sec.style.display = 'block';

              if (select) {
                select.innerHTML = '<option value="">-- اختاري عنواناً محفوظاً --</option>';
                let defaultKey = null;

                const govSelect = document.getElementById('f-gov');
                keys.forEach(k => {
                  const addr = customerSavedAddresses[k];
                  let govArabic = addr.governorate || '';
                  if (govSelect) {
                    const opt = Array.from(govSelect.options).find(o => o.value === addr.governorate);
                    if (opt) govArabic = opt.text;
                  }

                  const opt = document.createElement('option');
                  opt.value = k;
                  opt.textContent = `${addr.label || 'عنوان'} (${govArabic} - ${addr.city || ''}) ${addr.isDefault ? '★ (افتراضي)' : ''}`;
                  select.appendChild(opt);
                  if (addr.isDefault) defaultKey = k;
                });

                // تطبيق العنوان الافتراضي تلقائياً إن وجد
                const targetKey = defaultKey || keys[0];
                select.value = targetKey;
                window.applySavedAddress(targetKey);
              }
            } else {
              if (sec) sec.style.display = 'none';
            }
          } else {
            if (sec) sec.style.display = 'none';
          }

          // ملء الاسم ورقم الهاتف والبريد من بروفايل العميل إن كانا فارغين
          const custSnap = await db.ref('customers/' + user.uid).once('value');
          if (custSnap.exists()) {
            const cData = custSnap.val();
            const nameInput = document.getElementById('f-name');
            const phoneInput = document.getElementById('f-phone');
            const emailInput = document.getElementById('f-email');
            if (nameInput && !nameInput.value && cData.name) nameInput.value = cData.name;
            if (phoneInput && !phoneInput.value && cData.phone) phoneInput.value = cData.phone;
            if (emailInput && !emailInput.value && (cData.email || user.email)) emailInput.value = cData.email || user.email;
          }
        } catch (e) {
          console.warn('Error loading customer checkout addresses:', e);
        }
      });
    }

    window.toggleAddressMode = function(mode) {
      const selectWrap = document.getElementById('savedSelectWrap');
      const govInput = document.getElementById('f-gov');
      const cityInput = document.getElementById('f-city');
      const addrInput = document.getElementById('f-address');

      if (mode === 'saved') {
        if (selectWrap) selectWrap.style.display = 'block';
        const select = document.getElementById('savedAddressSelect');
        if (select && select.value) {
          window.applySavedAddress(select.value);
        }
      } else {
        if (selectWrap) selectWrap.style.display = 'none';
        if (govInput) govInput.value = '';
        if (cityInput) cityInput.value = '';
        if (addrInput) addrInput.value = '';
        if (typeof handleGovChange === 'function') handleGovChange();
      }
    };

    window.applySavedAddress = function(key) {
      if (!key || !customerSavedAddresses[key]) return;
      const addr = customerSavedAddresses[key];
      const govInput = document.getElementById('f-gov');
      const cityInput = document.getElementById('f-city');
      const addrInput = document.getElementById('f-address');

      if (govInput && addr.governorate) {
        govInput.value = addr.governorate;
      }
      if (cityInput && addr.city) {
        cityInput.value = addr.city;
      }
      if (addrInput && addr.address) {
        addrInput.value = addr.address;
      }
      if (typeof handleGovChange === 'function') handleGovChange();
    };

    initCustomerCheckoutAddresses();

    var hasFiredInitiateCheckout = false;

    window.goToStep = function(step) {
      currentStep = step;

      // Meta Pixel InitiateCheckout Event: Fire ONLY when the user actually starts the checkout process (Step 2: Shipping Details)
      if (step === 2 && !hasFiredInitiateCheckout && cart && cart.length > 0) {
        hasFiredInitiateCheckout = true;
        var cartVal = calculateCartSubtotal();
        if (window.DandyMeta && typeof window.DandyMeta.trackInitiateCheckout === 'function') {
          window.DandyMeta.trackInitiateCheckout(cart, cartVal);
        } else if (typeof fbq === 'function') {
          fbq('track', 'InitiateCheckout', {
            value: cartVal,
            currency: 'EGP',
            num_items: cart.reduce(function(sum, item) { return sum + (item.quantity ? parseInt(item.quantity) : 1); }, 0)
          });
        }
      }

      document.querySelectorAll('.checkout-step-panel').forEach(panel => panel.classList.remove('active'));
      document.querySelectorAll('.stepper-step').forEach((s, idx) => {
        s.classList.remove('active', 'completed');
        if (idx + 1 < step) {
          s.classList.add('completed');
        } else if (idx + 1 === step) {
          s.classList.add('active');
        }
      });

      const pct = ((step - 1) / 2) * 100;
      document.getElementById('stepperLineProgress').style.width = pct + '%';
      document.getElementById(`step-panel-${step}`).classList.add('active');
      syncAllShippingAndOrderSummaries();
      
      window.scrollTo({ top: 40, behavior: 'smooth' });
    };

    window.validateAndGoToReview = function() {
      const name = document.getElementById('f-name').value.trim();
      const phone = document.getElementById('f-phone').value.trim();
      const email = document.getElementById('f-email').value.trim();
      
      const govSelect = document.getElementById('f-gov');
      const governorate = govSelect.value;
      const govText = governorate ? govSelect.options[govSelect.selectedIndex].text : '';
      
      const city = document.getElementById('f-city').value.trim();
      const address = document.getElementById('f-address').value.trim();

      if (!name || name.length < 5) {
        alert('يرجى إدخال الاسم بالكامل (كلمتين على الأقل) لضمان دقة الشحن.');
        return;
      }
      if (!/^01[0125][0-9]{8}$/.test(phone)) {
        alert('يرجى كتابة رقم هاتف مصري صحيح (11 رقم، يبدأ بـ 010, 011, 012, أو 015)');
        return;
      }
      if (!governorate || !city || !address) {
        alert('يرجى ملء جميع التفاصيل، واختيار المحافظة، والمدينة، وعنوان الشارع بدقة.');
        return;
      }

      revCustName.textContent = name;
      revCustPhone.textContent = phone;
      revCustEmail.textContent = email || 'لا يوجد';
      revCustLocation.textContent = city + '، محافظة ' + govText;
      revCustAddress.textContent = address;

      revProductsList.innerHTML = '';
      const revContainer = document.createElement('div');
      revContainer.className = 'rev-products-container';

      cart.forEach(item => {
        const qtyVal = parseInt(item.quantity, 10) || 1;
        const unitPrice = typeof getEffectiveUnitPrice === 'function'
          ? getEffectiveUnitPrice(item)
          : (Number(item.price) || 0);
        const sub = unitPrice * qtyVal;
        
        const varInfo = typeof getVariantsDisplayInfo === 'function'
          ? getVariantsDisplayInfo(item)
          : (item.selectedVariant && item.selectedVariant.name ? { count: 1, label: 'الرائحة', text: item.selectedVariant.name } : null);

        const divItem = document.createElement('div');
        divItem.className = 'rev-product-item';

        const variantBadgeHtml = (varInfo && varInfo.text)
          ? `<span class="rev-product-variant"><i class="fas fa-sparkles" style="font-size:0.7rem;"></i> ${escapeCartHtml(varInfo.label)}: <strong>${escapeCartHtml(varInfo.text)}</strong></span>`
          : '';

        let revCollectionHtml = '';
        if (item.isCollection && Array.isArray(item.selectedItems) && item.selectedItems.length > 0) {
          revCollectionHtml = `
            <div style="margin-top:4px; font-size:0.73rem; color:#be185d; line-height:1.4;">
              <span style="font-weight:700;">محتويات الكوليكشن:</span>
              ${item.selectedItems.map(si => {
                const sName = si.selectedVariant && (si.selectedVariant.name || si.selectedVariant.id) ? (si.selectedVariant.name || si.selectedVariant.id) : '';
                return `• ${escapeCartHtml(si.productName || 'منتج')}${sName ? ` (${escapeCartHtml(sName)})` : ''}`;
              }).join(' | ')}
            </div>
          `;
        }

        divItem.innerHTML = `
          <div class="rev-product-start">
            <img class="rev-product-img" loading="lazy" src="${escapeCartHtml(item.image || '')}" alt="${escapeCartHtml(item.name || '')}" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=100&q=80';">
            <div class="rev-product-details">
              <h4 class="rev-product-name">${escapeCartHtml(item.name || '')}</h4>
              <div class="rev-product-meta-row">
                ${variantBadgeHtml}
                <span class="rev-product-qty-badge">الكمية: <strong>${qtyVal}</strong> × ${formatCartEgp(unitPrice)} ج.م</span>
              </div>
              ${revCollectionHtml}
            </div>
          </div>
          <div class="rev-product-subtotal">
            ${formatCartEgp(sub)} ج.م
          </div>
        `;
        revContainer.appendChild(divItem);
      });
      revProductsList.appendChild(revContainer);

      syncAllShippingAndOrderSummaries();
      goToStep(3);
    };

    function showCheckoutBanner(message, tone, options) {
      const banner = document.getElementById('checkoutStatusBanner');
      const textEl = document.getElementById('checkoutStatusBannerText');
      const actionsEl = document.getElementById('checkoutStatusBannerActions');
      const resetBtn = document.getElementById('btnResetOrderAttempt');
      if (!banner || !textEl) return;

      const isWarning = tone === 'warning';
      banner.style.background = isWarning ? '#fffbeb' : '#fff1f2';
      banner.style.borderColor = isWarning ? '#fde68a' : '#fecdd3';
      banner.style.color = isWarning ? '#92400e' : '#9f1239';
      textEl.textContent = message || 'حدث خطأ أثناء تنفيذ الطلب.';

      const showNewAttemptBtn = Boolean(options && options.showNewAttemptAction);
      if (actionsEl) {
        actionsEl.style.display = showNewAttemptBtn ? 'flex' : 'none';
      }
      if (resetBtn) {
        resetBtn.style.display = showNewAttemptBtn ? 'inline-flex' : 'none';
      }
      banner.style.display = 'block';
    }

    function hideCheckoutBanner() {
      const banner = document.getElementById('checkoutStatusBanner');
      const actionsEl = document.getElementById('checkoutStatusBannerActions');
      if (banner) banner.style.display = 'none';
      if (actionsEl) actionsEl.style.display = 'none';
    }

    function resetTurnstileWidgetSafely() {
      if (typeof turnstile !== 'undefined' && typeof turnstile.reset === 'function') {
        try {
          turnstile.reset();
        } catch (_) {}
      }
    }

    document.getElementById('btnResetOrderAttempt')?.addEventListener('click', function () {
      if (window.DandyOrderFlow) {
        window.DandyOrderFlow.clearCheckoutAttemptState(window.sessionStorage);
      }
      resetTurnstileWidgetSafely();
      showCheckoutBanner(
        'تم تجهيز محاولة طلب جديدة. يرجى إكمال التحقق الأمني (CAPTCHA) ثم الضغط على «تأكيد وإتمام الطلب».',
        'warning',
        { showNewAttemptAction: false }
      );
      const savingTextLoader = document.getElementById('savingTextLoader');
      if (savingTextLoader) {
        savingTextLoader.innerHTML = '<i class="fas fa-lock" style="color:#059669; margin-left:4px;"></i> تأكيد الطلب يسجله بأمان ويوفر لك كود تتبع فوري.';
      }
    });

    window.submitFinalOrder = async function() {
      const finalBtn = document.getElementById('finalPlaceOrderBtn');
      const savingTextLoader = document.getElementById('savingTextLoader');
      const restoreSubmitBtn = () => {
        if (finalBtn) {
          finalBtn.disabled = false;
          finalBtn.innerHTML = '<i class="fas fa-check"></i> تأكيد وإتمام الطلب';
        }
      };

      hideCheckoutBanner();
      finalBtn.disabled = true;
      finalBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تنفيذ طلبك...';
      savingTextLoader.innerHTML = '<span style="color:var(--color-blush); font-weight:700;"><i class="fas fa-cloud-upload-alt"></i> جاري رفع تفاصيل الفاتورة وحجز منتجاتك...</span>';

      const name = document.getElementById('f-name').value.trim();
      const phone = document.getElementById('f-phone').value.trim();
      const email = document.getElementById('f-email').value.trim();
      const governorate = document.getElementById('f-gov').value;
      const city = document.getElementById('f-city').value.trim();
      const address = document.getElementById('f-address').value.trim();

      // تجهيز قائمة المنتجات والكميات والروائح فقط دون إرسال أي أسعار من المتصفح
      const items = cart.map(item => {
        if (item.type === 'collection' || item.isCollection || item.collectionId) {
          return {
            type: 'collection',
            isCollection: true,
            isPinkFriday: true,
            collectionId: item.collectionId || item.id,
            name: item.name,
            image: item.image || '',
            quantity: parseInt(item.quantity) || 1,
            selectedItems: Array.isArray(item.selectedItems) ? item.selectedItems : []
          };
        }

        const rawVariants = (Array.isArray(item.selectedVariants) && item.selectedVariants.length > 0)
          ? item.selectedVariants
          : (item.selectedVariant ? [item.selectedVariant] : (item.variantName ? [{ id: item.variantId || 'scent-variant', name: item.variantName }] : []));

        return {
          productId: item.productId || String(item.id).split('::')[0],
          name: item.name,
          image: item.image || '',
          quantity: parseInt(item.quantity) || 1,
          selectedVariants: rawVariants.map(v => ({
            id: v.id || 'scent-variant',
            name: v.name || String(v)
          }))
        };
      });

      // جلب توكن العميل إن كان مسجل دخول لربط الطلب بحسابه بأمان عبر السيرفر
      let idToken = null;
      const currentAuthUser = (typeof firebase !== 'undefined' && firebase.auth) ? firebase.auth().currentUser : null;
      if (currentAuthUser) {
        try {
          idToken = await currentAuthUser.getIdToken();
        } catch(e) {
          console.warn('Could not retrieve idToken:', e);
        }
      }

      // جلب توكن التحقق الأمني من كابتشا Cloudflare Turnstile (مرة واحدة لكل محاولة إرسال فعلية)
      let turnstileToken = '';
      if (typeof turnstile !== 'undefined') {
        try {
          turnstileToken = turnstile.getResponse() || '';
        } catch(e) {}
      }
      if (!turnstileToken) {
        const turnstileInput = document.querySelector('[name="cf-turnstile-response"]');
        if (turnstileInput) turnstileToken = turnstileInput.value;
      }

      if (!turnstileToken) {
        showCheckoutBanner('يرجى إكمال اختبار التحقق الأمني (CAPTCHA) قبل تأكيد الطلب.', 'warning');
        restoreSubmitBtn();
        savingTextLoader.innerHTML = '<i class="fas fa-shield-alt" style="color:var(--color-blush);"></i> يرجى إكمال التحقق الأمني أولاً.';
        return;
      }

      const flow = window.DandyOrderFlow;
      if (!flow || typeof flow.prepareCheckoutIdempotency !== 'function' || typeof flow.isValidUuidV4 !== 'function') {
        showCheckoutBanner(
          'تعذر تحميل وحدة حماية الطلب من التكرار. تم الحفاظ على سلتكِ بأمان؛ يرجى إعادة تحميل الصفحة والمحاولة مرة أخرى.',
          'error',
          { showNewAttemptAction: false }
        );
        restoreSubmitBtn();
        savingTextLoader.innerHTML =
          '<i class="fas fa-exclamation-circle" style="color:var(--color-danger);"></i> تعذر التحقق من حماية الطلب؛ سلتكِ محفوظة كما هي.';
        return;
      }

      if (isValidatingCoupon) {
        showCheckoutBanner('جاري التحقق من كود الخصم؛ يرجى الانتظار لحظة ثم المحاولة مرة أخرى.', 'warning');
        restoreSubmitBtn();
        savingTextLoader.innerHTML = '<i class="fas fa-clock" style="color:var(--color-blush);"></i> يرجى الانتظار حتى يكتمل التحقق من الكوبون.';
        return;
      }

      const appliedCouponCode = activeCouponState && activeCouponState.code
        ? normalizeClientCouponCode(activeCouponState.code)
        : null;

      const customerUid = currentAuthUser && currentAuthUser.uid ? currentAuthUser.uid : null;
      let idempotencyPrep = null;
      try {
        idempotencyPrep = await flow.prepareCheckoutIdempotency({
          orderInput: {
            name,
            phone,
            email: email || 'N/A',
            governorate,
            city,
            address,
            customerId: customerUid,
            couponCode: appliedCouponCode,
            items
          },
          sessionStorage: window.sessionStorage
        });
      } catch (_) {
        idempotencyPrep = { ok: false, clientRequestId: null };
      }

      if (!idempotencyPrep || !idempotencyPrep.ok || !flow.isValidUuidV4(idempotencyPrep.clientRequestId)) {
        showCheckoutBanner(
          (idempotencyPrep && idempotencyPrep.message) ||
            'تعذر حفظ معرّف تأكيد الطلب في تخزين الجلسة بالمتصفح. تم الحفاظ على سلتكِ بأمان ولم يتم إرسال الطلب؛ يرجى السماح بتخزين الجلسة ثم المحاولة مرة أخرى.',
          'error',
          { showNewAttemptAction: false }
        );
        restoreSubmitBtn();
        savingTextLoader.innerHTML =
          '<i class="fas fa-exclamation-circle" style="color:var(--color-danger);"></i> لم يتم إرسال الطلب حفاظاً على عدم التكرار؛ سلتكِ محفوظة كما هي.';
        return;
      }

      const clientRequestId = idempotencyPrep.clientRequestId;

      let response = null;
      let result = {};
      let networkError = false;

      try {
        const orderRequestBody = {
          customer: {
            name,
            phone,
            email: email || 'N/A',
            governorate,
            city,
            address
          },
          items,
          idToken,
          turnstileToken,
          clientRequestId
        };
        if (appliedCouponCode) {
          orderRequestBody.couponCode = appliedCouponCode;
        }

        response = await fetch('/api/create-order', {
          method: 'POST',
          cache: 'no-store',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(orderRequestBody)
        });

        result = await response.json().catch(() => ({}));
      } catch (fetchErr) {
        networkError = true;
      }

      const outcome = flow
        ? flow.classifyCreateOrderOutcome({
            ok: Boolean(response && response.ok),
            status: response ? response.status : 0,
            result,
            networkError
          })
        : {
            action: (response && response.ok && result && result.success && result.invoiceAccessToken) ? 'SUCCESS_REDIRECT' : 'ERROR_KEEP_STATE',
            clearCart: Boolean(response && response.ok && result && result.success && result.invoiceAccessToken),
            clearAttempt: Boolean(response && response.ok && result && result.success && result.invoiceAccessToken),
            resetTurnstile: !(response && response.ok && result && result.success && result.invoiceAccessToken),
            redirectUrl: result && result.invoiceAccessToken ? '/invoice#access=' + encodeURIComponent(result.invoiceAccessToken) : '',
            invoiceCode: result && result.invoiceCode ? result.invoiceCode : '',
            message: (result && result.message) || 'حدث خطأ أثناء معالجة الطلب.'
          };

      if (outcome.action === 'SUCCESS_REDIRECT') {
        if (flow) {
          flow.clearCheckoutAttemptState(window.sessionStorage);
          if (outcome.invoiceCode) {
            flow.saveRecentLookupCode(window.localStorage, outcome.invoiceCode);
          }
        }
        clearStoredCouponCode();
        activeCouponState = null;
        pendingCouponCode = null;
        localStorage.removeItem('cart');
        window.location.href = outcome.redirectUrl;
        return;
      }

      // If final submission rejected coupon, clear applied coupon state so stale discount is never shown
      const serverErrCode = result && typeof result.error === 'string' ? result.error : '';
      if (
        appliedCouponCode &&
        (serverErrCode.startsWith('COUPON_') ||
          serverErrCode === 'PINK_FRIDAY_NOT_COMBINABLE' ||
          serverErrCode === 'NO_ELIGIBLE_CATEGORY_ITEMS' ||
          serverErrCode === 'EMPTY_ELIGIBLE_SUBTOTAL' ||
          serverErrCode === 'MINIMUM_SUBTOTAL_NOT_MET' ||
          serverErrCode === 'INVALID_COUPON_TOTAL')
      ) {
        activeCouponState = null;
        pendingCouponCode = null;
        clearStoredCouponCode();
        renderCouponUiState({
          loading: false,
          preserveInput: true,
          feedbackType: 'error',
          feedbackMessage: outcome.message
        });
        syncAllShippingAndOrderSummaries();
      }

      // Any non-redirect outcome: NEVER clear cart, NEVER auto-retry silently, reset one-time Turnstile token
      if (outcome.resetTurnstile) {
        resetTurnstileWidgetSafely();
      }

      const showNewAttemptAction = Boolean(outcome.requireNewAttempt);
      const tone =
        outcome.action === 'ORDER_IN_PROGRESS' ||
        outcome.action === 'RATE_LIMITED_KEEP_ID' ||
        outcome.action === 'CAPTCHA_FAILED_KEEP_ID'
          ? 'warning'
          : 'error';

      showCheckoutBanner(outcome.message, tone, { showNewAttemptAction });
      restoreSubmitBtn();
      savingTextLoader.innerHTML =
        '<i class="fas fa-exclamation-circle" style="color:var(--color-danger);"></i> لم يتم استلام تأكيد نهائي للطلب بعد؛ سلتكِ محفوظة كما هي.';
    };

    renderStep1CartItems();
    if (cart.length === 0) {
      clearStoredCouponCode();
      pendingCouponCode = null;
      activeCouponState = null;
    } else if (pendingCouponCode) {
      validateCouponWithServer(pendingCouponCode, { isRevalidation: true });
    }
  </script>
</BaseLayout>
