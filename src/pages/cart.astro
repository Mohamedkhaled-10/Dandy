                      <a href="/track-order" style="display:inline-flex; align-items:center; gap:6px; padding:7px 14px; border-radius:99px; border:1px solid var(--border-light); background:#fff; color:var(--color-primary); font-weight:700; font-size:0.82rem; text-decoration:none;">
                        <i class="fas fa-truck"></i> الانتقال لتتبع الطلب
                      </a>
                    </div>
                  </div>
                </div>
              </div>

              <div class="checkout-nav-row">
                <button class="btn-checkout-secondary" onclick="goToStep(2)">
                  <i class="fas fa-arrow-right"></i>
                  <span>تعديل العنوان</span>
                </button>
                <button class="btn-checkout-primary" style="background:#059669; box-shadow: 0 4px 14px rgba(5, 150, 105, 0.25);" id="finalPlaceOrderBtn" onclick="submitFinalOrder()">
                  <i class="fas fa-check"></i>
                  <span>تأكيد وإتمام الطلب</span>
                </button>
              </div>
            </div>

            <div class="panel-side-summary">
              <h3 style="font-size:1.05rem; font-weight:800; margin-bottom:14px; color:var(--color-primary); text-align: right;" dir="rtl">
                <i class="fas fa-money-bill-wave" style="color:#059669; margin-left:6px;"></i> طريقة الدفع
              </h3>
              
              <div style="background:rgba(5, 150, 105, 0.06); color:#065f46; padding:14px; border-radius:8px; font-weight:700; font-size:0.88rem; line-height:1.6; margin-bottom:18px; border:1px solid rgba(5, 150, 105, 0.15);">
                <i class="fas fa-hand-holding-usd"></i> الدفع عند الاستلام (COD)
                <p style="font-weight:normal; font-size:0.8rem; color:var(--color-text); margin-top:4px; margin-bottom:0;">يمكنكِ فحص وتأكيد المنتجات عند استلام الشحنة قبل الدفع.</p>
              </div>

              <div style="margin-bottom:12px; line-height:1.6;">
                <div class="summary-row">
                  <span class="summary-row-label">المجموع الفرعي للمنتجات:</span>
                  <span id="summSubtotal" class="summary-row-value">0 ج.م</span>
                </div>
                <div class="summary-row" id="couponSummaryRow3" style="display:none;">
                  <span class="summary-row-label">خصم الكوبون (<span id="couponCodeSummary3" dir="ltr"></span>):</span>
                  <span id="summCouponDiscount" class="summary-row-value" dir="ltr" style="color:#059669; font-weight:800;">0 ج.م</span>
                </div>
                <div class="summary-row">
                  <span class="summary-row-label">حالة الشحن المجاني:</span>
                  <span id="freeShippingStatusSummary3" class="summary-row-value" style="font-size:0.82rem;"></span>
                </div>
                <div class="summary-row">
                  <span class="summary-row-label">مصاريف الشحن:</span>
                  <span id="summShipping" class="summary-row-value" style="color:#059669;">0 ج.م</span>
                </div>
                <div class="summary-total-row" style="margin-bottom:0;">
                  <span style="color:var(--color-primary); font-size:0.95rem; font-weight:800;">الإجمالي النهائي المستحق:</span>
                  <strong style="font-size: 1.35rem; color:var(--color-blush); text-align:left;" id="finalSummaryTotal">0 ج.م</strong>
                </div>
              </div>
              
              <p style="font-size:0.78rem; color:var(--color-muted); margin-top:10px; margin-bottom:0;" id="savingTextLoader">
                <i class="fas fa-lock" style="color:#059669; margin-left:4px;"></i> تأكيد الطلب يسجله بأمان ويوفر لك كود تتبع فوري.
              </p>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <script type="application/json" id="dandy-store-shipping-policy" set:html={serializedStoreShippingPolicy}></script>

  <script is:inline>
    const db = firebase.database();

    function escapeCartHtml(str) {
      if (str === undefined || str === null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    let cart = typeof safeParseCart === 'function'
      ? safeParseCart(localStorage.getItem('cart'))
      : (() => {
          try {
            const parsed = JSON.parse(localStorage.getItem('cart') || '[]');
            return Array.isArray(parsed) ? parsed.filter(i => i && typeof i === 'object') : [];
          } catch (_) {
            return [];
          }
        })();
    let currentStep = 1;

    // Reconcile cart items with current Pink Friday campaign state
    function reconcileCartWithCampaign() {
      let modified = false;
      cart.forEach(item => {
        // Preserve and handle Collection Bundles safely
        if (item.type === 'collection' || item.isCollection || item.collectionId) {
          if (window.DandyPinkFriday && typeof window.DandyPinkFriday.isActive === 'function') {
            if (!window.DandyPinkFriday.isActive()) {
              item.isPinkFriday = false;
              if (item.regularPrice) item.price = item.regularPrice;
              modified = true;
            } else {
              item.isPinkFriday = true;
              if (!item.badgeText) item.badgeText = 'كوليكشن Pink Friday';
            }
          }
          return;
        }

        const rawId = item.productId || (item.id ? String(item.id).split('::')[0] : '');
        if (window.DandyPinkFriday && typeof window.DandyPinkFriday.getPricing === 'function') {
          const pf = window.DandyPinkFriday.getPricing({ id: rawId, price: item.regularPrice || item.price });
          if (pf.isEligible) {
            if (!item.isPinkFriday || item.price !== pf.campaignPrice) {
              item.isPinkFriday = true;
              item.campaignPrice = pf.campaignPrice;
              item.regularPrice = pf.regularPrice;
              item.price = pf.campaignPrice;
              item.badgeText = pf.badgeText;
              modified = true;
            }
          } else if (item.isPinkFriday) {
            item.isPinkFriday = false;
            if (item.regularPrice) {
              item.price = item.regularPrice;
            }
            delete item.campaignPrice;
            delete item.regularPrice;
            delete item.badgeText;
            modified = true;
          }
        }
      });
      if (modified) {
        localStorage.setItem('cart', JSON.stringify(cart));
      }
    }
    reconcileCartWithCampaign();

    // Centralized shipping policy injected from src/config/store-policy.ts (public policy fields only)
    const STORE_SHIPPING_POLICY = (() => {
      try {
        const policyEl = document.getElementById('dandy-store-shipping-policy');
        const parsed = policyEl && policyEl.textContent ? JSON.parse(policyEl.textContent) : null;
        if (parsed && typeof parsed === 'object') {
          return parsed;
        }
      } catch (_) {}
      return {
        ratesByGovernorate: {},
        defaultFeeEgp: 120,
        freeShippingThresholdEgp: 2000
      };
    })();

    function getShippingFeeForGov(govName) {
      const defaultFee = Number(STORE_SHIPPING_POLICY.defaultFeeEgp);
      if (!govName || typeof govName !== 'string') return defaultFee;
      const key = govName.trim();
      if (!key) return defaultFee;
      const rates = STORE_SHIPPING_POLICY.ratesByGovernorate || {};
      return Object.prototype.hasOwnProperty.call(rates, key) ? rates[key] : defaultFee;
    }

    function isFreeShippingEligible(subtotal) {
      const threshold = Number(STORE_SHIPPING_POLICY.freeShippingThresholdEgp);
      return typeof subtotal === 'number' && Number.isFinite(subtotal) && subtotal > threshold;
    }

    function calculateShippingFeeForGov(govName, subtotal) {
      if (isFreeShippingEligible(subtotal)) return 0;
      return getShippingFeeForGov(govName);
    }

    // Render elements references
    const cartItemsList = document.getElementById('cartItemsList');
    const subtotalValSummary = document.getElementById('subtotalValSummary');
    const subtotalValSummary2 = document.getElementById('subtotalValSummary2');
    const grandTotalSummaryValue1 = document.getElementById('grandTotalSummaryValue1');
    const grandTotalSummaryValue2 = document.getElementById('grandTotalSummaryValue2');
    const finalSummaryTotal = document.getElementById('finalSummaryTotal');

    const shippingCostSummary2 = document.getElementById('shippingCostSummary2');

    // Final review text references
    const revCustName = document.getElementById('revCustName');
    const revCustPhone = document.getElementById('revCustPhone');
    const revCustEmail = document.getElementById('revCustEmail');
    const revCustLocation = document.getElementById('revCustLocation');
    const revCustAddress = document.getElementById('revCustAddress');
    const revProductsList = document.getElementById('revProductsList');

    const summSubtotal = document.getElementById('summSubtotal');
    const summShipping = document.getElementById('summShipping');

    function formatCartEgp(value) {
      if (window.DandyCartShipping && typeof window.DandyCartShipping.formatCurrencyAmount === 'function') {
        return window.DandyCartShipping.formatCurrencyAmount(value);
      }
      const n = Number(value);
      if (!Number.isFinite(n) || n <= 0) return '0';
      const rounded = Math.round(n * 100) / 100;
      return Math.abs(rounded - Math.round(rounded)) < 1e-9 ? String(Math.round(rounded)) : String(rounded);
    }

    function calculateCartSubtotal() {
      if (window.DandyCartShipping && typeof window.DandyCartShipping.computeCartSubtotal === 'function') {
        return window.DandyCartShipping.computeCartSubtotal(
          cart,
          typeof getEffectiveUnitPrice === 'function' ? getEffectiveUnitPrice : null
        );
      }
      let subtotal = 0;
      cart.forEach(item => {
        const unitPrice = typeof getEffectiveUnitPrice === 'function'
          ? getEffectiveUnitPrice(item)
          : (Number(item.price) || 0);
        const qtyVal = parseInt(item.quantity, 10) || 1;
        subtotal += unitPrice * qtyVal;
      });
      return Math.round(subtotal * 100) / 100;
    }

    function getSelectedGovernorateInfo() {
      const govDropdown = document.getElementById('f-gov');
      if (!govDropdown || !govDropdown.value) {
        return { value: '', label: '' };
      }
      const selectedIdx = govDropdown.selectedIndex;
      const optText = selectedIdx >= 0 && govDropdown.options[selectedIdx]
        ? govDropdown.options[selectedIdx].text
        : govDropdown.value;
      return {
        value: govDropdown.value,
        label: optText || govDropdown.value
      };
    }

    function renderFreeShippingProgressCard(progress) {
      const card = document.getElementById('freeShippingProgressCard');
      if (!card || !progress) return;

      card.setAttribute('data-state', progress.state);

      const iconEl = document.getElementById('freeShippingIcon');
      if (iconEl) {
        if (progress.state === 'unlocked') {
          iconEl.className = 'fas fa-check-circle';
        } else if (progress.state === 'at_threshold') {
          iconEl.className = 'fas fa-exclamation-circle';
        } else {
          iconEl.className = 'fas fa-truck';
        }
      }

      const titleEl = document.getElementById('freeShippingTitle');
      const msgEl = document.getElementById('freeShippingMessage');
      const badgeEl = document.getElementById('freeShippingBadge');
      const barEl = document.getElementById('freeShippingProgressBar');
      const fillEl = document.getElementById('freeShippingProgressFill');

      if (titleEl) titleEl.textContent = progress.titleText;
      if (msgEl) msgEl.textContent = progress.messageText;
      if (badgeEl) badgeEl.textContent = progress.badgeText;
      if (fillEl) fillEl.style.width = progress.progressPercent + '%';
      if (barEl) {
        barEl.setAttribute('aria-valuemax', String(progress.threshold));
        barEl.setAttribute('aria-valuenow', String(Math.min(progress.subtotal, progress.threshold)));
        barEl.setAttribute('aria-valuetext', progress.ariaValueText);
      }
    }

    function applyFreeShippingStatusEl(el, progress) {
      if (!el || !progress) return;
      el.textContent = progress.statusChipText;
      if (progress.state === 'unlocked') {
        el.style.color = 'var(--color-success)';
      } else if (progress.state === 'at_threshold') {
        el.style.color = 'var(--color-warning)';
      } else {
        el.style.color = 'var(--color-blush)';
      }
    }

    // Coupon Checkout State & Persistence (Stores normalized code only — never definitions or trusted discounts)
    const COUPON_STORAGE_KEY = 'dandy_checkout_coupon_v1';
    let couponPreviewSeq = 0;
    let isValidatingCoupon = false;
    let activeCouponState = null;

    function normalizeClientCouponCode(raw) {
      if (typeof raw !== 'string') return '';
      return raw.trim().toUpperCase();
    }

    function readStoredCouponCode() {
      try {
        if (typeof localStorage === 'undefined' || !localStorage || typeof localStorage.getItem !== 'function') {
          return null;
        }
        const raw = localStorage.getItem(COUPON_STORAGE_KEY);
        const normalized = normalizeClientCouponCode(raw);
        return normalized || null;
      } catch (_) {
        return null;
      }
    }

    function writeStoredCouponCode(code) {
      const normalized = normalizeClientCouponCode(code);
      if (!normalized) return;
      try {
        if (typeof localStorage !== 'undefined' && localStorage && typeof localStorage.setItem === 'function') {
          localStorage.setItem(COUPON_STORAGE_KEY, normalized);
        }
      } catch (_) {}
    }

    function clearStoredCouponCode() {
      try {
        if (typeof localStorage !== 'undefined' && localStorage && typeof localStorage.removeItem === 'function') {
          localStorage.removeItem(COUPON_STORAGE_KEY);
        }
      } catch (_) {}
    }

    let pendingCouponCode = readStoredCouponCode();

    function buildMinimalCouponPreviewItems() {
      return cart.map(item => {
        if (item.type === 'collection' || item.isCollection || item.collectionId) {
          return {
            type: 'collection',
            isCollection: true,
            collectionId: item.collectionId || item.id,
            quantity: parseInt(item.quantity, 10) || 1,
            selectedItems: Array.isArray(item.selectedItems) ? item.selectedItems : []
          };
        }

        const rawVariants = (Array.isArray(item.selectedVariants) && item.selectedVariants.length > 0)
          ? item.selectedVariants
          : (item.selectedVariant ? [item.selectedVariant] : (item.variantName ? [{ id: item.variantId || 'scent-variant', name: item.variantName }] : []));

        return {
          productId: item.productId || String(item.id).split('::')[0],
          quantity: parseInt(item.quantity, 10) || 1,
          selectedVariants: rawVariants.map(v => ({
            id: v.id || 'scent-variant',
            name: v.name || String(v)
          }))
        };
      });
    }

    function renderCouponFeedback(type, message) {
      const feedbackEl = document.getElementById('couponFeedback');
      if (!feedbackEl) return;
      if (!message) {
        feedbackEl.style.display = 'none';
        feedbackEl.textContent = '';
        feedbackEl.className = 'coupon-feedback';
        return;
      }
      feedbackEl.textContent = message;
      feedbackEl.className = 'coupon-feedback ' + (type === 'success' ? 'is-success' : (type === 'info' ? 'is-info' : 'is-error'));
      feedbackEl.style.display = 'block';
    }

    function renderCouponUiState(options) {
      const opts = options || {};
      const inputEl = document.getElementById('couponCodeInput');
      const applyBtn = document.getElementById('applyCouponBtn');
      const appliedBadge = document.getElementById('appliedCouponBadge');
      const appliedCodeLabel = document.getElementById('appliedCouponCodeLabel');
      const removeBtn = document.getElementById('removeCouponBtn');

      if (applyBtn) {
        applyBtn.disabled = Boolean(opts.loading);
        applyBtn.innerHTML = opts.loading
          ? '<i class="fas fa-spinner fa-spin"></i> جاري التحقق...'
          : 'تطبيق';
      }
      if (removeBtn) {
        removeBtn.disabled = Boolean(opts.loading);
      }

      if (activeCouponState && activeCouponState.code) {
        if (inputEl && typeof opts.preserveInput !== 'boolean') {
          inputEl.value = activeCouponState.code;
        }
        if (appliedCodeLabel) appliedCodeLabel.textContent = activeCouponState.code;
        if (appliedBadge) appliedBadge.style.display = 'flex';
      } else {
        if (appliedCodeLabel) appliedCodeLabel.textContent = '';
        if (appliedBadge) appliedBadge.style.display = 'none';
      }

      if (Object.prototype.hasOwnProperty.call(opts, 'feedbackMessage')) {
        renderCouponFeedback(opts.feedbackType || 'info', opts.feedbackMessage);
      }
    }

    async function validateCouponWithServer(rawCode, options) {
      const opts = options || {};
      const normalizedCode = normalizeClientCouponCode(rawCode);
      const inputEl = document.getElementById('couponCodeInput');

      if (!normalizedCode) {
        activeCouponState = null;
        pendingCouponCode = null;
        clearStoredCouponCode();
        renderCouponUiState({
          loading: false,
          preserveInput: true,
          feedbackType: 'error',
          feedbackMessage: 'يرجى إدخال كود الخصم أولاً.'
        });
        syncAllShippingAndOrderSummaries();
        return { ok: false, reason: 'COUPON_CODE_REQUIRED' };
      }

      if (!Array.isArray(cart) || cart.length === 0) {
        activeCouponState = null;
        pendingCouponCode = null;
        clearStoredCouponCode();
        renderCouponUiState({ loading: false, feedbackMessage: '' });
        syncAllShippingAndOrderSummaries();
        return { ok: false, reason: 'EMPTY_CART' };
      }

      if (inputEl && !opts.preserveInput) {
        inputEl.value = normalizedCode;
      }

      if (typeof fetch !== 'function') {
        activeCouponState = null;
        pendingCouponCode = null;
        renderCouponUiState({
          loading: false,
          preserveInput: true,
          feedbackType: 'error',
          feedbackMessage: 'تعذر التحقق من الكوبون حالياً؛ لم يتم تطبيق أي خصم.'
        });
        syncAllShippingAndOrderSummaries();
        return { ok: false, reason: 'FETCH_UNAVAILABLE' };
      }

      const seq = ++couponPreviewSeq;
      isValidatingCoupon = true;
      renderCouponUiState({
        loading: true,
        preserveInput: true,
        feedbackType: 'info',
        feedbackMessage: opts.isRevalidation ? 'جاري إعادة التحقق من صلاحية الكوبون...' : 'جاري التحقق من الكوبون...'
      });

      let res = null;
      let data = {};
      let networkError = false;

      try {
        res = await fetch('/api/coupons/validate', {
          method: 'POST',
          cache: 'no-store',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            code: normalizedCode,
            items: buildMinimalCouponPreviewItems()
          })
        });
        data = await res.json().catch(() => ({}));
      } catch (_) {
        networkError = true;
      }

      if (seq !== couponPreviewSeq) {
        return { ok: false, stale: true };
      }

      isValidatingCoupon = false;

      if (!Array.isArray(cart) || cart.length === 0) {
        activeCouponState = null;
        pendingCouponCode = null;
        clearStoredCouponCode();
        renderCouponUiState({ loading: false, feedbackMessage: '' });
        syncAllShippingAndOrderSummaries();
        return { ok: false, reason: 'EMPTY_CART' };
      }

      if (!networkError && res && res.ok && data && data.success === true && data.eligible === true) {
        const discountVal = Math.round((Number(data.discountAmount) || 0) * 100) / 100;
        const resolvedCode = normalizeClientCouponCode(data.code || normalizedCode);
        activeCouponState = {
          code: resolvedCode,
          discountType: data.discountType || null,
          discountValue: data.discountValue ?? null,
          scope: data.scope || null,
          categorySlug: data.categorySlug || null,
          eligibleSubtotal: Number(data.eligibleSubtotal) || 0,
          orderProductSubtotal: Number(data.orderProductSubtotal) || 0,
          discountAmount: discountVal,
          discountedProductSubtotal: Number(data.discountedProductSubtotal) || 0,
          message: data.message || `تم تطبيق الكوبون ${resolvedCode} بخصم ${formatCartEgp(discountVal)} ج.م.`
        };
        pendingCouponCode = resolvedCode;
        writeStoredCouponCode(resolvedCode);
        renderCouponUiState({
          loading: false,
          feedbackType: 'success',
          feedbackMessage: activeCouponState.message
        });
        syncAllShippingAndOrderSummaries();
        return { ok: true, data };
      }

      // Any rejection, rate limit, outage, or network error: NEVER preserve stale active discount preview
      activeCouponState = null;
      pendingCouponCode = null;
      clearStoredCouponCode();

      let errMsg = (data && typeof data.message === 'string' && data.message.trim())
        ? data.message.trim()
        : '';
      if (!errMsg) {
        if (networkError || !res || res.status >= 500) {
          errMsg = 'تعذر التحقق من صلاحية الكوبون حالياً؛ لم يتم تطبيق أي خصم. يرجى المحاولة مرة أخرى.';
        } else if (res.status === 429) {
          errMsg = 'تم إرسال عدد كبير من محاولات التحقق من الكوبون. يرجى الانتظار قليلاً ثم المحاولة.';
        } else {
          errMsg = 'كود الخصم غير صالح أو غير مؤهل لهذه السلة.';
        }
      }

      renderCouponUiState({
        loading: false,
        preserveInput: true,
        feedbackType: 'error',
        feedbackMessage: errMsg
      });
      syncAllShippingAndOrderSummaries();
      return { ok: false, reason: (data && (data.reason || data.error)) || 'COUPON_VALIDATION_FAILED', message: errMsg };
    }

    window.applyCouponCode = function() {
      const inputEl = document.getElementById('couponCodeInput');
      const raw = inputEl ? inputEl.value : '';
      return validateCouponWithServer(raw, { isRevalidation: false });
    };

    window.removeCouponCode = function(silent) {
      couponPreviewSeq += 1;
      isValidatingCoupon = false;
      activeCouponState = null;
      pendingCouponCode = null;
      clearStoredCouponCode();
      const inputEl = document.getElementById('couponCodeInput');
      if (inputEl) inputEl.value = '';
      renderCouponUiState({
        loading: false,
        preserveInput: true,
        feedbackType: 'info',
        feedbackMessage: silent ? '' : 'تمت إزالة كود الخصم.'
      });
      syncAllShippingAndOrderSummaries();
    };

    const applyCouponBtnEl = document.getElementById('applyCouponBtn');
    if (applyCouponBtnEl) {
      applyCouponBtnEl.addEventListener('click', function() {
        window.applyCouponCode();
      });
    }
    const removeCouponBtnEl = document.getElementById('removeCouponBtn');
    if (removeCouponBtnEl) {
      removeCouponBtnEl.addEventListener('click', function() {
        window.removeCouponCode(false);
      });
    }
    const couponInputDomEl = document.getElementById('couponCodeInput');
    if (couponInputDomEl) {
      couponInputDomEl.addEventListener('keydown', function(evt) {
        if (evt && evt.key === 'Enter') {
          if (typeof evt.preventDefault === 'function') evt.preventDefault();
          window.applyCouponCode();
        }
      });
    }

    function updateCouponSummaryRows(couponCode, couponDiscount) {
      const show = Boolean(couponCode && couponDiscount > 0);
      const formattedDiscount = '-' + formatCartEgp(couponDiscount) + ' ج.م';

      const pairs = [
        { row: 'couponSummaryRow1', code: 'couponCodeSummary1', val: 'couponDiscountSummary1' },
        { row: 'couponSummaryRow2', code: 'couponCodeSummary2', val: 'couponDiscountSummary2' },
        { row: 'couponSummaryRow3', code: 'couponCodeSummary3', val: 'summCouponDiscount' }
      ];

      pairs.forEach(p => {
        const rowEl = document.getElementById(p.row);
        const codeEl = document.getElementById(p.code);
        const valEl = document.getElementById(p.val);
        if (rowEl) rowEl.style.display = show ? 'flex' : 'none';
        if (codeEl) codeEl.textContent = show ? couponCode : '';
        if (valEl) valEl.textContent = show ? formattedDiscount : '0 ج.م';
      });
    }

    function syncAllShippingAndOrderSummaries() {
      const subtotal = calculateCartSubtotal();
      const govInfo = getSelectedGovernorateInfo();

      const summaryState = (window.DandyCartShipping && typeof window.DandyCartShipping.computeCheckoutSummaryState === 'function')
        ? window.DandyCartShipping.computeCheckoutSummaryState({
            subtotal: subtotal,
            policy: STORE_SHIPPING_POLICY,
            selectedGovernorate: govInfo.value,
            selectedGovernorateLabel: govInfo.label
          })
        : (() => {
            const eligible = isFreeShippingEligible(subtotal);
            const hasGov = Boolean(govInfo.value);
            const fee = eligible ? 0 : (hasGov ? calculateShippingFeeForGov(govInfo.value, subtotal) : null);
            const threshold = Number(STORE_SHIPPING_POLICY.freeShippingThresholdEgp);
            const feeRange = STORE_SHIPPING_POLICY.feeRangeEgp || { min: 70, max: 120 };
            const state = eligible ? 'unlocked' : (subtotal === threshold ? 'at_threshold' : 'below_threshold');
            return {
              progress: {
                state,
                isEligible: eligible,
                isAtThreshold: subtotal === threshold,
                subtotal,
                threshold,
                progressPercent: eligible ? 100 : (subtotal === threshold ? 99 : Math.min(98, Math.round((subtotal / threshold) * 100))),
                titleText: eligible ? 'تم تفعيل الشحن المجاني' : `شحن مجاني للطلبات فوق ${threshold} ج.م`,
                messageText: eligible ? `تجاوز المجموع ${threshold} ج.م` : `يتبقى للوصول ${Math.max(0, threshold - subtotal)} ج.م ويلزم تجاوز ${threshold} ج.م`,
                badgeText: eligible ? 'شحن مجاني مُفعّل' : (state === 'at_threshold' ? 'عند الحد تماماً' : 'متبقي للشحن المجاني'),
                statusChipText: eligible ? 'مُفعّل' : 'غير مؤهل بعد',
                ariaValueText: String(subtotal)
              },
              subtotalText: formatCartEgp(subtotal) + ' ج.م',
              shippingFee: fee,
              shippingConfirmed: fee !== null,
              totalConfirmed: fee !== null,
              shippingDisplayText: fee === 0 ? 'شحن مجاني (0 ج.م)' : (fee !== null ? `${formatCartEgp(fee)} ج.م (${govInfo.label})` : `تُحدد حسب المحافظة (${feeRange.min}–${feeRange.max} ج.م)`),
              step1TotalLabel: eligible ? 'الإجمالي المستحق:' : (hasGov ? `الإجمالي شامل الشحن (${govInfo.label}):` : 'مجموع المنتجات (قبل الشحن):'),
              step1TotalText: eligible ? formatCartEgp(subtotal) + ' ج.م' : (hasGov ? formatCartEgp(subtotal + fee) + ' ج.م' : formatCartEgp(subtotal) + ' ج.م + الشحن'),
              step2TotalLabel: eligible ? 'الإجمالي النهائي:' : (hasGov ? 'الإجمالي الكلي (شامل الشحن):' : 'الإجمالي النهائي:'),
              step2TotalText: eligible ? formatCartEgp(subtotal) + ' ج.م' : (hasGov ? formatCartEgp(subtotal + fee) + ' ج.م' : 'يُحدد بعد اختيار المحافظة'),
              step2TotalHint: '',
              step3ShippingText: fee === 0 ? 'شحن مجاني (0 ج.م)' : (fee !== null ? `${formatCartEgp(fee)} ج.م (${govInfo.label})` : `تُحدد حسب المحافظة`),
              step3TotalText: fee !== null ? formatCartEgp(subtotal + fee) + ' ج.م' : 'يُحدد بعد اختيار المحافظة'
            };
          })();

      const activeCode = activeCouponState && activeCouponState.code ? activeCouponState.code : '';
      const rawCouponDiscount = activeCode && Number.isFinite(Number(activeCouponState.discountAmount)) && Number(activeCouponState.discountAmount) > 0
        ? Math.round(Number(activeCouponState.discountAmount) * 100) / 100
        : 0;
      const couponDiscount = Math.min(subtotal, rawCouponDiscount);
      const hasActiveCoupon = Boolean(activeCode && couponDiscount > 0);
      const discountedSubtotal = Math.max(0, Math.round((subtotal - couponDiscount) * 100) / 100);

      updateCouponSummaryRows(activeCode, couponDiscount);

      const step1TotalText = hasActiveCoupon
        ? (summaryState.shippingConfirmed
            ? formatCartEgp(Math.max(0, Math.round((discountedSubtotal + Number(summaryState.shippingFee || 0)) * 100) / 100)) + ' ج.م'
            : formatCartEgp(discountedSubtotal) + ' ج.م + الشحن')
        : summaryState.step1TotalText;

      const step2TotalText = hasActiveCoupon
        ? (summaryState.totalConfirmed
            ? formatCartEgp(Math.max(0, Math.round((discountedSubtotal + Number(summaryState.shippingFee || 0)) * 100) / 100)) + ' ج.م'
            : summaryState.step2TotalText)
        : summaryState.step2TotalText;

      const step3TotalText = hasActiveCoupon
        ? (summaryState.shippingConfirmed
            ? formatCartEgp(Math.max(0, Math.round((discountedSubtotal + Number(summaryState.shippingFee || 0)) * 100) / 100)) + ' ج.م'
            : summaryState.step3TotalText)
        : summaryState.step3TotalText;

      renderFreeShippingProgressCard(summaryState.progress);

      // Step 1 Summary
      if (subtotalValSummary) subtotalValSummary.textContent = summaryState.subtotalText;
      applyFreeShippingStatusEl(document.getElementById('freeShippingStatusSummary1'), summaryState.progress);
      const shippingCostSummary1 = document.getElementById('shippingCostSummary1');
      if (shippingCostSummary1) {
        shippingCostSummary1.textContent = summaryState.shippingDisplayText;
        shippingCostSummary1.style.color = summaryState.progress.isEligible
          ? 'var(--color-success)'
          : (summaryState.shippingConfirmed ? 'var(--color-primary)' : 'var(--color-muted)');
        shippingCostSummary1.style.fontWeight = summaryState.shippingConfirmed ? '700' : '600';
      }
      const grandTotalLabel1 = document.getElementById('grandTotalLabelSummary1');
      if (grandTotalLabel1) grandTotalLabel1.textContent = summaryState.step1TotalLabel;
      if (grandTotalSummaryValue1) grandTotalSummaryValue1.textContent = step1TotalText;
      const hint1 = document.getElementById('shippingSummaryHint1');
      if (hint1) hint1.textContent = summaryState.step1TotalHint || '';

      // Step 2 Summary
      if (subtotalValSummary2) subtotalValSummary2.textContent = summaryState.subtotalText;
      applyFreeShippingStatusEl(document.getElementById('freeShippingStatusSummary2'), summaryState.progress);
      if (shippingCostSummary2) {
        shippingCostSummary2.textContent = summaryState.shippingDisplayText;
        shippingCostSummary2.style.color = summaryState.progress.isEligible
          ? 'var(--color-success)'
          : (summaryState.shippingConfirmed ? 'var(--color-primary)' : 'var(--color-blush)');
      }
      const grandTotalLabel2 = document.getElementById('grandTotalLabelSummary2');
      if (grandTotalLabel2) grandTotalLabel2.textContent = summaryState.step2TotalLabel;
      if (grandTotalSummaryValue2) {
        grandTotalSummaryValue2.textContent = step2TotalText;
        grandTotalSummaryValue2.style.fontSize = summaryState.totalConfirmed ? '1.25rem' : '0.96rem';
        grandTotalSummaryValue2.style.color = summaryState.totalConfirmed ? 'var(--color-blush)' : 'var(--color-primary)';
      }
      const hint2 = document.getElementById('shippingSummaryHint2');
      if (hint2) hint2.textContent = summaryState.step2TotalHint;

      // Step 3 Summary
      if (summSubtotal) summSubtotal.textContent = summaryState.subtotalText;
      applyFreeShippingStatusEl(document.getElementById('freeShippingStatusSummary3'), summaryState.progress);
      if (summShipping) {
        summShipping.textContent = summaryState.step3ShippingText;
        summShipping.style.color = summaryState.progress.isEligible ? 'var(--color-success)' : 'var(--color-primary)';
      }
      if (finalSummaryTotal) finalSummaryTotal.textContent = step3TotalText;

      return summaryState;
    }

    // Handle live updates on Governorates dropdown change
    window.handleGovChange = function() {
      const govDropdown = document.getElementById('f-gov');
      if (!govDropdown) return; // Prevent TypeError if the cart is empty and the DOM is replaced
      syncAllShippingAndOrderSummaries();
    };

    // Update Cart Badge inside Navbar
    function updateCartBadge() {
      if (typeof window.updateSharedCartCount === 'function') {
        window.updateSharedCartCount();
      } else {
        const badge = document.getElementById('cart-count');
        if (badge) {
          const totalQty = cart.reduce((sum, item) => sum + (parseInt(item.quantity, 10) || 1), 0);
          badge.textContent = totalQty;
        }
      }
    }

    function renderStep1CartItems() {
      updateCartBadge(); // Ensure badge is always up to date

      if (cart.length === 0) {
        document.getElementById('cartCheckoutContainer').innerHTML = `
          <div style="text-align:center; padding:64px 24px; background:var(--color-surface); border:1px solid var(--border-light); border-radius:var(--border-radius-md); margin:0 auto; max-width:540px;" dir="rtl">
            <div style="width:64px; height:64px; border-radius:50%; background:var(--color-surface-soft); display:flex; align-items:center; justify-content:center; margin:0 auto 18px; color:var(--color-blush); font-size:1.6rem; border:1px solid var(--border-light);">
              <i class="fas fa-shopping-bag"></i>
            </div>
            <h2 style="font-size:1.35rem; font-weight:800; margin-bottom:8px; color:var(--color-primary);">حقيبة التسوق فارغة</h2>
            <p style="color:var(--color-muted); font-size:0.92rem; margin-bottom:24px; line-height:1.6;">لم تقومي بإضافة أي منتجات إلى حقيبتكِ بعد. تصفحي مجموعاتنا الطبيعية الآن!</p>
            <a href="/all-products" class="btn-checkout-primary" style="display:inline-flex; border-radius:99px; text-decoration:none;">
              <i class="fas fa-shopping-bag"></i>
              <span>تصفح جميع المنتجات</span>
            </a>
