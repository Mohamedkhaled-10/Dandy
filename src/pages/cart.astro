      cartItemsList.innerHTML = '';
      cart.forEach((item, index) => {
        const qtyVal = parseInt(item.quantity, 10) || 1;
        const unitPrice = typeof getEffectiveUnitPrice === 'function'
          ? getEffectiveUnitPrice(item)
          : (Number(item.price) || 0);
        const rowSubtotal = unitPrice * qtyVal;
        
        const varInfo = typeof getVariantsDisplayInfo === 'function' 
          ? getVariantsDisplayInfo(item) 
          : (item.selectedVariant && item.selectedVariant.name ? { count: 1, label: 'الرائحة', text: item.selectedVariant.name } : null);
        
        // إذا كان المنتج لا يحتوي variants: لا تعرض أي سطر متعلق بالرائحة
        const variantHtml = (varInfo && varInfo.text)
          ? `<div class="cart-item-scent-badge">
               <i class="fas fa-sparkles"></i>
               <span>${escapeCartHtml(varInfo.label)}: <strong>${escapeCartHtml(varInfo.text)}</strong></span>
             </div>`
          : '';

        let collectionHtml = '';
        if (item.isCollection && Array.isArray(item.selectedItems) && item.selectedItems.length > 0) {
          collectionHtml = `
            <div class="cart-col-breakdown" style="margin-top:6px; padding:6px 10px; background:#fdf2f8; border-radius:6px; font-size:0.75rem; border:1px solid #fbcfe8;">
              <div style="font-weight:700; color:#be185d; margin-bottom:3px;"><i class="fas fa-boxes" style="margin-left:4px;"></i> محتويات الكوليكشن:</div>
              <ul style="margin:0; padding-right:16px; list-style-type:circle; color:#374151;">
                ${item.selectedItems.map(si => {
                  const scentName = si.selectedVariant && (si.selectedVariant.name || si.selectedVariant.id) ? (si.selectedVariant.name || si.selectedVariant.id) : '';
                  return `<li>${escapeCartHtml(si.productName || 'منتج')}${scentName ? ` <span style="color:#9d174d; font-weight:600;">(الرائحة: ${escapeCartHtml(scentName)})</span>` : ''}</li>`;
                }).join('')}
              </ul>
            </div>
