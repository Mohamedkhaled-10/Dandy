        }

        const pfBadgeHtml = item.isPinkFriday
          ? `<div class="cart-item-pf-badge" style="display:inline-flex; align-items:center; gap:6px; background:#fe5d9f; color:#ffffff; font-size:0.75rem; font-weight:700; padding:2px 8px; border-radius:99px; margin-bottom:4px;">
               <span>${escapeCartHtml(item.badgeText || (item.isCollection ? 'كوليكشن Pink Friday' : 'Pink Friday'))}</span>
               ${item.regularPrice ? `<span style="text-decoration:line-through; opacity:0.85;">${formatCartEgp(item.regularPrice)} ج.م</span>` : ''}
             </div>`
          : '';

        const itemCard = document.createElement('div');
        itemCard.className = 'cart-product-list-item';
        itemCard.innerHTML = `
          <div class="cart-item-info">
            <img loading="lazy" src="${escapeCartHtml(item.image || '')}" alt="${escapeCartHtml(item.name || '')}" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=100&q=80';">
            <div class="cart-item-meta">
              <h3>${escapeCartHtml(item.name || '')}</h3>
              ${pfBadgeHtml}
              ${variantHtml}
              ${collectionHtml}
              <div class="cart-item-unit-price">${formatCartEgp(unitPrice)} ج.م للقطعة</div>
            </div>
          </div>

          <div class="cart-item-actions">
            <div class="qty-tactile-selector">
              <button type="button" class="qty-btn-adjust" onclick="changeQty(${index}, -1)" aria-label="تقليل الكمية">−</button>
