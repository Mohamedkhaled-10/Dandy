---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="تتبع الطلب | Dandy"
  description="تابعي حالة شحنتك خطوة بخطوة عبر إدخال كود الفاتورة ورقم الهاتف."
  keywords="تتبع الطلب, Dandy, حالة الشحنة"
  canonical="https://dandy-ebon.vercel.app/track-order"
>
  <slot name="head" slot="head">
    <script is:inline src="/assets/js/order-flow-helpers.js"></script>
    <meta name="robots" content="noindex, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dandy-ebon.vercel.app/track-order" />
    <meta property="og:title" content="تتبع الطلب | Dandy" />
    <meta property="og:description" content="تابعي حالة شحنتك خطوة بخطوة." />
    <meta property="og:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <style is:global>
      .track-page-wrap {
        padding: 120px 20px 80px;
        max-width: 720px;
        margin: 0 auto;
      }

      .track-header {
        margin-bottom: 32px;
        text-align: right;
      }

      .track-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 0 0 8px 0;
        letter-spacing: -0.02em;
      }

      .track-header p {
        font-size: 0.95rem;
        color: var(--color-muted);
        margin: 0;
        line-height: 1.6;
      }

      /* Form Box */
      .track-form-card {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        padding: 28px;
        margin-bottom: 28px;
      }

      .track-inputs-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
      }

      .track-field-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .track-field-group label {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-primary);
      }

      .track-field-group input {
        padding: 11px 14px;
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-sm);
        font-size: 0.92rem;
        color: var(--color-primary);
        background: var(--color-canvas);
        outline: none;
        transition: border-color 0.2s;
        box-sizing: border-box;
      }

      .track-field-group input:focus {
        border-color: var(--color-primary);
        background: var(--color-surface);
      }

      .btn-submit-track {
        background: var(--color-primary);
        color: #fff;
        border: none;
        border-radius: var(--border-radius-sm);
        padding: 12px 24px;
        font-size: 0.92rem;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .btn-submit-track:hover {
        opacity: 0.9;
      }

      .track-loading-text {
        display: none;
        font-size: 0.88rem;
        color: var(--color-rose-kiss-500, #fe5d9f);
        font-weight: 700;
      }

      .recent-lookups {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border-light);
        font-size: 0.82rem;
        color: var(--color-muted);
      }

      .recent-chips-list {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 8px;
      }

      .recent-chip {
        background: var(--color-surface-soft);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-sm);
        padding: 4px 10px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        color: var(--color-primary);
        transition: border-color 0.2s;
      }

      .recent-chip:hover {
        border-color: var(--color-primary);
      }

      /* Tracking Result Card */
      .track-results-card {
        display: none;
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        padding: 28px;
      }

      .track-results-card.show {
        display: block;
      }

      .track-results-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-light);
        padding-bottom: 16px;
        margin-bottom: 24px;
      }

      .track-results-top span {
        font-size: 0.82rem;
        color: var(--color-muted);
        display: block;
      }

      .track-results-top h2 {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 2px 0 0;
      }

      .btn-print-invoice {
        background: transparent;
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-sm);
        padding: 6px 14px;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--color-primary);
        cursor: pointer;
      }

      /* Minimal Timeline */
      .timeline-track-wrap {
        margin: 24px 0 32px;
        position: relative;
      }

      .timeline-track-steps {
        display: flex;
        justify-content: space-between;
        position: relative;
      }

      .timeline-track-steps::before {
        content: '';
        position: absolute;
        top: 14px;
        left: 12%;
        right: 12%;
        height: 2px;
        background: var(--border-light);
        z-index: 1;
      }

      .timeline-track-bar {
        position: absolute;
        top: 14px;
        right: 12%;
        height: 2px;
        background: var(--color-success);
        z-index: 2;
        transition: width 0.4s ease;
        width: 0%;
      }

      .timeline-track-step {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        flex: 1;
      }

      .timeline-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--color-surface);
        border: 2px solid var(--border-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        color: var(--color-muted);
        font-weight: 700;
      }

      .timeline-track-step.active .timeline-dot {
        background: var(--color-success);
        border-color: var(--color-success);
        color: #fff;
      }

      .timeline-text {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--color-muted);
        text-align: center;
      }

      .timeline-track-step.active .timeline-text {
        color: var(--color-primary);
      }

      .cancelled-track-notice {
        background: rgba(184, 67, 79, 0.08);
        border: 1px solid var(--color-danger);
        color: var(--color-danger);
        padding: 12px;
        border-radius: var(--border-radius-sm);
        text-align: center;
        font-weight: 700;
        font-size: 0.9rem;
        margin: 16px 0;
        display: none;
      }

      /* Meta columns */
      .track-meta-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        border-bottom: 1px solid var(--border-light);
        padding-bottom: 20px;
        margin-bottom: 20px;
      }

      .track-meta-col span {
        font-size: 0.8rem;
        color: var(--color-muted);
        display: block;
        margin-bottom: 4px;
      }

      .track-meta-col strong {
        font-size: 0.92rem;
        color: var(--color-primary);
      }

      .track-meta-col p {
        font-size: 0.85rem;
        color: var(--color-muted);
        margin: 4px 0 0;
      }

      /* Items Table */
      .track-items-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
      }

      .track-items-table th {
        font-size: 0.8rem;
        color: var(--color-muted);
        font-weight: 700;
        border-bottom: 1px solid var(--border-light);
        padding: 8px 0;
      }

      .track-items-table td {
        padding: 12px 0;
        border-bottom: 1px solid var(--border-light);
        font-size: 0.9rem;
      }

      .track-item-img {
        width: 36px;
        height: 36px;
        object-fit: cover;
        border-radius: var(--border-radius-sm);
        border: 1px solid var(--border-light);
        margin-left: 10px;
      }

      .track-status-banner {
        display: none;
        margin-top: 16px;
        padding: 13px 16px;
        border-radius: var(--border-radius-sm);
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.6;
        border: 1px solid #fecdd3;
        background: #fff1f2;
        color: #9f1239;
      }

      .track-status-banner.info {
        border-color: #fde68a;
        background: #fffbeb;
        color: #92400e;
      }

      .track-stage-dates {
        margin-top: 16px;
        padding: 12px 14px;
        background: var(--color-surface-soft);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-sm);
        display: none;
        flex-wrap: wrap;
        gap: 12px 20px;
        font-size: 0.82rem;
        color: var(--color-muted);
      }

      .track-stage-dates strong {
        color: var(--color-primary);
      }

      .track-privacy-note {
        margin-top: 12px;
        font-size: 0.8rem;
        color: var(--color-muted);
        line-height: 1.6;
      }

      @media (max-width: 600px) {
        .track-page-wrap {
          padding-top: 100px;
        }
        .track-inputs-grid {
          grid-template-columns: 1fr;
        }
        .track-meta-row {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </slot>

  <div class="track-page-wrap container" dir="rtl">
    <header class="track-header">
      <h1>تتبع الطلب</h1>
      <p>أدخلي كود الفاتورة ورقم الهاتف المسجل لمتابعة خط سير وتجهيز شحنتك فورياً.</p>
    </header>

    <main>
      <!-- Search Form -->
      <section class="track-form-card">
        <form id="trackingForm">
          <div class="track-inputs-grid">
            <div class="track-field-group">
              <label for="trackCode">كود الفاتورة</label>
              <input type="text" id="trackCode" placeholder="مثال: DNY-123456" required />
            </div>
            <div class="track-field-group">
              <label for="trackPhone">رقم هاتف المستلم</label>
              <input type="tel" id="trackPhone" placeholder="مثال: 01012345678" required />
            </div>
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
            <button type="submit" id="btnSubmitTrack" class="btn-submit-track">
              <i class="fas fa-search"></i> تتبع الطلب
            </button>
            <div id="loadingIndicator" class="track-loading-text">
              <i class="fas fa-circle-notch fa-spin"></i> جاري التحقق من السجلات...
            </div>
          </div>

          <div id="trackStatusBanner" class="track-status-banner" role="alert" aria-live="polite"></div>
        </form>

        <div class="recent-lookups" id="recentSearchesBox" style="display:none;">
          <span>أكواد الطلبات الأخيرة على هذا الجهاز (اضغطي لتعبئة الكود ثم أدخلي رقم الهاتف):</span>
          <div class="recent-chips-list" id="recentTagsList"></div>
        </div>
      </section>

      <!-- Results Card -->
      <section class="track-results-card" id="trackingResultsCard">
        <div class="track-results-top">
          <div>
            <span>كود الطلب</span>
            <h2 id="resInvoiceCode">DNY-******</h2>
          </div>
          <button type="button" class="btn-print-invoice" onclick="window.print()">
            <i class="fas fa-print"></i> طباعة حالة الطلب
          </button>
        </div>

        <div class="cancelled-track-notice" id="cancelledBanner">
          <i class="fas fa-times-circle"></i> تم إلغاء هذا الطلب.
        </div>

        <div class="timeline-track-wrap" id="timelineContainer">
          <div class="timeline-track-steps">
            <div class="timeline-track-bar" id="timelineProgressBar"></div>
            
            <div class="timeline-track-step" id="step-new">
              <div class="timeline-dot"><i class="fas fa-receipt"></i></div>
              <div class="timeline-text">تم الاستلام</div>
            </div>
            
            <div class="timeline-track-step" id="step-processing">
              <div class="timeline-dot"><i class="fas fa-box-open"></i></div>
              <div class="timeline-text">قيد التجهيز</div>
            </div>
            
            <div class="timeline-track-step" id="step-shipped">
              <div class="timeline-dot"><i class="fas fa-shipping-fast"></i></div>
              <div class="timeline-text">تم الشحن</div>
            </div>
            
            <div class="timeline-track-step" id="step-delivered">
              <div class="timeline-dot"><i class="fas fa-check"></i></div>
              <div class="timeline-text">تم التوصيل</div>
            </div>
          </div>

          <div class="track-stage-dates" id="stageDatesRow"></div>
        </div>

        <div class="track-meta-row">
          <div class="track-meta-col">
            <span>المستلم</span>
            <strong id="resCustName">-</strong>
            <p id="resOrderDates"></p>
          </div>
          <div class="track-meta-col">
            <span>نطاق التوصيل وحالة الشحن</span>
            <strong id="resCustLocation">-</strong>
            <p id="resShippingMeta"></p>
          </div>
        </div>

        <table class="track-items-table">
          <thead>
            <tr>
              <th style="text-align: right;">المنتج</th>
              <th style="text-align: center; width: 90px;">الكمية</th>
            </tr>
          </thead>
          <tbody id="resProductsBody"></tbody>
        </table>

        <p class="track-privacy-note">
          <i class="fas fa-shield-alt" style="color:var(--color-blush); margin-left:4px;"></i>
          لحماية خصوصيتكِ، تعرض صفحة التتبع العامة حالة الشحنة والمنتجات فقط دون عرض تفاصيل العنوان أو المبالغ المالية.
        </p>
      </section>
    </main>
  </div>

  <script is:inline>
    const trackingForm = document.getElementById('trackingForm');
    const trackCodeInput = document.getElementById('trackCode');
    const trackPhoneInput = document.getElementById('trackPhone');
    const submitBtn = document.getElementById('btnSubmitTrack');
    const loadingIndicator = document.getElementById('loadingIndicator');
    const statusBanner = document.getElementById('trackStatusBanner');

    const resultsCard = document.getElementById('trackingResultsCard');
    const resInvoiceCode = document.getElementById('resInvoiceCode');
    const resCustName = document.getElementById('resCustName');
    const resOrderDates = document.getElementById('resOrderDates');
    const resCustLocation = document.getElementById('resCustLocation');
    const resShippingMeta = document.getElementById('resShippingMeta');
    const resProductsBody = document.getElementById('resProductsBody');
    const stageDatesRow = document.getElementById('stageDatesRow');

    const cancelledBanner = document.getElementById('cancelledBanner');
    const timelineContainer = document.getElementById('timelineContainer');
    const timelineProgressBar = document.getElementById('timelineProgressBar');

    const stepNew = document.getElementById('step-new');
    const stepProcessing = document.getElementById('step-processing');
    const stepShipped = document.getElementById('step-shipped');
    const stepDelivered = document.getElementById('step-delivered');

    const recentSearchesBox = document.getElementById('recentSearchesBox');
    const recentTagsList = document.getElementById('recentTagsList');

    function showTrackBanner(message, isInfo) {
      if (!statusBanner) return;
      statusBanner.textContent = message || '';
      statusBanner.classList.toggle('info', Boolean(isInfo));
      statusBanner.style.display = message ? 'block' : 'none';
    }

    function hideTrackBanner() {
      if (!statusBanner) return;
      statusBanner.style.display = 'none';
      statusBanner.textContent = '';
    }

    function formatArabicDate(value) {
      if (!value) return '';
      const d = new Date(value);
      if (isNaN(d.getTime())) return '';
      return d.toLocaleDateString('ar-EG', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    function drawRecentSearches() {
      const flow = window.DandyOrderFlow;
      const recent = flow ? flow.loadAndMigrateRecentLookups(window.localStorage, 4) : [];
      if (!recentSearchesBox || !recentTagsList) return;
      if (!recent || recent.length === 0) {
        recentSearchesBox.style.display = 'none';
        recentTagsList.innerHTML = '';
        return;
      }

      recentSearchesBox.style.display = 'block';
      recentTagsList.innerHTML = '';

      recent.forEach((r) => {
        const tag = document.createElement('button');
        tag.type = 'button';
        tag.className = 'recent-chip';
        tag.textContent = r.code;
        tag.title = 'اضغطي لتعبئة كود الفاتورة ثم أدخلي رقم الهاتف';
        tag.addEventListener('click', () => {
          trackCodeInput.value = r.code;
          trackPhoneInput.value = '';
          trackPhoneInput.focus();
          showTrackBanner('تم تعبئة كود الفاتورة. يرجى إدخال رقم الهاتف المسجل بالطلب للمتابعة.', true);
        });
        recentTagsList.appendChild(tag);
      });
    }

    function saveRecentSearchCodeOnly(code) {
      const flow = window.DandyOrderFlow;
      if (flow) {
        flow.saveRecentLookupCode(window.localStorage, code, 4);
      }
      drawRecentSearches();
    }

    function getNormalizedStatus(status) {
      if (status === 'جديد' || status === 'قيد الانتظار' || status === 'New' || status === 'Pending') return 'new';
      if (status === 'تم التواصل' || status === 'قيد التجهيز' || status === 'قيد التحضير' || status === 'قيد المعالجة' || status === 'Processing') return 'processing';
      if (status === 'تم الشحن' || status === 'جاري الشحن' || status === 'جاري التوصيل' || status === 'شحن' || status === 'Shipped') return 'shipped';
      if (status === 'مكتمل' || status === 'تم التوصيل' || status === 'واصل' || status === 'Delivered') return 'delivered';
      return 'new';
    }

    function renderOrderResults(order) {
      hideTrackBanner();
      resultsCard.classList.add('show');
      resInvoiceCode.textContent = order.invoiceCode || '';
      resCustName.textContent = order.firstName || '-';

      const createdStr = formatArabicDate(order.createdAt);
      const updatedStr = formatArabicDate(order.lastStatusUpdate);
      const dateParts = [];
      if (createdStr) dateParts.push('تاريخ الطلب: ' + createdStr);
      if (updatedStr) dateParts.push('آخر تحديث: ' + updatedStr);
      resOrderDates.textContent = dateParts.join(' · ');

      const locationParts = [];
      if (order.city) locationParts.push(order.city);
      if (order.governorate) locationParts.push(order.governorate);
      resCustLocation.textContent = locationParts.length > 0 ? locationParts.join('، ') : '-';

      const shippingParts = [];
      if (order.shippingCompany) shippingParts.push('شركة الشحن: ' + order.shippingCompany);
      if (order.shippingStatus) shippingParts.push('تفاصيل الشحن: ' + order.shippingStatus);
      resShippingMeta.textContent = shippingParts.join(' · ');

      resProductsBody.innerHTML = '';

      if (Array.isArray(order.products) && order.products.length > 0) {
        order.products.forEach((p) => {
          const qty = Number.isFinite(Number(p.quantity)) && Number(p.quantity) > 0
            ? Math.floor(Number(p.quantity))
            : 1;

          const tr = document.createElement('tr');

          const tdName = document.createElement('td');
          const strongName = document.createElement('strong');
          strongName.style.color = 'var(--color-primary)';
          strongName.style.fontSize = '0.92rem';
          strongName.textContent = p && typeof p.name === 'string' && p.name.trim() ? p.name.trim() : 'منتج داندي';
          tdName.appendChild(strongName);

          const tdQty = document.createElement('td');
          tdQty.style.textAlign = 'center';
          tdQty.style.fontWeight = '700';
          tdQty.textContent = String(qty);

          tr.appendChild(tdName);
          tr.appendChild(tdQty);
          resProductsBody.appendChild(tr);
        });
      } else {
        const emptyTr = document.createElement('tr');
        const emptyTd = document.createElement('td');
        emptyTd.colSpan = 2;
        emptyTd.style.textAlign = 'center';
        emptyTd.style.color = 'var(--color-muted)';
        emptyTd.style.padding = '16px';
        emptyTd.textContent = 'لا توجد منتجات مسجلة.';
        emptyTr.appendChild(emptyTd);
        resProductsBody.appendChild(emptyTr);
      }

      if (stageDatesRow) {
        stageDatesRow.innerHTML = '';
        const stageLabels = [
          { key: 'processingAt', label: 'بدء التجهيز' },
          { key: 'shippedAt', label: 'تاريخ الشحن' },
          { key: 'deliveredAt', label: 'تاريخ التوصيل' },
          { key: 'cancelledAt', label: 'تاريخ الإلغاء' }
        ];
        let hasAnyStageDate = false;
        if (order.stageDates && typeof order.stageDates === 'object') {
          stageLabels.forEach(({ key, label }) => {
            const formatted = formatArabicDate(order.stageDates[key]);
            if (formatted) {
              hasAnyStageDate = true;
              const chip = document.createElement('div');
              const labelSpan = document.createElement('span');
              labelSpan.textContent = label + ': ';
              const valStrong = document.createElement('strong');
              valStrong.textContent = formatted;
              chip.appendChild(labelSpan);
              chip.appendChild(valStrong);
              stageDatesRow.appendChild(chip);
            }
          });
        }
        stageDatesRow.style.display = hasAnyStageDate ? 'flex' : 'none';
      }

      const status = order.status || 'New';
      stepNew.classList.remove('active');
      stepProcessing.classList.remove('active');
      stepShipped.classList.remove('active');
      stepDelivered.classList.remove('active');

      cancelledBanner.style.display = 'none';
      timelineContainer.style.display = 'block';

      if (status === 'ملغي' || status === 'Cancelled') {
        cancelledBanner.style.display = 'block';
        timelineContainer.style.display = 'none';
      } else {
        const normStatus = getNormalizedStatus(status);
        if (normStatus === 'new') {
          stepNew.classList.add('active');
          timelineProgressBar.style.width = '0%';
        } else if (normStatus === 'processing') {
          stepNew.classList.add('active');
          stepProcessing.classList.add('active');
          timelineProgressBar.style.width = '33%';
        } else if (normStatus === 'shipped') {
          stepNew.classList.add('active');
          stepProcessing.classList.add('active');
          stepShipped.classList.add('active');
          timelineProgressBar.style.width = '66%';
        } else if (normStatus === 'delivered') {
          stepNew.classList.add('active');
          stepProcessing.classList.add('active');
          stepShipped.classList.add('active');
          stepDelivered.classList.add('active');
          timelineProgressBar.style.width = '100%';
        }
      }

      resultsCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function performQuery(code, phone) {
      hideTrackBanner();
      loadingIndicator.style.display = 'inline-block';
      if (submitBtn) submitBtn.disabled = true;
      resultsCard.classList.remove('show');

      const flow = window.DandyOrderFlow;
      let response = null;
      let data = {};
      let networkError = false;

      try {
        response = await fetch('/api/track-order', {
          method: 'POST',
          cache: 'no-store',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            invoiceCode: code,
            phone: phone
          })
        });
        data = await response.json().catch(() => ({}));
      } catch (_) {
        networkError = true;
      } finally {
        loadingIndicator.style.display = 'none';
        if (submitBtn) submitBtn.disabled = false;
      }

      if (!networkError && response && response.ok && data && data.success && data.order) {
        renderOrderResults(data.order);
        saveRecentSearchCodeOnly(data.order.invoiceCode || code);
        return;
      }

      const errorMsg = flow
        ? flow.classifyTrackOrderError({
            status: response ? response.status : 0,
            data,
            networkError
          })
        : (data && data.message) || 'تعذر العثور على الطلب أو بيانات التحقق غير مطابقة.';

      showTrackBanner(errorMsg, false);
    }

    if (trackingForm) {
      trackingForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const code = trackCodeInput.value.trim().toUpperCase();
        const phone = trackPhoneInput.value.trim();

        if (!code || !phone) {
          showTrackBanner('يرجى إدخال كود الفاتورة ورقم الهاتف.', false);
          return;
        }

        performQuery(code, phone);
      });
    }

    drawRecentSearches();

    (function handleInitialUrlParams() {
      const flow = window.DandyOrderFlow;
      const extracted = flow
        ? flow.extractTrackOrderUrlParams(window.location.search)
        : { code: '', phone: '', shouldStripPhone: false, cleanedRelativeSearch: '' };

      if (extracted.shouldStripPhone) {
        try {
          history.replaceState(null, '', window.location.pathname + extracted.cleanedRelativeSearch);
        } catch (_) {}
      }

      if (extracted.code && trackCodeInput) {
        trackCodeInput.value = extracted.code;
      }

      if (extracted.code && extracted.phone && trackCodeInput && trackPhoneInput) {
        trackPhoneInput.value = extracted.phone;
        performQuery(extracted.code, extracted.phone);
      } else if (extracted.code && trackPhoneInput) {
        trackPhoneInput.focus();
      }
    })();
  </script>
</BaseLayout>
