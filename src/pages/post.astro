---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ركن الجمال والمقالات | Dandy"
  description="تصفحي أحدث نصائح العناية بالبشرة والشعر بتركيبات داندي الطبيعية."
  keywords="داندي, مقالات داندي, العناية بالبشرة, جمال طبيعي, العناية بالبشرة مصر"
  canonical="https://dandy-ebon.vercel.app/post"
>
  <slot name="head" slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:title" id="og-title-meta" content="ركن الجمال | Dandy" />
    <meta property="og:description" id="og-desc-meta" content="نصائح وأسرار الجمال الطبيعي للعناية بالبشرة والشعر بتركيبات داندي." />
    <meta property="og:image" id="og-image-meta" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />
    <meta property="og:url" id="og-url-meta" content="https://dandy-ebon.vercel.app/post" />
    <meta name="twitter:card" content="summary_large_image" />

    <style is:global>
      .article-page-wrap {
        padding: 120px 20px 80px;
      }

      .article-reader {
        max-width: 760px;
        margin: 0 auto;
      }

      .article-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: var(--color-muted);
        margin-bottom: 24px;
      }

      .article-breadcrumb a {
        color: var(--color-muted);
        text-decoration: none;
        transition: color 0.2s;
      }

      .article-breadcrumb a:hover {
        color: var(--color-blush);
      }

      .article-header {
        margin-bottom: 32px;
      }

      .article-header h1 {
        font-size: 2.1rem;
        font-weight: 800;
        color: var(--color-primary);
        line-height: 1.35;
        margin: 0 0 16px;
        letter-spacing: -0.02em;
      }

      .article-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 0.85rem;
        color: var(--color-muted);
      }

      .article-hero-media {
        width: 100%;
        max-height: 440px;
        border-radius: var(--border-radius-md);
        overflow: hidden;
        margin-bottom: 36px;
        background: var(--color-surface-soft);
        border: 1px solid var(--border-light);
      }

      .article-hero-media img {
        width: 100%;
        height: 100%;
        max-height: 440px;
        object-fit: cover;
        display: block;
      }

      .article-content {
        font-size: 1.08rem;
        line-height: 1.85;
        color: var(--color-primary);
      }

      .article-content p {
        margin-bottom: 24px;
      }

      .article-content h2 {
        font-size: 1.45rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 40px 0 16px;
        line-height: 1.4;
      }

      .article-content h3 {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-primary);
        margin: 30px 0 12px;
      }

      .article-content blockquote {
        margin: 32px 0;
        padding: 18px 24px;
        border-right: 3px solid var(--color-blush);
        background: var(--color-surface-soft);
        border-radius: 0 8px 8px 0;
        color: var(--color-muted);
        font-style: italic;
        line-height: 1.7;
      }

      .article-content ul,
      .article-content ol {
        margin-right: 24px;
        margin-bottom: 24px;
      }

      .article-content li {
        margin-bottom: 10px;
        line-height: 1.7;
      }

      .article-content img {
        max-width: 100%;
        border-radius: var(--border-radius-md);
        margin: 24px 0;
      }

      /* Related Section */
      .related-articles-section {
        max-width: 1000px;
        margin: 60px auto 0;
        padding-top: 40px;
        border-top: 1px solid var(--border-light);
      }

      .related-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--color-primary);
        margin-bottom: 24px;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
      }

      .related-card {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .related-card:hover {
        border-color: var(--color-blush);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
      }

      .related-card img {
        width: 100%;
        height: 160px;
        object-fit: cover;
      }

      .related-card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      .related-card-body span {
        font-size: 0.78rem;
        color: var(--color-muted);
        margin-bottom: 6px;
      }

      .related-card-body h4 {
        font-size: 0.98rem;
        font-weight: 700;
        color: var(--color-primary);
        line-height: 1.45;
        margin: 0 0 12px;
      }

      .related-card-body .read-link {
        margin-top: auto;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--color-blush);
      }

      @media (max-width: 640px) {
        .article-page-wrap {
          padding-top: 100px;
        }
        .article-header h1 {
          font-size: 1.6rem;
        }
      }
    </style>
  </slot>

  <div class="article-page-wrap container" dir="rtl">
    <main class="article-reader">
      <nav class="article-breadcrumb" aria-label="مسار المقال">
        <a href="/"><i class="fas fa-home"></i> الرئيسية</a>
        <span>/</span>
        <a href="/blog">المدونة</a>
        <span>/</span>
        <span id="breadcrumbCurrent">المقال</span>
      </nav>

      <article id="postArticleArea">
        <header class="article-header">
          <h1 id="postTitle">جاري تحميل المقال...</h1>
          <div class="article-meta">
            <span id="postDate"></span>
          </div>
        </header>

        <div class="article-hero-media" id="postImageWrapper" style="display:none;">
          <img loading="lazy" id="postImage" src="" alt="غلاف المقال" />
        </div>

        <div class="article-content" id="postContent">
          <p style="color:var(--color-muted);">جاري تجهيز نص المقال...</p>
        </div>
      </article>
    </main>

    <!-- Related Articles -->
    <section class="related-articles-section">
      <h3 class="related-title">مقالات مقترحة</h3>
      <div class="related-grid" id="suggestedContainer">
        <p style="color: var(--color-muted); font-size: 0.9rem;">جاري تحميل المقالات المقترحة...</p>
      </div>
    </section>
  </div>

  <script is:inline>
    const db = window.firestore || (window.firebase && firebase.firestore ? firebase.firestore() : null);

    function formatArticleDate(data) {
      if (data.createdAt && typeof data.createdAt.toDate === 'function') {
        try {
          return data.createdAt.toDate().toLocaleDateString('ar-EG', {year:'numeric', month:'long', day:'numeric'});
        } catch (e) {}
      }
      if (data.date) return data.date;
      return '';
    }

    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const isSlugRoute = pathParts[0] === 'blog' && pathParts[1];
    const slugFromPath = isSlugRoute ? decodeURIComponent(pathParts[1]) : null;

    const urlParams = new URLSearchParams(window.location.search);
    let postId = urlParams.get("id");
    let slugParam = urlParams.get("slug");
    let targetSlug = slugFromPath || slugParam;

    let articleDoc = null;

    async function loadPost() {
      try {
        if (!db) {
          showNotFound();
          return;
        }

        const timeoutPromise = (ms) => new Promise((_, reject) => setTimeout(() => reject(new Error('Firestore timeout')), ms));

        if (targetSlug) {
          const queryPromise = db.collection('articles').where('slug', '==', targetSlug).limit(1).get();
          const query = await Promise.race([queryPromise, timeoutPromise(4000)]);
          if (!query.empty) articleDoc = query.docs[0];
        }

        if (!articleDoc && postId) {
          const docPromise = db.collection('articles').doc(postId).get();
          const doc = await Promise.race([docPromise, timeoutPromise(4000)]);
          if (doc.exists) articleDoc = doc;
        }

        if (!articleDoc || !articleDoc.exists) {
          showNotFound();
          return;
        }
        
        postId = articleDoc.id;
        const data = articleDoc.data();
        const pImg = document.getElementById('postImage');
        const pImgWrap = document.getElementById('postImageWrapper');
        const pTitle = document.getElementById('postTitle');
        const pDate = document.getElementById('postDate');
        const pContent = document.getElementById('postContent');
        const bc = document.getElementById('breadcrumbCurrent');

        const dateStr = formatArticleDate(data);
        if (data.image && pImg && pImgWrap) {
          pImg.src = data.image;
          pImgWrap.style.display = 'block';
        }
        if (pTitle) pTitle.textContent = data.title || '';
        if (bc) bc.textContent = data.title || 'المقال';
        if (pDate) pDate.textContent = dateStr || '';
        if (pContent) pContent.innerHTML = data.content || '';

        document.title = data.title ? `${data.title} | مدونة داندي` : 'عرض المقال | داندي';

        const cleanDesc = (data.content || "نصائح العناية بالبشرة والشعر من داندي.").replace(/<[^>]*>/g, '').substring(0, 155).trim() + "...";
        const cleanImg = data.image || 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=1200&q=80';

        const updateMeta = (selector, attr, val) => {
          try {
            let m = document.querySelector(selector);
            if (m) m.setAttribute(attr, val || '');
          } catch(e) {}
        };

        updateMeta('meta[name="description"]', 'content', cleanDesc);
        updateMeta('#og-title-meta', 'content', data.title);
        updateMeta('#og-desc-meta', 'content', cleanDesc);
        updateMeta('#og-image-meta', 'content', cleanImg);
        updateMeta('#og-url-meta', 'content', window.location.href);

      } catch(e) {
        console.error(e);
      }
    }

    function showNotFound() {
      const area = document.getElementById('postArticleArea');
      if (area) {
        area.innerHTML = `
          <div style="text-align:center; padding:50px 20px; border: 1px dashed var(--border-light); border-radius: var(--border-radius-md);">
            <i class="far fa-file-alt" style="font-size:2.5rem; color:var(--color-muted); margin-bottom:12px; opacity:0.6;"></i>
            <h2 style="font-size:1.3rem; margin-bottom:10px; color:var(--color-primary);">المقال غير موجود أو تم نقله</h2>
            <a href="/blog" class="cta-btn" style="border-radius:99px; padding:10px 20px; font-size:0.88rem; display:inline-block; margin-top:12px;">العودة للمدونة</a>
          </div>
        `;
      }
    }

    async function loadSuggested() {
      const container = document.getElementById('suggestedContainer');
      if (!container) return;
      
      try {
        if (!db) {
          container.innerHTML = '<p style="color:var(--color-muted); font-size:0.88rem;">لا توجد مقالات مقترحة حالياً.</p>';
          return;
        }

        const fetchPromise = db.collection('articles').orderBy('createdAt', 'desc').limit(4).get();
        const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('Firestore timeout')), 4000));
        const snapshot = await Promise.race([fetchPromise, timeoutPromise]);
        let matchCount = 0;

        container.innerHTML = '';

        snapshot.forEach(doc => {
          if (doc.id === postId) return;
          const d = doc.data();
          if (d.status === 'draft') return;
          matchCount++;
          
          const img = d.image ? d.image : 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=400&q=80';
          const title = d.title || 'بدون عنوان';
          const dateText = formatArticleDate(d);
          const postLink = d.slug ? `/post?slug=${encodeURIComponent(d.slug)}` : `/post?id=${doc.id}`;

          const cardEl = document.createElement('a');
          cardEl.href = postLink;
          cardEl.className = 'related-card';
          cardEl.innerHTML = `
            <img loading="lazy" src="${img}" alt="${title}" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=400&q=80';">
            <div class="related-card-body">
              ${dateText ? `<span>${dateText}</span>` : ''}
              <h4>${title}</h4>
              <span class="read-link">اقرئي المقال ←</span>
            </div>
          `;
          container.appendChild(cardEl);
        });

        if (matchCount === 0) {
          container.innerHTML = '<p style="color:var(--color-muted); font-size:0.88rem;">لا توجد مقالات مقترحة حالياً.</p>';
        }

      } catch(err) {
        container.innerHTML = '<p style="color:var(--color-muted); font-size:0.88rem;">تعذر تحميل المقترحات.</p>';
      }
    }

    async function init() {
      await loadPost();
      loadSuggested();
    }
    init();
  </script>
</BaseLayout>

