---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { getArticleById, getArticleBySlug, type Article } from '../utils/articles';

const idParam = Astro.url.searchParams.get('id');
const slugParam = Astro.url.searchParams.get('slug');

const cleanId = typeof idParam === 'string' ? idParam.trim() : '';
const cleanSlug = typeof slugParam === 'string' ? slugParam.trim() : '';

let article: Article | null = null;

if (cleanId) {
  article = await getArticleById(cleanId);
} else if (cleanSlug) {
  article = await getArticleBySlug(cleanSlug);
}

if (article && article.status === 'published' && article.slug && typeof article.slug === 'string' && article.slug.trim()) {
  const canonicalSlug = article.slug.trim();
  return Astro.redirect(`/blog/${canonicalSlug}`, 301);
}

Astro.response.status = 404;

const pageTitle = 'المقال غير موجود (404) | Dandy';
const pageDescription = 'عذراً، المقال الذي تبحثين عنه غير متوفر أو تم نقله.';
const canonicalUrl = 'https://dandy-ebon.vercel.app/404';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  robots="noindex, follow"
>
  <main class="dandy-error-wrap dandy-container" data-dandy-motion="calm">
    <div class="dandy-error-code" data-dandy-entrance="0">404</div>
    <h1 class="dandy-font-ar-display" data-dandy-entrance="1">عذراً، هذا المقال غير موجود</h1>
    <p data-dandy-entrance="2">قد يكون الرابط غير صحيح أو تم نقل المقال إلى مسار جديد في مدونة داندي.</p>
    <div class="dandy-error-actions" data-dandy-entrance="3">
      <a href="/blog" class="dandy-btn dandy-btn--editorial">
        <Icon name="book-open" size={16} strokeWidth={1.85} />
        <span>تصفح المدونة</span>
      </a>
      <a href="/" class="dandy-btn dandy-btn--outline">
        <Icon name="home" size={16} strokeWidth={1.85} />
        <span>الصفحة الرئيسية</span>
      </a>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .dandy-error-wrap {
    min-height: 68vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: 72px 88px;
    max-width: 560px;
  }

  .dandy-error-code {
    font-family: var(--dandy-font-en-display);
    font-size: clamp(4rem, 10vw, 6rem);
    font-weight: 700;
    color: var(--dandy-border-default);
    line-height: 1;
    margin-bottom: 12px;
  }

  .dandy-error-wrap h1 {
    margin: 0 0 10px;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    color: var(--dandy-ink-primary);
  }

  .dandy-error-wrap p {
    margin: 0 0 28px;
    font-size: var(--dandy-text-base);
    line-height: 1.72;
    color: var(--dandy-ink-secondary);
  }

  .dandy-error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
