---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticleById, getArticleBySlug, type Article } from '../utils/articles';

const idParam = Astro.url.searchParams.get('id');
const slugParam = Astro.url.searchParams.get('slug');

const cleanId = typeof idParam === 'string' ? idParam.trim() : '';
const cleanSlug = typeof slugParam === 'string' ? slugParam.trim() : '';

let article: Article | null = null;

// Case A & Deterministic Precedence: Document ID takes precedence as the immutable database primary key
if (cleanId) {
  article = await getArticleById(cleanId);
} else if (cleanSlug) {
  // Case B: Slug parameter
  article = await getArticleBySlug(cleanSlug);
}

// Validate published status and presence of canonical slug before redirecting
if (article && article.status === 'published' && article.slug && typeof article.slug === 'string' && article.slug.trim()) {
  const canonicalSlug = article.slug.trim();
  // Case A & B: Redirect with HTTP 301 to the stored canonical slug route
  return Astro.redirect(`/blog/${canonicalSlug}`, 301);
}

// Case C & D: Missing, invalid, unpublished, or no query params -> Return 404 Not Found
Astro.response.status = 404;

const pageTitle = 'المقال غير موجود (404) | Dandy';
const pageDescription = 'عذراً، المقال الذي تبحثين عنه غير متوفر أو تم نقله.';
const canonicalUrl = 'https://dandy-ebon.vercel.app/404';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  robots="noindex, follow"
>
  <slot name="head" slot="head">
    <style is:global>
      .error-page-wrap {
        min-height: 65vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 140px 20px 80px;
        max-width: 540px;
        margin: 0 auto;
      }
      .error-code {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 4.5rem;
        font-weight: 800;
        color: var(--border-medium);
        line-height: 1;
        margin-bottom: 12px;
      }
      .error-page-wrap h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 0 0 10px;
      }
      .error-page-wrap p {
        font-size: 0.95rem;
        color: var(--color-muted);
        line-height: 1.6;
        margin: 0 0 28px;
      }
      .error-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .error-btn-primary {
        background: var(--color-primary);
        color: #fff;
        padding: 11px 22px;
        border-radius: var(--border-radius-sm);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 700;
        transition: opacity 0.2s;
      }
      .error-btn-primary:hover {
        opacity: 0.9;
      }
      .error-btn-secondary {
        background: var(--color-surface-soft);
        color: var(--color-primary);
        border: 1px solid var(--border-light);
        padding: 11px 22px;
        border-radius: var(--border-radius-sm);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 700;
        transition: background 0.2s;
      }
      .error-btn-secondary:hover {
        background: var(--border-light);
      }
    </style>
  </slot>

  <div class="error-page-wrap container" dir="rtl">
    <div class="error-code">404</div>
    <h1>عذراً، هذا المقال غير موجود</h1>
    <p>قد يكون الرابط غير صحيح أو تم نقل المقال إلى مسار جديد في مدونة داندي.</p>
    <div class="error-actions">
      <a href="/blog" class="error-btn-primary"><i class="fas fa-book-open"></i> تصفح المدونة</a>
      <a href="/" class="error-btn-secondary"><i class="fas fa-home"></i> الصفحة الرئيسية</a>
    </div>
  </div>
</BaseLayout>
