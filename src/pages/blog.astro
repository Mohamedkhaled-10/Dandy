---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllArticles, type Article } from '../utils/articles';

// Fetch all published articles server-side via centralized article utility
let articles: Article[] = [];
try {
  articles = await getAllArticles();
} catch (err) {
  articles = [];
}

// Fallback helper for article excerpt if empty
function getArticleExcerpt(article: Article): string {
  if (article.excerpt && article.excerpt.trim()) {
    return article.excerpt.trim();
  }
  if (article.content) {
    const plainText = article.content.replace(/<[^>]+>/g, '').trim();
    return plainText.length > 160 ? plainText.substring(0, 160) + '...' : plainText;
  }
  return '';
}

// Format date consistently with Arabic locale
function formatArticleDate(article: Article): string {
  if (article.date) {
    return article.date;
  }
  if (article.createdAt) {
    try {
      const d = new Date(article.createdAt);
      return d.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
    } catch (e) {
      return '';
    }
  }
  return '';
}
---

<BaseLayout
  title="مدونة داندي للعناية | أسرار ونصائح الجمال الطبيعي"
  description="تصفحي مدونة داندي واكتشفي أسرار العناية بالبشرة والشعر والروتين الصحي بتركيبات طبيعية."
  keywords="مدونة داندي بيوتي، العناية بالبشرة، العناية بالشعر، خلطات تجميلية طبيعية، روتين صحي للبشرة مصر"
  canonical="https://dandy-ebon.vercel.app/blog"
>
  <slot name="head" slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dandy-ebon.vercel.app/blog" />
    <meta property="og:title" content="مدونة داندي للعناية | أسرار ونصائح الجمال الطبيعي" />
    <meta property="og:description" content="تصفحي مدونة داندي واكتشفي أسرار العناية بالبشرة والشعر والروتين الصحي." />
    <meta property="og:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <style is:global>
      .blog-page-header {
        padding: 120px 20px 32px;
        text-align: right;
        max-width: 1200px;
        margin: 0 auto;
      }

      .blog-page-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 0 0 8px 0;
        letter-spacing: -0.02em;
      }

      .blog-page-header p {
        font-size: 0.95rem;
        color: var(--color-muted);
        margin: 0;
        max-width: 600px;
        line-height: 1.6;
      }

      .blog-section {
        padding: 10px 0 80px;
      }

      .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 28px;
      }

      /* Editorial Blog Card */
      .blog-card {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
        text-decoration: none;
      }

      .blog-card:hover {
        border-color: var(--color-soft-blossom-400, #efa2c4);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
        transform: translateY(-2px);
      }

      .blog-thumb {
        width: 100%;
        height: 220px;
        overflow: hidden;
        background: var(--color-surface-soft);
        position: relative;
        display: block;
      }

      .blog-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }

      .blog-card:hover .blog-thumb img {
        transform: scale(1.03);
      }

      .blog-card-body {
        padding: 22px;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      .blog-card-body .meta-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 0.8rem;
        color: var(--color-muted);
      }

      .blog-card-body .category-tag {
        background: var(--color-surface-soft);
        color: var(--color-primary);
        border: 1px solid var(--border-light);
        padding: 3px 10px;
        font-weight: 700;
        font-size: 0.78rem;
        border-radius: 99px;
      }

      .blog-card-body h2 {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 0 0 10px;
        line-height: 1.45;
      }

      .blog-card-body p {
        font-size: 0.88rem;
        color: var(--color-muted);
        line-height: 1.6;
        margin: 0 0 18px;
        height: 66px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
      }

      .blog-card-body .read-more-btn {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-rose-kiss-500, #fe5d9f);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.88rem;
        transition: color 0.2s, gap 0.2s;
      }

      .blog-card-body .read-more-btn:hover {
        color: var(--color-primary);
        gap: 9px;
      }

      .blog-empty-state {
        text-align: center;
        grid-column: 1 / -1;
        padding: 60px 20px;
        color: var(--color-muted);
        background: var(--color-surface);
        border: 1px dashed var(--border-light);
        border-radius: var(--border-radius-md);
      }

      .blog-empty-state i {
        font-size: 2.5rem;
        margin-bottom: 12px;
        color: var(--color-muted);
        opacity: 0.6;
      }

      @media (max-width: 640px) {
        .blog-page-header {
          padding-top: 100px;
        }
        .blog-grid {
          grid-template-columns: 1fr;
          gap: 20px;
        }
      }
    </style>
  </slot>

  <!-- Editorial Blog Header -->
  <header class="blog-page-header" dir="rtl">
    <h1>مدونة داندي</h1>
    <p>دليلكِ الشامل للعناية اليومية بالبشرة والشعر، مع نصائح تركيبات طبيعية متوازنة.</p>
  </header>

  <!-- Blog Listings (Server-Side Rendered) -->
  <main class="blog-section container" dir="rtl">
    <div class="blog-grid" id="blogContainer">
      {articles.length > 0 ? (
        articles.map((item) => {
          const canonicalLink = `/blog/${encodeURIComponent(item.slug)}`;
          const imgUrl = item.image || 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=600&q=80';
          const title = item.title || 'عنوان غير متوفر';
          const dateText = formatArticleDate(item);
          const excerptText = getArticleExcerpt(item);
          const category = item.category || 'العناية بالبشرة';

          return (
            <article class="blog-card">
              <a href={canonicalLink} class="blog-thumb" aria-label={title}>
                <img
                  src={imgUrl}
                  alt={title}
                  loading="lazy"
                />
              </a>
              <div class="blog-card-body">
                <div class="meta-row">
                  <span class="category-tag">{category}</span>
                  {dateText && <span>{dateText}</span>}
                </div>
                <h2>
                  <a href={canonicalLink} style="color:inherit; text-decoration:none;">
                    {title}
                  </a>
                </h2>
                <p>{excerptText}</p>
                <a href={canonicalLink} class="read-more-btn">
                  اقرئي المقال <i class="fas fa-arrow-left"></i>
                </a>
              </div>
            </article>
          );
        })
      ) : (
        <div class="blog-empty-state">
          <i class="far fa-newspaper"></i>
          <p>لا توجد مقالات منشورة حالياً بالمدونة.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
