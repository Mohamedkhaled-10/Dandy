---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="مدونة داندي للعناية | أسرار ونصائح الجمال الطبيعي"
  description="تصفحي مدونة داندي واكتشفي أسرار العناية بالبشرة والشعر والروتين الصحي بتركيبات طبيعية."
  keywords="مدونة داندي بيوتي، العناية بالبشرة، العناية بالشعر، خلطات تجميلية طبيعية، روتين صحي للبشرة مصر"
  canonical="https://dandy-ebon.vercel.app/blog"
>
  <slot name="head" slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dandy-ebon.vercel.app/blog" />
    <meta property="og:title" content="مدونة داندي للعناية | أسرار ونصائح الجمال الطبيعي" />
    <meta property="og:description" content="تصفحي مدونة داندي واكتشفي أسرار العناية بالبشرة والشعر والروتين الصحي." />
    <meta property="og:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <style is:global>
      .blog-page-header {
        padding: 120px 20px 32px;
        text-align: right;
        max-width: 1200px;
        margin: 0 auto;
      }

      .blog-page-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 0 0 8px 0;
        letter-spacing: -0.02em;
      }

      .blog-page-header p {
        font-size: 0.95rem;
        color: var(--color-muted);
        margin: 0;
        max-width: 600px;
        line-height: 1.6;
      }

      .blog-section {
        padding: 10px 0 80px;
      }

      .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 28px;
      }

      /* Editorial Blog Card */
      .blog-card {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
        text-decoration: none;
      }

      .blog-card:hover {
        border-color: var(--color-blush);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
        transform: translateY(-2px);
      }

      .blog-thumb {
        width: 100%;
        height: 220px;
        overflow: hidden;
        background: var(--color-surface-soft);
        position: relative;
      }

      .blog-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }

      .blog-card:hover .blog-thumb img {
        transform: scale(1.03);
      }

      .blog-card-body {
        padding: 22px;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      .blog-card-body .meta-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 0.8rem;
        color: var(--color-muted);
      }

      .blog-card-body .category-tag {
        background: var(--color-surface-soft);
        color: var(--color-primary);
        border: 1px solid var(--border-light);
        padding: 3px 10px;
        font-weight: 700;
        font-size: 0.78rem;
        border-radius: 99px;
      }

      .blog-card-body h2 {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 0 0 10px;
        line-height: 1.45;
      }

      .blog-card-body p {
        font-size: 0.88rem;
        color: var(--color-muted);
        line-height: 1.6;
        margin: 0 0 18px;
        height: 66px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
      }

      .blog-card-body .read-more-btn {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-blush);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.88rem;
        transition: color 0.2s, gap 0.2s;
      }

      .blog-card-body .read-more-btn:hover {
        color: var(--color-primary);
        gap: 9px;
      }

      .blog-empty-state {
        text-align: center;
        grid-column: 1 / -1;
        padding: 60px 20px;
        color: var(--color-muted);
        background: var(--color-surface);
        border: 1px dashed var(--border-light);
        border-radius: var(--border-radius-md);
      }

      .blog-empty-state i {
        font-size: 2.5rem;
        margin-bottom: 12px;
        color: var(--color-muted);
        opacity: 0.6;
      }

      @media (max-width: 640px) {
        .blog-page-header {
          padding-top: 100px;
        }
        .blog-grid {
          grid-template-columns: 1fr;
          gap: 20px;
        }
      }
    </style>
  </slot>

  <!-- Editorial Blog Header -->
  <header class="blog-page-header" dir="rtl">
    <h1>مدونة داندي</h1>
    <p>دليلكِ الشامل للعناية اليومية بالبشرة والشعر، مع نصائح تركيبات طبيعية متوازنة.</p>
  </header>

  <!-- Blog Listings -->
  <main class="blog-section container" dir="rtl">
    <div class="blog-grid" id="blogContainer">
      <p style="text-align: center; grid-column:1/-1; color:var(--color-muted); padding: 40px 0;">جاري تحميل المقالات...</p>
    </div>
  </main>

  <script is:inline>
    const db = window.firestore || (window.firebase && firebase.firestore ? firebase.firestore() : null);

    function formatArticleDate(data) {
      if (data.createdAt && typeof data.createdAt.toDate === 'function') {
        try {
          return data.createdAt.toDate().toLocaleDateString('ar-EG', {year:'numeric', month:'long', day:'numeric'});
        } catch (e) {}
      }
      if (data.date) return data.date;
      return '';
    }

    async function loadArticles() {
      const container = document.getElementById('blogContainer');
      if (!container) return;
      
      try {
        if (!db) {
          container.innerHTML = '<div class="blog-empty-state"><i class="far fa-newspaper"></i><p>لا توجد مقالات منشورة حالياً بالمدونة.</p></div>';
          return;
        }

        const fetchPromise = db.collection('articles').orderBy('createdAt', 'desc').get();
        const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('Firestore timeout')), 4000));
        const snapshot = await Promise.race([fetchPromise, timeoutPromise]);

        if (snapshot.empty) {
          container.innerHTML = '<div class="blog-empty-state"><i class="far fa-newspaper"></i><p>لا توجد مقالات منشورة حالياً بالمدونة.</p></div>';
          return;
        }

        container.innerHTML = '';
        let visibleCount = 0;

        snapshot.forEach(doc => {
          const data = doc.data();
          if (data.status === 'draft') return;
          visibleCount++;

          const img = data.image ? data.image : 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=600&q=80';
          const title = data.title ? data.title : 'عنوان غير متوفر';
          const dateText = formatArticleDate(data);
          const excerpt = data.excerpt ? data.excerpt : (data.content ? (data.content.replace(/<[^>]+>/g,'').substring(0, 160) + '...') : '');
          const category = data.category ? data.category : 'العناية بالبشرة';

          const postLink = data.slug
            ? `/post?slug=${encodeURIComponent(data.slug)}`
            : `/post?id=${doc.id}`;

          const card = document.createElement('article');
          card.className = 'blog-card';
          card.innerHTML = `
            <a href="${postLink}" class="blog-thumb" aria-label="${title}">
              <img src="${img}" alt="${title}" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=400&q=80';">
            </a>
            <div class="blog-card-body">
              <div class="meta-row">
                <span class="category-tag">${category}</span>
                ${dateText ? `<span>${dateText}</span>` : ''}
              </div>
              <h2><a href="${postLink}" style="color:inherit; text-decoration:none;">${title}</a></h2>
              <p>${excerpt}</p>
              <a href="${postLink}" class="read-more-btn">
                اقرئي المقال <i class="fas fa-arrow-left"></i>
              </a>
            </div>
          `;
          container.appendChild(card);
        });

        if (visibleCount === 0) {
          container.innerHTML = '<div class="blog-empty-state"><i class="far fa-newspaper"></i><p>لا توجد مقالات منشورة حالياً بالمدونة.</p></div>';
        }

      } catch(err) {
        container.innerHTML = '<div class="blog-empty-state"><p>تعذر تحميل المقالات حالياً. يرجى المحاولة مرة أخرى لاحقاً.</p></div>';
      }
    }

    loadArticles();
  </script>
</BaseLayout>

