---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="تواصل معنا | Dandy Cosmetics - خدمة العملاء والاستفسارات"
  description="تواصلي مع فريق خدمة عملاء داندي (Dandy Cosmetics) عبر الواتساب ومنصات التواصل الاجتماعي للاستفسار عن المنتجات، الشحن، والطلبات الخاصة."
  keywords="تواصل مع داندي, خدمة عملاء داندي, واتساب داندي, Dandy contact, Contact Dandy Cosmetics Cairo"
  canonical="https://dandy-ebon.vercel.app/contact-us"
>
  <slot name="head" slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dandy-ebon.vercel.app/contact-us" />
    <meta property="og:title" content="تواصل معنا | Dandy Cosmetics" />
    <meta property="og:description" content="تواصلي مع فريق خدمة عملاء داندي عبر الواتساب ومنصات التواصل الاجتماعي." />
    <meta property="og:image" content="https://i.postimg.cc/0yKZhwzg/601405410-122174066234434656-1527373666969709188-n.jpg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="تواصل معنا | Dandy Cosmetics" />
    <meta name="twitter:description" content="خدمة عملاء واستفسارات منتجات داندي لمستحضرات التجميل والعناية الطبيعية." />
    <meta name="twitter:image" content="https://i.postimg.cc/0yKZhwzg/601405410-122174066234434656-1527373666969709188-n.jpg" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "name": "تواصل معنا | Dandy Cosmetics",
        "description": "قنوات التواصل الرسمية لمتجر داندي لمستحضرات التجميل والعناية بالبشرة والشعر.",
        "url": "https://dandy-ebon.vercel.app/contact-us",
        "mainEntity": {
          "@type": "Organization",
          "name": "Dandy Cosmetics",
          "telephone": "+201038941005",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Nasr City",
            "addressRegion": "Cairo",
            "addressCountry": "EG"
          },
          "sameAs": [
            "https://www.instagram.com/dandy_skincare_cosmotics",
            "https://www.facebook.com/profile.php?id=61563039704396"
          ]
        }
      }
    </script>

    <style is:global>
      .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        margin-top: 40px;
      }

      .contact-card {
        background: #fff;
        border: 1px solid var(--border-light, #e8dfd8);
        border-radius: var(--border-radius-lg, 16px);
        padding: 32px;
        box-shadow: var(--shadow-sm, 0 4px 15px rgba(0,0,0,0.03));
        transition: var(--transition-smooth, all 0.3s ease);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .contact-card:hover {
        box-shadow: var(--shadow-md, 0 8px 25px rgba(0,0,0,0.07));
        border-color: var(--color-blush, #DB2777);
        transform: translateY(-2px);
      }

      .contact-card-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 18px;
      }

      .contact-icon-circle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
      }

      .contact-icon-wa {
        background: #e8f7ee;
        color: #25D366;
      }

      .contact-icon-ig {
        background: #fdf0f4;
        color: #E1306C;
      }

      .contact-icon-fb {
        background: #edf2fc;
        color: #1877F2;
      }

      .contact-icon-loc {
        background: #fdf5ea;
        color: var(--color-gold, #c5a059);
      }

      .contact-title {
        font-family: 'Cairo', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-primary, #2b2b2b);
        margin: 0;
      }

      .contact-subtitle {
        font-size: 0.88rem;
        color: var(--color-muted, #777);
        margin-top: 2px;
      }

      .contact-desc {
        font-size: 0.98rem;
        line-height: 1.7;
        color: var(--color-text, #444);
        margin-bottom: 24px;
      }

      .contact-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 24px;
        border-radius: 99px;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: var(--transition-fast, all 0.2s ease);
        width: 100%;
        box-sizing: border-box;
      }

      .contact-btn-wa {
        background: #25D366;
        color: #fff;
      }
      .contact-btn-wa:hover {
        background: #1eb956;
        color: #fff;
      }

      .contact-btn-ig {
        background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
        color: #fff;
      }
      .contact-btn-ig:hover {
        opacity: 0.92;
        color: #fff;
      }

      .contact-btn-fb {
        background: #1877F2;
        color: #fff;
      }
      .contact-btn-fb:hover {
        background: #1464cc;
        color: #fff;
      }

      .contact-hours-box {
        background: var(--color-gold-cream, #fcf9f5);
        border: 1px solid var(--border-light, #e8dfd8);
        border-radius: var(--border-radius-lg, 16px);
        padding: 28px;
        margin-top: 36px;
        text-align: center;
      }

      @media (max-width: 768px) {
        .contact-grid {
          grid-template-columns: 1fr;
          gap: 20px;
        }
        .contact-card {
          padding: 24px;
        }
      }
    </style>
  </slot>

  <!-- Contact Us Main Section -->
  <main class="container" style="padding-top: 140px; padding-bottom: 80px;">
    <div class="section-header" style="text-align: center; margin-bottom: 30px;">
      <span class="sub" style="font-family:'Space Grotesk', sans-serif; letter-spacing:0.15em; text-transform:uppercase; color:var(--color-gold); font-weight:700; font-size:0.85rem; display:block; margin-bottom:8px;">Customer Care & Support</span>
      <h1 style="font-family:'Cairo', sans-serif; font-size:2.2rem; font-weight:800; color:var(--color-primary); margin:0 0 12px 0;">تواصل مع داندي</h1>
      <p style="color:var(--color-muted); max-width:600px; margin:0 auto; font-size:1.05rem; line-height:1.7;">
        يسعدنا دائماً استقبال استفساراتكِ، ملاحظاتكِ، وطلباتكِ الخاصة. فريق داندي جاهز لمساعدتكِ وتقديم الاستشارات المناسبة لجمالكِ الطبيعي.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="contact-grid">
      <!-- WhatsApp Card -->
      <div class="contact-card">
        <div>
          <div class="contact-card-header">
            <div class="contact-icon-circle contact-icon-wa">
              <i class="fab fa-whatsapp"></i>
            </div>
            <div>
              <h2 class="contact-title">محادثة واتساب الفورية</h2>
              <div class="contact-subtitle">+20 103 894 1005</div>
            </div>
          </div>
          <p class="contact-desc">
            تواصلي مباشرة مع خدمة العملاء عبر الواتساب للاستفسار السريع عن المنتجات، توفر العطور، متابعة الشحن، أو تقديم طلب مخصص.
          </p>
        </div>
        <a href="https://wa.me/201038941005" target="_blank" class="contact-btn contact-btn-wa" aria-label="تواصل عبر الواتساب">
          <i class="fab fa-whatsapp" style="font-size:1.2rem;"></i> محادثة عبر واتساب الآن
        </a>
      </div>

      <!-- Instagram Card -->
      <div class="contact-card">
        <div>
          <div class="contact-card-header">
            <div class="contact-icon-circle contact-icon-ig">
              <i class="fab fa-instagram"></i>
            </div>
            <div>
              <h2 class="contact-title">إنستجرام داندي</h2>
              <div class="contact-subtitle">@dandy_skincare_cosmotics</div>
            </div>
          </div>
          <p class="contact-desc">
            تابعي جديد إطلالات وتجارب منتجاتنا الطبيعية، وتواصلي معنا عبر الرسائل المباشرة (DM) للاستشارات الجمالية اليومية.
          </p>
        </div>
        <a href="https://www.instagram.com/dandy_skincare_cosmotics" target="_blank" class="contact-btn contact-btn-ig" aria-label="متابعة على إنستجرام">
          <i class="fab fa-instagram" style="font-size:1.2rem;"></i> زيارة صفحة إنستجرام
        </a>
      </div>

      <!-- Facebook Card -->
      <div class="contact-card">
        <div>
          <div class="contact-card-header">
            <div class="contact-icon-circle contact-icon-fb">
              <i class="fab fa-facebook-f"></i>
            </div>
            <div>
              <h2 class="contact-title">صفحة فيسبوك الرسمية</h2>
              <div class="contact-subtitle">Dandy Cosmetics</div>
            </div>
          </div>
          <p class="contact-desc">
            انضمي لمجتمع داندي على فيسبوك، واقرئي تجارب العملاء وتقييمات المنتجات، وتواصلي مع فريق الدعم عبر مسنجر في أي وقت.
          </p>
        </div>
        <a href="https://www.facebook.com/profile.php?id=61563039704396" target="_blank" class="contact-btn contact-btn-fb" aria-label="زيارة صفحة فيسبوك">
          <i class="fab fa-facebook-f" style="font-size:1.1rem;"></i> زيارة صفحة فيسبوك
        </a>
      </div>

      <!-- Location & Headquarters Card -->
      <div class="contact-card">
        <div>
          <div class="contact-card-header">
            <div class="contact-icon-circle contact-icon-loc">
              <i class="fas fa-map-marked-alt"></i>
            </div>
            <div>
              <h2 class="contact-title">المقر الرئيسي والشحن</h2>
              <div class="contact-subtitle">مدينة نصر، القاهرة، مصر</div>
            </div>
          </div>
          <p class="contact-desc">
            نخدم جميع محافظات جمهورية مصر العربية من خلال شبكة شحن سريعة وموثوقة تضمن وصول مستحضراتكِ بحالتها المثالية والنقية.
          </p>
        </div>
        <a href="/all-products" class="contact-btn" style="background:var(--color-primary, #2b2b2b); color:#fff;" aria-label="تصفح المنتجات">
          <i class="fas fa-sparkles"></i> تصفحي مجموعاتنا الطبيعية
        </a>
      </div>
    </div>

    <!-- Working Hours and Quick Info -->
    <div class="contact-hours-box">
      <h3 style="font-family:'Cairo', sans-serif; font-size:1.2rem; color:var(--color-primary); margin:0 0 8px 0;">
        <i class="fas fa-clock" style="color:var(--color-gold); margin-left:6px;"></i> مواعيد خدمة العملاء والرد على الاستفسارات
      </h3>
      <p style="color:var(--color-muted); margin:0; font-size:0.95rem; line-height:1.6;">
        فريقنا متاح للرد على رسائل الواتساب ومنصات التواصل طوال أيام الأسبوع من الساعة <strong>10:00 صباحاً</strong> حتى <strong>10:00 مساءً</strong> بتوقيت القاهرة.
      </p>
    </div>
  </main>
</BaseLayout>
