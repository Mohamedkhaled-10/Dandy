---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticleBySlug, getAllArticles, type Article } from '../../utils/articles';

const { slug } = Astro.params;
const rawSlug = typeof slug === 'string' ? slug.trim() : '';

// Resolve article by canonical permanent slug via centralized utility
const article: Article | null = rawSlug ? await getArticleBySlug(rawSlug) : null;

if (!article) {
  Astro.response.status = 404;
}

// Format dates and SEO metadata
const pageTitle = article ? `${article.title} | داندي` : 'المقال غير موجود (404) | Dandy';
const pageDescription = article?.excerpt || (article ? `اقرأي مقال: ${article.title} على مدونة داندي.` : 'عذراً، المقال الذي تبحثين عنه غير متوفر حالياً.');
const canonicalUrl = article ? `https://dandy-ebon.vercel.app/blog/${article.slug}` : 'https://dandy-ebon.vercel.app/404';
const robots = article ? 'index, follow' : 'noindex, follow';

// Fetch related articles for server rendering (excluding current article)
let relatedArticles: Article[] = [];
if (article) {
  try {
    const all = await getAllArticles();
    relatedArticles = all.filter(a => a.id !== article.id).slice(0, 3);
  } catch (e) {
    relatedArticles = [];
  }
}

// Genuine timestamps without any synthetic/fake data
const isoPublished = article?.createdAt ? new Date(article.createdAt).toISOString() : undefined;
const isoModified = article?.updatedAt ? new Date(article.updatedAt).toISOString() : isoPublished;

// Display date string
const displayDate = article?.date || (isoPublished ? new Date(isoPublished).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' }) : '');

// Schema.org BlogPosting — Strictly genuine data (no fake authors, no fake review/ratings)
const blogPostingSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalUrl
  },
  'headline': article.title,
  'description': article.excerpt || article.title,
  'image': article.image ? [article.image] : undefined,
  ...(isoPublished ? { 'datePublished': isoPublished } : {}),
  ...(isoModified ? { 'dateModified': isoModified } : {}),
  'publisher': {
    '@type': 'Organization',
    'name': 'Dandy Cosmetics',
    'url': 'https://dandy-ebon.vercel.app/',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg'
    }
  },
  'articleSection': article.category
} : null;

// Schema.org BreadcrumbList
const breadcrumbSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'الرئيسية',
      'item': 'https://dandy-ebon.vercel.app/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'المدونة',
      'item': 'https://dandy-ebon.vercel.app/blog'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': article.title,
      'item': canonicalUrl
    }
  ]
} : null;
---

{article ? (
  <BaseLayout
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalUrl}
    robots={robots}
  >
    <slot name="head" slot="head">
      <meta property="og:type" content="article" />
      <meta property="og:title" content={article.title} />
      <meta property="og:description" content={article.excerpt || article.title} />
      {article.image && <meta property="og:image" content={article.image} />}
      <meta property="og:url" content={canonicalUrl} />
      {isoPublished && <meta property="article:published_time" content={isoPublished} />}
      {isoModified && <meta property="article:modified_time" content={isoModified} />}
      <meta property="article:section" content={article.category} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={article.title} />
      <meta name="twitter:description" content={article.excerpt || article.title} />
      {article.image && <meta name="twitter:image" content={article.image} />}

      {blogPostingSchema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(blogPostingSchema)} />
      )}
      {breadcrumbSchema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
      )}

      <style is:global>
        .article-page-wrap {
          padding: 120px 20px 80px;
        }

        .article-reader {
          max-width: 760px;
          margin: 0 auto;
        }

        .article-breadcrumb {
          display: flex;
          align-items: center;
          gap: 8px;
          font-size: 0.85rem;
          color: var(--color-muted);
          margin-bottom: 24px;
        }

        .article-breadcrumb a {
          color: var(--color-muted);
          text-decoration: none;
          transition: color 0.2s;
        }

        .article-breadcrumb a:hover {
          color: var(--color-rose-kiss-500, #fe5d9f);
        }

        .article-header {
          margin-bottom: 32px;
        }

        .article-header h1 {
          font-size: 2.1rem;
          font-weight: 800;
          color: var(--color-primary);
          line-height: 1.35;
          margin: 0 0 16px;
          letter-spacing: -0.02em;
        }

        .article-meta {
          display: flex;
          align-items: center;
          gap: 16px;
          font-size: 0.85rem;
          color: var(--color-muted);
        }

        .article-date {
          display: inline-flex;
          align-items: center;
          gap: 6px;
        }

        .article-category-badge {
          background: var(--color-lavender-veil-600, #f3e8f5);
          color: var(--color-primary);
          padding: 3px 10px;
          border-radius: 99px;
          font-size: 0.8rem;
          font-weight: 600;
        }

        .article-hero-media {
          width: 100%;
          max-height: 440px;
          border-radius: var(--border-radius-md);
          overflow: hidden;
          margin-bottom: 36px;
          background: var(--color-surface-soft);
          border: 1px solid var(--border-light);
        }

        .article-hero-media img {
          width: 100%;
          height: 100%;
          max-height: 440px;
          object-fit: cover;
          display: block;
        }

        .article-content {
          font-size: 1.08rem;
          line-height: 1.85;
          color: var(--color-primary);
        }

        .article-content p {
          margin-bottom: 24px;
        }

        .article-content h2 {
          font-size: 1.45rem;
          font-weight: 800;
          color: var(--color-primary);
          margin: 40px 0 16px;
          line-height: 1.4;
        }

        .article-content h3 {
          font-size: 1.2rem;
          font-weight: 700;
          color: var(--color-primary);
          margin: 30px 0 12px;
        }

        .article-content blockquote {
          margin: 32px 0;
          padding: 18px 24px;
          border-right: 3px solid var(--color-rose-kiss-500, #fe5d9f);
          background: var(--color-lavender-veil-600, #f3e8f5);
          border-radius: 0 8px 8px 0;
          color: var(--color-muted);
          font-style: italic;
          line-height: 1.7;
        }

        .article-content ul,
        .article-content ol {
          margin-right: 24px;
          margin-bottom: 24px;
        }

        .article-content li {
          margin-bottom: 10px;
          line-height: 1.7;
        }

        .article-content img {
          max-width: 100%;
          border-radius: var(--border-radius-md);
          margin: 24px 0;
        }

        /* Related Section */
        .related-articles-section {
          max-width: 1000px;
          margin: 60px auto 0;
          padding-top: 40px;
          border-top: 1px solid var(--border-light);
        }

        .related-title {
          font-size: 1.25rem;
          font-weight: 800;
          color: var(--color-primary);
          margin-bottom: 24px;
        }

        .related-grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
          gap: 20px;
        }

        .related-card {
          background: var(--color-surface);
          border: 1px solid var(--border-light);
          border-radius: var(--border-radius-md);
          overflow: hidden;
          display: flex;
          flex-direction: column;
          text-decoration: none;
          transition: border-color 0.2s, box-shadow 0.2s;
        }

        .related-card:hover {
          border-color: var(--color-soft-blossom-400, #efa2c4);
          box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
        }

        .related-card img {
          width: 100%;
          height: 160px;
          object-fit: cover;
        }

        .related-card-body {
          padding: 16px;
          display: flex;
          flex-direction: column;
          flex: 1;
        }

        .related-card-body span {
          font-size: 0.78rem;
          color: var(--color-muted);
          margin-bottom: 6px;
        }

        .related-card-body h4 {
          font-size: 0.98rem;
          font-weight: 700;
          color: var(--color-primary);
          line-height: 1.45;
          margin: 0 0 12px;
        }

        .related-card-body .read-link {
          margin-top: auto;
          font-size: 0.82rem;
          font-weight: 700;
          color: var(--color-rose-kiss-500, #fe5d9f);
        }

        @media (max-width: 640px) {
          .article-page-wrap {
            padding-top: 100px;
          }
          .article-header h1 {
            font-size: 1.6rem;
          }
        }
      </style>
    </slot>

    <div class="article-page-wrap container" dir="rtl">
      <main class="article-reader">
        <nav class="article-breadcrumb" aria-label="مسار المقال">
          <a href="/"><i class="fas fa-home"></i> الرئيسية</a>
          <span>/</span>
          <a href="/blog">المدونة</a>
          <span>/</span>
          <span>{article.title}</span>
        </nav>

        <article class="article-main-entry">
          <header class="article-header">
            <h1>{article.title}</h1>
            <div class="article-meta">
              {displayDate && (
                <span class="article-date">
                  <i class="far fa-calendar-alt"></i> {displayDate}
                </span>
              )}
              {article.category && (
                <span class="article-category-badge">{article.category}</span>
              )}
            </div>
          </header>

          {article.image && (
            <div class="article-hero-media">
              <img fetchpriority="high" src={article.image} alt={article.title} />
            </div>
          )}

          <div class="article-content" set:html={article.content} />
        </article>
      </main>

      {relatedArticles.length > 0 && (
        <section class="related-articles-section">
          <h3 class="related-title">مقالات مقترحة</h3>
          <div class="related-grid">
            {relatedArticles.map((item) => (
              <a href={`/blog/${item.slug}`} class="related-card">
                {item.image && (
                  <img loading="lazy" src={item.image} alt={item.title} />
                )}
                <div class="related-card-body">
                  {item.category && <span>{item.category}</span>}
                  <h4>{item.title}</h4>
                  <span class="read-link">اقرأي المقال <i class="fas fa-arrow-left"></i></span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalUrl}
    robots="noindex, follow"
  >
    <slot name="head" slot="head">
      <style is:global>
        .error-page-wrap {
          min-height: 65vh;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          padding: 140px 20px 80px;
          max-width: 540px;
          margin: 0 auto;
        }
        .error-code {
          font-family: 'Space Grotesk', sans-serif;
          font-size: 4.5rem;
          font-weight: 800;
          color: var(--border-medium);
          line-height: 1;
          margin-bottom: 12px;
        }
        .error-page-wrap h1 {
          font-size: 1.5rem;
          font-weight: 800;
          color: var(--color-primary);
          margin: 0 0 10px;
        }
        .error-page-wrap p {
          font-size: 0.95rem;
          color: var(--color-muted);
          line-height: 1.6;
          margin: 0 0 28px;
        }
        .error-actions {
          display: flex;
          gap: 12px;
          justify-content: center;
          flex-wrap: wrap;
        }
        .error-btn-primary {
          background: var(--color-primary);
          color: #fff;
          padding: 11px 22px;
          border-radius: var(--border-radius-sm);
          text-decoration: none;
          font-size: 0.88rem;
          font-weight: 700;
          transition: opacity 0.2s;
        }
        .error-btn-primary:hover {
          opacity: 0.9;
        }
        .error-btn-secondary {
          background: var(--color-surface-soft);
          color: var(--color-primary);
          border: 1px solid var(--border-light);
          padding: 11px 22px;
          border-radius: var(--border-radius-sm);
          text-decoration: none;
          font-size: 0.88rem;
          font-weight: 700;
          transition: background 0.2s;
        }
        .error-btn-secondary:hover {
          background: var(--border-light);
        }
      </style>
    </slot>

    <div class="error-page-wrap container" dir="rtl">
      <div class="error-code">404</div>
      <h1>عذراً، هذا المقال غير موجود</h1>
      <p>قد يكون الرابط غير صحيح أو تم نقل المقال إلى مسار جديد في مدونة داندي.</p>
      <div class="error-actions">
        <a href="/blog" class="error-btn-primary"><i class="fas fa-book-open"></i> تصفح المدونة</a>
        <a href="/" class="error-btn-secondary"><i class="fas fa-home"></i> الصفحة الرئيسية</a>
      </div>
    </div>
  </BaseLayout>
)}


