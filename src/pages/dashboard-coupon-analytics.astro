      <section class="ca-panel" aria-label="منهجية الحساب وحدود البيانات">
        <div class="ca-section-head" style="margin-bottom: 6px;">
          <h2>منهجية التحليل وحدود تفسير البيانات</h2>
        </div>
        <ol class="ca-methodology-list">
          <li>يُحتسب استخدام الكوبون فقط عند وجود لقطة كوبون محفوظة ومعتمدة داخل سجل طلب فعلي، وليس عند معاينة الكود أو تجربته في السلة.</li>
          <li>تبقى الطلبات الملغاة مسجلة ضمن السجل التاريخي لاستخدام الكوبونات، ويتم فصل قيمتها وعددها بوضوح عن الطلبات المُسلّمة والنشطة.</li>
          <li>يُحسب عدد العملاء الفريدين القابلين للتمييز في ذاكرة السيرفر فقط اعتماداً على رقم الهاتف المصري المُطَبّع مع استخدام معرّف العميل كبديل احتياطي، ولا يُستدل من ذلك على هوية شخصية موثقة خارج هذا النطاق.</li>
          <li>الطلبات التي تم حذفها نهائياً من قاعدة الطلبات لا يمكن إعادة بنائها في تحليلات الكوبونات لعدم الاحتفاظ بلقطتها المالية الكاملة.</li>
          <li>تستند قيمة الطلبات المُسلّمة إلى حالة الطلب المسجلة حالياً ولا تمثل دليلاً على تسوية مالية مستقلة نظراً لاعتماد الدفع عند الاستلام.</li>
          <li>لا يتضمن النظام الحالي سجل مرتجعات أو استرداد مالي مستقل، وتُصنف أي حالات غير قياسية في خانة غير محدد / أخرى.</li>
          <li>لا يمكن حساب صافي الربح أو تكلفة البضاعة أو تكلفة الاستحواذ أو العائد على الإنفاق الإعلاني أو معدل التحويل من بيانات الطلبات الحالية؛ لذا تُعرض المؤشرات المتاحة بمسمياتها الدقيقة فقط.</li>
          <li>عند اختيار قسم، يتم عرض الطلبات التي تحتوي على منتج مؤهل من هذا القسم. القيم المالية تعكس إجمالي الكوبون والطلب بالكامل، ولا تمثل خصمًا موزعًا على هذا القسم وحده.</li>
          <li>عند وجود نقص أو عدم تطابق في توزيع سطور المنتجات المؤهلة داخل طلب محفوظ، يُحتسب الطلب بقيمته الكاملة في ملخص الكوبون وسجل الاستخدامات، ويُستبعد تفصيل سطوره من جداول وتصدير الأقسام والمنتجات.</li>
        </ol>
      </section>
    </div>
  </main>

  <script is:inline>
    (function () {
      const ANALYTICS_API_URL = '/api/coupons/analytics';
      const ALLOWED_ADMIN_EMAIL = 'admin@dandy.com';

      let currentReport = null;
      let selectedCouponGroupKey = null;
      let isLoading = false;
      const chartsRegistry = {};

      function escapeHtml(val) {
        return String(val ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function formatEgp(val) {
        if (typeof val !== 'number' || !Number.isFinite(val)) return 'غير متاح';
        const formatted = Number.isInteger(val) ? val.toLocaleString('en-US') : val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        return `${formatted} ج.م`;
      }

      function formatInt(val) {
        if (typeof val !== 'number' || !Number.isFinite(val)) return '0';
        return Math.round(val).toLocaleString('en-US');
      }

      function formatPct(val) {
        if (val === null || val === undefined || !Number.isFinite(val)) return 'غير متاح';
        const s = Number.isInteger(val) ? String(val) : val.toFixed(1);
        return `${s}%`;
      }

      function getStatusArabic(status) {
        switch (status) {
          case 'new': return 'جديد';
          case 'processing': return 'قيد التجهيز';
          case 'shipped': return 'تم الشحن';
          case 'delivered': return 'تم التوصيل';
          case 'cancelled': return 'ملغي';
          default: return 'غير محدد / أخرى';
        }
      }

      function getCouponStatusMeta(status) {
        switch (status) {
          case 'active': return { label: 'مفعّل', cls: 'ca-status-text-active' };
          case 'scheduled': return { label: 'مجدول', cls: 'ca-status-text-scheduled' };
          case 'expired': return { label: 'منتهي', cls: 'ca-status-text-expired' };
          case 'disabled': return { label: 'معطّل', cls: 'ca-status-text-disabled' };
          default: return { label: 'سجل تاريخي (غير موجود حالياً)', cls: 'ca-status-text-unavailable' };
        }
      }

      function getCategoryArabic(slug) {
        if (!slug) return 'جميع المنتجات';
        if (slug === 'unknown') return 'غير مصنف';
        const cats = currentReport && Array.isArray(currentReport.categories) ? currentReport.categories : [];
        const match = cats.find((c) => c.slug === slug);
        return match ? match.arabicName : slug;
      }

      async function getAuthToken() {
        const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
        if (!auth || !auth.currentUser || typeof auth.currentUser.getIdToken !== 'function') {
          return '';
        }
        return await auth.currentUser.getIdToken();
      }

      function readFilterQueryObject() {
        const period = document.getElementById('filterPeriodSelect')?.value || 'all';
        const from = (document.getElementById('filterFromInput')?.value || '').trim();
        const to = (document.getElementById('filterToInput')?.value || '').trim();
        const couponId = (document.getElementById('filterCouponSelect')?.value || '').trim();
        const categorySlug = (document.getElementById('filterCategorySelect')?.value || 'all').trim();
        const scope = (document.getElementById('filterScopeSelect')?.value || '').trim();
        const discountType = (document.getElementById('filterTypeSelect')?.value || 'all').trim();
        const status = (document.getElementById('filterStatusSelect')?.value || 'all').trim();

        const params = new URLSearchParams();
        params.set('period', period);
        if (period === 'custom') {
          if (from) params.set('from', from);
          if (to) params.set('to', to);
        }
        if (couponId) params.set('couponId', couponId);
        if (categorySlug && categorySlug !== 'all') params.set('categorySlug', categorySlug);
        if (scope) params.set('scope', scope);
        if (discountType && discountType !== 'all') params.set('discountType', discountType);
        if (status && status !== 'all') params.set('status', status);

        return { period, from, to, params };
      }

      function syncCustomDateVisibility() {
        const period = document.getElementById('filterPeriodSelect')?.value || 'all';
        const row = document.getElementById('customDateRangeRow');
        const msgEl = document.getElementById('customDateValidationMsg');
        if (row) {
          row.classList.toggle('show', period === 'custom');
        }
        if (msgEl && period !== 'custom') {
          msgEl.textContent = '';
        }
      }

      function validateClientCustomDates() {
        const { period, from, to } = readFilterQueryObject();
        const msgEl = document.getElementById('customDateValidationMsg');
        if (period !== 'custom') {
          if (msgEl) msgEl.textContent = '';
          return true;
        }
        if (!from || !to) {
          if (msgEl) msgEl.textContent = 'يرجى تحديد تاريخ البداية وتاريخ النهاية.';
          return false;
        }
        if (from > to) {
          if (msgEl) msgEl.textContent = 'تاريخ البداية يجب أن يكون قبل أو مساوياً لتاريخ النهاية.';
          return false;
        }
        if (msgEl) msgEl.textContent = '';
        return true;
      }

      function setLoadingState(loading) {
        isLoading = loading;
        const loadEl = document.getElementById('analyticsLoadingState');
        const mainEl = document.getElementById('analyticsMainContent');
        const refreshBtn = document.getElementById('btnRefreshAnalytics');
        const applyBtn = document.getElementById('btnApplyFilters');
        if (loadEl) loadEl.style.display = loading ? 'flex' : 'none';
        if (mainEl && loading && !currentReport) mainEl.style.display = 'none';
        if (refreshBtn) refreshBtn.disabled = loading;
        if (applyBtn) applyBtn.disabled = loading;
      }

      function showErrorBanner(msg) {
        const banner = document.getElementById('analyticsErrorBanner');
        const text = document.getElementById('analyticsErrorMessage');
        if (text) text.textContent = msg || 'حدث خطأ غير متوقع.';
        if (banner) banner.classList.add('show');
      }

      function hideErrorBanner() {
        const banner = document.getElementById('analyticsErrorBanner');
        if (banner) banner.classList.remove('show');
      }

      function formatComparisonSub(compMetric, isCurrency) {
        if (!currentReport?.comparison?.available || !compMetric) {
          return 'لا توجد مقارنة فترة سابقة لهذا النطاق';
        }
        const prevStr = isCurrency ? formatEgp(compMetric.previous) : formatInt(compMetric.previous);
        if (compMetric.deltaPct === null) {
          return `الفترة السابقة: ${prevStr} (المقارنة النسبية غير متاحة لعدم وجود قاعدة سابقة)`;
        }
        const sign = compMetric.delta > 0 ? '+' : '';
        const cls = compMetric.delta > 0 ? 'ca-delta-pos' : compMetric.delta < 0 ? 'ca-delta-neg' : 'ca-delta-flat';
        return `<span class="${cls}">${sign}${compMetric.deltaPct.toFixed(1)}%</span> عن الفترة السابقة (${prevStr})`;
      }

      function populateDynamicFilterOptions(report) {
        const catSelect = document.getElementById('filterCategorySelect');
        if (catSelect && Array.isArray(report.categories)) {
          const prev = catSelect.value || 'all';
          catSelect.innerHTML = '<option value="all">جميع الأقسام</option>';
          report.categories.forEach((c) => {
            const opt = document.createElement('option');
            opt.value = c.slug;
            opt.textContent = c.arabicName;
            catSelect.appendChild(opt);
          });
          const optUnknown = document.createElement('option');
          optUnknown.value = 'unknown';
          optUnknown.textContent = 'غير مصنف';
          catSelect.appendChild(optUnknown);
          catSelect.value = prev;
        }

        const couponSelect = document.getElementById('filterCouponSelect');
        if (couponSelect && Array.isArray(report.coupons)) {
          const prev = couponSelect.value || '';
          couponSelect.innerHTML = '<option value="">جميع الكوبونات</option>';
          report.coupons.forEach((c) => {
            const opt = document.createElement('option');
            opt.value = c.groupKey;
            const suffix = c.hasCurrentDefinition ? '' : ' (تاريخي)';
            opt.textContent = `${c.currentCode}${suffix}`;
            couponSelect.appendChild(opt);
          });
          if (Array.from(couponSelect.options).some((o) => o.value === prev)) {
            couponSelect.value = prev;
          }
        }
      }

      function renderBanners(report) {
        const emptyBanner = document.getElementById('analyticsEmptyBanner');
        const emptyMsg = document.getElementById('analyticsEmptyMessage');
        const dqBanner = document.getElementById('analyticsDataQualityBanner');
        const dqText = document.getElementById('analyticsDataQualityText');

        const hasCoupons = Array.isArray(report.coupons) && report.coupons.length > 0;
        const ordersCount = report.summary?.couponOrders || 0;

        if (!hasCoupons && ordersCount === 0) {
          emptyMsg.textContent = 'لا توجد تعريفات كوبونات مسجلة أو طلبات كوبونات محفوظة حتى الآن.';
          emptyBanner.classList.add('show');
        } else if (ordersCount === 0) {
          emptyMsg.textContent = report.filters?.period !== 'all' || report.filters?.couponId || report.filters?.status || report.filters?.categorySlug || report.filters?.scope || report.filters?.discountType
            ? 'لا توجد طلبات استخدام كوبونات مطابقة للفلاتر الحالية، مع بقاء الكوبونات المعرّفة ظاهرة بصفر استخدام.'
            : 'توجد كوبونات مسجلة لكن لم يتم تسجيل أي طلبات استخدام كوبونات حتى الآن.';
          emptyBanner.classList.add('show');
        } else {
          emptyBanner.classList.remove('show');
        }

        const dq = report.dataQuality || {};
        const notes = [];
        if (dq.invalidCouponSnapshots > 0) notes.push(`لقطات كوبون غير صالحة مستبعدة: ${dq.invalidCouponSnapshots}`);
        if (dq.invalidCurrentCoupons > 0) notes.push(`تعريفات كوبون حالية تالفة مستبعدة: ${dq.invalidCurrentCoupons}`);
        if (dq.missingCustomerIdentities > 0) notes.push(`طلبات دون هوية عميل قابلة للتمييز: ${dq.missingCustomerIdentities}`);
        if (dq.appliedAtFallbacks > 0) notes.push(`طلبات اعتمدت وقت تطبيق الكوبون كبديل عن وقت الطلب: ${dq.appliedAtFallbacks}`);
        if (dq.missingTimestamps > 0) notes.push(`طلبات دون تاريخ صالح: ${dq.missingTimestamps}`);
        if (dq.snapshotLineMismatches > 0) notes.push(`طلبات بتوزيع سطور منتجات/أقسام غير مكتمل (تُحتسب في إجمالي الكوبون وتُستبعد من تفصيل وتصدير الأقسام والمنتجات): ${dq.snapshotLineMismatches}`);
        if (dq.unknownOrderStatuses > 0) notes.push(`طلبات بحالة غير قياسية: ${dq.unknownOrderStatuses}`);
        if (dq.missingHistoricalProductNames > 0) notes.push(`سطور منتجات دون اسم تاريخي (تم العرض بالمعرّف): ${dq.missingHistoricalProductNames}`);

        if (notes.length > 0) {
          dqText.textContent = `تم فحص ${dq.ordersScanned || 0} طلباً (${dq.couponOrdersIncluded || 0} طلب كوبون مقبول). ${notes.join(' · ')}`;
          dqBanner.classList.add('show');
        } else {
          dqBanner.classList.remove('show');
        }
      }

      function renderSummaryCards(report) {
        const s = report.summary;
        const cmp = report.comparison?.metrics || null;

        document.getElementById('kpiCouponOrders').textContent = formatInt(s.couponOrders);
        document.getElementById('kpiCouponOrdersSub').innerHTML = formatComparisonSub(cmp?.couponOrders, false);

        document.getElementById('kpiUniqueCustomers').textContent = formatInt(s.uniqueCustomers);
        document.getElementById('kpiUniqueCustomersSub').innerHTML =
          `عملاء قابلون للتمييز · متوسط ${s.avgOrdersPerCustomer} طلب/عميل`;

        document.getElementById('kpiDiscountAmount').textContent = formatEgp(s.discountAmount);
        document.getElementById('kpiDiscountAmountSub').innerHTML = formatComparisonSub(cmp?.discountAmount, true);

        document.getElementById('kpiEligibleSubtotal').textContent = formatEgp(s.eligibleSubtotal);
        document.getElementById('kpiEligibleSubtotalSub').innerHTML = formatComparisonSub(cmp?.eligibleSubtotal, true);

        document.getElementById('kpiEligibleNetSales').textContent = formatEgp(s.eligibleNetSales);
        document.getElementById('kpiEligibleNetSalesSub').innerHTML = formatComparisonSub(cmp?.eligibleNetSales, true);

        document.getElementById('kpiAvgDiscount').textContent = formatEgp(s.avgDiscountPerOrder);
        document.getElementById('kpiAvgDiscountSub').textContent =
          `نسبة الخصم الفعلية من المؤهل: ${formatPct(s.effectiveDiscountRatePct)}`;

        document.getElementById('kpiCouponsUsedCount').textContent = formatInt(s.activeCouponsUsedCount);
        document.getElementById('kpiCouponsUsedSub').textContent =
          `من إجمالي ${formatInt((report.coupons || []).length)} كوبون في القائمة`;

        document.getElementById('kpiRepeatRate').textContent = formatPct(s.repeatCustomerRatePct);
        document.getElementById('kpiRepeatRateSub').textContent =
          `عملاء متكررون: ${formatInt(s.repeatCustomers)} عميلاً`;

        document.getElementById('valAssociatedOrders').textContent = formatEgp(s.associatedFinalOrderValue);
        document.getElementById('valDeliveredOrders').textContent = formatEgp(s.deliveredOrderValue);
        document.getElementById('valDeliveredSub').textContent =
          `${formatInt(s.deliveredOrders)} طلب مُسلّم (${formatPct(s.deliveredOrderRatePct)}) — الدفع عند الاستلام`;
        document.getElementById('valPipelineOrders').textContent = formatEgp(s.pipelineValue);
        document.getElementById('valPipelineSub').textContent =
          `${formatInt(s.pipelineOrders)} طلب قيد التنفيذ أو الشحن`;
        document.getElementById('valCancelledOrders').textContent = formatEgp(s.cancelledOrderValue);
        document.getElementById('valCancelledSub').textContent =
          `${formatInt(s.cancelledOrders)} طلب ملغي (${formatPct(s.cancelledOrderRatePct)})`;
      }

      function renderCouponsTable() {
        const tbody = document.getElementById('couponsPerformanceBody');
        if (!tbody || !currentReport) return;

        const searchQ = (document.getElementById('couponTableSearch')?.value || '').trim().toUpperCase();
        const sortVal = document.getElementById('couponTableSortSelect')?.value || 'couponOrders:desc';
        const [sortKey, sortDir] = sortVal.split(':');

        const filtered = (currentReport.coupons || []).filter((c) => {
          if (!searchQ) return true;
          if (String(c.currentCode || '').toUpperCase().includes(searchQ)) return true;
          return (c.historicalCodes || []).some((hc) => String(hc).toUpperCase().includes(searchQ));
        });

        filtered.sort((a, b) => {
          let cmp = 0;
          if (sortKey === 'currentCode') {
            cmp = String(a.currentCode || '').localeCompare(String(b.currentCode || ''));
          } else {
            cmp = (Number(a[sortKey]) || 0) - (Number(b[sortKey]) || 0);
          }
          return sortDir === 'asc' ? cmp : -cmp;
        });

        if (filtered.length === 0) {
          tbody.innerHTML = '<tr><td colspan="13" style="text-align: center; padding: 28px; color: #64748b;">لا توجد كوبونات مطابقة لبحثك الحالي.</td></tr>';
          return;
        }

        tbody.innerHTML = '';
        filtered.forEach((c) => {
          const def = c.currentDefinition;
          const stMeta = getCouponStatusMeta(c.currentStatus);
          const typeAndVal = def
            ? (def.discountType === 'percentage' ? `نسبة ${def.discountValue}%` : `ثابت ${formatEgp(def.discountValue)}`)
            : 'غير متاح حالياً';
          const scopeText = !def
            ? 'سجل تاريخي'
            : def.scope === 'category'
              ? getCategoryArabic(def.categorySlug)
              : 'جميع المنتجات';
          const histCodesStr = (c.historicalCodes && c.historicalCodes.length > 0)
            ? c.historicalCodes.join(' · ')
            : '—';

          const tr = document.createElement('tr');
          if (selectedCouponGroupKey === c.groupKey) {
            tr.classList.add('is-selected');
          }
          tr.innerHTML = `
            <td><span class="ca-code-text">${escapeHtml(c.currentCode)}</span></td>
            <td style="font-size: 0.78rem; color: #475569;">${escapeHtml(histCodesStr)}</td>
            <td><span class="${stMeta.cls}">${escapeHtml(stMeta.label)}</span></td>
            <td class="ca-num">${escapeHtml(typeAndVal)}</td>
            <td>${escapeHtml(scopeText)}</td>
            <td class="ca-num"><strong>${formatInt(c.couponOrders)}</strong></td>
            <td class="ca-num">${formatInt(c.uniqueCustomers)}</td>
            <td class="ca-num">${escapeHtml(formatEgp(c.eligibleSubtotal))}</td>
            <td class="ca-num" style="color: #db2777; font-weight: 700;">${escapeHtml(formatEgp(c.discountAmount))}</td>
            <td class="ca-num">${escapeHtml(formatEgp(c.eligibleNetSales))}</td>
            <td class="ca-num">${escapeHtml(formatEgp(c.avgDiscountPerOrder))}</td>
            <td class="ca-num" style="white-space: nowrap;">${formatInt(c.deliveredOrders)} / ${formatInt(c.pipelineOrders)} / ${formatInt(c.cancelledOrders)}</td>
            <td>
              <button type="button" class="ca-row-btn" data-select-coupon="${escapeHtml(c.groupKey)}">
                عرض التفاصيل
              </button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      }

      function renderCouponDetailPanel() {
        const panel = document.getElementById('couponDetailPanel');
        if (!panel || !currentReport) return;

        const coupon = (currentReport.coupons || []).find((c) => c.groupKey === selectedCouponGroupKey);
        if (!coupon) {
          panel.classList.remove('show');
          return;
        }

        panel.classList.add('show');
        document.getElementById('detailCouponHeading').textContent = `تفاصيل الكوبون: ${coupon.currentCode}`;
        const histCodesText = coupon.allTimeHistoricalCodes && coupon.allTimeHistoricalCodes.length > 0
          ? coupon.allTimeHistoricalCodes.join(' · ')
          : 'لم يُستخدم في أي طلب مسجل';
        document.getElementById('detailCouponSubheading').textContent =
          `المعرّف الثابت: ${coupon.couponId || 'لقطة قديمة بدون معرّف'} · الأكواد التاريخية المستخدمة: ${histCodesText}`;

        const defEl = document.getElementById('detailCurrentDefinitionList');
        const def = coupon.currentDefinition;
        const stMeta = getCouponStatusMeta(coupon.currentStatus);
        if (def) {
          defEl.innerHTML = `
            <div class="ca-kv-item"><dt>الكود الحالي</dt><dd class="ca-code-text">${escapeHtml(def.code)}</dd></div>
            <div class="ca-kv-item"><dt>الحالة الحالية</dt><dd class="${stMeta.cls}">${escapeHtml(stMeta.label)}</dd></div>
            <div class="ca-kv-item"><dt>الخصم المحدد حالياً</dt><dd class="ca-num">${def.discountType === 'percentage' ? `${def.discountValue}%` : escapeHtml(formatEgp(def.discountValue))}</dd></div>
            <div class="ca-kv-item"><dt>النطاق الحالي</dt><dd>${escapeHtml(def.scope === 'category' ? getCategoryArabic(def.categorySlug) : 'جميع المنتجات')}</dd></div>
            <div class="ca-kv-item"><dt>الحد الأدنى</dt><dd class="ca-num">${def.minimumSubtotal ? escapeHtml(formatEgp(def.minimumSubtotal)) : 'بدون'}</dd></div>
            <div class="ca-kv-item"><dt>الحد الأقصى للخصم</dt><dd class="ca-num">${def.maximumDiscount ? escapeHtml(formatEgp(def.maximumDiscount)) : 'بدون'}</dd></div>
          `;
        } else {
          defEl.innerHTML = `
            <div class="ca-kv-item"><dt>حالة التعريف الحالي</dt><dd class="ca-status-text-unavailable">غير متاح في settings/coupons (سجل تاريخي)</dd></div>
            <div class="ca-kv-item"><dt>ملاحظة</dt><dd>يُعرض الأداء من لقطات الطلبات التاريخية كما طُبّقت وقت الشراء.</dd></div>
          `;
        }

        const histEl = document.getElementById('detailHistoricalSummaryList');
        histEl.innerHTML = `
          <div class="ca-kv-item"><dt>الطلبات ضمن الفلاتر / كل الأوقات</dt><dd class="ca-num">${formatInt(coupon.couponOrders)} / ${formatInt(coupon.allTimeOrders)}</dd></div>
          <div class="ca-kv-item"><dt>العملاء الفريدون / المتكررون</dt><dd class="ca-num">${formatInt(coupon.uniqueCustomers)} / ${formatInt(coupon.repeatCustomers)} (${formatPct(coupon.repeatCustomerRatePct)})</dd></div>
          <div class="ca-kv-item"><dt>المؤهل قبل الخصم</dt><dd class="ca-num">${escapeHtml(formatEgp(coupon.eligibleSubtotal))}</dd></div>
          <div class="ca-kv-item"><dt>إجمالي الخصومات</dt><dd class="ca-num">${escapeHtml(formatEgp(coupon.discountAmount))}</dd></div>
          <div class="ca-kv-item"><dt>صافي المنتجات المؤهلة</dt><dd class="ca-num">${escapeHtml(formatEgp(coupon.eligibleNetSales))}</dd></div>
          <div class="ca-kv-item"><dt>القيمة النهائية للطلبات</dt><dd class="ca-num">${escapeHtml(formatEgp(coupon.associatedFinalOrderValue))}</dd></div>
          <div class="ca-kv-item"><dt>مسلّمة / نشطة / ملغاة / غير محدد</dt><dd class="ca-num">${formatInt(coupon.deliveredOrders)} / ${formatInt(coupon.pipelineOrders)} / ${formatInt(coupon.cancelledOrders)} / ${formatInt(coupon.unknownStatusOrders)}</dd></div>
          <div class="ca-kv-item"><dt>إجمالي الخصم التراكمي (كل الأوقات)</dt><dd class="ca-num">${escapeHtml(formatEgp(coupon.allTimeDiscountAmount))}</dd></div>
        `;

        const variantsBody = document.getElementById('detailHistoricalConfigsBody');
        const variants = coupon.historicalConfigs || [];
        if (variants.length === 0) {
          variantsBody.innerHTML = '<tr><td colspan="9" style="text-align: center; color: #64748b;">لا توجد تطبيقات تاريخية في النطاق المحدد.</td></tr>';
        } else {
          variantsBody.innerHTML = variants.map((v) => `
            <tr>
              <td><span class="ca-code-text">${escapeHtml(v.code)}</span></td>
              <td>${v.discountType === 'percentage' ? 'نسبة مئوية' : 'مبلغ ثابت'}</td>
              <td class="ca-num">${v.discountType === 'percentage' ? `${v.discountValue}%` : escapeHtml(formatEgp(v.discountValue))}</td>
              <td>${escapeHtml(v.scope === 'category' ? getCategoryArabic(v.categorySlug) : 'جميع المنتجات')}</td>
              <td class="ca-num">${v.minimumSubtotal ? escapeHtml(formatEgp(v.minimumSubtotal)) : '—'}</td>
              <td class="ca-num">${v.maximumDiscount ? escapeHtml(formatEgp(v.maximumDiscount)) : '—'}</td>
              <td class="ca-num">${formatInt(v.couponOrders)}</td>
              <td class="ca-num">${escapeHtml(formatEgp(v.eligibleSubtotal))}</td>
              <td class="ca-num">${escapeHtml(formatEgp(v.discountAmount))}</td>
            </tr>
          `).join('');
        }

        const catBody = document.getElementById('detailCategoryBody');
        const cats = (coupon.categoryBreakdown || []).filter((r) => r.couponOrders > 0);
        catBody.innerHTML = cats.length === 0
          ? '<tr><td colspan="4" style="text-align: center; color: #64748b;">لا توجد بيانات أقسام.</td></tr>'
          : cats.map((r) => `
            <tr>
              <td>${escapeHtml(r.arabicName)}</td>
              <td class="ca-num">${formatInt(r.eligibleQuantity)}</td>
              <td class="ca-num">${escapeHtml(formatEgp(r.eligibleSubtotal))}</td>
              <td class="ca-num">${formatInt(r.couponOrders)}</td>
            </tr>
          `).join('');

        const prodBody = document.getElementById('detailProductBody');
        const prods = (coupon.productBreakdown || []).slice(0, 15);
        prodBody.innerHTML = prods.length === 0
          ? '<tr><td colspan="4" style="text-align: center; color: #64748b;">لا توجد بيانات منتجات.</td></tr>'
          : prods.map((r) => `
            <tr>
              <td>${escapeHtml(r.productName)}</td>
              <td class="ca-num">${formatInt(r.eligibleQuantity)}</td>
              <td class="ca-num">${escapeHtml(formatEgp(r.eligibleSubtotal))}</td>
              <td class="ca-num">${formatInt(r.couponOrders)}</td>
            </tr>
          `).join('');

        const usesBody = document.getElementById('detailRecentUsesBody');
        const uses = (coupon.recentUses || []).slice(0, 15);
        usesBody.innerHTML = uses.length === 0
          ? '<tr><td colspan="7" style="text-align: center; color: #64748b;">لا توجد طلبات مسجلة لهذا الكوبون في النطاق المحدد.</td></tr>'
          : uses.map((u) => {
            const incompleteNote = u.lineAllocationIncomplete
              ? '<div class="ca-line-incomplete-note">توزيع سطور المنتجات غير مكتمل</div>'
              : '';
            return `
            <tr${u.lineAllocationIncomplete ? ' data-line-allocation-incomplete="true"' : ''}>
              <td class="ca-code-text">${escapeHtml(u.invoiceCode)}</td>
              <td class="ca-num">${escapeHtml(u.cairoDateTime)}</td>
              <td class="ca-code-text">${escapeHtml(u.couponCode)}</td>
              <td class="ca-num">${escapeHtml(formatEgp(u.eligibleSubtotal))}${incompleteNote}</td>
              <td class="ca-num">${escapeHtml(formatEgp(u.discountAmount))}</td>
              <td class="ca-num">${escapeHtml(formatEgp(u.totalAmount))}</td>
              <td>${escapeHtml(getStatusArabic(u.status))}</td>
            </tr>
          `;
          }).join('');
      }

      function renderBreakdownTables(report) {
        const catBody = document.getElementById('categoryBreakdownBody');
        const cats = report.categoryBreakdown || [];
        if (cats.every((c) => c.couponOrders === 0)) {
          catBody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #64748b; padding: 20px;">لا توجد مبيعات مؤهلة مصنفة في النطاق المحدد.</td></tr>';
        } else {
          catBody.innerHTML = cats.map((c) => `
            <tr>
              <td><strong>${escapeHtml(c.arabicName)}</strong></td>
              <td class="ca-num">${formatInt(c.eligibleQuantity)}</td>
              <td class="ca-num">${escapeHtml(formatEgp(c.eligibleSubtotal))}</td>
              <td class="ca-num">${formatInt(c.couponOrders)}</td>
              <td class="ca-num">${formatInt(c.uniqueCustomers)}</td>
              <td class="ca-num">${formatPct(c.sharePct)}</td>
            </tr>
          `).join('');
        }

        const prodBody = document.getElementById('productBreakdownBody');
        const prods = report.productBreakdown || [];
        if (prods.length === 0) {
          prodBody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #64748b; padding: 20px;">لا توجد منتجات مؤهلة مسجلة في النطاق المحدد.</td></tr>';
        } else {
          prodBody.innerHTML = prods.slice(0, 30).map((p) => `
            <tr>
              <td>${escapeHtml(p.productName)}</td>
              <td>${escapeHtml(p.categoryArabicName)}</td>
              <td class="ca-num">${formatInt(p.eligibleQuantity)}</td>
              <td class="ca-num">${escapeHtml(formatEgp(p.eligibleSubtotal))}</td>
              <td class="ca-num">${formatInt(p.couponOrders)}</td>
              <td class="ca-num">${formatInt(p.uniqueCustomers)}</td>
            </tr>
          `).join('');
        }

        const usesBody = document.getElementById('recentUsesBody');
        const uses = report.recentUses || [];
        if (uses.length === 0) {
          usesBody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #64748b; padding: 24px;">لا توجد استخدامات كوبونات مطابقة للفلاتر المحددة.</td></tr>';
        } else {
          usesBody.innerHTML = uses.map((u) => {
            const scopeLabel = u.scope === 'category' ? getCategoryArabic(u.categorySlug) : 'جميع المنتجات';
            const incompleteNote = u.lineAllocationIncomplete
              ? '<div class="ca-line-incomplete-note">توزيع سطور المنتجات غير مكتمل (مُستبعد من تفصيل الأقسام والمنتجات)</div>'
              : '';
            return `
              <tr${u.lineAllocationIncomplete ? ' data-line-allocation-incomplete="true"' : ''}>
                <td><span class="ca-code-text">${escapeHtml(u.invoiceCode)}</span></td>
                <td class="ca-num">${escapeHtml(u.cairoDateTime)}</td>
                <td><span class="ca-code-text">${escapeHtml(u.couponCode)}</span></td>
                <td>${escapeHtml(scopeLabel)}</td>
                <td class="ca-num">${escapeHtml(formatEgp(u.eligibleSubtotal))}${incompleteNote}</td>
                <td class="ca-num" style="color: #db2777; font-weight: 700;">${escapeHtml(formatEgp(u.discountAmount))}</td>
                <td class="ca-num">${escapeHtml(formatEgp(u.totalAmount))}</td>
                <td>${escapeHtml(getStatusArabic(u.status))}</td>
              </tr>
            `;
          }).join('');
        }
      }

      function destroyChart(key) {
        if (chartsRegistry[key]) {
          try {
            chartsRegistry[key].destroy();
          } catch {
            // ignore
          }
          delete chartsRegistry[key];
        }
      }

      function toggleChartEmpty(emptyId, isEmpty) {
        const el = document.getElementById(emptyId);
        if (el) el.classList.toggle('show', Boolean(isEmpty));
      }

      function renderAllCharts(report) {
        if (typeof Chart === 'undefined') return;

        const trend = report.trend || [];
        const hasTrendData = trend.some((t) => t.couponOrders > 0);

        // 1. Usage over time
        destroyChart('usage');
        toggleChartEmpty('emptyChartUsage', !hasTrendData);
        if (hasTrendData) {
          chartsRegistry.usage = new Chart(document.getElementById('chartUsageOverTime'), {
            type: 'line',
            data: {
              labels: trend.map((t) => t.label),
              datasets: [{
                label: 'عدد طلبات الكوبونات',
                data: trend.map((t) => t.couponOrders),
                borderColor: '#db2777',
                backgroundColor: 'rgba(219, 39, 119, 0.12)',
                fill: true,
                tension: 0.25
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
          });
        }

        // 2. Discounts & net sales over time
        destroyChart('discounts');
        toggleChartEmpty('emptyChartDiscounts', !hasTrendData);
        if (hasTrendData) {
          chartsRegistry.discounts = new Chart(document.getElementById('chartDiscountsOverTime'), {
            type: 'line',
            data: {
              labels: trend.map((t) => t.label),
              datasets: [
                {
                  label: 'صافي المؤهل بعد الخصم (ج.م)',
                  data: trend.map((t) => t.eligibleNetSales),
                  borderColor: '#0f172a',
                  backgroundColor: 'rgba(15, 23, 42, 0.08)',
                  fill: false,
                  tension: 0.25
                },
                {
                  label: 'الخصومات الممنوحة (ج.م)',
                  data: trend.map((t) => t.discountAmount),
                  borderColor: '#db2777',
                  backgroundColor: 'rgba(219, 39, 119, 0.14)',
                  fill: false,
                  tension: 0.25
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: { y: { beginAtZero: true } }
            }
          });
        }

        // 3. Top coupons by usage count
        const topUsage = [...(report.coupons || [])].filter((c) => c.couponOrders > 0).sort((a, b) => b.couponOrders - a.couponOrders).slice(0, 8);
        destroyChart('topUsage');
        toggleChartEmpty('emptyChartTopUsage', topUsage.length === 0);
        if (topUsage.length > 0) {
          chartsRegistry.topUsage = new Chart(document.getElementById('chartTopCouponsUsage'), {
            type: 'bar',
            data: {
              labels: topUsage.map((c) => c.currentCode),
              datasets: [{
                label: 'عدد الطلبات',
                data: topUsage.map((c) => c.couponOrders),
                backgroundColor: '#0f172a',
                borderRadius: 6
              }]
            },
            options: {
              indexAxis: 'y',
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
            }
          });
        }

        // 4. Top coupons by discount total
        const topDiscount = [...(report.coupons || [])].filter((c) => c.discountAmount > 0).sort((a, b) => b.discountAmount - a.discountAmount).slice(0, 8);
        destroyChart('topDiscount');
        toggleChartEmpty('emptyChartTopDiscount', topDiscount.length === 0);
        if (topDiscount.length > 0) {
          chartsRegistry.topDiscount = new Chart(document.getElementById('chartTopCouponsDiscount'), {
            type: 'bar',
            data: {
              labels: topDiscount.map((c) => c.currentCode),
              datasets: [{
                label: 'إجمالي الخصم (ج.م)',
                data: topDiscount.map((c) => c.discountAmount),
                backgroundColor: '#db2777',
                borderRadius: 6
              }]
            },
            options: {
              indexAxis: 'y',
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: { x: { beginAtZero: true } }
            }
          });
        }

        // 5. Eligible sales by canonical category
        const cats = (report.categoryBreakdown || []).filter((c) => c.eligibleSubtotal > 0);
        destroyChart('categories');
        toggleChartEmpty('emptyChartCategories', cats.length === 0);
        if (cats.length > 0) {
          chartsRegistry.categories = new Chart(document.getElementById('chartCategorySales'), {
            type: 'doughnut',
            data: {
              labels: cats.map((c) => c.arabicName),
              datasets: [{
                data: cats.map((c) => c.eligibleSubtotal),
                backgroundColor: ['#db2777', '#0f172a', '#0369a1', '#15803d', '#64748b']
              }]
            },
            options: { responsive: true, maintainAspectRatio: false }
          });
        }

        // 6. Order status distribution
        const statuses = (report.statusBreakdown || []).filter((s) => s.orders > 0);
        destroyChart('status');
        toggleChartEmpty('emptyChartStatus', statuses.length === 0);
        if (statuses.length > 0) {
          chartsRegistry.status = new Chart(document.getElementById('chartStatusDistribution'), {
            type: 'doughnut',
            data: {
              labels: statuses.map((s) => s.arabicLabel),
              datasets: [{
                data: statuses.map((s) => s.orders),
                backgroundColor: ['#0369a1', '#d97706', '#4f46e5', '#15803d', '#b91c1c', '#64748b']
              }]
            },
            options: { responsive: true, maintainAspectRatio: false }
          });
        }

        // 7. Eligible product performance
        const prods = (report.productBreakdown || []).slice(0, 10);
        destroyChart('products');
        toggleChartEmpty('emptyChartProducts', prods.length === 0);
        if (prods.length > 0) {
          chartsRegistry.products = new Chart(document.getElementById('chartProductPerformance'), {
            type: 'bar',
            data: {
              labels: prods.map((p) => p.productName),
              datasets: [{
                label: 'قيمة المبيعات المؤهلة قبل الخصم (ج.م)',
                data: prods.map((p) => p.eligibleSubtotal),
                backgroundColor: '#0369a1',
                borderRadius: 6
              }]
            },
            options: {
              indexAxis: 'y',
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: { x: { beginAtZero: true } }
            }
          });
        }
      }

      function renderActiveWindowNote(report) {
        const el = document.getElementById('activeWindowText');
        if (!el || !report?.window) return;
        const w = report.window;
        if (w.period === 'all') {
          el.textContent = 'النطاق المعروض: كل الأوقات (بتوقيت القاهرة)';
        } else {
          el.textContent = `النطاق المعروض: من ${w.from} إلى ${w.to} (${w.dayCount} يوم بتوقيت القاهرة)`;
        }
      }

      async function loadAnalytics() {
        if (!validateClientCustomDates()) {
          return;
        }
        hideErrorBanner();
        setLoadingState(true);

        try {
          const token = await getAuthToken();
          if (!token) {
            window.location.href = '/login';
            return;
          }

          const { params } = readFilterQueryObject();
          const queryString = params.toString();
          const url = queryString ? `${ANALYTICS_API_URL}?${queryString}` : ANALYTICS_API_URL;

          const res = await fetch(url, {
            method: 'GET',
            headers: {
              Authorization: `Bearer ${token}`
            }
          });

          if (res.status === 401 || res.status === 403) {
            window.location.href = '/login';
            return;
          }

          const data = await res.json();
          if (!res.ok || !data.success) {
            setLoadingState(false);
            showErrorBanner(data.message || 'تعذر تحميل تحليلات الكوبونات من السيرفر.');
            return;
          }

          currentReport = data;
          document.getElementById('lastUpdatedCairoText').textContent = data.generatedAtCairo || 'الآن';
          document.getElementById('analyticsMainContent').style.display = 'block';
          setLoadingState(false);

          populateDynamicFilterOptions(data);
          renderActiveWindowNote(data);
          renderBanners(data);
          renderSummaryCards(data);
          renderCouponsTable();
          renderCouponDetailPanel();
          renderBreakdownTables(data);
          renderAllCharts(data);
        } catch {
          setLoadingState(false);
          showErrorBanner('تعذر الاتصال بالسيرفر لتحميل تحليلات الكوبونات. يرجى المحاولة مرة أخرى.');
        }
      }

      async function exportCsvDataset(dataset) {
        if (!validateClientCustomDates()) return;
        const menu = document.getElementById('exportDropdownMenu');
        const toggle = document.getElementById('btnExportDropdownToggle');
        if (menu) menu.classList.remove('show');
        if (toggle) toggle.setAttribute('aria-expanded', 'false');

        try {
          const token = await getAuthToken();
          if (!token) {
            window.location.href = '/login';
            return;
          }
          const { params } = readFilterQueryObject();
          params.set('format', 'csv');
          params.set('dataset', dataset);

          const res = await fetch(`${ANALYTICS_API_URL}?${params.toString()}`, {
            method: 'GET',
            headers: { Authorization: `Bearer ${token}` }
          });

          if (res.status === 401 || res.status === 403) {
            window.location.href = '/login';
            return;
          }
          if (!res.ok) {
            showErrorBanner('تعذر تصدير ملف CSV المطلوب.');
            return;
          }

          const blob = await res.blob();
          const disposition = res.headers.get('Content-Disposition') || '';
          const match = /filename="([^"]+)"/.exec(disposition);
          const filename = match ? match[1] : `dandy-coupon-analytics-${dataset}.csv`;

          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        } catch {
          showErrorBanner('حدث خطأ أثناء تحميل ملف التصدير.');
        }
      }

      // Wire events
      document.getElementById('filterPeriodSelect')?.addEventListener('change', syncCustomDateVisibility);
      document.getElementById('btnApplyFilters')?.addEventListener('click', loadAnalytics);
      document.getElementById('btnRefreshAnalytics')?.addEventListener('click', loadAnalytics);
      document.getElementById('btnRetryAnalytics')?.addEventListener('click', loadAnalytics);

      document.getElementById('btnClearFilters')?.addEventListener('click', () => {
        document.getElementById('filterPeriodSelect').value = 'all';
        document.getElementById('filterFromInput').value = '';
        document.getElementById('filterToInput').value = '';
        document.getElementById('filterCouponSelect').value = '';
        document.getElementById('filterCategorySelect').value = 'all';
        document.getElementById('filterScopeSelect').value = '';
        document.getElementById('filterTypeSelect').value = 'all';
        document.getElementById('filterStatusSelect').value = 'all';
        selectedCouponGroupKey = null;
        syncCustomDateVisibility();
        loadAnalytics();
      });

      document.getElementById('couponTableSearch')?.addEventListener('input', renderCouponsTable);
      document.getElementById('couponTableSortSelect')?.addEventListener('change', renderCouponsTable);

      document.getElementById('couponsPerformanceBody')?.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-select-coupon]');
        if (!btn) return;
        selectedCouponGroupKey = btn.getAttribute('data-select-coupon');
        renderCouponsTable();
        renderCouponDetailPanel();
        document.getElementById('couponDetailPanel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      document.getElementById('btnCloseCouponDetail')?.addEventListener('click', () => {
        selectedCouponGroupKey = null;
        renderCouponsTable();
        renderCouponDetailPanel();
      });

      const exportToggle = document.getElementById('btnExportDropdownToggle');
      const exportMenu = document.getElementById('exportDropdownMenu');
      exportToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = exportMenu?.classList.toggle('show');
        exportToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      document.addEventListener('click', (e) => {
        if (exportMenu && exportToggle && !exportMenu.contains(e.target) && !exportToggle.contains(e.target)) {
          exportMenu.classList.remove('show');
          exportToggle.setAttribute('aria-expanded', 'false');
        }
      });

      document.querySelectorAll('[data-csv-dataset]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const ds = btn.getAttribute('data-csv-dataset');
          if (ds) return exportCsvDataset(ds);
        });
      });

      function initAuthGuard() {
        function check(user) {
          if (!user) {
            window.location.href = '/login';
            return;
          }
          if (!user.email || user.email.toLowerCase() !== ALLOWED_ADMIN_EMAIL) {
            window.location.replace('/');
            return;
          }
          if (user.emailVerified !== true) {
            const a = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
            Promise.resolve(a && typeof a.signOut === 'function' ? a.signOut() : null)
              .catch(() => {})
              .finally(() => {
                window.location.replace('/login?reason=email_not_verified');
              });
            return;
          }
          loadAnalytics();
        }

        const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
        if (auth && typeof auth.onAuthStateChanged === 'function') {
          auth.onAuthStateChanged(check);
        } else {
          let attempts = 0;
          const interval = setInterval(() => {
            attempts++;
            const a = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
            if (a && typeof a.onAuthStateChanged === 'function') {
              clearInterval(interval);
              a.onAuthStateChanged(check);
            } else if (attempts > 30) {
              clearInterval(interval);
              window.location.href = '/login';
            }
          }, 100);
        }
      }

      syncCustomDateVisibility();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAuthGuard);
      } else {
        initAuthGuard();
      }
    })();
  </script>
</BaseLayout>
