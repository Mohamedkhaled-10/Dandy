---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="تحليلات أداء الكوبونات | Dandy Operations"
  description="متابعة استخدام أكواد الخصم، العملاء، الخصومات، والمبيعات المؤهلة داخل متجر داندي."
  robots="noindex, nofollow"
  showHeader={false}
  showFooter={false}
  showDashboardNav={true}
>
  <slot name="head" slot="head">
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <style is:global>
      :root {
        --ca-bg: #f8fafc;
        --ca-surface: #ffffff;
        --ca-surface-soft: #f1f5f9;
        --ca-border: #e2e8f0;
        --ca-text: #0f172a;
        --ca-text-secondary: #475569;
        --ca-muted: #64748b;
        --ca-accent: #db2777;
        --ca-accent-soft: #fdf2f8;
        --ca-green: #15803d;
        --ca-amber: #b45309;
        --ca-red: #b91c1c;
        --ca-blue: #0369a1;
      }

      body {
        background-color: var(--ca-bg);
      }

      .ca-wrap {
        width: 100%;
        max-width: 1400px;
        box-sizing: border-box;
        margin: 0 auto;
        padding: 24px 20px 80px;
        direction: rtl;
        font-family: 'Cairo', system-ui, -apple-system, sans-serif;
        color: var(--ca-text);
        overflow-x: clip;
      }

      .ca-num {
        font-variant-numeric: tabular-nums;
      }

      /* Header */
      .ca-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        padding-bottom: 20px;
        margin-bottom: 20px;
        border-bottom: 1px solid var(--ca-border);
      }

      .ca-header-text h1 {
        margin: 0 0 6px;
        font-size: 1.55rem;
        font-weight: 800;
        color: var(--ca-text);
        text-wrap: balance;
      }

      .ca-header-text p {
        margin: 0 0 8px;
        font-size: 0.92rem;
        color: var(--ca-text-secondary);
        line-height: 1.6;
      }

      .ca-header-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: var(--ca-muted);
      }

      .ca-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .ca-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        border: 1px solid var(--ca-border);
        background: var(--ca-surface);
        color: var(--ca-text);
        white-space: nowrap;
        flex-shrink: 0;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
      }

      .ca-btn:hover:not(:disabled) {
        background: var(--ca-surface-soft);
        border-color: #cbd5e1;
      }

      .ca-btn:focus-visible,
      .ca-input:focus-visible,
      .ca-select:focus-visible,
      .ca-sort-btn:focus-visible,
      .ca-row-btn:focus-visible {
        outline: 2px solid var(--ca-accent);
        outline-offset: 2px;
      }

      .ca-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .ca-btn-primary {
        background: #0f172a;
        border-color: #0f172a;
        color: #ffffff;
      }

      .ca-btn-primary:hover:not(:disabled) {
        background: #1e293b;
        border-color: #1e293b;
      }

      .ca-btn-accent {
        background: var(--ca-accent);
        border-color: var(--ca-accent);
        color: #ffffff;
      }

      .ca-btn-accent:hover:not(:disabled) {
        background: #be185d;
        border-color: #be185d;
      }

      .ca-export-menu {
        position: relative;
        display: inline-block;
      }

      .ca-export-dropdown {
        display: none;
        position: absolute;
        left: 0;
        top: calc(100% + 6px);
        min-width: 240px;
        background: var(--ca-surface);
        border: 1px solid var(--ca-border);
        border-radius: 10px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.12);
        padding: 6px;
        z-index: 60;
      }

      .ca-export-dropdown.show {
        display: block;
      }

      .ca-export-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        min-height: 40px;
        padding: 8px 12px;
        border: none;
        background: transparent;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--ca-text);
        text-align: right;
        cursor: pointer;
      }

      .ca-export-item:hover {
        background: var(--ca-surface-soft);
      }

      /* Toolbar / Filters */
      .ca-panel {
        background: var(--ca-surface);
        border: 1px solid var(--ca-border);
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 20px;
        min-width: 0;
        max-width: 100%;
        box-sizing: border-box;
      }

      .ca-filters-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        align-items: end;
      }

      .ca-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .ca-field label {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--ca-text-secondary);
      }

      .ca-input,
      .ca-select {
        width: 100%;
        min-height: 40px;
        padding: 8px 12px;
        border: 1px solid var(--ca-border);
        border-radius: 8px;
        background: var(--ca-surface);
        color: var(--ca-text);
        font-family: inherit;
        font-size: 0.85rem;
        box-sizing: border-box;
      }

      .ca-custom-dates-row {
        display: none;
        grid-template-columns: repeat(2, minmax(0, 220px)) 1fr;
        gap: 12px;
        align-items: end;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--ca-border);
      }

      .ca-custom-dates-row.show {
        display: grid;
      }

      .ca-filter-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid var(--ca-border);
      }

      .ca-filter-btns {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .ca-active-window-note {
        font-size: 0.82rem;
        color: var(--ca-text-secondary);
      }

      .ca-filter-semantics-note {
        margin: 12px 0 0;
        font-size: 0.8rem;
        line-height: 1.6;
        color: var(--ca-text-secondary);
      }

      .ca-line-incomplete-note {
        margin-top: 3px;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--ca-amber);
      }

      /* Banners */
      .ca-banner {
        display: none;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
        border-radius: 10px;
        border: 1px solid var(--ca-border);
        background: var(--ca-surface);
        margin-bottom: 18px;
        font-size: 0.86rem;
        line-height: 1.6;
      }

      .ca-banner.show {
        display: flex;
      }

      .ca-banner.error {
        background: #fef2f2;
        border-color: #fecaca;
        color: #991b1b;
      }

      .ca-banner.warning {
        background: #fffbeb;
        border-color: #fde68a;
        color: #92400e;
      }

      .ca-banner.info {
        background: #f8fafc;
        border-color: var(--ca-border);
        color: var(--ca-text-secondary);
      }

      /* Loading */
      .ca-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 56px 20px;
        text-align: center;
        color: var(--ca-muted);
        background: var(--ca-surface);
        border: 1px solid var(--ca-border);
        border-radius: 12px;
        margin-bottom: 20px;
      }

      .ca-spinner {
        width: 36px;
        height: 36px;
        border: 3px solid var(--ca-border);
        border-top-color: var(--ca-accent);
        border-radius: 50%;
        animation: caSpin 0.8s linear infinite;
        margin-bottom: 12px;
      }

      @keyframes caSpin {
        to { transform: rotate(360deg); }
      }

      @media (prefers-reduced-motion: reduce) {
        .ca-spinner { animation: none; }
        .ca-btn { transition: none; }
      }

      /* KPI Grid */
      .ca-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 20px;
      }

      .ca-kpi-card {
        background: var(--ca-surface);
        border: 1px solid var(--ca-border);
        border-radius: 10px;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .ca-kpi-label {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--ca-muted);
      }

      .ca-kpi-value {
        font-size: 1.45rem;
        font-weight: 800;
        color: var(--ca-text);
        line-height: 1.25;
      }

      .ca-kpi-sub {
        font-size: 0.76rem;
        color: var(--ca-text-secondary);
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
      }

      .ca-delta-pos { color: var(--ca-green); font-weight: 700; }
      .ca-delta-neg { color: var(--ca-red); font-weight: 700; }
      .ca-delta-flat { color: var(--ca-muted); font-weight: 700; }

      /* Financial Status Strip */
      .ca-value-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 24px;
      }

      /* Section Heading */
      .ca-section-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
      }

      .ca-section-head h2 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--ca-text);
      }

      .ca-section-sub {
        font-size: 0.8rem;
        color: var(--ca-muted);
        margin: 2px 0 0;
      }

      /* Charts Grid */
      .ca-charts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
      }

      .ca-chart-card {
        background: var(--ca-surface);
        border: 1px solid var(--ca-border);
        border-radius: 12px;
        padding: 18px;
        display: flex;
        flex-direction: column;
        min-width: 0;
        max-width: 100%;
        box-sizing: border-box;
        overflow: hidden;
      }

      .ca-chart-card.wide {
        grid-column: 1 / -1;
      }

      .ca-chart-box {
        position: relative;
        height: 270px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
      }

      .ca-chart-box canvas {
        max-width: 100% !important;
      }

      .ca-chart-empty {
        display: none;
        position: absolute;
        inset: 0;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 0.84rem;
        color: var(--ca-muted);
        background: rgba(248, 250, 252, 0.85);
        border-radius: 8px;
        padding: 16px;
      }

      .ca-chart-empty.show {
        display: flex;
      }

      /* Tables */
      .ca-table-tools {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }

      .ca-table-wrap {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow-x: auto;
        border: 1px solid var(--ca-border);
        border-radius: 8px;
        box-sizing: border-box;
      }

      .ca-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
        min-width: 780px;
      }

      .ca-table.ca-table-coupons {
        font-size: 0.8rem;
      }

      .ca-table.compact {
        min-width: 560px;
      }

      .ca-table th {
        background: var(--ca-surface-soft);
        color: var(--ca-text-secondary);
        font-weight: 700;
        font-size: 0.75rem;
        text-align: right;
        padding: 9px 8px;
        border-bottom: 1px solid var(--ca-border);
        white-space: nowrap;
      }

      .ca-table td {
        padding: 9px 8px;
        border-bottom: 1px solid #f1f5f9;
        color: var(--ca-text);
        vertical-align: middle;
      }

      .ca-table tbody tr:last-child td {
        border-bottom: none;
      }

      .ca-table tbody tr:hover td {
        background: #f8fafc;
      }

      .ca-table tbody tr.is-selected td {
        background: #fdf2f8;
      }

      .ca-sort-btn {
        border: none;
        background: transparent;
        padding: 0;
        font: inherit;
        color: inherit;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }

      .ca-code-text {
        font-family: 'Courier New', Courier, monospace;
        font-weight: 700;
        letter-spacing: 0.03em;
        color: var(--ca-text);
      }

      .ca-row-btn {
        min-height: 34px;
        padding: 5px 10px;
        border-radius: 6px;
        border: 1px solid var(--ca-border);
        background: var(--ca-surface);
        color: var(--ca-text);
        font-family: inherit;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
      }

      .ca-row-btn:hover {
        border-color: var(--ca-accent);
        color: var(--ca-accent);
      }

      .ca-status-text-active { color: var(--ca-green); font-weight: 700; }
      .ca-status-text-scheduled { color: var(--ca-amber); font-weight: 700; }
      .ca-status-text-expired { color: var(--ca-red); font-weight: 700; }
      .ca-status-text-disabled { color: var(--ca-muted); font-weight: 700; }
      .ca-status-text-unavailable { color: #7c3aed; font-weight: 700; }

      /* Detail Panel */
      .ca-detail-panel {
        display: none;
        background: var(--ca-surface);
        border: 1px solid #f9a8d4;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 24px;
        min-width: 0;
        max-width: 100%;
        box-sizing: border-box;
      }

      .ca-detail-panel.show {
        display: block;
      }

      .ca-detail-split {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin: 16px 0;
      }

      .ca-detail-block {
        padding: 14px 16px;
        border: 1px solid var(--ca-border);
        border-radius: 8px;
        background: #fcfcfd;
        min-width: 0;
        max-width: 100%;
        box-sizing: border-box;
      }

      .ca-detail-block h3 {
        margin: 0 0 10px;
        font-size: 0.92rem;
        font-weight: 800;
        color: var(--ca-text);
      }

      .ca-kv-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px 16px;
        margin: 0;
        font-size: 0.83rem;
      }

      .ca-kv-item dt {
        color: var(--ca-muted);
        font-size: 0.76rem;
      }

      .ca-kv-item dd {
        margin: 2px 0 0;
        font-weight: 700;
        color: var(--ca-text);
      }

      /* Two-column breakdown grid */
      .ca-two-col {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
      }

      /* Methodology list */
      .ca-methodology-list {
        margin: 10px 0 0;
        padding-right: 20px;
        color: var(--ca-text-secondary);
        font-size: 0.85rem;
        line-height: 1.75;
      }

      .ca-methodology-list li + li {
        margin-top: 4px;
      }

      @media (max-width: 1100px) {
        .ca-filters-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .ca-kpi-grid,
        .ca-value-strip {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .ca-charts-grid,
        .ca-two-col,
        .ca-detail-split {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      @media (max-width: 640px) {
        .ca-wrap {
          padding: 16px 12px 64px;
        }
        .ca-panel,
        .ca-chart-card,
        .ca-detail-panel,
        .ca-detail-block {
          padding: 14px 12px;
        }
        .ca-filters-grid,
        .ca-custom-dates-row,
        .ca-kpi-grid,
        .ca-value-strip,
        .ca-kv-list {
          grid-template-columns: minmax(0, 1fr);
        }
        .ca-table-tools {
          width: 100%;
        }
        .ca-table-tools .ca-input,
        .ca-table-tools .ca-select {
          width: 100% !important;
          max-width: 100%;
        }
        .ca-chart-box {
          height: 230px;
        }
        .ca-btn {
          min-height: 44px;
        }
        .ca-export-dropdown {
          right: 0;
          left: auto;
        }
      }
    </style>
  </slot>

  <main class="ca-wrap" dir="rtl">
    <!-- Page Header -->
    <header class="ca-header">
      <div class="ca-header-text">
        <h1>تحليلات أداء الكوبونات</h1>
        <p>متابعة استخدام أكواد الخصم، العملاء، الخصومات، والمبيعات المؤهلة داخل متجر داندي.</p>
        <div class="ca-header-meta">
          <span>المنطقة الزمنية: القاهرة (Africa/Cairo)</span>
          <span aria-hidden="true">·</span>
          <span>آخر تحديث: <strong id="lastUpdatedCairoText" class="ca-num">غير متاح</strong></span>
        </div>
      </div>

      <div class="ca-header-actions">
        <a href="/dashboard-coupons" class="ca-btn">
          <i class="fas fa-ticket-alt"></i>
          <span>إدارة الكوبونات</span>
        </a>

        <button type="button" class="ca-btn" id="btnRefreshAnalytics">
          <i class="fas fa-sync-alt"></i>
          <span>تحديث</span>
        </button>

        <div class="ca-export-menu">
          <button
            type="button"
            class="ca-btn ca-btn-primary"
            id="btnExportDropdownToggle"
            aria-expanded="false"
            aria-controls="exportDropdownMenu"
          >
            <i class="fas fa-download"></i>
            <span>تصدير CSV</span>
            <i class="fas fa-chevron-down" style="font-size: 0.72rem;"></i>
          </button>
          <div class="ca-export-dropdown" id="exportDropdownMenu" role="menu">
            <button type="button" class="ca-export-item" data-csv-dataset="coupons" role="menuitem">
              <i class="fas fa-table"></i>
              <span>ملخص أداء الكوبونات</span>
            </button>
            <button type="button" class="ca-export-item" data-csv-dataset="uses" role="menuitem">
              <i class="fas fa-receipt"></i>
              <span>سجل استخدامات الكوبونات</span>
            </button>
            <button type="button" class="ca-export-item" data-csv-dataset="products" role="menuitem">
              <i class="fas fa-box-open"></i>
              <span>أداء المنتجات المؤهلة</span>
            </button>
            <button type="button" class="ca-export-item" data-csv-dataset="categories" role="menuitem">
              <i class="fas fa-layer-group"></i>
              <span>أداء الأقسام المؤهلة</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Filters Toolbar -->
    <section class="ca-panel" aria-label="تصفية تحليلات الكوبونات">
      <div class="ca-filters-grid">
        <div class="ca-field">
          <label for="filterPeriodSelect">الفترة الزمنية</label>
          <select id="filterPeriodSelect" class="ca-select">
            <option value="all">كل الأوقات</option>
            <option value="today">اليوم</option>
            <option value="7d">آخر 7 أيام</option>
            <option value="30d">آخر 30 يوماً</option>
            <option value="90d">آخر 90 يوماً</option>
            <option value="this_month">هذا الشهر</option>
            <option value="prev_month">الشهر السابق</option>
            <option value="custom">فترة مخصصة</option>
          </select>
        </div>

        <div class="ca-field">
          <label for="filterCouponSelect">الكوبون</label>
          <select id="filterCouponSelect" class="ca-select">
            <option value="">جميع الكوبونات</option>
          </select>
        </div>

        <div class="ca-field">
          <label for="filterCategorySelect">القسم</label>
          <select id="filterCategorySelect" class="ca-select">
            <option value="all">جميع الأقسام</option>
          </select>
        </div>

        <div class="ca-field">
          <label for="filterScopeSelect">نطاق الكوبون</label>
          <select id="filterScopeSelect" class="ca-select">
            <option value="">جميع النطاقات</option>
            <option value="all">جميع المنتجات</option>
            <option value="category">قسم محدد فقط</option>
          </select>
        </div>

        <div class="ca-field">
          <label for="filterTypeSelect">نوع الخصم</label>
          <select id="filterTypeSelect" class="ca-select">
            <option value="all">كل الأنواع</option>
            <option value="percentage">نسبة مئوية (%)</option>
            <option value="fixed">مبلغ ثابت (ج.م)</option>
          </select>
        </div>

        <div class="ca-field">
          <label for="filterStatusSelect">حالة الطلب</label>
          <select id="filterStatusSelect" class="ca-select">
