---
// src/pages/product/[...slug].astro
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getProductBySlug,
  getProductById,
  normalizeCategory,
  parseDescriptionToHtml,
  generateProductJsonLd,
  optimizeCloudinaryUrl,
  SITE_URL,
  type Product
} from '../../utils/products';
import {
  getPublishedPinkFridayCampaign,
  calculatePinkFridayPricing
} from '../../utils/pink-friday-server';
import {
  normalizeProductVariants,
  hasSelectableProductVariants
} from '../../utils/server-variant-pricing';

const livePfCampaign = await getPublishedPinkFridayCampaign();

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/all-products', 301);
}

// 1. Resolve product by slug
let product: Product | null = await getProductBySlug(slug);

// 2. If not found by slug, check if the parameter was a legacy product ID
if (!product) {
  const productById = await getProductById(slug);
  if (productById) {
    const searchParams = new URLSearchParams();
    for (const [k, v] of Astro.url.searchParams.entries()) {
      if (k.startsWith('utm_') || k === 'fbclid' || k === 'gclid') {
        searchParams.set(k, v);
      }
    }
    const qs = searchParams.toString() ? `?${searchParams.toString()}` : '';
    return Astro.redirect(`/product/${encodeURIComponent(productById.resolvedSlug)}${qs}`, 301);
  }
}

// 3. Handle 404 when product is not found or is hidden
const isNotFound = !product || product.isHidden;
if (isNotFound) {
  Astro.response.status = 404;
}

// 4. Enforce canonical slug URL (301 redirect if accessed with non-canonical alias)
if (product && !product.isHidden) {
  const reqSlug = decodeURIComponent(slug).toLowerCase().trim();
  if (reqSlug !== product.resolvedSlug.toLowerCase()) {
    const searchParams = new URLSearchParams();
    for (const [k, v] of Astro.url.searchParams.entries()) {
      if (k.startsWith('utm_') || k === 'fbclid' || k === 'gclid') {
        searchParams.set(k, v);
      }
    }
    const qs = searchParams.toString() ? `?${searchParams.toString()}` : '';
    return Astro.redirect(`/product/${encodeURIComponent(product.resolvedSlug)}${qs}`, 301);
  }
}

// 5. Prepare SEO & Meta Tags
const productName = product?.name || 'المنتج غير متوفر';
const pageTitle = product ? `${product.name} | داندي كوزمتكس - Dandy Cosmetics` : 'المنتج غير موجود (404) | داندي كوزمتكس';

const rawDesc = (product?.description || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const metaDescription = rawDesc
  ? (rawDesc.length > 155 ? rawDesc.substring(0, 155) + '...' : rawDesc)
  : (product ? `${product.name} - مستحضر طبيعي فاخر للعناية بالجمال من داندي كوزمتكس مصر.` : 'المنتج المطلوب غير متوفر حالياً في متجر داندي كوزمتكس.');

const canonicalUrl = product ? `${SITE_URL}/product/${encodeURIComponent(product.resolvedSlug)}` : `${SITE_URL}/all-products`;
const ogImage = product?.image || `${SITE_URL}/assets/images/fav-icons/android-chrome-512x512.png`;
const jsonLd = product ? generateProductJsonLd(product, canonicalUrl) : null;
const structuredDescriptionHtml = product ? parseDescriptionToHtml(product.description) : '';

const categoryName = product ? normalizeCategory(product.category) : '';
const priceNumber = product ? Number(product.price) || 0 : 0;
const originalPriceNumber = product?.originalPrice ? Number(product.originalPrice) : null;
const discountNumber = product?.discount ? Number(product.discount) : null;
const pfPricing = product ? calculatePinkFridayPricing(product, livePfCampaign) : { isEligible: false, regularPrice: 0, campaignPrice: 0, discountAmount: 0, discountPercentage: 0 };
const isPfEligible = pfPricing.isEligible;
const isSoldOut = Boolean(product?.isSoldOut);
const isAvailable = Boolean(product && !product.isSoldOut && product.inStock !== false);
const effectivePrice = isPfEligible ? pfPricing.campaignPrice : priceNumber;
const hasValidRegularOriginal = Boolean(!isPfEligible && originalPriceNumber && originalPriceNumber > priceNumber);
const regularSavingsAmount = hasValidRegularOriginal ? (originalPriceNumber! - priceNumber) : 0;
const mainDisplayImage = optimizeCloudinaryUrl(product?.image, { width: 800, height: 800, crop: 'limit' }) || 'https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=800&q=80';

// Pre-render variants using unified frontend/backend normalization & eligibility contract
const variantsList = product ? normalizeProductVariants(product) : [];
const hasVariants = Boolean(product && hasSelectableProductVariants(product));

// Pre-render WhatsApp link
const waPhone = '201038941005';
const waMessage = product ? `مرحباً داندي بيوتي، أود الاستفسار عن هذا المنتج:\n- اسم المنتج: ${product.name}\n- الرابط: ${canonicalUrl}` : '';
const waLink = `https://wa.me/${waPhone}?text=${encodeURIComponent(waMessage)}`;

// Share URLs
const shareWaLink = product ? `https://wa.me/?text=${encodeURIComponent(product.name + '\n' + canonicalUrl)}` : '#';
const shareFbLink = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`;
const shareIgLink = 'https://www.instagram.com/dandy_skincare_cosmotics';
const shareMessengerLink = 'https://www.facebook.com/profile.php?id=61563039704396';

// 6. Approved Product-to-Article Editorial Guides (Phase 3.5)
interface ProductArticleGuide {
  label: string;
  leadText: string;
  anchorText: string;
  tailText?: string;
  articleUrl: string;
}

