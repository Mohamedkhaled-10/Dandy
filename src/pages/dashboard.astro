---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="لوحة الإدارة | Dandy Operations"
  description="مركز إدارة العمليات ومتابعة المتجر"
  robots="noindex, nofollow"
  showHeader={false}
  showFooter={false}
  showDashboardNav={true}
>
  <slot name="head" slot="head">
    <style is:global>
      .dash-main-wrap {
        padding: 32px 20px 80px;
        max-width: 1400px;
        margin: 0 auto;
      }

      .dash-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
      }

      .dash-header-title h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--color-primary, #111827);
        margin: 0 0 4px 0;
      }

      .dash-header-title p {
        font-size: 0.88rem;
        color: var(--color-muted, #6b7280);
        margin: 0;
      }

      .operator-chip {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px 14px;
        background: var(--color-surface, #ffffff);
        border: 1px solid var(--border-light, #e5e7eb);
        border-radius: var(--border-radius-sm, 6px);
      }

      .operator-initial {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        background: var(--color-primary, #111827);
        color: #ffffff;
        font-weight: 800;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .operator-info {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-primary, #111827);
      }

      /* Clean Operational Bento Grid */
      .admin-modules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
        margin-bottom: 36px;
      }

      .module-card {
        background: var(--color-surface, #ffffff);
        border: 1px solid var(--border-light, #e5e7eb);
        border-radius: var(--border-radius-md, 8px);
        padding: 20px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s ease, transform 0.15s ease;
      }

      .module-card:hover {
        border-color: var(--color-primary, #111827);
        transform: translateY(-2px);
      }

      .module-icon-wrap {
        width: 40px;
        height: 40px;
        border-radius: 6px;
        background: var(--color-surface-soft, #f9fafb);
        border: 1px solid var(--border-light, #e5e7eb);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary, #111827);
        font-size: 1.1rem;
        margin-bottom: 14px;
      }

      .module-card h2 {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-primary, #111827);
        margin: 0 0 6px 0;
      }

      .module-card p {
        font-size: 0.82rem;
        color: var(--color-muted, #6b7280);
        line-height: 1.5;
        margin: 0 0 16px 0;
        flex: 1;
      }

      .module-link-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--color-primary, #111827);
        padding-top: 12px;
        border-top: 1px solid var(--border-light, #f3f4f6);
      }

      /* Clean Operational Change Logs */
      .admin-panel-card {
        background: var(--color-surface, #ffffff);
        border: 1px solid var(--border-light, #e5e7eb);
        border-radius: var(--border-radius-md, 8px);
        overflow: hidden;
      }

      .panel-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-light, #e5e7eb);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .panel-card-header h2 {
        font-size: 0.98rem;
        font-weight: 800;
        color: var(--color-primary, #111827);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .table-responsive {
        overflow-x: auto;
      }

      .logs-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        text-align: right;
      }

      .logs-table th {
        background: var(--color-surface-soft, #f9fafb);
        color: var(--color-muted, #4b5563);
        font-weight: 700;
        padding: 12px 20px;
        border-bottom: 1px solid var(--border-light, #e5e7eb);
        white-space: nowrap;
      }

      .logs-table td {
        padding: 12px 20px;
        border-bottom: 1px solid var(--border-light, #f3f4f6);
        vertical-align: middle;
      }

      .logs-table tr:last-child td {
        border-bottom: none;
      }

      .admin-user-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--color-surface-soft, #f3f4f6);
        color: var(--color-primary, #374151);
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 600;
      }

      .log-date {
        color: var(--color-muted, #6b7280);
        font-size: 0.8rem;
        white-space: nowrap;
      }

      @media (max-width: 640px) {
        .dash-main-wrap {
          padding: 20px 14px 60px;
        }
        .admin-modules-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </slot>

  <main class="dash-main-wrap" dir="rtl">
    <div class="dash-page-header">
      <div class="dash-header-title">
        <h1>لوحة التحكم الرئيسية</h1>
        <p>نظرة عامة على أقسام المتجر وسجل العمليات اللحظي.</p>
      </div>

      <div class="operator-chip" id="operatorCard" style="display: none;">
        <div class="operator-initial" id="operatorInitials">A</div>
        <div class="operator-info" id="operatorEmail">...</div>
      </div>
    </div>

    <!-- Operational Modules -->
    <div class="admin-modules-grid">
      <!-- Orders Module -->
      <a href="/dashboard-order" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-shopping-bag"></i></div>
        <h2>إدارة الطلبات</h2>
        <p>معالجة الطلبات الواردة، تحديث حالات الشحن، والاطلاع على تفاصيل الفواتير والعملاء.</p>
        <div class="module-link-action"><span>فتح الطلبات</span> <i class="fas fa-arrow-left"></i></div>
      </a>

      <!-- Products Module -->
      <a href="/dashboard-product" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-boxes"></i></div>
        <h2>المنتجات والمخزون</h2>
        <p>إضافة وتعديل المنتجات، ضبط الأسعار والتخفيضات، وإدارة خيارات الروائح والمخزون.</p>
        <div class="module-link-action"><span>فتح المنتجات</span> <i class="fas fa-arrow-left"></i></div>
      </a>

      <!-- Blog Module -->
      <a href="/dashboard-blog" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-newspaper"></i></div>
        <h2>المقالات والمدونة</h2>
        <p>تحرير ونشر المقالات الجمالية، وإدارة المحتوى الإرشادي والتصنيفات.</p>
        <div class="module-link-action"><span>فتح المدونة</span> <i class="fas fa-arrow-left"></i></div>
      </a>

      <!-- Homepage Index Module -->
      <a href="/dashboard-index" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-sliders-h"></i></div>
        <h2>تخصيص الواجهة</h2>
        <p>التحكم ببانرات الهيرو، الأقسام الديناميكية، شريط المزايا، ومجموعات المنتجات.</p>
        <div class="module-link-action"><span>فتح الواجهة</span> <i class="fas fa-arrow-left"></i></div>
      </a>

      <!-- Analytics Module -->
      <a href="/statues" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-chart-line"></i></div>
        <h2>الإحصائيات والتقارير</h2>
        <p>مؤشرات الأداء، حجم المبيعات، توزيع الطلبات، وحالة استقرار النظام.</p>
        <div class="module-link-action"><span>فتح الإحصائيات</span> <i class="fas fa-arrow-left"></i></div>
      </a>
    </div>

    <!-- Change Logs Panel -->
    <div class="admin-panel-card">
      <div class="panel-card-header">
        <h2><i class="fas fa-history" style="color: var(--color-muted);"></i> سجل النشاطات والإجراءات (Change Logs)</h2>
      </div>

      <div class="table-responsive">
        <table class="logs-table">
          <thead>
            <tr>
              <th style="width: 220px;">المشرف</th>
              <th>الإجراء المنفذ</th>
              <th style="width: 180px;">التاريخ والوقت</th>
            </tr>
          </thead>
          <tbody id="logsTableBody">
            <tr>
              <td colspan="3" style="text-align:center; padding: 28px; color: var(--color-muted);">
                <i class="fas fa-spinner fa-spin"></i> جاري تحميل السجل...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script is:inline>
    const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
    const db = window.firestore || (typeof firebase !== 'undefined' ? firebase.firestore() : null);

    const operatorCard = document.getElementById('operatorCard');
    const operatorEmail = document.getElementById('operatorEmail');
    const operatorInitials = document.getElementById('operatorInitials');
    const logsTableBody = document.getElementById('logsTableBody');

    // Auth guard
    if (auth) {
      auth.onAuthStateChanged(user => {
        if (!user) {
          window.location.href = '/login';
        } else {
          if (operatorCard) operatorCard.style.display = 'inline-flex';
          if (operatorEmail) operatorEmail.textContent = user.email || 'Admin';
          if (operatorInitials) operatorInitials.textContent = (user.email ? user.email.charAt(0).toUpperCase() : 'A');
          
          fetchChangeLogs();
        }
      });
    }

    // Fetch Change Logs from Firestore
    async function fetchChangeLogs() {
      if (!db || !logsTableBody) return;
      try {
        const snapshot = await db.collection('change_logs')
                                 .orderBy('timestamp', 'desc')
                                 .limit(15)
                                 .get();

        if (snapshot.empty) {
          logsTableBody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding: 24px; color: var(--color-muted);">لا توجد نشاطات مسجلة حتى الآن.</td></tr>';
          return;
        }

        logsTableBody.innerHTML = '';

        snapshot.forEach(doc => {
          const data = doc.data();
          const adminEmail = data.adminEmail || 'غير معروف';
          const action = data.action || 'إجراء غير محدد';
          
          let dateString = 'الآن';
          if (data.timestamp) {
            const dateObj = data.timestamp.toDate();
            dateString = dateObj.toLocaleString('ar-EG', { 
              year: 'numeric', month: 'short', day: 'numeric',
              hour: '2-digit', minute: '2-digit'
            });
          }

          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><span class="admin-user-pill"><i class="fas fa-user-circle"></i> ${adminEmail}</span></td>
            <td style="font-weight: 500; color: var(--color-primary, #111827);">${action}</td>
            <td class="log-date" dir="ltr" style="text-align: right;">${dateString}</td>
          `;
          logsTableBody.appendChild(tr);
        });

      } catch (error) {
        console.warn("Could not fetch change logs: ", error.message);
        logsTableBody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding: 24px; color:var(--color-muted);">لا توجد نشاطات مسجلة حتى الآن.</td></tr>';
      }
    }
  </script>
</BaseLayout>

