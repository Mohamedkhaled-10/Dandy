---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="لوحة الإدارة | Dandy Operations"
  description="مركز إدارة العمليات ومتابعة المتجر"
  robots="noindex, nofollow"
  showHeader={false}
  showFooter={false}
  showDashboardNav={true}
>
  <slot name="head" slot="head">
    <style is:global>
      .dash-main-wrap {
        padding: 32px 20px 80px;
        max-width: 1400px;
        margin: 0 auto;
      }

      .dash-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
      }

      .dash-header-title h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--color-primary, #111827);
        margin: 0 0 4px 0;
      }

      .dash-header-title p {
        font-size: 0.88rem;
        color: var(--color-muted, #6b7280);
        margin: 0;
      }

      .operator-chip {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px 14px;
        background: var(--color-surface, #ffffff);
        border: 1px solid var(--border-light, #e5e7eb);
        border-radius: var(--border-radius-sm, 6px);
      }

      .operator-initial {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        background: var(--color-primary, #111827);
        color: #ffffff;
        font-weight: 800;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .operator-info {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-primary, #111827);
      }

      .btn-telegram-test {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: #0088cc;
        color: #ffffff;
        border: none;
        border-radius: var(--border-radius-sm, 6px);
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        font-family: inherit;
        transition: background 0.15s ease, transform 0.15s ease;
      }
      .btn-telegram-test:hover {
        background: #0077b5;
        transform: translateY(-1px);
      }
      .btn-telegram-test:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      /* Diagnostics Modal */
      .diag-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
      }
      .diag-modal-content {
        background: #ffffff;
        border-radius: 12px;
        max-width: 620px;
        width: 100%;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
        max-height: 90vh;
        overflow: hidden;
      }
      .diag-modal-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-light, #e5e7eb);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .diag-modal-header h3 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .diag-modal-close {
        background: none;
        border: none;
        font-size: 1.4rem;
        cursor: pointer;
        color: var(--color-muted, #6b7280);
      }
      .diag-modal-body {
        padding: 20px;
        overflow-y: auto;
        font-size: 0.9rem;
      }
      .diag-modal-footer {
        padding: 12px 20px;
        border-top: 1px solid var(--border-light, #e5e7eb);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: var(--color-surface-soft, #f9fafb);
      }
      .diag-btn-secondary {
        padding: 8px 16px;
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-family: inherit;
      }
      .diag-card-item {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 14px;
        margin-bottom: 12px;
      }
      .diag-badge-success {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        background: #dcfce7;
        color: #166534;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 700;
      }
      .diag-badge-fail {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        background: #fee2e2;
        color: #991b1b;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 700;
      }

      /* Clean Operational Bento Grid */
      .admin-modules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
        margin-bottom: 36px;
      }

      .module-card {
        background: var(--color-surface, #ffffff);
        border: 1px solid var(--border-light, #e5e7eb);
        border-radius: var(--border-radius-md, 8px);
        padding: 20px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s ease, transform 0.15s ease;
      }

      .module-card:hover {
        border-color: var(--color-primary, #111827);
        transform: translateY(-2px);
      }

      .module-icon-wrap {
        width: 40px;
        height: 40px;
        border-radius: 6px;
        background: var(--color-surface-soft, #f9fafb);
        border: 1px solid var(--border-light, #e5e7eb);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary, #111827);
        font-size: 1.1rem;
        margin-bottom: 14px;
      }

      .module-card h2 {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-primary, #111827);
        margin: 0 0 6px 0;
      }

      .module-card p {
        font-size: 0.82rem;
        color: var(--color-muted, #6b7280);
        line-height: 1.5;
        margin: 0 0 16px 0;
        flex: 1;
      }

      .module-link-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--color-primary, #111827);
        padding-top: 12px;
        border-top: 1px solid var(--border-light, #f3f4f6);
      }

      /* Clean Operational Change Logs */
      .admin-panel-card {
        background: var(--color-surface, #ffffff);
        border: 1px solid var(--border-light, #e5e7eb);
        border-radius: var(--border-radius-md, 8px);
        overflow: hidden;
      }

      .panel-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-light, #e5e7eb);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .panel-card-header h2 {
        font-size: 0.98rem;
        font-weight: 800;
        color: var(--color-primary, #111827);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .table-responsive {
        overflow-x: auto;
      }

      .logs-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        text-align: right;
      }

      .logs-table th {
        background: var(--color-surface-soft, #f9fafb);
        color: var(--color-muted, #4b5563);
        font-weight: 700;
        padding: 12px 20px;
        border-bottom: 1px solid var(--border-light, #e5e7eb);
        white-space: nowrap;
      }

      .logs-table td {
        padding: 12px 20px;
        border-bottom: 1px solid var(--border-light, #f3f4f6);
        vertical-align: middle;
      }

      .logs-table tr:last-child td {
        border-bottom: none;
      }

      .admin-user-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--color-surface-soft, #f3f4f6);
        color: var(--color-primary, #374151);
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 600;
      }

      .log-date {
        color: var(--color-muted, #6b7280);
        font-size: 0.8rem;
        white-space: nowrap;
      }

      @media (max-width: 640px) {
        .dash-main-wrap {
          padding: 20px 14px 60px;
        }
        .admin-modules-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </slot>

  <main class="dash-main-wrap" dir="rtl">
    <div class="dash-page-header">
      <div class="dash-header-title">
        <h1>لوحة التحكم الرئيسية</h1>
        <p>نظرة عامة على أقسام المتجر وسجل العمليات اللحظي.</p>
      </div>

      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <button type="button" id="btnTestTelegram" class="btn-telegram-test">
          <i class="fab fa-telegram-plane"></i>
          <span>فحص إشعارات التيليجرام</span>
        </button>

        <div class="operator-chip" id="operatorCard" style="display: none;">
          <div class="operator-initial" id="operatorInitials">A</div>
          <div class="operator-info" id="operatorEmail">...</div>
        </div>
      </div>
    </div>

    <!-- Operational Modules -->
    <div class="admin-modules-grid">
      <!-- Orders Module -->
      <a href="/dashboard-order" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-shopping-bag"></i></div>
        <h2>إدارة الطلبات</h2>
        <p>معالجة الطلبات الواردة، تحديث حالات الشحن، والاطلاع على تفاصيل الفواتير والعملاء.</p>
        <div class="module-link-action"><span>فتح الطلبات</span> <i class="fas fa-arrow-left"></i></div>
      </a>

      <!-- Products Module -->
      <a href="/dashboard-product" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-boxes"></i></div>
        <h2>المنتجات والمخزون</h2>
        <p>إضافة وتعديل المنتجات، ضبط الأسعار والتخفيضات، وإدارة خيارات الروائح والمخزون.</p>
        <div class="module-link-action"><span>فتح المنتجات</span> <i class="fas fa-arrow-left"></i></div>
      </a>

      <!-- Blog Module -->
      <a href="/dashboard-blog" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-newspaper"></i></div>
        <h2>المقالات والمدونة</h2>
        <p>تحرير ونشر المقالات الجمالية، وإدارة المحتوى الإرشادي والتصنيفات.</p>
        <div class="module-link-action"><span>فتح المدونة</span> <i class="fas fa-arrow-left"></i></div>
      </a>

      <!-- Homepage Index Module -->
      <a href="/dashboard-index" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-sliders-h"></i></div>
        <h2>تخصيص الواجهة</h2>
        <p>التحكم ببانرات الهيرو، الأقسام الديناميكية، شريط المزايا، ومجموعات المنتجات.</p>
        <div class="module-link-action"><span>فتح الواجهة</span> <i class="fas fa-arrow-left"></i></div>
      </a>

      <!-- Pink Friday Campaign Module -->
      <a href="/dashboard-pink-friday" class="module-card">
        <div class="module-icon-wrap" style="color: #db2777; background: #fdf2f8;"><i class="fas fa-tags"></i></div>
        <h2>إدارة حملة Pink Friday</h2>
        <p>التحكم بالحملة السنوية، ضبط الخصومات والمنتجات، معاينة التنسيقات قبل النشر، وتتبع الأرشيف التاريخي.</p>
        <div class="module-link-action"><span>إدارة الحملة</span> <i class="fas fa-arrow-left"></i></div>
      </a>

      <!-- Analytics Module -->
      <a href="/statues" class="module-card">
        <div class="module-icon-wrap"><i class="fas fa-chart-line"></i></div>
        <h2>الإحصائيات والتقارير</h2>
        <p>مؤشرات الأداء، حجم المبيعات، توزيع الطلبات، وحالة استقرار النظام.</p>
        <div class="module-link-action"><span>فتح الإحصائيات</span> <i class="fas fa-arrow-left"></i></div>
      </a>
    </div>

    <!-- Change Logs Panel -->
    <div class="admin-panel-card">
      <div class="panel-card-header">
        <h2><i class="fas fa-history" style="color: var(--color-muted);"></i> سجل النشاطات والإجراءات (Change Logs)</h2>
      </div>

      <div class="table-responsive">
        <table class="logs-table">
          <thead>
            <tr>
              <th style="width: 220px;">المشرف</th>
              <th>الإجراء المنفذ</th>
              <th style="width: 180px;">التاريخ والوقت</th>
            </tr>
          </thead>
          <tbody id="logsTableBody">
            <tr>
              <td colspan="3" style="text-align:center; padding: 28px; color: var(--color-muted);">
                <i class="fas fa-spinner fa-spin"></i> جاري تحميل السجل...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script is:inline>
    function escapeHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
    const db = window.firestore || (typeof firebase !== 'undefined' ? firebase.firestore() : null);

    const operatorCard = document.getElementById('operatorCard');
    const operatorEmail = document.getElementById('operatorEmail');
    const operatorInitials = document.getElementById('operatorInitials');
    const logsTableBody = document.getElementById('logsTableBody');

    // Strict Admin Auth Guard
    function handleDashboardAuth(user) {
      if (!user) {
        window.location.href = '/login';
        return;
      }
      if (!user.email || user.email.toLowerCase() !== 'admin@dandy.com') {
        window.location.replace('/');
        return;
      }
      if (operatorCard) operatorCard.style.display = 'inline-flex';
      if (operatorEmail) operatorEmail.textContent = user.email || 'Admin';
      if (operatorInitials) operatorInitials.textContent = (user.email ? user.email.charAt(0).toUpperCase() : 'A');
      
      fetchChangeLogs();
    }

    if (auth && typeof auth.onAuthStateChanged === 'function') {
      auth.onAuthStateChanged(handleDashboardAuth);
    } else {
      let attempts = 0;
      const pollInterval = setInterval(() => {
        attempts++;
        const a = window.auth || (typeof firebase !== 'undefined' && firebase.auth ? firebase.auth() : null);
        if (a && typeof a.onAuthStateChanged === 'function') {
          clearInterval(pollInterval);
          a.onAuthStateChanged(handleDashboardAuth);
        } else if (attempts > 30) {
          clearInterval(pollInterval);
          window.location.href = '/login';
        }
      }, 100);
    }

    // Fetch Change Logs from Firestore
    async function fetchChangeLogs() {
      if (!db || !logsTableBody) return;
      try {
        const snapshot = await db.collection('change_logs')
                                 .orderBy('timestamp', 'desc')
                                 .limit(15)
                                 .get();

        if (snapshot.empty) {
          logsTableBody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding: 24px; color: var(--color-muted);">لا توجد نشاطات مسجلة حتى الآن.</td></tr>';
          return;
        }

        logsTableBody.innerHTML = '';

        snapshot.forEach(doc => {
          const data = doc.data();
          const adminEmail = data.adminEmail || 'غير معروف';
          const action = data.action || 'إجراء غير محدد';
          
          let dateString = 'الآن';
          if (data.timestamp) {
            const dateObj = data.timestamp.toDate();
            dateString = dateObj.toLocaleString('ar-EG', { 
              year: 'numeric', month: 'short', day: 'numeric',
              hour: '2-digit', minute: '2-digit'
            });
          }

          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><span class="admin-user-pill"><i class="fas fa-user-circle"></i> ${escapeHtml(adminEmail)}</span></td>
            <td style="font-weight: 500; color: var(--color-primary, #111827);">${escapeHtml(action)}</td>
            <td class="log-date" dir="ltr" style="text-align: right;">${escapeHtml(dateString)}</td>
          `;
          logsTableBody.appendChild(tr);
        });

      } catch (error) {
        console.warn("Could not fetch change logs: ", error.message);
        logsTableBody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding: 24px; color:var(--color-muted);">لا توجد نشاطات مسجلة حتى الآن.</td></tr>';
      }
    }

    // Telegram Connection Diagnostic Logic
    const testModal = document.getElementById('telegramTestModal');
    const diagBody = document.getElementById('telegramDiagBody');
    const btnTestTelegram = document.getElementById('btnTestTelegram');
    const closeModalBtn = document.getElementById('closeTelegramModal');
    const closeModalFooterBtn = document.getElementById('closeTelegramModalBtn');
    const retryModalBtn = document.getElementById('retryTelegramModalBtn');

    function closeDiagModal() {
      if (testModal) testModal.style.display = 'none';
    }

    closeModalBtn?.addEventListener('click', closeDiagModal);
    closeModalFooterBtn?.addEventListener('click', closeDiagModal);
    retryModalBtn?.addEventListener('click', runTelegramDiagnosis);
    btnTestTelegram?.addEventListener('click', () => {
      if (testModal) testModal.style.display = 'flex';
      runTelegramDiagnosis();
    });

    async function runTelegramDiagnosis() {
      if (!diagBody) return;
      diagBody.innerHTML = `
        <div style="text-align: center; padding: 28px 16px;">
          <i class="fas fa-spinner fa-spin fa-2x" style="color: #0088cc;"></i>
          <p style="margin-top: 14px; font-weight: 700; color: #1e293b;">جاري فحص اتصال Telegram Bot والتحقق من الجروب...</p>
          <p style="font-size: 0.8rem; color: #64748b;">يتم فحص getMe و getChat وإرسال رسالة اختبار حقيقية إلى الجروب المصرح به.</p>
        </div>
      `;

      try {
        const currentUser = auth?.currentUser;
        if (!currentUser) {
          diagBody.innerHTML = `<div class="diag-card-item" style="border-color: #fca5a5; background: #fef2f2; color: #991b1b;"><i class="fas fa-exclamation-triangle"></i> يجب تسجيل الدخول كمسؤول أولاً.</div>`;
          return;
        }

        const idToken = await currentUser.getIdToken();
        const res = await fetch('/api/admin/telegram-test', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${idToken}`
          }
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok && res.status === 401) {
          diagBody.innerHTML = `<div class="diag-card-item" style="border-color: #fca5a5; background: #fef2f2; color: #991b1b;">غير مصرح: هذا الفحص متاح فقط لحساب admin@dandy.com.</div>`;
          return;
        }

        let html = '';
        const isSuccess = data.success === true;
        const statusBadge = isSuccess
          ? `<span class="diag-badge-success"><i class="fas fa-check-circle"></i> متصل بنجاح</span>`
          : `<span class="diag-badge-fail"><i class="fas fa-times-circle"></i> تعذر الاتصال</span>`;

        html += `
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h4 style="margin: 0; font-size: 1rem; font-weight: 800;">نتيجة الفحص التشخيصي</h4>
            ${statusBadge}
          </div>
        `;

        // Bot Info Card
        if (data.bot) {
          html += `
            <div class="diag-card-item">
              <div style="font-weight: 700; margin-bottom: 6px;"><i class="fas fa-robot"></i> بيانات البوت:</div>
              <div style="font-size: 0.84rem; color: #334155; line-height: 1.6;">
                <div><b>الحالة:</b> ${data.bot.valid ? '✅ Bot Token صالح وموثق' : '❌ Bot Token غير صالح'}</div>
                ${data.bot.username ? `<div><b>اسم المستخدم:</b> @${escapeHtml(data.bot.username)}</div>` : ''}
                ${data.bot.firstName ? `<div><b>الاسم:</b> ${escapeHtml(data.bot.firstName)}</div>` : ''}
              </div>
            </div>
          `;
        }

        // Chat Info Cards
        if (Array.isArray(data.chats) && data.chats.length > 0) {
          html += `<div style="font-weight: 700; margin: 12px 0 6px;"><i class="fas fa-comments"></i> الجروبات الموجه إليها:</div>`;
          data.chats.forEach((c, idx) => {
            const cardBg = c.messageSent ? '#f0fdf4' : '#fef2f2';
            const cardBorder = c.messageSent ? '#bbf7d0' : '#fecaca';
            html += `
              <div class="diag-card-item" style="background: ${cardBg}; border-color: ${cardBorder};">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <b>الوجهة ${idx + 1}: ${escapeHtml(c.title || c.chatId || 'جروب')}</b>
                  ${c.messageSent ? '<span class="diag-badge-success">وصلت الرسالة ✅</span>' : '<span class="diag-badge-fail">فشل الإرسال ❌</span>'}
                </div>
                <div style="font-size: 0.82rem; color: #475569; line-height: 1.6;">
                  <div><b>النوع:</b> ${escapeHtml(c.type || 'غير محدد')}</div>
                  <div><b>حالة عضوية البوت:</b> ${escapeHtml(c.botStatus || 'غير معروف')}</div>
                  <div><b>إمكانية الإرسال:</b> ${c.canSendMessages ? 'متاحة' : 'غير متاحة'}</div>
                  ${c.error ? `<div style="color: #b91c1c; margin-top: 4px;"><b>الخطأ:</b> ${escapeHtml(c.error.description || JSON.stringify(c.error))}</div>` : ''}
                </div>
              </div>
            `;
          });
        }

        if (data.message) {
          html += `<p style="margin-top: 12px; font-weight: 600; font-size: 0.85rem; color: #1e293b;">${escapeHtml(data.message)}</p>`;
        }

        diagBody.innerHTML = html;

      } catch (err) {
        diagBody.innerHTML = `<div class="diag-card-item" style="border-color: #fca5a5; background: #fef2f2; color: #991b1b;">حدث خطأ أثناء إجراء التشخيص: ${escapeHtml(err.message)}</div>`;
      }
    }
  </script>

  <!-- Telegram Diagnostic Modal HTML -->
  <div id="telegramTestModal" class="diag-modal-backdrop" style="display: none;">
    <div class="diag-modal-content">
      <div class="diag-modal-header">
        <h3><i class="fab fa-telegram-plane" style="color: #0088cc;"></i> فحص اتصال إشعارات تيليجرام</h3>
        <button type="button" class="diag-modal-close" id="closeTelegramModal">&times;</button>
      </div>
      <div class="diag-modal-body" id="telegramDiagBody">
        <!-- Content inserted dynamically -->
      </div>
      <div class="diag-modal-footer">
        <button type="button" class="diag-btn-secondary" id="closeTelegramModalBtn">إغلاق</button>
        <button type="button" class="btn-telegram-test" id="retryTelegramModalBtn">
          <i class="fas fa-redo"></i>
          <span>إعادة الفحص</span>
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

