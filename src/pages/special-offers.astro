---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="العروض الخاصة | Dandy Cosmetics - خصومات وتخفيضات مذهلة"
  description="استفيدي من العروض الخاصة والخصومات الحصرية من داندي (Dandy Cosmetics). منتجات أصلية للعناية بالبشرة والشعر بأسعار لا تقبل المنافسة."
  keywords="Dandy, Dandy Cosmetics, دندي, داندي, دندي للتجميل, عروض مستحضرات تجميل, خصومات العناية بالبشرة, تخفيضات دندي, Special Offers Cosmetics"
  canonical="https://dandy-ebon.vercel.app/special-offers"
>
  <slot name="head" slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dandy-ebon.vercel.app/special-offers" />
    <meta property="og:title" content="العروض الخاصة | Dandy Cosmetics - خصومات وتخفيضات مذهلة" />
    <meta property="og:description" content="استفيدي من العروض الخاصة والخصومات الحصرية من داندي (Dandy Cosmetics). منتجات أصلية بأسعار لا تقبل المنافسة." />
    <meta property="og:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="العروض الخاصة | Dandy Cosmetics - خصومات وتخفيضات مذهلة" />
    <meta name="twitter:description" content="استفيدي من العروض الخاصة والخصومات الحصرية من داندي (Dandy Cosmetics). منتجات أصلية بأسعار لا تقبل المنافسة." />
    <meta name="twitter:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "العروض الخاصة | Dandy Cosmetics",
        "description": "استفيدي من العروض الخاصة والخصومات الحصرية من داندي.",
        "url": "https://dandy-ebon.vercel.app/special-offers"
      }
    </script>

    <style is:global>
      .offers-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 16px;
        background: rgba(254, 93, 159, 0.18);
        color: #ff9ec7;
        border: 1px solid rgba(254, 93, 159, 0.35);
        font-weight: 700;
        font-size: 0.8rem;
        border-radius: 99px;
        margin-bottom: 14px;
        letter-spacing: 0.02em;
      }
      .offers-bf-hero-card {
        background: linear-gradient(135deg, #ff5e9c 0%, #fe5d9f 40%, #e02f78 85%, #c41e64 100%);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: var(--radius-lg, 20px);
        padding: 34px 28px;
        box-shadow: 0 16px 36px rgba(254, 93, 159, 0.28), 0 4px 12px rgba(0, 0, 0, 0.05);
        max-width: 860px;
        margin: 0 auto 30px;
        text-align: center;
        color: #ffffff;
      }
      .offers-title {
        font-size: 2.15rem;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 10px;
        line-height: 1.3;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .offers-subtitle {
        color: rgba(255, 255, 255, 0.95);
        max-width: 620px;
        margin: 0 auto 24px;
        font-size: 0.98rem;
        line-height: 1.6;
      }
      .offers-countdown-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding-top: 10px;
        border-top: 1px solid rgba(254, 93, 159, 0.2);
      }
      .offers-countdown-title {
        font-size: 0.82rem;
        color: #f7b4ce;
        font-weight: 600;
      }
      .bf-countdown-timer {
        display: flex;
        align-items: center;
        gap: 8px;
        direction: ltr;
      }
      .bf-time-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: rgba(0, 0, 0, 0.55);
        border: 1px solid rgba(254, 93, 159, 0.35);
        border-radius: 8px;
        min-width: 58px;
        padding: 8px 10px;
      }
      .bf-time-num {
        font-size: 1.5rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1;
        font-variant-numeric: tabular-nums;
      }
      .bf-time-unit {
        font-size: 0.68rem;
        color: #c4b0bd;
        margin-top: 4px;
        font-weight: 500;
      }
      .bf-time-sep {
        font-size: 1.35rem;
        font-weight: 700;
        color: #fe5d9f;
        margin-bottom: 8px;
      }
    </style>
  </slot>

  <section class="container" style="padding-top: 130px; text-align: center;">
    <div class="offers-bf-hero-card">
      <span class="offers-hero-badge">🔥 موسم الجمعة البيضاء • Dandy Black Friday</span>
      <h1 class="offers-title">أقوى عروض وتخفيضات الجمعة البيضاء</h1>
      <p class="offers-subtitle">استمتعي بخصومات استثنائية وباقات توفير حصرية على منتجات العناية الطبيعية الأصلية من داندي، سارعي بالطلب قبل نفاد الكمية.</p>

      <div class="offers-countdown-box">
        <span class="offers-countdown-title">تنتهي العروض والباقات الحصرية خلال:</span>
        <div class="bf-countdown-timer" id="offersBfCountdown">
          <div class="bf-time-block">
            <span class="bf-time-num" id="spDays">00</span>
            <span class="bf-time-unit">يوم</span>
          </div>
          <span class="bf-time-sep">:</span>
          <div class="bf-time-block">
            <span class="bf-time-num" id="spHours">00</span>
            <span class="bf-time-unit">ساعة</span>
          </div>
          <span class="bf-time-sep">:</span>
          <div class="bf-time-block">
            <span class="bf-time-num" id="spMinutes">00</span>
            <span class="bf-time-unit">دقيقة</span>
          </div>
          <span class="bf-time-sep">:</span>
          <div class="bf-time-block">
            <span class="bf-time-num" id="spSeconds">00</span>
            <span class="bf-time-unit">ثانية</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="products" style="padding: 10px 0 80px;">
    <div class="container">
      <div class="modern-product-grid" id="offersContainer">
        <p style="text-align: center; grid-column:1/-1; color: var(--color-muted); padding: 40px 0;">جاري تحضير العروض الخاصة...</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const db = window.db || (typeof firebase !== 'undefined' && firebase.database ? firebase.database() : null);

    function escapeHtml(string) {
      if (!string) return '';
      return String(string)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // تتبع وإدارة المفضلة
    window.userWishlistSet = window.userWishlistSet || new Set();

    function initWishlistTracking() {
      const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
      if (!auth) return;

      auth.onAuthStateChanged(async (user) => {
        if (!user) {
          window.userWishlistSet.clear();
          updateWishlistButtons();
          return;
        }

        try {
          if (!db) return;
          const snap = await db.ref('wishlists/' + user.uid).once('value');
          if (snap.exists()) {
            const val = snap.val() || {};
            window.userWishlistSet = new Set(Object.keys(val).filter(k => !!val[k]));
            updateWishlistButtons();
          }
        } catch (e) {
          console.warn('Error loading wishlist set:', e);
        }
      });
    }

    function updateWishlistButtons() {
      document.querySelectorAll('.btn-card-wishlist').forEach(btn => {
        const pid = btn.getAttribute('data-product-id');
        if (window.userWishlistSet.has(pid)) {
          btn.classList.add('active');
          const svg = btn.querySelector('svg');
          if (svg) svg.setAttribute('fill', 'currentColor');
        } else {
          btn.classList.remove('active');
          const svg = btn.querySelector('svg');
          if (svg) svg.setAttribute('fill', 'none');
        }
      });
    }

    window.toggleCardWishlist = async function(productId, btnEl) {
      const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
      const user = auth ? auth.currentUser : null;

      if (!user) {
        if (typeof showToast === 'function') {
          showToast('سجّلي دخولك لحفظ المنتج في المفضلة');
        } else {
          alert('سجّلي دخولك لحفظ المنتج في المفضلة');
        }
        setTimeout(() => { window.location.href = '/account-login'; }, 1000);
        return;
      }

      const isFav = btnEl.classList.contains('active');
      const svg = btnEl.querySelector('svg');

      try {
        if (isFav) {
          await db.ref('wishlists/' + user.uid + '/' + productId).remove();
          window.userWishlistSet.delete(productId);
          btnEl.classList.remove('active');
          if (svg) svg.setAttribute('fill', 'none');
          if (typeof showToast === 'function') showToast('تمت الإزالة من المفضلة');
        } else {
          await db.ref('wishlists/' + user.uid + '/' + productId).set(true);
          window.userWishlistSet.add(productId);
          btnEl.classList.add('active');
          if (svg) svg.setAttribute('fill', 'currentColor');
          if (typeof showToast === 'function') showToast('تمت الإضافة إلى المفضلة');
        }
      } catch (err) {
        console.error('Error toggling wishlist:', err);
      }
    };

    initWishlistTracking();

    window.quickAdd = function(id, name, price, image, discount, onSale, hasVariants, slug) {
      if (hasVariants) {
        const productLink = (typeof window.getProductLink === 'function')
          ? window.getProductLink({ id, slug, name })
          : (slug ? `/product/${encodeURIComponent(slug)}` : `/product?id=${id}`);
        window.location.href = productLink;
        return;
      }
      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      const productItem = { id, productId: id, name, price, image, discount, onSale };

      if (typeof fbq === 'function') {
        fbq('track', 'AddToCart', {
          content_name: name,
          content_ids: [id],
          content_type: 'product',
          value: parseFloat(price) || 0,
          currency: 'EGP'
        });
      }

      const existIndex = cart.findIndex(item => (item.productId || item.id) === id && (!item.selectedVariants || item.selectedVariants.length === 0) && !item.selectedVariant);
      if(existIndex !== -1) {
        cart[existIndex].quantity = (parseInt(cart[existIndex].quantity) || 0) + 1;
      } else {
        productItem.quantity = 1;
        cart.push(productItem);
      }

      localStorage.setItem("cart", JSON.stringify(cart));
      if (typeof window.updateSharedCartCount === 'function') window.updateSharedCartCount();
      if (typeof updateCartCount === 'function') updateCartCount();

      const alertDiv = document.createElement("div");
      alertDiv.style.position = "fixed";
      alertDiv.style.bottom = "100px";
      alertDiv.style.left = "50%";
      alertDiv.style.transform = "translateX(-50%)";
      alertDiv.style.background = "var(--color-dust-grey-100, #2c2828)";
      alertDiv.style.color = "#fff";
      alertDiv.style.padding = "10px 20px";
      alertDiv.style.borderRadius = "8px";
      alertDiv.style.boxShadow = "0 4px 12px rgba(0,0,0,0.15)";
      alertDiv.style.zIndex = "1030";
      alertDiv.style.fontWeight = "bold";
      alertDiv.style.textAlign = "center";
      alertDiv.innerHTML = `Added to Cart!`;
      document.body.appendChild(alertDiv);
      
      setTimeout(() => {
        alertDiv.style.opacity = "0";
        alertDiv.style.transition = "opacity 0.4s ease";
        setTimeout(() => alertDiv.remove(), 400);
      }, 2000);
    };

    const offersContainer = document.getElementById("offersContainer");

    db.ref("products").on("value", snapshot => {
      if (!offersContainer) return;
      offersContainer.innerHTML = "";
      let offerCount = 0;

      if (!snapshot.exists()) {
        offersContainer.innerHTML = `<p style="text-align:center;grid-column:1/-1;color:var(--color-muted);">No exclusive offers are currently available. Check our general catalogue.</p>`;
        return;
      }

      snapshot.forEach(child => {
        const data = child.val();
        
        if (data.onSale === true && !data.isHidden) {
          offerCount++;
          const productEl = document.createElement("div");
          
          productEl.className = "product-card product";
          productEl.setAttribute("data-category", data.category || 'Special Promo');
          const productLink = (typeof window.getProductLink === 'function')
            ? window.getProductLink({ ...data, id: child.key })
            : (data.slug ? `/product/${encodeURIComponent(data.slug)}` : `/product?id=${child.key}`);
          productEl.onclick = function() { window.location.href = productLink; };

          const priceRaw = parseFloat(data.price) || 0;
          let priceStr = `<span class="price-current">${priceRaw} ج.م</span>`;
          let badgeStr = '';

          if (data.originalPrice) {
            const oldPrice = parseFloat(data.originalPrice) || 0;
            priceStr = `<span class="price-current">${priceRaw} ج.م</span><span class="price-old">${oldPrice} ج.م</span>`;
            badgeStr = `<span class="card-badge black-friday-badge">بلاك فرايداي • عرض خاص</span>`;
          } else if (data.discount) {
            const discountPercent = parseFloat(data.discount) || 0;
            const oldPrice = (discountPercent > 0 && discountPercent < 100) ? Math.round(priceRaw / (1 - (discountPercent/100))) : 0;
            priceStr = `<span class="price-current">${priceRaw} ج.م</span>${oldPrice ? `<span class="price-old">${oldPrice} ج.م</span>` : ''}`;
            badgeStr = `<span class="card-badge black-friday-badge">بلاك فرايداي • خصم ${data.discount}%</span>`;
          }

          const hasVars = typeof hasSelectableVariants === 'function' 
            ? hasSelectableVariants(data) 
            : (data.hasVariants === true || data.hasVariants === 'true');

          let actionBtn = `
            <button type="button" class="card-add-btn add-cart-btn" onclick="event.stopPropagation(); quickAdd('${child.key}', \`${(data.name || '').replace(/`/g, '')}\`, '${data.price}', '${data.image}', '${data.discount || ''}', ${data.onSale || false}, false, '${data.slug || ''}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              <span>أضيفي للسلة</span>
            </button>
          `;

          if (hasVars) {
            actionBtn = `
              <button type="button" class="card-add-btn add-cart-btn" onclick="event.stopPropagation(); window.location.href='${productLink}'">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <span>اختاري الرائحة</span>
              </button>
            `;
          }

          if (data.isSoldOut) {
            badgeStr = `<span class="card-badge sold-out">نفذت الكمية</span>`;
            actionBtn = `
              <button type="button" disabled class="card-add-btn add-cart-btn is-sold-out" onclick="event.stopPropagation();">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                <span>نفذت الكمية</span>
              </button>
            `;
          }

          const isFavorited = window.userWishlistSet && window.userWishlistSet.has(child.key);
          const heartActive = isFavorited ? 'active' : '';
          const heartFill = isFavorited ? 'currentColor' : 'none';

          const reviewCountNum = Number(data.reviewCount) || 0;
          const avgRatingNum = Number(data.avgRating) || 0;
          const ratingHtml = reviewCountNum > 0 ? `
            <div class="card-rating-mini">
              <i class="fas fa-star card-rating-star"></i>
              <span class="card-rating-val">${avgRatingNum.toFixed(1)}</span>
              <span class="card-rating-count">(${reviewCountNum})</span>
            </div>
          ` : '';

          productEl.innerHTML = `
            <div class="card-image-box product-image-wrap">
              ${badgeStr}
              <button type="button" class="btn-card-wishlist ${heartActive}" data-product-id="${child.key}" onclick="event.stopPropagation(); window.toggleCardWishlist('${child.key}', this);" title="حفظ في المفضلة" aria-label="حفظ في المفضلة">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="${heartFill}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
              <img loading="lazy" src="${data.image || '/assets/images/logo.png'}" alt="${escapeHtml(data.name || 'عرض داندي')}" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=400&q=80';">
            </div>
            <div class="card-content-box product-info-box">
              ${data.category ? `<span class="card-category">${escapeHtml(data.category)}</span>` : ''}
              <h3 class="card-title product-title">${escapeHtml(data.name || '')}</h3>
              ${ratingHtml}
              <div class="card-price-row product-price">
                ${priceStr}
              </div>
              ${actionBtn}
            </div>
          `;
          
          offersContainer.appendChild(productEl);
        }
      });

      if (offerCount === 0) {
        offersContainer.innerHTML = `<p style="text-align:center;grid-column:1/-1;color:var(--color-muted);padding:40px 0;">لا توجد عروض ترويجية نشطة حالياً. يرجى تصفح باقي تشكيلة المنتجات.</p>`;
      }
    });

    function initOffersCountdown() {
      // 35 days target deadline: Nov 30, 2026, 23:59:59 Egypt Time (UTC+2)
      const targetDate = new Date('2026-11-30T23:59:59+02:00').getTime();

      function update() {
        const now = Date.now();
        const diff = targetDate - now;

        // AUTOMATIC EXPIRATION AFTER 35 DAYS
        if (diff <= 0) {
          const cdBox = document.getElementById('offersBfCountdown');
          if (cdBox && cdBox.closest('.offers-bf-hero-card')) {
            cdBox.closest('.offers-bf-hero-card').style.display = 'none';
          }
          document.querySelectorAll('.black-friday-badge').forEach(b => {
            b.classList.remove('black-friday-badge');
            b.textContent = b.textContent.replace('بلاك فرايداي • ', '');
          });
          if (window.spIntervalId) clearInterval(window.spIntervalId);
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        const dEl = document.getElementById('spDays');
        const hEl = document.getElementById('spHours');
        const mEl = document.getElementById('spMinutes');
        const sEl = document.getElementById('spSeconds');

        if (dEl) dEl.textContent = String(days).padStart(2, '0');
        if (hEl) hEl.textContent = String(hours).padStart(2, '0');
        if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
        if (sEl) sEl.textContent = String(seconds).padStart(2, '0');
      }

      update();
      window.spIntervalId = setInterval(update, 1000);
    }
    initOffersCountdown();
  </script>
</BaseLayout>
