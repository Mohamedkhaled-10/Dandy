---
// src/pages/product.astro
// Legacy Product Route & 301 Redirect Handler
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { getProductById } from '../utils/products';

const id = Astro.url.searchParams.get('id');

if (id) {
  const product = await getProductById(id);
  if (product && !product.isHidden) {
    // Preserve attribution/tracking parameters
    const searchParams = new URLSearchParams();
    for (const [k, v] of Astro.url.searchParams.entries()) {
      if (k.startsWith('utm_') || k === 'fbclid' || k === 'gclid') {
        searchParams.set(k, v);
      }
    }
    const qs = searchParams.toString() ? `?${searchParams.toString()}` : '';
    return Astro.redirect(`/product/${encodeURIComponent(product.resolvedSlug)}${qs}`, 301);
  } else {
    // Product ID was supplied but does not exist in DB -> real HTTP 404
    Astro.response.status = 404;
  }
} else {
  // Direct access to /product without an ID -> 301 redirect to catalog
  return Astro.redirect('/all-products', 301);
}
---

<BaseLayout
  title="المنتج غير موجود (404) | داندي كوزمتكس"
  description="عذراً، المنتج المطلوب غير متوفر حالياً في متجر داندي كوزمتكس."
  canonical="https://dandy-ebon.vercel.app/all-products"
  robots="noindex, nofollow"
>
  <main class="dandy-error-wrap dandy-container" data-dandy-motion="calm">
    <div class="dandy-error-code">404</div>
    <h1 class="dandy-font-ar-display">عذراً، المستحضر المطلوب غير متوفر</h1>
    <p>
      لم نتمكن من العثور على المنتج المطلوب برقم التعريف ({id || 'غير محدد'}). قد يكون المنتج قد نفد أو تم حذفه من التشكيلة.
    </p>
    <div class="dandy-error-actions">
      <a href="/all-products" class="dandy-btn dandy-btn--editorial">
        <Icon name="shopping-bag" size={16} strokeWidth={1.85} />
        <span>تصفح تشكيلة منتجات داندي</span>
      </a>
      <a href="/" class="dandy-btn dandy-btn--outline">
        <Icon name="home" size={16} strokeWidth={1.85} />
        <span>الصفحة الرئيسية</span>
      </a>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .dandy-error-wrap {
    min-height: 68vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: 72px 88px;
    max-width: 560px;
  }

  .dandy-error-code {
    font-family: var(--dandy-font-en-display);
    font-size: clamp(4rem, 10vw, 6rem);
    font-weight: 700;
    color: var(--dandy-border-default);
    line-height: 1;
    margin-bottom: 12px;
  }

  .dandy-error-wrap h1 {
    margin: 0 0 10px;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    color: var(--dandy-ink-primary);
  }

  .dandy-error-wrap p {
    margin: 0 0 28px;
    font-size: var(--dandy-text-base);
    line-height: 1.72;
    color: var(--dandy-ink-secondary);
  }

  .dandy-error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
