---
// src/pages/product.astro
// Legacy Product Route & 301 Redirect Handler
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getProductById } from '../utils/products';

const id = Astro.url.searchParams.get('id');

if (id) {
  const product = await getProductById(id);
  if (product && !product.isHidden) {
    // Preserve attribution/tracking parameters
    const searchParams = new URLSearchParams();
    for (const [k, v] of Astro.url.searchParams.entries()) {
      if (k.startsWith('utm_') || k === 'fbclid' || k === 'gclid') {
        searchParams.set(k, v);
      }
    }
    const qs = searchParams.toString() ? `?${searchParams.toString()}` : '';
    return Astro.redirect(`/product/${encodeURIComponent(product.resolvedSlug)}${qs}`, 301);
  } else {
    // Product ID was supplied but does not exist in DB -> real HTTP 404
    Astro.response.status = 404;
  }
} else {
  // Direct access to /product without an ID -> 301 redirect to catalog
  return Astro.redirect('/all-products', 301);
}
---

<BaseLayout
  title="المنتج غير موجود (404) | داندي كوزمتكس"
  description="عذراً، المنتج المطلوب غير متوفر حالياً في متجر داندي كوزمتكس."
  canonical="https://dandy-ebon.vercel.app/all-products"
  hideFooterTop={false}
>
  <slot name="head">
    <meta name="robots" content="noindex, nofollow" />
    <style>
      .not-found-container {
        text-align: center;
        padding: 160px 20px 100px;
        max-width: 600px;
        margin: 0 auto;
        direction: rtl;
        font-family: 'Tajawal', sans-serif;
      }
      .not-found-icon {
        font-size: 3.5rem;
        color: #db2777;
        margin-bottom: 20px;
      }
      .not-found-title {
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 12px;
        color: #18181b;
      }
      .not-found-desc {
        color: #71717a;
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 24px;
      }
      .btn-catalog-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #db2777;
        color: #ffffff;
        padding: 12px 28px;
        border-radius: 99px;
        text-decoration: none;
        font-weight: 700;
        transition: all 0.2s ease;
      }
      .btn-catalog-cta:hover {
        background: #be185d;
        transform: translateY(-2px);
      }
    </style>
  </slot>

  <main class="container">
    <div class="not-found-container">
      <div class="not-found-icon">
        <i class="fas fa-search"></i>
      </div>
      <h1 class="not-found-title">عذراً، المستحضر المطلوب غير متوفر</h1>
      <p class="not-found-desc">
        لم نتمكن من العثور على المنتج المطلوب برقم التعريف ({id || 'غير محدد'}). قد يكون المنتج قد نفد أو تم حذفه من التشكيلة.
      </p>
      <a href="/all-products" class="btn-catalog-cta">
        <i class="fas fa-th-large"></i>
        <span>تصفح تشكيلة منتجات داندي</span>
      </a>
    </div>
  </main>
</BaseLayout>
