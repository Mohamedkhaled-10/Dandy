---
// src/pages/pink-friday.astro
// Dedicated Campaign Page for Dandy Cosmetics Pink Friday Event
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProducts, SITE_URL, type Product } from '../utils/products';
import {
  getPublishedPinkFridayCampaign,
  getCampaignStatus,
  calculatePinkFridayPricing,
  validateOffer,
  type PinkFridayCampaign
} from '../utils/pink-friday-server';

const campaign: PinkFridayCampaign = await getPublishedPinkFridayCampaign();
const realStatus = getCampaignStatus(campaign);
const allProducts = await getAllProducts();

// State simulation and preview support for QA and visual auditing
const stateParam = Astro.url.searchParams.get('state');
const previewParam = Astro.url.searchParams.get('preview');

let status = realStatus;
const isPreview = previewParam === '1' || previewParam === 'true';

if (stateParam) {
  if (['disabled', 'upcoming', 'active', 'ended', 'collections', 'offers', 'hybrid'].includes(stateParam)) {
    status = (stateParam === 'collections' || stateParam === 'offers' || stateParam === 'hybrid') ? 'active' : stateParam as any;
  }
} else if (isPreview && status !== 'active') {
  status = 'active';
}

interface ValidCampaignItem {
  product: Product;
  regularPrice: number;
  campaignPrice: number;
  discountAmount: number;
  discountPercentage: number;
  badgeText: string;
}

const validCampaignItems: ValidCampaignItem[] = [];

// When simulating 'collections' only, do not populate individual offers
if (status === 'active' && stateParam !== 'collections') {
  if (campaign.offers && campaign.offers.length > 0) {
    for (const offer of campaign.offers) {
      if (!offer.active) continue;
      const prod = allProducts.find(p => String(p.id) === String(offer.productId));
      if (!prod) continue;

      const validation = validateOffer(offer, prod, campaign);
      if (validation.isValid) {
        const pricing = calculatePinkFridayPricing(prod, campaign);
        if (pricing.isEligible) {
          validCampaignItems.push({
            product: prod,
            regularPrice: pricing.regularPrice,
            campaignPrice: pricing.campaignPrice,
            discountAmount: pricing.discountAmount,
            discountPercentage: pricing.discountPercentage,
            badgeText: offer.badgeText || campaign.visuals?.badgeText || 'Pink Friday'
          });
        }
      }
    }
  }

  // If testing 'offers' or 'hybrid' and database has 0 offers, mock 3 catalog items for visual QA
  if ((stateParam === 'offers' || stateParam === 'hybrid') && validCampaignItems.length === 0 && allProducts.length > 0) {
    allProducts.slice(0, 3).forEach((prod, i) => {
      const reg = parseFloat(String(prod.price)) || 250;
      const discPct = 20 + i * 5;
      const camp = Math.round(reg * (1 - discPct / 100));
      validCampaignItems.push({
        product: prod,
        regularPrice: reg,
        campaignPrice: camp,
        discountAmount: reg - camp,
        discountPercentage: discPct,
        badgeText: 'خصم خاص'
      });
    });
  }
}

interface ResolvedCollectionItem {
  collectionItemId: string;
  productId: string;
  productName: string;
  image: string;
  price: number;
  scents: Array<{ id: string; name: string }>;
  defaultVariantId?: string;
}

interface ValidCollectionItem {
  id: string;
  name: string;
  description: string;
  coverImage: string;
  badgeText: string;
  pricingType: 'package' | 'percentage';
  packagePrice?: number;
  discountPercentage?: number;
  calculatedPrice: number;
  totalRegularPrice: number;
  savings: number;
  items: ResolvedCollectionItem[];
}

const validCollections: ValidCollectionItem[] = [];

// When simulating 'offers' only, do not populate collections
if (status === 'active' && stateParam !== 'offers') {
  const rawCampaignCollections = campaign.collections;
  const campaignCollectionsList = Array.isArray(rawCampaignCollections)
    ? rawCampaignCollections
    : (rawCampaignCollections && typeof rawCampaignCollections === 'object' ? Object.values(rawCampaignCollections) : []);

  if (campaignCollectionsList.length > 0) {
    for (const col of campaignCollectionsList) {
      if (!col || col.active === false) continue;
      const colItems = Array.isArray(col.items)
        ? col.items
        : (col.items && typeof col.items === 'object' ? Object.values(col.items) : []);
      if (colItems.length === 0) continue;

      let totalRegPrice = 0;
      let isAllAvailable = true;
      const resolvedItems: ResolvedCollectionItem[] = [];

      for (const cItem of colItems) {
        const prod = allProducts.find(p => String(p.id) === String(cItem.productId));
        if (!prod || prod.isHidden || prod.isSoldOut) {
          isAllAvailable = false;
          break;
        }
        const itemBasePrice = parseFloat(String(prod.price)) || 0;
        totalRegPrice += itemBasePrice;

        // Extract scents / variants if available
        const rawScents = (prod as any).scents || (prod as any).variants || [];
        const cleanScents = Array.isArray(rawScents) ? rawScents.map(s => ({
          id: typeof s === 'object' ? (s.id || s.name) : String(s),
          name: typeof s === 'object' ? s.name : String(s)
        })) : [];

        resolvedItems.push({
          collectionItemId: cItem.collectionItemId,
          productId: cItem.productId,
          productName: prod.name,
          image: prod.image,
          price: itemBasePrice,
          scents: cleanScents,
          defaultVariantId: cItem.defaultVariantId
        });
      }

      if (!isAllAvailable) continue;

      let calcPrice = totalRegPrice;
      if (col.pricingType === 'package' && typeof col.packagePrice === 'number' && col.packagePrice > 0) {
        calcPrice = col.packagePrice;
      } else if (col.pricingType === 'percentage' && typeof col.discountPercentage === 'number' && col.discountPercentage > 0) {
        calcPrice = Math.round(totalRegPrice * (1 - col.discountPercentage / 100));
      } else if (typeof col.packagePrice === 'number' && col.packagePrice > 0) {
        calcPrice = col.packagePrice;
      } else if (typeof col.discountPercentage === 'number' && col.discountPercentage > 0) {
        calcPrice = Math.round(totalRegPrice * (1 - col.discountPercentage / 100));
      }

      const savings = Math.max(0, totalRegPrice - calcPrice);

      validCollections.push({
        id: col.id,
        name: col.name,
        description: col.description || '',
        coverImage: col.coverImage || resolvedItems[0]?.image || '',
        badgeText: col.badgeText || 'كوليكشن داندي',
        pricingType: col.pricingType,
        packagePrice: col.packagePrice,
        discountPercentage: col.discountPercentage,
        calculatedPrice: calcPrice,
        totalRegularPrice: totalRegPrice,
        savings,
        items: resolvedItems
      });
    }
  }
}

const pageTitle = "عروض Pink Friday | داندي كوزمتكس";
const pageDescription = "استعدّي لتجربة تسوّق استثنائية مع عروض Pink Friday الحصرية من داندي. مستحضرات طبيعية للعناية بالبشرة والشعر بأعلى جودة.";
const canonicalUrl = `${SITE_URL}/pink-friday`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
>
  <slot name="head" slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "عروض Pink Friday من داندي كوزمتكس",
      "url": canonicalUrl,
      "description": pageDescription,
      "publisher": {
        "@type": "Organization",
        "name": "Dandy Cosmetics",
        "url": SITE_URL
      }
    })} />
  </slot>

  <main class="pf-page" id="pink-friday-main" dir="rtl">
    {isPreview && (
      <aside class="pf-preview-banner" aria-label="شريط المعاينة">
        <div class="pf-container pf-preview-inner">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <span>وضع المعاينة الإدارية المباشرة لحملة Pink Friday</span>
        </div>
      </aside>
    )}

    <!-- Premium Campaign Hero Section -->
    <section class="pf-hero" aria-label="بانر عروض Pink Friday">
      <div class="pf-hero-backdrop"></div>
      <div class="pf-container pf-hero-content">
        <div class="pf-kicker-tag">
          <span class="pf-kicker-sparkle" aria-hidden="true">✨</span>
          <span>{campaign.visuals?.badgeText || "موسم الجمال الحصري — Pink Friday"}</span>
        </div>
        <h1 class="pf-hero-title">{campaign.visuals?.headline || "عروض Pink Friday الحصرية"}</h1>
        <p class="pf-hero-subtitle">
          {campaign.visuals?.subtitle || "استعدّي لتجربة تسوّق استثنائية مع عروض Pink Friday من داندي. عناية طبيعية فائقة وتخفيضات موسمية مميزة."}
        </p>

        {status === 'active' && (validCampaignItems.length > 0 || validCollections.length > 0) && (
          <div class="pf-hero-actions">
            <a href={validCampaignItems.length > 0 ? "#pink-friday-products" : "#pink-friday-collections"} class="pf-btn pf-btn-primary">
              <span>{campaign.visuals?.ctaText || "اكتشفي العروض"}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
            </a>
          </div>
        )}

        {status === 'upcoming' && (
          <div class="pf-status-badge pf-status-upcoming">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>عروض Pink Friday تنطلق قريبًا جدًا</span>
          </div>
        )}

        {status === 'ended' && (
          <div class="pf-status-badge pf-status-ended">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>انتهت عروض Pink Friday لهذا الموسم</span>
          </div>
        )}

        {status === 'disabled' && (
          <div class="pf-status-badge pf-status-neutral">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>نجهّز لكِ تجربة تسوق استثنائية قريبًا</span>
          </div>
        )}
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="pf-section" id="pink-friday-products" aria-label="محتوى عروض Pink Friday">
      <div class="pf-container">
        
        {/* Collections / Bundles Section (Presented first or alone) */}
        {status === 'active' && validCollections.length > 0 && (
          <div id="pink-friday-collections" class="pf-collections-group">
            <div class="pf-section-header">
              <span class="pf-section-pretitle">مجموعات متميزة وحصرية</span>
              <h2 class="pf-section-title">كوليكشنز Pink Friday</h2>
              <div class="pf-divider"></div>
            </div>

            <div class="pf-products-grid">
              {validCollections.map((col) => (
                <article class="pf-card pf-col-card">
                  <div class="pf-card-media">
                    <span class="pf-badge">{col.badgeText}</span>
                    {col.savings > 0 && (
                      <span class="pf-discount-chip">وفر {col.savings.toFixed(0)} ج.م</span>
                    )}
                    <div class="pf-card-img-link">
                      <img
                        src={col.coverImage}
                        alt={col.name}
                        width="380"
                        height="380"
                        loading="lazy"
                        decoding="async"
                        onerror="this.onerror=null;this.src='/assets/images/logo.png';"
                      />
                    </div>
                  </div>

                  <div class="pf-card-body">
                    <h3 class="pf-card-title">
                      <span>{col.name}</span>
                    </h3>
                    <p class="pf-col-desc">
                      {col.description || `بكج متكامل يحتوي على ${col.items.length} منتجات أصلية من داندي.`}
                    </p>

                    <!-- Included items preview -->
                    <div class="pf-col-preview-box">
                      <div class="pf-col-preview-label">محتويات الكوليكشن ({col.items.length}):</div>
                      <ul class="pf-col-items-list">
                        {col.items.map(it => (
                          <li>
                            <span class="pf-col-item-bullet">•</span>
                            <span>{it.productName}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="pf-card-pricing">
                      <div class="pf-price-current">
                        <span class="pf-price-val">{col.calculatedPrice.toFixed(0)}</span>
                        <span class="pf-price-cur">ج.م</span>
                      </div>
                      {col.totalRegularPrice > col.calculatedPrice && (
                        <div class="pf-price-orig">
                          <span class="pf-price-val">{col.totalRegularPrice.toFixed(0)}</span>
                          <span class="pf-price-cur">ج.م</span>
                        </div>
                      )}
                    </div>

                    {col.savings > 0 && (
                      <div class="pf-savings-note">
                        وفّري إجمالي <strong>{col.savings.toFixed(0)} ج.م</strong>
                      </div>
                    )}

                    <div class="pf-card-footer">
                      <button
                        type="button"
                        class="pf-btn pf-btn-primary pf-col-btn btn-open-col-modal"
                        data-col-id={col.id}
                        data-col-name={col.name}
                        data-col-price={col.calculatedPrice}
                        data-col-json={JSON.stringify(col)}
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <span>اختيار الروائح وإضافة للسلة</span>
                      </button>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        {/* Individual Products Offers Section */}
        {status === 'active' && validCampaignItems.length > 0 && (
          <div class="pf-offers-group">
            <div class="pf-section-header">
              <span class="pf-section-pretitle">عروض فردية خاصة</span>
              <h2 class="pf-section-title">منتجات مميزة في الحملة</h2>
              <div class="pf-divider"></div>
            </div>

            <div class="pf-products-grid">
              {validCampaignItems.map(({ product, regularPrice, campaignPrice, discountAmount, discountPercentage, badgeText }) => (
                <article class="pf-card">
                  <div class="pf-card-media">
                    <span class="pf-badge">{badgeText}</span>
                    {discountPercentage > 0 && (
                      <span class="pf-discount-chip">خصم {discountPercentage}%</span>
                    )}
                    <a href={`/product/${product.resolvedSlug}`} class="pf-card-img-link" aria-label={product.name}>
                      <img
                        src={product.image}
                        alt={product.name}
                        width="380"
                        height="380"
                        loading="lazy"
                        decoding="async"
                        onerror="this.onerror=null;this.src='/assets/images/logo.png';"
                      />
                    </a>
                  </div>

                  <div class="pf-card-body">
                    <h3 class="pf-card-title">
                      <a href={`/product/${product.resolvedSlug}`}>{product.name}</a>
                    </h3>

                    <div class="pf-card-pricing">
                      <div class="pf-price-current">
                        <span class="pf-price-val">{campaignPrice.toFixed(0)}</span>
                        <span class="pf-price-cur">ج.م</span>
                      </div>
                      <div class="pf-price-orig">
                        <span class="pf-price-val">{regularPrice.toFixed(0)}</span>
                        <span class="pf-price-cur">ج.م</span>
                      </div>
                    </div>

                    <div class="pf-savings-note">
                      وفّري <strong>{discountAmount.toFixed(0)} ج.م</strong>
                    </div>

                    <div class="pf-card-footer">
                      <a href={`/product/${product.resolvedSlug}`} class="pf-card-btn">
                        <span>عرض التفاصيل والطلب</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 19l-7-7 7-7"/></svg>
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        {/* Empty State: Active but no offers or collections configured yet */}
        {status === 'active' && validCampaignItems.length === 0 && validCollections.length === 0 && (
          <div class="pf-empty-state">
            <div class="pf-empty-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <h2 class="pf-empty-title">نجهّز لكِ عروض Pink Friday المميزة</h2>
            <p class="pf-empty-desc">
              نقوم حالياً بإعداد تشكيلة مختارة من أقوى المنتجات الطبيعية. تابعينا لاكتشاف العروض فور تدشينها!
            </p>
            <div class="pf-empty-actions">
              <a href="/all-products" class="pf-btn pf-btn-secondary">
                <span>تصفح جميع المنتجات</span>
              </a>
              <a href="/special-offers" class="pf-btn pf-btn-outline">
                <span>العروض الخاصة الحالية</span>
              </a>
            </div>
          </div>
        )}

        {/* Upcoming State */}
        {status === 'upcoming' && (
          <div class="pf-empty-state">
            <div class="pf-empty-icon pf-icon-accent">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h2 class="pf-empty-title">عروض Pink Friday قادمة قريبًا</h2>
            <p class="pf-empty-desc">
              ترقبي أقوى تجارب العناية والتألق من داندي. عروض خاصة وبكجات مخصصة بأسعار حصرية لفترة محدودة.
            </p>
            <div class="pf-empty-actions">
              <a href="/all-products" class="pf-btn pf-btn-secondary">
                <span>تصفح جميع المنتجات</span>
              </a>
              <a href="/special-offers" class="pf-btn pf-btn-outline">
                <span>عروضنا الحالية</span>
              </a>
            </div>
          </div>
        )}

        {/* Ended State */}
        {status === 'ended' && (
          <div class="pf-empty-state">
            <div class="pf-empty-icon pf-icon-muted">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M16 8V6a4 4 0 0 0-8 0v2"/><line x1="12" y1="12" x2="12" y2="16"/></svg>
            </div>
            <h2 class="pf-empty-title">انتهت عروض Pink Friday</h2>
            <p class="pf-empty-desc">
              شكرًا لتسوقكِ معنا! يمكنكِ متابعة أحدث العروض والمنتجات الطبيعية من خلال أقسام المتجر الدائمة.
            </p>
            <div class="pf-empty-actions">
              <a href="/all-products" class="pf-btn pf-btn-secondary">
                <span>تصفح جميع المنتجات</span>
              </a>
              <a href="/special-offers" class="pf-btn pf-btn-outline">
                <span>العروض الحالية</span>
              </a>
            </div>
          </div>
        )}

        {/* Disabled State */}
        {status === 'disabled' && (
          <div class="pf-empty-state">
            <div class="pf-empty-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            </div>
            <h2 class="pf-empty-title">الحملة غير متاحة حالياً</h2>
            <p class="pf-empty-desc">
              حملة Pink Friday ليست نشطة في الوقت الحالي. استمتعي بتجربة تسوق طبيعية ومتكاملة عبر تشكيلاتنا الدائمة.
            </p>
            <div class="pf-empty-actions">
              <a href="/all-products" class="pf-btn pf-btn-secondary">
                <span>تصفح جميع المنتجات</span>
              </a>
            </div>
          </div>
        )}

      </div>
    </section>

    <!-- Collection Scent Selection Modal -->
    <div class="pf-modal-backdrop" id="storefrontColModal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="sfColModalName">
      <div class="pf-modal-dialog">
        <div class="pf-modal-header">
          <h3 class="pf-modal-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fe5d9f" stroke-width="2" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span id="sfColModalName">تخصيص الروائح للكوليكشن</span>
          </h3>
          <button type="button" id="btnCloseSfColModal" class="pf-modal-close" aria-label="إغلاق">&times;</button>
        </div>

        <p class="pf-modal-subtext">
          اختاري العطر/الرائحة المفضلة لكل منتج داخل الكوليكشن قبل الإضافة للسلة:
        </p>

        <div id="sfColItemsContainer" class="pf-modal-items">
          <!-- Populated dynamically via JS -->
        </div>

        <div class="pf-modal-footer">
          <div class="pf-modal-total-wrap">
            <span class="pf-modal-total-label">السعر الإجمالي للبكج:</span>
            <div class="pf-modal-total-price" id="sfColModalTotalPrice">0 ج.م</div>
          </div>

          <button type="button" class="pf-btn pf-btn-primary pf-modal-submit-btn" id="btnConfirmAddColToCart">
            <span>تأكيد وإضافة للسلة</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
          </button>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    let selectedColData = null;

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.btn-open-col-modal').forEach(btn => {
        btn.addEventListener('click', () => {
          const rawJson = btn.getAttribute('data-col-json');
          if (!rawJson) return;
          try {
            selectedColData = JSON.parse(rawJson);
            renderSfColModal();
            const modal = document.getElementById('storefrontColModal');
            if (modal) modal.style.display = 'flex';
          } catch (e) {
            console.error('Error parsing col json:', e);
          }
        });
      });

      document.getElementById('btnCloseSfColModal')?.addEventListener('click', () => {
        const modal = document.getElementById('storefrontColModal');
        if (modal) modal.style.display = 'none';
      });

      // Close modal on backdrop click
      document.getElementById('storefrontColModal')?.addEventListener('click', (e) => {
        if (e.target.id === 'storefrontColModal') {
          e.target.style.display = 'none';
        }
      });

      function renderSfColModal() {
        if (!selectedColData) return;
        document.getElementById('sfColModalName').textContent = selectedColData.name;
        document.getElementById('sfColModalTotalPrice').textContent = selectedColData.calculatedPrice + ' ج.م';

        const container = document.getElementById('sfColItemsContainer');
        if (!container) return;
        container.innerHTML = '';

        selectedColData.items.forEach((item, idx) => {
          const div = document.createElement('div');
          div.className = 'sf-modal-item-row';

          const scents = item.scents || [];
          let scentSelectHtml = '';

          if (scents.length > 0) {
            scentSelectHtml = `
              <select class="sf-item-scent-select" data-item-index="${idx}">
                ${scents.map(s => `<option value="${s.id}" ${String(s.id) === String(item.defaultVariantId) ? 'selected' : ''}>${s.name}</option>`).join('')}
              </select>
            `;
          } else {
            scentSelectHtml = `<span class="sf-item-fixed-note">شامل حسب التشكيلة</span>`;
          }

          div.innerHTML = `
            <div class="sf-modal-item-info">
              <img src="${item.image}" alt="${item.productName}" class="sf-modal-item-img">
              <strong class="sf-modal-item-name">${item.productName}</strong>
            </div>
            <div class="sf-modal-item-scent">${scentSelectHtml}</div>
          `;

          container.appendChild(div);
        });
      }

      document.getElementById('btnConfirmAddColToCart')?.addEventListener('click', () => {
        if (!selectedColData) return;

        const selectedItems = [];
        const scentSelects = document.querySelectorAll('.sf-item-scent-select');

        selectedColData.items.forEach((item, idx) => {
          const select = Array.from(scentSelects).find(s => s.getAttribute('data-item-index') === String(idx));
          let chosenScent = null;
          if (select) {
            const selectedOpt = select.options[select.selectedIndex];
            if (selectedOpt) {
              chosenScent = { id: selectedOpt.value, name: selectedOpt.textContent };
            }
          }

          selectedItems.push({
            collectionItemId: item.collectionItemId,
            productId: item.productId,
            productName: item.productName,
            selectedVariant: chosenScent
          });
        });

        const cartItem = {
          type: 'collection',
          isCollection: true,
          isPinkFriday: true,
          collectionId: selectedColData.id,
          name: selectedColData.name,
          price: selectedColData.calculatedPrice,
          regularPrice: selectedColData.totalRegularPrice,
          image: selectedColData.coverImage,
          quantity: 1,
          selectedItems: selectedItems
        };

        // Add to localStorage cart
        let cart = [];
        try {
          cart = JSON.parse(localStorage.getItem('cart') || '[]');
        } catch (e) {
          cart = [];
        }

        cart.push(cartItem);
        localStorage.setItem('cart', JSON.stringify(cart));
        localStorage.setItem('dandy_cart', JSON.stringify(cart));

        const modal = document.getElementById('storefrontColModal');
        if (modal) modal.style.display = 'none';

        // Trigger cart badge updates
        if (typeof window.updateSharedCartCount === 'function') window.updateSharedCartCount();
        if (typeof window.updateCartBadge === 'function') window.updateCartBadge();
        if (typeof window.openCartDrawer === 'function') window.openCartDrawer();
        else window.location.href = '/cart';
      });
    });
  </script>
</BaseLayout>

