  <script>
    import Sortable from 'sortablejs';

    // Type Definitions for Studio
    interface HeroSlide {
      desktopImage?: string;
      mobileImage?: string;
      image?: string;
      duration?: number;
      title?: string;
      subtitle?: string;
      buttonText?: string;
      link?: string;
    }

    interface HeroMetaConfig {
      kicker?: string;
      secondaryCtaLabel?: string;
      secondaryCtaHref?: string;
