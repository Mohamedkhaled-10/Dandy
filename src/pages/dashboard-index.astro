        </div>
      `;

      const reviewsSortable = document.getElementById('reviewsSortableList');
      if (reviewsSortable && studioState.reviews.length > 1) {
        Sortable.create(reviewsSortable, {
          handle: '.review-drag-handle',
          animation: 150,
          onEnd: (evt) => {
            if (evt.oldIndex !== undefined && evt.newIndex !== undefined && evt.oldIndex !== evt.newIndex) {
              const moved = studioState.reviews.splice(evt.oldIndex, 1)[0];
              studioState.reviews.splice(evt.newIndex, 0, moved);
