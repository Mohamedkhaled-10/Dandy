    function openStudioConfirm(message: string, title = 'تأكيد الحذف'): Promise<boolean> {
      return new Promise((resolve) => {
        const modal = document.getElementById('studioConfirmModal');
        const msgEl = document.getElementById('studioConfirmMessage');
        const titleEl = document.getElementById('studioConfirmTitle');
        const okBtn = document.getElementById('studioConfirmOkBtn');
        const cancelBtn = document.getElementById('studioConfirmCancelBtn');
        const closeBtn = document.getElementById('studioConfirmCloseBtn');
        if (!modal || !msgEl || !okBtn || !cancelBtn) {
          resolve(false);
          return;
        }

        if (titleEl) {
          titleEl.innerHTML = `<i class="fas fa-exclamation-triangle" style="color:#d97706;"></i> <span>${escapeHtml(title)}</span>`;
        }
        msgEl.textContent = message;
        modal.classList.add('is-open');

        const cleanup = (result: boolean) => {
          modal.classList.remove('is-open');
          okBtn.removeEventListener('click', onOk);
          cancelBtn.removeEventListener('click', onCancel);
          closeBtn?.removeEventListener('click', onCancel);
          modal.removeEventListener('click', onBackdrop);
          resolve(result);
        };
        const onOk = () => cleanup(true);
        const onCancel = () => cleanup(false);
        const onBackdrop = (ev: MouseEvent) => {
          if (ev.target === modal) cleanup(false);
        };

        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        closeBtn?.addEventListener('click', onCancel);
        modal.addEventListener('click', onBackdrop);
      });
    }

    function switchSidebarTab(tab: 'nav' | 'inspector') {
      const navBtn = document.getElementById('tabNavBtn');
      const insBtn = document.getElementById('tabInspectorBtn');
      const navView = document.getElementById('sidebarViewNav');
      const insView = document.getElementById('sidebarViewInspector');

      if (tab === 'nav') {
        navBtn?.classList.add('active');
        insBtn?.classList.remove('active');
        if (navView) navView.style.display = 'block';
        if (insView) insView.style.display = 'none';
      } else {
        insBtn?.classList.add('active');
        navBtn?.classList.remove('active');
        if (insView) insView.style.display = 'block';
        if (navView) navView.style.display = 'none';
      }
    }

    function findDynamicProductSection(secKey: 'offers' | 'newArrivals'): DynamicSection | undefined {
      const list = studioState.sections || [];
      if (secKey === 'offers') {
        return (
          list.find((s) => s && (s.id === 'sec-special-offers' || s.id === 'sec-offers')) ||
          list.find((s) => s && s.type === 'offers')
        );
      }
      const offersCandidate =
        list.find((s) => s && (s.id === 'sec-special-offers' || s.id === 'sec-offers')) ||
        list.find((s) => s && s.type === 'offers');
      return (
        list.find((s) => s && (s.id === 'sec-new-arrivals' || s.id === 'sec-newArrivals')) ||
        list.find((s) => s && s.id !== offersCandidate?.id && s.type !== 'offers')
      );
    }

    function isSectionCurrentlyVisible(secId: string): boolean {
      if (studioState.sectionsVisibility && studioState.sectionsVisibility[secId] !== undefined) {
        return studioState.sectionsVisibility[secId] !== false;
      }
      if (secId === 'offers' || secId === 'newArrivals') {
        const secObj = findDynamicProductSection(secId);
        return secObj ? secObj.visible !== false : true;
      }
      return true;
    }

    function selectSection(secId: string, switchTab = true) {
      activeSectionId = secId;
      renderSectionsNavigator();
      renderActiveInspector();
      if (switchTab) {
        switchSidebarTab('inspector');
      }
      sendIframeMessage({ type: 'STUDIO_SELECT_SECTION', sectionId: secId });
    }

    function toggleSectionVisibility(secId: string, e?: Event) {
      if (e) e.stopPropagation();
      if (!studioState.sectionsVisibility) {
        studioState.sectionsVisibility = {};
      }
      const currentVis = isSectionCurrentlyVisible(secId);
      studioState.sectionsVisibility[secId] = !currentVis;

      if (secId === 'offers' || secId === 'newArrivals') {
        const target = findDynamicProductSection(secId);
        if (target) {
          target.visible = studioState.sectionsVisibility[secId];
        }
      }

      recordStateMutation();
      renderSectionsNavigator();
      renderActiveInspector();
    }

