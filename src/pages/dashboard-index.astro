            }
          }
        });
      }
    }

    (window as any).updateReviewsSectionMeta = function(field: 'kicker' | 'title', val: string, isLiveInput = false) {
      if (studioLang === 'en') {
        const ov = ensureEnOverlay();
        if (!ov.reviewsSection) ov.reviewsSection = {};
        ov.reviewsSection[field] = val;
      } else {
        if (!studioState.reviewsSection) studioState.reviewsSection = {};
        studioState.reviewsSection[field] = val;
      }
      if (isLiveInput) scheduleLivePreviewMutation();
      else recordStateMutation();
    };

    (window as any).updateReviewItem = function(idx: number, field: string, val: string, isLiveInput = false) {
      if (!studioState.reviews[idx]) return;
      if (studioLang === 'en' && (field === 'author' || field === 'text')) {
        const ov = ensureEnOverlay();
        if (!ov.reviews) ov.reviews = {};
        if (!ov.reviews[idx]) ov.reviews[idx] = {};
        ov.reviews[idx][field] = val;
      } else {
        (studioState.reviews[idx] as any)[field] = val;
      }
      if (isLiveInput) scheduleLivePreviewMutation();
      else recordStateMutation();
    };

    (window as any).addReviewItem = function() {
      studioState.reviews.push({
        author: 'عميلة داندي',
        text: 'تجربة رائعة',
        image: '/assets/images/logo.png'
      });
      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تمت إضافة تقييم جديد');
    };

    (window as any).deleteReviewItem = function(idx: number) {
      studioState.reviews.splice(idx, 1);
      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تم حذف التقييم');
    };

