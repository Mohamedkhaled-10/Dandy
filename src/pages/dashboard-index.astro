        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        padding: 6px;
        font-size: 1.1rem;
        border-radius: 6px;
        transition: color 0.15s ease;
      }
      .studio-modal-close:hover {
        color: #111827;
      }
      .studio-modal-body {
        padding: 20px;
        overflow-y: auto;
      }
      .section-type-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
