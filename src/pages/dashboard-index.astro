              <div class="image-spec-box">
                <div class="image-spec-header">
                  <span class="image-device-label"><i class="fas fa-desktop" style="color:#2563eb;"></i> ديسكتوب ${sharedTagHtml()}</span>
                  <span class="image-ratio-tag">16:9 / 21:9</span>
                </div>
                <input type="url" class="studio-input" value="${escapeHtml(desktop)}" placeholder="رابط صورة عريضة" oninput="updateHeroSlideField(${idx}, 'desktopImage', this.value, true)" onchange="updateHeroSlideField(${idx}, 'desktopImage', this.value)">
                <div class="image-preview-thumb">
                  ${desktop ? `<img src="${escapeHtml(desktop)}" alt="Desktop" onerror="this.parentElement.innerHTML='<span class=thumb-empty>صورة غير صالحة</span>'">` : `<span class="thumb-empty"><i class="fas fa-image"></i> بدون صورة</span>`}
                </div>
              </div>

              <div class="image-spec-box">
                <div class="image-spec-header">
                  <span class="image-device-label"><i class="fas fa-mobile-alt" style="color:#fe5d9f;"></i> هاتف ${sharedTagHtml()}</span>
                  <span class="image-ratio-tag">9:16 / 3:4</span>
                </div>
                <input type="url" class="studio-input" value="${escapeHtml(mobile)}" placeholder="رابط صورة طولية" oninput="updateHeroSlideField(${idx}, 'mobileImage', this.value, true)" onchange="updateHeroSlideField(${idx}, 'mobileImage', this.value)">
                <div class="image-preview-thumb">
                  ${mobile ? `<img src="${escapeHtml(mobile)}" alt="Mobile" onerror="this.parentElement.innerHTML='<span class=thumb-empty>صورة غير صالحة</span>'">` : `<span class="thumb-empty"><i class="fas fa-mobile-alt"></i> بدون صورة</span>`}
