              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span style="font-size:0.75rem; font-weight:700; color:#374151;">صورة #${idx + 1}</span>
                <button type="button" class="btn-studio-outline" style="color:#dc2626; border-color:#fca5a5; padding:2px 6px; font-size:0.7rem;" onclick="deleteCustomSectionItem('${secId}', ${idx})">
                  <i class="fas fa-trash-alt"></i> حذف
                </button>
              </div>
              <div class="studio-form-group">
                <label class="studio-label">رابط الصورة (Image URL)</label>
                <input type="text" class="studio-input" value="${escapeHtml(item.image || '')}" oninput="updateCustomSectionItemField('${secId}', ${idx}, 'image', this.value)" placeholder="https://..." />
              </div>
              <div class="studio-form-group">
                <label class="studio-label">عنوان أو تعليق الصورة</label>
                <input type="text" class="studio-input" value="${escapeHtml(item.title || '')}" oninput="updateCustomSectionItemField('${secId}', ${idx}, 'title', this.value)" placeholder="مثال: إشراقة طبيعية" />
              </div>
            </div>
          `;
        });

        specificFormHtml = `
          <div style="margin-top:14px;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
              <span style="font-weight:700; font-size:0.82rem; color:#1f2937;">صور المعرض (${items.length})</span>
              <button type="button" class="btn-studio-outline" style="padding:4px 8px; font-size:0.72rem;" onclick="addCustomSectionItem('${secId}')">
                <i class="fas fa-plus"></i> إضافة صورة
              </button>
            </div>
            ${itemsHtml || '<p style="color:#9ca3af; font-size:0.78rem; text-align:center; padding:12px;">لا توجد صور مضافة.</p>'}
          </div>
        `;
      } else if (sec.type === 'trust') {
        let itemsHtml = '';
        items.forEach((item, idx) => {
          itemsHtml += `
            <div class="studio-card-item" style="display:flex; flex-direction:column; gap:8px; margin-bottom:8px; padding:10px; border:1px solid #e5e7eb; border-radius:8px; background:#fff;">
              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span style="font-size:0.75rem; font-weight:700; color:#374151;">ميزة #${idx + 1}</span>
                <button type="button" class="btn-studio-outline" style="color:#dc2626; border-color:#fca5a5; padding:2px 6px; font-size:0.7rem;" onclick="deleteCustomSectionItem('${secId}', ${idx})">
                  <i class="fas fa-trash-alt"></i> حذف
                </button>
              </div>
              <div class="form-grid-2">
                <div class="studio-form-group">
                  <label class="studio-label">أيقونة FontAwesome</label>
                  <input type="text" class="studio-input" value="${escapeHtml(item.icon || '')}" oninput="updateCustomSectionItemField('${secId}', ${idx}, 'icon', this.value)" placeholder="fa-leaf" />
                </div>
                <div class="studio-form-group">
                  <label class="studio-label">عنوان الميزة</label>
                  <input type="text" class="studio-input" value="${escapeHtml(item.title || '')}" oninput="updateCustomSectionItemField('${secId}', ${idx}, 'title', this.value)" placeholder="مثال: نباتي 100%" />
                </div>
              </div>
              <div class="studio-form-group">
                <label class="studio-label">الوصف التفصيلي</label>
                <input type="text" class="studio-input" value="${escapeHtml(item.desc || '')}" oninput="updateCustomSectionItemField('${secId}', ${idx}, 'desc', this.value)" placeholder="شرح مختصر..." />
              </div>
            </div>
          `;
        });

        specificFormHtml = `
          <div style="margin-top:14px;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
              <span style="font-weight:700; font-size:0.82rem; color:#1f2937;">بطاقات المزايا (${items.length})</span>
              <button type="button" class="btn-studio-outline" style="padding:4px 8px; font-size:0.72rem;" onclick="addCustomSectionItem('${secId}')">
                <i class="fas fa-plus"></i> إضافة ميزة
              </button>
            </div>
            ${itemsHtml || '<p style="color:#9ca3af; font-size:0.78rem; text-align:center; padding:12px;">لا توجد مزايا مضافة.</p>'}
          </div>
        `;
      }

      container.innerHTML = `
        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas ${typeMeta.icon}"></i> معلومات القسم (${typeMeta.nameAr})</h4>
            <button type="button" class="btn-studio-outline" style="color:#dc2626; border-color:#fca5a5; padding:4px 8px; font-size:0.72rem;" onclick="deleteCustomSection('${secId}')">
              <i class="fas fa-trash-alt"></i> حذف القسم
            </button>
          </div>
          <div class="form-grid-2">
            <div class="studio-form-group">
              <label class="studio-label">عنوان القسم الرئيسي</label>
              <input type="text" class="studio-input" value="${escapeHtml(sec.title || '')}" oninput="updateCustomSectionField('${secId}', 'title', this.value)" placeholder="عنوان القسم" />
            </div>
            <div class="studio-form-group">
              <label class="studio-label">العنوان الفرعي أو الوصف</label>
              <input type="text" class="studio-input" value="${escapeHtml(sec.subtitle || '')}" oninput="updateCustomSectionField('${secId}', 'subtitle', this.value)" placeholder="وصف مختصر للقسم" />
            </div>
          </div>
          ${specificFormHtml}
        </div>
      `;
    }

    function updateCustomSectionField(secId: string, field: string, val: any) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec) return;
      (sec as any)[field] = val;
      recordStateMutation();
    }

    function addCustomSectionItem(secId: string) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec) return;
      if (!sec.items) sec.items = [];

      if (sec.type === 'faq') {
        sec.items.push({ q: 'سؤال جديد', a: 'الإجابة التفصيلية للسؤال هنا...' });
      } else if (sec.type === 'gallery') {
        sec.items.push({ image: 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg', title: 'صورة جديدة' });
      } else if (sec.type === 'trust') {
        sec.items.push({ icon: 'fa-shield-alt', title: 'ميزة جديدة', desc: 'وصف الميزة...' });
      }

      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تمت إضافة عنصر جديد');
    }

    function deleteCustomSectionItem(secId: string, idx: number) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec || !sec.items) return;
      sec.items.splice(idx, 1);
      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تم حذف العنصر');
    }

    function updateCustomSectionItemField(secId: string, idx: number, field: string, val: string) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec || !sec.items?.[idx]) return;
      (sec.items[idx] as any)[field] = val;
      recordStateMutation();
    }

    function toggleCustomSectionManualProduct(secId: string, prodId: string, isChecked: boolean) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec) return;
      if (!sec.manualProducts) sec.manualProducts = {};
      if (isChecked) {
        sec.manualProducts[prodId] = true;
      } else {
        delete sec.manualProducts[prodId];
      }
      recordStateMutation();
    }

    // 7. GLOBAL SAVE & FIREBASE PERSISTENCE
    async function saveAllChanges() {
      const db = (window as any).db || (typeof (window as any).firebase !== 'undefined' ? (window as any).firebase.database() : null);
      if (!db) {
        showStudioToast('قاعدة البيانات غير مهيأة', true);
        return;
      }

      const saveBtn = document.getElementById('studioSaveBtn') as HTMLButtonElement | null;
      const statusPill = document.getElementById('studioStatusPill');
      const statusText = document.getElementById('studioStatusText');

      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>جاري الحفظ...</span>';
      }
      if (statusPill && statusText) {
        statusPill.className = 'studio-status-indicator is-saving';
        statusText.textContent = 'جاري الحفظ بالسحابة...';
      }

      try {
        const promises: Promise<any>[] = [
          db.ref('homepage/dynamicHero').set(studioState.hero),
          db.ref('homepage/dynamicSections').set(studioState.sections),
          db.ref('homepage/trust').set(studioState.trust),
          db.ref('homepage/dynamicReviews').set(studioState.reviews),
          db.ref('categories').set(studioState.categories)
        ];

        if (studioState.promoBanner) {
          promises.push(db.ref('homepage/promoBanner').set(studioState.promoBanner));
        }

        if (studioState.customSections) {
          promises.push(db.ref('homepage/customSections').set(studioState.customSections));
        }

        if (studioState.sectionOrder) {
          promises.push(db.ref('homepage/sectionOrder').set(studioState.sectionOrder));
        }

        if (studioState.sectionsVisibility) {
          promises.push(db.ref('homepage/sectionsVisibility').set(studioState.sectionsVisibility));
        }

        await Promise.all(promises);

        isDirty = false;
        updateToolbarStatus();
        showStudioToast('✓ تم حفظ جميع التعديلات بنجاح!');

        // Refresh live preview iframe
        sendIframeMessage({ type: 'STUDIO_RELOAD' });
      } catch (err) {
        console.error('Save error:', err);
        showStudioToast('حدث خطأ أثناء حفظ التغييرات', true);
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.innerHTML = '<i class="fas fa-cloud-upload-alt"></i> <span>حفظ التعديلات</span> <kbd>Ctrl+S</kbd>';
        }
      }
    }

    // 8. KEYBOARD SHORTCUTS & UNLOAD PROTECTION
    function setupKeyboardShortcuts() {
      window.addEventListener('keydown', (e) => {
        // Ctrl+S / Cmd+S
        if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          saveAllChanges();
        }
        // Ctrl+Z / Cmd+Z (Undo)
        if ((e.ctrlKey || e.metaKey) && !e.shiftKey && (e.key === 'z' || e.key === 'Z')) {
          e.preventDefault();
          triggerUndo();
        }
        // Ctrl+Shift+Z / Cmd+Shift+Z or Ctrl+Y (Redo)
        if (((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'z' || e.key === 'Z')) ||
            ((e.ctrlKey || e.metaKey) && (e.key === 'y' || e.key === 'Y'))) {
          e.preventDefault();
          triggerRedo();
        }
      });
    }

    function setupWindowUnloadWarning() {
      window.addEventListener('beforeunload', (e) => {
        if (isDirty) {
          e.preventDefault();
          e.returnValue = 'لديك تعديلات غير محفوظة في الاستوديو. هل أنت متأكد من المغادرة؟';
          return e.returnValue;
        }
      });
    }

    function showStudioToast(msg: string, isError = false) {
      const toast = document.getElementById('studioToast');
      const text = document.getElementById('studioToastMsg');
      const icon = document.getElementById('studioToastIcon');
      if (!toast || !text) return;

      text.textContent = msg;
      toast.className = 'studio-toast show' + (isError ? ' is-error' : '');
      if (icon) {
        icon.className = isError ? 'fas fa-exclamation-triangle' : 'fas fa-check-circle';
      }

      setTimeout(() => {
        toast.className = 'studio-toast' + (isError ? ' is-error' : '');
      }, 3200);
    }

    function escapeHtml(string: string) {
      if (!string) return '';
      return String(string)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</BaseLayout>
