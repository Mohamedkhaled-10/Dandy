      viewAllLabel?: string;
      limit?: number;
    }

    interface DynamicSection {
      id: string;
      order?: number;
      visible?: boolean;
      title?: string;
      subtitle?: string;
      type?: 'manual' | 'bestsellers' | 'offers' | 'newArrivals' | 'all';
      manualProducts?: Record<string, boolean>;
      limit?: number;
      viewAllLabel?: string;
      viewAllHref?: string;
    }

    interface TrustItem {
      icon?: string;
      title?: string;
      desc?: string;
    }

    interface ReviewItem {
      author?: string;
      text?: string;
      image?: string;
    }

    interface CategoryItem {
      id?: string;
      name?: string;
      tagline?: string;
      description?: string;
      count?: string;
      visible?: boolean;
      order?: number;
      layoutVariant?: 'auto' | 'wide' | 'large' | 'tall' | 'small';
      desktopImage?: string;
      mobileImage?: string;
      image?: string;
    }

    interface CustomSectionItem {
      id?: string;
      title?: string;
      desc?: string;
      q?: string;
      a?: string;
      image?: string;
      link?: string;
      icon?: string;
    }

    interface CustomSection {
      id: string;
      type: 'products' | 'banner' | 'trust' | 'story' | 'faq' | 'video' | 'gallery';
      title?: string;
      subtitle?: string;
      content?: string;
      author?: string;
      videoUrl?: string;
      poster?: string;
      eyebrow?: string;
      desc?: string;
      ctaText?: string;
      ctaLink?: string;
      image?: string;
