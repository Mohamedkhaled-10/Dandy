    (window as any).startCategoryEdit = function(key: string) {
      activeCategoryEditKey = key;
      renderActiveInspector();
    };

    (window as any).cancelCategoryEdit = function() {
      activeCategoryEditKey = null;
      renderActiveInspector();
    };

    (window as any).onCategoryLayoutSelectionChange = function(variant: string) {
      const spec = categoryLayoutSpecs[variant] || categoryLayoutSpecs.auto;
      const gName = document.getElementById('catGuidanceName');
      const gD = document.getElementById('catGuidanceDesktop');
      const gM = document.getElementById('catGuidanceMobile');
      const tagD = document.getElementById('catDesktopRatioTag');
      const tagM = document.getElementById('catMobileRatioTag');

      if (gName) gName.textContent = spec.nameAr.split(' ')[0];
      if (gD) gD.textContent = spec.desktop.label;
      if (gM) gM.textContent = spec.mobile.label;
      if (tagD) tagD.textContent = spec.desktop.ratio;
      if (tagM) tagM.textContent = spec.mobile.ratio;
    };

    (window as any).updateCatImagePreview = function(type: 'desktop' | 'mobile', url: string) {
      const thumb = document.getElementById(type === 'desktop' ? 'catDesktopThumb' : 'catMobileThumb');
      if (!thumb) return;
      if (url.trim()) {
        thumb.innerHTML = `<img src="${escapeHtml(url.trim())}" alt="${type}" onerror="this.parentElement.innerHTML='<span class=thumb-empty>صورة غير صالحة</span>'">`;
      } else {
        thumb.innerHTML = `<span class="thumb-empty"><i class="fas fa-${type === 'desktop' ? 'image' : 'mobile-alt'}"></i> بدون صورة</span>`;
      }
    };

    (window as any).saveCategoryForm = function() {
      const nameInput = document.getElementById('catFormName') as HTMLInputElement | null;
      const taglineInput = document.getElementById('catFormTagline') as HTMLInputElement | null;
      const countInput = document.getElementById('catFormCount') as HTMLInputElement | null;
      const layoutInput = document.getElementById('catFormLayout') as HTMLSelectElement | null;
      const desktopInput = document.getElementById('catFormDesktopImg') as HTMLInputElement | null;
      const mobileInput = document.getElementById('catFormMobileImg') as HTMLInputElement | null;

      const name = nameInput?.value.trim() || '';
      const desktop = desktopInput?.value.trim() || '';
      const mobile = mobileInput?.value.trim() || '';
      const fallbackImg = desktop || mobile;

      if (!name) {
        showStudioToast('يرجى كتابة اسم القسم', true);
        return;
      }
      if (!desktop && !mobile) {
        showStudioToast('يرجى إضافة صورة ديسكتوب أو هاتف للقسم', true);
        return;
      }

      const payload: CategoryItem = {
        name,
        tagline: taglineInput?.value.trim() || '',
        count: countInput?.value.trim() || '',
        layoutVariant: (layoutInput?.value || 'auto') as any,
        desktopImage: desktop || fallbackImg,
        mobileImage: mobile || fallbackImg,
        image: fallbackImg
      };

      if (!studioState.categories) studioState.categories = {};

      if (activeCategoryEditKey) {
        studioState.categories[activeCategoryEditKey] = {
          ...studioState.categories[activeCategoryEditKey],
          ...payload
        };
        showStudioToast('تم حفظ تعديلات القسم');
      } else {
        const newKey = 'cat_' + Date.now();
        studioState.categories[newKey] = payload;
        showStudioToast('تمت إضافة القسم بنجاح');
      }

      activeCategoryEditKey = null;
      recordStateMutation();
      renderActiveInspector();
    };

    (window as any).deleteCategoryItem = function(key: string) {
      if (confirm('هل أنتِ متأكدة من حذف هذا القسم؟')) {
        delete studioState.categories[key];
        if (activeCategoryEditKey === key) activeCategoryEditKey = null;
        recordStateMutation();
        renderActiveInspector();
        showStudioToast('تم حذف القسم');
      }
    };

