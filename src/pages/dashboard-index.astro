      .section-type-header {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .section-type-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: #fce7f3;
        color: var(--studio-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
