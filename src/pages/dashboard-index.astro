    function updateCustomSectionField(secId: string, field: string, val: any, isLiveInput = false, forceShared = false) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec) return;
      if (studioLang === 'en' && !forceShared) {
        const ov = ensureEnOverlay();
        if (!ov.customSections) ov.customSections = {};
        if (!ov.customSections[secId]) ov.customSections[secId] = {};
        ov.customSections[secId][field] = val;
      } else {
        (sec as any)[field] = val;
      }
      if (isLiveInput) scheduleLivePreviewMutation();
      else recordStateMutation();
    }

    function addCustomSectionItem(secId: string) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec) return;
      if (!sec.items) sec.items = [];

      if (sec.type === 'faq') {
        sec.items.push({ q: 'سؤال جديد', a: 'الإجابة التفصيلية للسؤال هنا...' });
      } else if (sec.type === 'gallery') {
        sec.items.push({ image: '/assets/images/hero/hero-1.jpg', title: 'صورة جديدة', link: '' });
      } else if (sec.type === 'trust') {
        sec.items.push({ icon: 'fa-shield-alt', title: 'ميزة جديدة', desc: 'وصف الميزة...' });
      }

      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تمت إضافة عنصر جديد');
    }

    function deleteCustomSectionItem(secId: string, idx: number) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec || !sec.items) return;
      sec.items.splice(idx, 1);
      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تم حذف العنصر');
    }

    function updateCustomSectionItemField(secId: string, idx: number, field: string, val: string, forceShared = false) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec || !sec.items?.[idx]) return;
      if (studioLang === 'en' && !forceShared) {
        const ov = ensureEnOverlay();
        if (!ov.customSections) ov.customSections = {};
        if (!ov.customSections[secId]) ov.customSections[secId] = {};
        if (!ov.customSections[secId].items) ov.customSections[secId].items = {};
        if (!ov.customSections[secId].items[idx]) ov.customSections[secId].items[idx] = {};
        ov.customSections[secId].items[idx][field] = val;
      } else {
        (sec.items[idx] as any)[field] = val;
      }
      scheduleLivePreviewMutation();
    }

    function toggleCustomSectionManualProduct(secId: string, prodId: string, isChecked: boolean) {
      const sec = studioState.customSections?.find(s => s.id === secId);
      if (!sec) return;
      if (!sec.manualProducts) sec.manualProducts = {};
      if (isChecked) {
        sec.manualProducts[prodId] = true;
      } else {
        delete sec.manualProducts[prodId];
      }
      recordStateMutation();
    }

    // 7. GLOBAL SAVE & FIREBASE PERSISTENCE
    function sanitizeForRtdb(val: any): any {
      if (val === undefined) return null;
      return JSON.parse(JSON.stringify(val));
    }

    async function saveAllChanges() {
      const db = (window as any).db || (typeof (window as any).firebase !== 'undefined' ? (window as any).firebase.database() : null);
      if (!db) {
        showStudioToast('قاعدة البيانات غير مهيأة', true);
        return;
      }

      const saveBtn = document.getElementById('studioSaveBtn') as HTMLButtonElement | null;
      const statusPill = document.getElementById('studioStatusPill');
      const statusText = document.getElementById('studioStatusText');

      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>جاري الحفظ...</span>';
      }
      if (statusPill && statusText) {
        statusPill.className = 'studio-status-indicator is-saving';
        statusText.textContent = 'جاري الحفظ بالسحابة...';
      }

      try {
        const promises: Promise<any>[] = [
          db.ref('homepage/dynamicHero').set(sanitizeForRtdb(studioState.hero || [])),
          db.ref('homepage/dynamicSections').set(sanitizeForRtdb(studioState.sections || [])),
          db.ref('homepage/trust').set(sanitizeForRtdb(studioState.trust || {})),
          db.ref('homepage/dynamicReviews').set(sanitizeForRtdb(studioState.reviews || [])),
          db.ref('categories').set(sanitizeForRtdb(studioState.categories || {})),
          db.ref('homepage/heroMeta').set(sanitizeForRtdb(studioState.heroMeta || {})),
          db.ref('homepage/trustSection').set(sanitizeForRtdb(studioState.trustSection || {})),
          db.ref('homepage/categoriesSection').set(sanitizeForRtdb(studioState.categoriesSection || {})),
          db.ref('homepage/blogSection').set(sanitizeForRtdb(studioState.blogSection || {})),
          db.ref('homepage/reviewsSection').set(sanitizeForRtdb(studioState.reviewsSection || {})),
          db.ref('homepage/enOverlay').set(sanitizeForRtdb(studioState.enOverlay || {}))
        ];

        if (studioState.promoBanner) {
          promises.push(db.ref('homepage/promoBanner').set(sanitizeForRtdb(studioState.promoBanner)));
        }

        if (studioState.customSections) {
          promises.push(db.ref('homepage/customSections').set(sanitizeForRtdb(studioState.customSections)));
        }

        if (studioState.sectionOrder) {
          promises.push(db.ref('homepage/sectionOrder').set(sanitizeForRtdb(studioState.sectionOrder)));
        }

        if (studioState.sectionsVisibility) {
          promises.push(db.ref('homepage/sectionsVisibility').set(sanitizeForRtdb(studioState.sectionsVisibility)));
        }

        await Promise.all(promises);

        isDirty = false;
        updateToolbarStatus();
        showStudioToast('✓ تم حفظ جميع التعديلات بنجاح!');

        // Refresh live preview iframe
        sendIframeMessage({ type: 'STUDIO_RELOAD' });
      } catch (err) {
        console.error('Save error:', err);
        showStudioToast('حدث خطأ أثناء حفظ التغييرات', true);
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.innerHTML = '<i class="fas fa-cloud-upload-alt"></i> <span>حفظ التعديلات</span> <kbd>Ctrl+S</kbd>';
        }
      }
    }

    // 8. KEYBOARD SHORTCUTS & UNLOAD PROTECTION
    function setupKeyboardShortcuts() {
      window.addEventListener('keydown', (e) => {
        // Ctrl+S / Cmd+S
        if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          saveAllChanges();
        }
        // Ctrl+Z / Cmd+Z (Undo)
        if ((e.ctrlKey || e.metaKey) && !e.shiftKey && (e.key === 'z' || e.key === 'Z')) {
          e.preventDefault();
          triggerUndo();
        }
        // Ctrl+Shift+Z / Cmd+Shift+Z or Ctrl+Y (Redo)
        if (((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'z' || e.key === 'Z')) ||
            ((e.ctrlKey || e.metaKey) && (e.key === 'y' || e.key === 'Y'))) {
          e.preventDefault();
          triggerRedo();
        }
      });
    }

    function setupWindowUnloadWarning() {
      window.addEventListener('beforeunload', (e) => {
        if (isDirty) {
          e.preventDefault();
          e.returnValue = 'لديك تعديلات غير محفوظة في الاستوديو. هل أنت متأكد من المغادرة؟';
          return e.returnValue;
        }
      });
    }

    function showStudioToast(msg: string, isError = false) {
      const toast = document.getElementById('studioToast');
      const text = document.getElementById('studioToastMsg');
      const icon = document.getElementById('studioToastIcon');
      if (!toast || !text) return;

      text.textContent = msg;
      toast.className = 'studio-toast show' + (isError ? ' is-error' : '');
      if (icon) {
        icon.className = isError ? 'fas fa-exclamation-triangle' : 'fas fa-check-circle';
      }

      setTimeout(() => {
        toast.className = 'studio-toast' + (isError ? ' is-error' : '');
      }, 3200);
    }

    function escapeHtml(string: string) {
      if (!string) return '';
      return String(string)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</BaseLayout>
