  <!-- SortableJS bundle & Studio Logic -->
  <script>
    import Sortable from 'sortablejs';

    // Type Definitions for Studio
    interface HeroSlide {
      desktopImage?: string;
      mobileImage?: string;
      image?: string;
      duration?: number;
      title?: string;
      subtitle?: string;
      buttonText?: string;
      link?: string;
    }

    interface DynamicSection {
      id: string;
      order?: number;
      visible?: boolean;
      title?: string;
      subtitle?: string;
      type?: 'manual' | 'bestsellers' | 'offers';
      manualProducts?: Record<string, boolean>;
    }

    interface TrustItem {
      icon?: string;
      title?: string;
      desc?: string;
    }

    interface ReviewItem {
      author?: string;
      text?: string;
      image?: string;
    }

    interface CategoryItem {
      id?: string;
      name?: string;
      tagline?: string;
      count?: string;
      layoutVariant?: 'auto' | 'wide' | 'large' | 'tall' | 'small';
      desktopImage?: string;
      mobileImage?: string;
      image?: string;
    }

    interface CustomSectionItem {
      id?: string;
      title?: string;
      desc?: string;
      q?: string;
      a?: string;
      image?: string;
      link?: string;
      icon?: string;
    }

    interface CustomSection {
      id: string;
      type: 'products' | 'banner' | 'trust' | 'story' | 'faq' | 'video' | 'gallery';
      title?: string;
      subtitle?: string;
      content?: string;
      author?: string;
      videoUrl?: string;
      poster?: string;
      eyebrow?: string;
      desc?: string;
      ctaText?: string;
      ctaLink?: string;
      image?: string;
      productSource?: 'all' | 'offers' | 'bestsellers' | 'manual';
      manualProducts?: Record<string, boolean>;
      limit?: number;
      linkText?: string;
      linkUrl?: string;
      items?: CustomSectionItem[];
    }

    interface StudioState {
      hero: HeroSlide[];
      sections: DynamicSection[];
      trust: {
        item1: TrustItem;
        item2: TrustItem;
        item3: TrustItem;
      };
      reviews: ReviewItem[];
      categories: Record<string, CategoryItem>;
      promoBanner?: {
        eyebrow?: string;
        title?: string;
        desc?: string;
        ctaText?: string;
        ctaLink?: string;
        image?: string;
      };
      customSections?: CustomSection[];
      sectionOrder?: string[];
      sectionsVisibility?: Record<string, boolean>;
    }

    // Category Layout Specifications
    const categoryLayoutSpecs: Record<string, any> = {
      wide: {
        id: 'wide',
        nameAr: 'عريض أفقي (Wide)',
        tileClass: 'cat-tile-h250',
        desktop: { ratio: '21:9', numericRatio: 2.6, width: 1600, height: 615, label: '1600 × 615 px (21:9)' },
        mobile: { ratio: '16:9', numericRatio: 1.77, width: 800, height: 450, label: '800 × 450 px (16:9)' }
      },
      large: {
        id: 'large',
        nameAr: 'كبير رئيسي (Large)',
        tileClass: 'cat-tile-h350',
        desktop: { ratio: '16:9', numericRatio: 1.87, width: 1400, height: 750, label: '1400 × 750 px (16:9)' },
        mobile: { ratio: '4:3', numericRatio: 1.33, width: 800, height: 600, label: '800 × 600 px (4:3)' }
      },
      tall: {
        id: 'tall',
        nameAr: 'طولي عمودي (Tall)',
        tileClass: 'cat-tile-h360',
        desktop: { ratio: '3:2', numericRatio: 1.46, width: 1200, height: 820, label: '1200 × 820 px (3:2)' },
        mobile: { ratio: '3:4', numericRatio: 0.75, width: 600, height: 800, label: '600 × 800 px (3:4)' }
      },
      small: {
        id: 'small',
        nameAr: 'مدمج صغير (Small)',
        tileClass: 'cat-tile-h240',
        desktop: { ratio: '2.2:1', numericRatio: 2.19, width: 1100, height: 500, label: '1100 × 500 px (2.2:1)' },
        mobile: { ratio: '16:9', numericRatio: 1.77, width: 720, height: 400, label: '720 × 400 px (16:9)' }
      },
      auto: {
        id: 'auto',
        nameAr: 'تلقائي تحريري (Auto)',
        tileClass: 'auto',
        desktop: { ratio: '16:9 / 3:2', numericRatio: 1.77, width: 1400, height: 750, label: '1400 × 750 px' },
        mobile: { ratio: '16:9 / 4:3', numericRatio: 1.33, width: 800, height: 600, label: '800 × 600 px' }
      }
    };

    // Master Studio State & History Stack
    let studioState: StudioState = {
      hero: [],
      sections: [],
      trust: { item1: {}, item2: {}, item3: {} },
      reviews: [],
      categories: {}
    };

    let historyStack: StudioState[] = [];
    let historyIndex = -1;
    let isDirty = false;
    let activeSectionId = 'hero';
    let productsCatalogCache: Record<string, any> = {};
    let activeCategoryEditKey: string | null = null;

    // Standard Section Definitions for Homepage Structure
    const defaultSectionsMetadata: Record<string, { title: string; subtitle: string; icon: string }> = {
      hero: { title: 'بانر الهيرو الرئيسي', subtitle: 'الشرائح الإعلانية والتحويل', icon: 'fa-images' },
      trust: { title: 'شريط المزايا والثقة', subtitle: '3 بطاقات مميزات الخدمة والشحن', icon: 'fa-shield-alt' },
      offers: { title: 'العروض الخاصة', subtitle: 'قسم المنتجات الأول', icon: 'fa-tags' },
      categories: { title: 'التصنيفات والمجموعات', subtitle: 'الشبكة التحريرية للأقسام', icon: 'fa-th-large' },
      promo: { title: 'البانر الترويجي التحريري', subtitle: 'مجموعة الروتين والعناية', icon: 'fa-ad' },
      newArrivals: { title: 'أحدث المنتجات', subtitle: 'قسم المنتجات الثاني', icon: 'fa-sparkles' },
      blog: { title: 'مدونة العناية والجمال', subtitle: 'مقالات نصائح البشرة والشعر', icon: 'fa-newspaper' },
      reviews: { title: 'آراء وتجارب العميلات', subtitle: 'لقطات شاشات المحادثات والتقييمات', icon: 'fa-comments' }
    };

    // Expose helpers on window for inline handlers
    (window as any).switchViewport = switchViewport;
    (window as any).switchEditorMode = switchEditorMode;
    (window as any).switchSidebarTab = switchSidebarTab;
    (window as any).selectSection = selectSection;
    (window as any).toggleSectionVisibility = toggleSectionVisibility;
    (window as any).triggerUndo = triggerUndo;
    (window as any).triggerRedo = triggerRedo;
    (window as any).saveAllChanges = saveAllChanges;
    (window as any).reloadPreviewIframe = reloadPreviewIframe;
    (window as any).onPreviewIframeLoaded = onPreviewIframeLoaded;
    (window as any).openAddSectionModal = openAddSectionModal;
    (window as any).closeAddSectionModal = closeAddSectionModal;
    (window as any).addNewSectionOfType = addNewSectionOfType;
    (window as any).deleteCustomSection = deleteCustomSection;
    (window as any).updateCustomSectionField = updateCustomSectionField;
    (window as any).addCustomSectionItem = addCustomSectionItem;
    (window as any).deleteCustomSectionItem = deleteCustomSectionItem;
    (window as any).updateCustomSectionItemField = updateCustomSectionItemField;
    (window as any).toggleCustomSectionManualProduct = toggleCustomSectionManualProduct;

    // 1. INITIALIZATION & FIREBASE DATA LOADING
    document.addEventListener('DOMContentLoaded', () => {
      initStudio();
    });

    async function initStudio() {
      const auth = (window as any).auth || (typeof (window as any).firebase !== 'undefined' ? (window as any).firebase.auth() : null);
      if (auth) {
        auth.onAuthStateChanged(async (user: any) => {
          if (!user) {
            window.location.href = '/login';
          } else {
            await loadProductsCatalog();
            await loadStudioFirebaseData();
          }
        });
      } else {
        await loadProductsCatalog();
        await loadStudioFirebaseData();
      }

      setupKeyboardShortcuts();
      setupWindowUnloadWarning();
      setupPreviewBridgeListener();
    }

    async function loadProductsCatalog() {
      const db = (window as any).db || (typeof (window as any).firebase !== 'undefined' ? (window as any).firebase.database() : null);
      if (!db) return;
      try {
        const snap = await db.ref('products').once('value');
        if (snap.exists()) {
          productsCatalogCache = snap.val();
        }
      } catch (e) {
        console.warn('Error loading products catalog:', e);
      }
    }

    async function loadStudioFirebaseData() {
      const db = (window as any).db || (typeof (window as any).firebase !== 'undefined' ? (window as any).firebase.database() : null);
      if (!db) return;

      try {
        const [homeSnap, catSnap] = await Promise.all([
          db.ref('homepage').once('value'),
          db.ref('categories').once('value')
        ]);

        const homeData = homeSnap.exists() ? homeSnap.val() : {};
        const catData = catSnap.exists() ? catSnap.val() : {};

        studioState = {
          hero: Array.isArray(homeData.dynamicHero) ? homeData.dynamicHero : [],
          sections: Array.isArray(homeData.dynamicSections) ? homeData.dynamicSections : [],
          trust: homeData.trust || { item1: {}, item2: {}, item3: {} },
          reviews: Array.isArray(homeData.dynamicReviews) ? homeData.dynamicReviews : [],
          categories: catData || {},
          promoBanner: homeData.promoBanner || {},
          customSections: Array.isArray(homeData.customSections) ? homeData.customSections : [],
          sectionOrder: Array.isArray(homeData.sectionOrder) ? homeData.sectionOrder : undefined,
          sectionsVisibility: homeData.sectionsVisibility || {}
        };

        // Fallbacks if empty
        if (!studioState.hero.length) {
          studioState.hero = [{
            desktopImage: 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg',
            mobileImage: 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg',
            duration: 5,
            title: 'جمال طبيعي مستخلص بعناية فائقة',
            subtitle: 'تركيبات مصرية طبيعية 100% غنية بخلاصات الزيوت العضوية.',
            buttonText: 'تسوقي الآن',
            link: '/all-products'
          }];
        }

        if (!studioState.sections.length) {
          studioState.sections = [
            { id: 'sec-special-offers', type: 'offers', title: 'العروض الخاصة', subtitle: 'عروض مميزة', visible: true, order: 0 },
            { id: 'sec-new-arrivals', type: 'newArrivals', title: 'أحدث المنتجات', subtitle: 'تشكيلة مختارة', visible: true, order: 1 }
          ];
        }

        // Initialize history stack
        historyStack = [cloneState(studioState)];
        historyIndex = 0;
        isDirty = false;
        updateToolbarStatus();

        // Render UI
        renderSectionsNavigator();
        renderActiveInspector();
      } catch (err) {
        console.error('Error loading studio data:', err);
        showStudioToast('تعذر تحميل بيانات الصفحة الرئيسية من الخادم', true);
      }
    }

    // 2. STATE MANAGEMENT & HISTORY (UNDO / REDO)
    function cloneState(st: StudioState): StudioState {
      return JSON.parse(JSON.stringify(st));
    }

    function recordStateMutation(notifyPreview = true) {
      if (historyIndex < historyStack.length - 1) {
        historyStack = historyStack.slice(0, historyIndex + 1);
      }
      historyStack.push(cloneState(studioState));
      if (historyStack.length > 30) {
        historyStack.shift();
      } else {
        historyIndex++;
      }

      isDirty = true;
      updateToolbarStatus();

      if (notifyPreview) {
        dispatchPreviewStateUpdate();
      }
    }

    function triggerUndo() {
      if (historyIndex > 0) {
        historyIndex--;
        studioState = cloneState(historyStack[historyIndex]);
        isDirty = true;
        updateToolbarStatus();
        renderSectionsNavigator();
        renderActiveInspector();
        dispatchPreviewStateUpdate();
        showStudioToast('تم التراجع');
      }
    }

    function triggerRedo() {
      if (historyIndex < historyStack.length - 1) {
        historyIndex++;
        studioState = cloneState(historyStack[historyIndex]);
        isDirty = true;
        updateToolbarStatus();
        renderSectionsNavigator();
        renderActiveInspector();
        dispatchPreviewStateUpdate();
        showStudioToast('تمت الإعادة');
      }
    }

    function updateToolbarStatus() {
      const undoBtn = document.getElementById('studioUndoBtn') as HTMLButtonElement | null;
      const redoBtn = document.getElementById('studioRedoBtn') as HTMLButtonElement | null;
      const statusPill = document.getElementById('studioStatusPill');
      const statusText = document.getElementById('studioStatusText');

      if (undoBtn) undoBtn.disabled = historyIndex <= 0;
      if (redoBtn) redoBtn.disabled = historyIndex >= historyStack.length - 1;

      if (statusPill && statusText) {
        if (isDirty) {
          statusPill.className = 'studio-status-indicator is-dirty';
          statusText.textContent = 'تغييرات غير محفوظة';
        } else {
          statusPill.className = 'studio-status-indicator is-saved';
          statusText.textContent = 'تم حفظ التغييرات';
        }
      }
    }

    // 3. VIEWPORT & EDITOR MODE SWITCHERS
    function switchViewport(mode: 'desktop' | 'tablet' | 'mobile') {
      const frame = document.getElementById('studioDeviceFrame');
      const dimText = document.getElementById('viewportDimensionText');
      const btns = {
        desktop: document.getElementById('vpDesktopBtn'),
        tablet: document.getElementById('vpTabletBtn'),
        mobile: document.getElementById('vpMobileBtn')
      };

      Object.values(btns).forEach(b => b?.classList.remove('active'));
      if (btns[mode]) btns[mode]?.classList.add('active');

      if (frame) {
        frame.className = `studio-device-frame is-${mode}`;
      }

      if (dimText) {
        if (mode === 'desktop') dimText.textContent = '100% (شاشة كاملة ديسكتوب)';
        if (mode === 'tablet') dimText.textContent = '768 × 1024 px (أجهزة لوحية)';
        if (mode === 'mobile') dimText.textContent = '375 × 812 px (هواتف ذكية)';
      }
    }

    function switchEditorMode(mode: 'edit' | 'preview') {
      const editBtn = document.getElementById('modeEditBtn');
      const prevBtn = document.getElementById('modePreviewBtn');
      if (mode === 'edit') {
        editBtn?.classList.add('active');
        prevBtn?.classList.remove('active');
      } else {
        prevBtn?.classList.add('active');
        editBtn?.classList.remove('active');
      }

      sendIframeMessage({ type: 'STUDIO_SET_MODE', mode });
    }

    function switchSidebarTab(tab: 'nav' | 'inspector') {
      const navBtn = document.getElementById('tabNavBtn');
      const insBtn = document.getElementById('tabInspectorBtn');
      const navView = document.getElementById('sidebarViewNav');
      const insView = document.getElementById('sidebarViewInspector');

      if (tab === 'nav') {
        navBtn?.classList.add('active');
        insBtn?.classList.remove('active');
        if (navView) navView.style.display = 'block';
        if (insView) insView.style.display = 'none';
      } else {
        insBtn?.classList.add('active');
        navBtn?.classList.remove('active');
        if (insView) insView.style.display = 'block';
        if (navView) navView.style.display = 'none';
      }
    }

    function selectSection(secId: string, switchTab = true) {
      activeSectionId = secId;
      renderSectionsNavigator();
      renderActiveInspector();
      if (switchTab) {
        switchSidebarTab('inspector');
      }
      sendIframeMessage({ type: 'STUDIO_SELECT_SECTION', sectionId: secId });
    }

    function toggleSectionVisibility(secId: string, e: Event) {
      e.stopPropagation();
      if (!studioState.sectionsVisibility) {
        studioState.sectionsVisibility = {};
      }
      const currentVis = studioState.sectionsVisibility[secId] !== false;
      studioState.sectionsVisibility[secId] = !currentVis;

      if (secId === 'offers' || secId === 'newArrivals') {
        const target = studioState.sections.find(s => (secId === 'offers' ? s.type === 'offers' : s.type !== 'offers'));
        if (target) {
          target.visible = studioState.sectionsVisibility[secId];
        }
      }

      recordStateMutation();
      renderSectionsNavigator();
      renderActiveInspector();
    }

    // Custom Section Metadata Mapping
    const customSectionTypeMeta: Record<string, { nameAr: string; icon: string; defaultTitle: string; defaultSubtitle: string }> = {
      products: { nameAr: 'شبكة منتجات مخصصة', icon: 'fa-shopping-bag', defaultTitle: 'منتجات مختارة', defaultSubtitle: 'أفضل التوليفات والزيوت الطبيعية' },
      banner: { nameAr: 'بانر ترويجي', icon: 'fa-ad', defaultTitle: 'عرض العناية الفائقة', defaultSubtitle: 'خصم خاص لفترة محدودة على المجموعات الكاملة' },
      faq: { nameAr: 'الأسئلة الشائعة', icon: 'fa-question-circle', defaultTitle: 'الأسئلة الشائعة', defaultSubtitle: 'كل ما تودين معرفته عن منتجات داندي واستخدامها' },
      story: { nameAr: 'قصة ورسالة العلامة', icon: 'fa-quote-right', defaultTitle: 'فلسفتنا الطبيعية', defaultSubtitle: 'نقاء الطبيعة مع عناية فائقة للبشرة والشعر' },
      video: { nameAr: 'فيديو استعراضي', icon: 'fa-play-circle', defaultTitle: 'شاهدي نتائج داندي', defaultSubtitle: 'طريقة الاستخدام وتجارب واقعية للعميلات' },
      gallery: { nameAr: 'معرض صور مصغر', icon: 'fa-images', defaultTitle: 'معرض داندي', defaultSubtitle: 'إشراقة طبيعية ولمسات جمال مستدامة' },
      trust: { nameAr: 'شريط مزايا إضافي', icon: 'fa-shield-alt', defaultTitle: 'ضمان وتجربة داندي', defaultSubtitle: 'مزايا إضافية لضمان راحتكِ ورضاكِ التام' }
    };

    // 4. PREVIEW IFRAME COMMUNICATION BRIDGE
    function sendIframeMessage(payload: any) {
      const iframe = document.getElementById('studioPreviewFrame') as HTMLIFrameElement | null;
      if (iframe && iframe.contentWindow) {
        iframe.contentWindow.postMessage(payload, '*');
      }
    }

    function dispatchPreviewStateUpdate() {
      sendIframeMessage({
        type: 'STUDIO_UPDATE_STATE',
        state: {
          hero: studioState.hero,
          trust: studioState.trust,
          sections: studioState.sections,
          reviews: studioState.reviews,
          categories: studioState.categories,
          promoBanner: studioState.promoBanner,
          header: studioState.header,
          footer: studioState.footer,
          customSections: studioState.customSections,
          sectionOrder: studioState.sectionOrder,
          sectionsVisibility: studioState.sectionsVisibility
        }
      });
    }

    function reloadPreviewIframe() {
      const loader = document.getElementById('iframeLoader');
      const iframe = document.getElementById('studioPreviewFrame') as HTMLIFrameElement | null;
      if (loader) loader.classList.remove('hidden');
      if (iframe) {
        iframe.src = '/?studio_preview=1&t=' + Date.now();
      }
    }

    function onPreviewIframeLoaded() {
      const loader = document.getElementById('iframeLoader');
      if (loader) loader.classList.add('hidden');
      dispatchPreviewStateUpdate();
      sendIframeMessage({ type: 'STUDIO_SELECT_SECTION', sectionId: activeSectionId });
    }

    function setupPreviewBridgeListener() {
      window.addEventListener('message', (event) => {
        const data = event.data;
        if (!data || typeof data !== 'object') return;

        if (data.type === 'STUDIO_SECTION_CLICKED') {
          if (data.sectionId) {
            selectSection(data.sectionId, true);
          }
        } else if (data.type === 'STUDIO_PREVIEW_READY') {
          dispatchPreviewStateUpdate();
          sendIframeMessage({ type: 'STUDIO_SELECT_SECTION', sectionId: activeSectionId });
        }
      });
    }

    // Modal Controls for Adding New Section
    function openAddSectionModal() {
      const modal = document.getElementById('addSectionModal');
      if (modal) modal.classList.add('is-open');
    }

    function closeAddSectionModal() {
      const modal = document.getElementById('addSectionModal');
      if (modal) modal.classList.remove('is-open');
    }

    function addNewSectionOfType(type: string) {
      closeAddSectionModal();
      const newId = 'sec-custom-' + Date.now().toString(36) + '-' + Math.random().toString(36).substr(2, 4);
      const meta = customSectionTypeMeta[type] || { nameAr: 'قسم مخصص', icon: 'fa-cube', defaultTitle: 'قسم جديد', defaultSubtitle: 'وصف القسم' };

      const newSection: CustomSection = {
        id: newId,
        type: type as any,
        title: meta.defaultTitle,
        subtitle: meta.defaultSubtitle,
        items: []
      };

      // Type-specific defaults
      if (type === 'faq') {
        newSection.items = [
          { q: 'هل المنتجات طبيعية وآمنة بنسبة 100%؟', a: 'نعم، جميع تركيبات داندي محضرة من خلاصات الزيوت العضوية والنباتية النقية وخالية من البارابين والكبريتات الضارة.' },
          { q: 'كم يستغرق توصيل الشحنة؟', a: 'يتم التوصيل لجميع محافظات مصر خلال 24 إلى 48 ساعة فقط، مع إمكانية الدفع عند الاستلام والمعاينة.' }
        ];
      } else if (type === 'story') {
        newSection.content = 'نؤمن في داندي بأن الجمال الحقيقي ينبع من الطبيعة النقية. صُممت تركيباتنا بعناية لتعيد إحياء بشرتك وشعرك بأفضل المستخلصات العضوية وأعلى معايير الجودة.';
        newSection.author = 'فريق داندي الطبيعي';
      } else if (type === 'video') {
        newSection.videoUrl = 'https://www.youtube.com/watch?v=dQw4w9WgXcQ';
        newSection.poster = 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg';
      } else if (type === 'banner') {
        newSection.eyebrow = 'تألقي بجمال طبيعي';
        newSection.desc = 'مجموعات متكاملة للعناية المكثفة بالبشرة والشعر بخصم يصل إلى 30% مع شحن مجاني لفترة محدودة.';
        newSection.ctaText = 'اكتشفي المجموعة الآن';
        newSection.ctaLink = '/all-products';
        newSection.image = 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg';
      } else if (type === 'products') {
        newSection.productSource = 'all';
        newSection.limit = 4;
        newSection.linkText = 'عرض كل المنتجات';
        newSection.linkUrl = '/all-products';
      } else if (type === 'gallery') {
        newSection.items = [
          { image: 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg', title: 'سيروم التغذية الفائقة' },
          { image: 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg', title: 'زيت الشعر المركز' },
          { image: 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg', title: 'مرطب الشفاه الطبيعي' }
        ];
      } else if (type === 'trust') {
        newSection.items = [
          { icon: 'fa-leaf', title: 'نباتي 100%', desc: 'مكونات عضوية خالية من المواد الكيميائية الضارة' },
          { icon: 'fa-truck-fast', title: 'شحن فوري سريع', desc: 'توصيل لباب منزلك بجميع المحافظات خلال 48 ساعة' },
          { icon: 'fa-hand-holding-heart', title: 'ضمان الجودة والرضا', desc: 'استبدال واسترجاع مرن خلال 14 يوماً' }
        ];
      }

      if (!studioState.customSections) {
        studioState.customSections = [];
      }
      studioState.customSections.push(newSection);

      if (!studioState.sectionOrder) {
        studioState.sectionOrder = ['hero', 'trust', 'offers', 'categories', 'promo', 'newArrivals', 'blog', 'reviews'];
      }
      studioState.sectionOrder.push(newId);

      recordStateMutation();
      renderSectionsNavigator();
      selectSection(newId, true);
      showStudioToast(`✓ تمت إضافة قسم "${meta.nameAr}" بنجاح`);
    }

    function deleteCustomSection(secId: string, e?: Event) {
      if (e) e.stopPropagation();
      if (!confirm('هل أنتِ متأكدة من حذف هذا القسم نهائياً؟')) return;

      if (studioState.customSections) {
        studioState.customSections = studioState.customSections.filter(s => s.id !== secId);
      }
      if (studioState.sectionOrder) {
        studioState.sectionOrder = studioState.sectionOrder.filter(id => id !== secId);
      }
      if (studioState.sectionsVisibility) {
        delete studioState.sectionsVisibility[secId];
      }

      if (activeSectionId === secId) {
        activeSectionId = 'hero';
      }

      recordStateMutation();
      renderSectionsNavigator();
      renderActiveInspector();
      showStudioToast('تم حذف القسم بنجاح');
    }

    // 5. RENDER SECTION NAVIGATOR (TAB 1) WITH DRAG & DROP
    function renderSectionsNavigator() {
      const list = document.getElementById('studioSectionsList');
      if (!list) return;

      const defaultOrderedSectionKeys = [
        'hero',
        'trust',
        'offers',
        'categories',
        'promo',
        'newArrivals',
        'blog',
        'reviews'
      ];

      const orderedSectionKeys = studioState.sectionOrder && studioState.sectionOrder.length
        ? studioState.sectionOrder
        : defaultOrderedSectionKeys;

      let html = '';
      orderedSectionKeys.forEach(key => {
        let meta = defaultSectionsMetadata[key];
        const customSec = studioState.customSections?.find(s => s.id === key);
        let isCustom = false;

        if (customSec) {
          isCustom = true;
          const typeInfo = customSectionTypeMeta[customSec.type] || { nameAr: 'قسم مخصص', icon: 'fa-cube' };
          meta = {
            title: customSec.title || typeInfo.nameAr,
            subtitle: `قسم مخصص - ${typeInfo.nameAr}`,
            icon: typeInfo.icon
          };
        } else if (!meta) {
          meta = { title: key, subtitle: '', icon: 'fa-cube' };
        }

        const isActive = activeSectionId === key ? 'is-active' : '';

        // Visibility calculation
        let isVisible = true;
        if (studioState.sectionsVisibility && studioState.sectionsVisibility[key] !== undefined) {
          isVisible = studioState.sectionsVisibility[key];
        } else if (key === 'offers' || key === 'newArrivals') {
          const secObj = studioState.sections.find(s => (key === 'offers' ? s.type === 'offers' : s.type !== 'offers'));
          isVisible = secObj ? secObj.visible !== false : true;
        }

        html += `
          <div class="nav-section-card ${isActive}" data-id="${key}" onclick="selectSection('${key}', true)">
            <span class="nav-drag-handle" title="اسحبي لإعادة الترتيب">
              <i class="fas fa-grip-vertical"></i>
            </span>
            <div class="nav-section-icon">
              <i class="fas ${meta.icon}"></i>
            </div>
            <div class="nav-section-info">
              <h4 class="nav-section-title">${escapeHtml(meta.title)}</h4>
              <div class="nav-section-meta">
                <span>${escapeHtml(meta.subtitle)}</span>
              </div>
            </div>
            <div class="nav-section-actions">
              <button type="button" class="btn-nav-action ${isVisible ? 'active-vis' : 'hidden-vis'}" onclick="toggleSectionVisibility('${key}', event)" title="${isVisible ? 'إخفاء القسم' : 'إظهار القسم'}">
                <i class="fas ${isVisible ? 'fa-eye' : 'fa-eye-slash'}"></i>
              </button>
              <button type="button" class="btn-nav-action" onclick="selectSection('${key}', true)" title="فتح إعدادات القسم">
                <i class="fas fa-sliders-h"></i>
              </button>
              ${isCustom ? `
                <button type="button" class="btn-nav-action" onclick="deleteCustomSection('${key}', event)" title="حذف القسم نهائياً" style="color:#dc2626;">
                  <i class="fas fa-trash-alt"></i>
                </button>
              ` : ''}
            </div>
          </div>
        `;
      });

      list.innerHTML = html;

      // Initialize SortableJS on the navigator list
      if (!(list as any)._sortableInitialized) {
        Sortable.create(list, {
          handle: '.nav-drag-handle',
          animation: 180,
          ghostClass: 'sortable-ghost',
          onEnd: () => {
            const cards = list.querySelectorAll('.nav-section-card');
            const newOrder: string[] = [];
            cards.forEach(c => {
              const id = c.getAttribute('data-id');
              if (id) newOrder.push(id);
            });
            studioState.sectionOrder = newOrder;
            recordStateMutation();
            showStudioToast('تم تحديث ترتيب الأقسام');
          }
        });
        (list as any)._sortableInitialized = true;
      }
    }

    // 6. CONTEXTUAL SECTION INSPECTOR (TAB 2)
    function renderActiveInspector() {
      const container = document.getElementById('inspectorPanelsContainer');
      const titleEl = document.getElementById('inspectorHeaderTitle');
      const subEl = document.getElementById('inspectorHeaderSubtitle');
      const iconEl = document.getElementById('inspectorHeaderIcon');
      if (!container) return;

      const customSec = studioState.customSections?.find(s => s.id === activeSectionId);
      if (customSec) {
        const typeInfo = customSectionTypeMeta[customSec.type] || { nameAr: 'قسم مخصص', icon: 'fa-cube' };
        if (titleEl) titleEl.textContent = customSec.title || typeInfo.nameAr;
        if (subEl) subEl.textContent = `قسم مخصص - ${typeInfo.nameAr}`;
        if (iconEl) iconEl.innerHTML = `<i class="fas ${typeInfo.icon}"></i>`;
        renderCustomSectionInspector(container, activeSectionId);
        return;
      }

      const meta = defaultSectionsMetadata[activeSectionId] || { title: 'إعدادات القسم', subtitle: '', icon: 'fa-cube' };
      if (titleEl) titleEl.textContent = meta.title;
      if (subEl) subEl.textContent = meta.subtitle;
      if (iconEl) iconEl.innerHTML = `<i class="fas ${meta.icon}"></i>`;

      switch (activeSectionId) {
        case 'hero':
          renderHeroInspector(container);
          break;
        case 'trust':
          renderTrustInspector(container);
          break;
        case 'offers':
          renderProductsSectionInspector(container, 'offers');
          break;
        case 'categories':
          renderCategoriesInspector(container);
          break;
        case 'promo':
          renderPromoBannerInspector(container);
          break;
        case 'newArrivals':
          renderProductsSectionInspector(container, 'newArrivals');
          break;
        case 'blog':
          renderBlogInspector(container);
          break;
        case 'reviews':
          renderReviewsInspector(container);
          break;
        default:
          container.innerHTML = `<p style="color:#6b7280; font-size:0.85rem;">اختر قسماً لعرض إعداداته.</p>`;
      }
    }

    /* --------------------------------------------------------------------------
       INSPECTOR: 1. HERO SLIDER
       -------------------------------------------------------------------------- */
    function renderHeroInspector(container: HTMLElement) {
      let slidesHtml = '';
      studioState.hero.forEach((slide, idx) => {
        const desktop = slide.desktopImage || slide.image || '';
        const mobile = slide.mobileImage || slide.desktopImage || slide.image || '';
        const dur = slide.duration || 5;

        slidesHtml += `
          <div class="studio-slide-item" data-slide-index="${idx}">
            <div class="slide-item-topbar">
              <span style="font-weight:700; font-size:0.84rem; display:flex; align-items:center; gap:6px;">
                <span class="slide-drag-handle"><i class="fas fa-grip-vertical"></i></span>
                <span>شريحة #${idx + 1}</span>
              </span>
              <div style="display:flex; align-items:center; gap:6px;">
                <label style="font-size:0.72rem; color:#4b5563;">المدة (ثواني):</label>
                <input type="number" min="1" max="60" value="${dur}" class="studio-input" style="width:60px; padding:3px 6px;" onchange="updateHeroSlideField(${idx}, 'duration', parseFloat(this.value) || 5)">
                <button type="button" class="btn-nav-action" onclick="deleteHeroSlide(${idx})" title="حذف الشريحة" style="color:#dc2626;">
                  <i class="fas fa-trash-alt"></i>
                </button>
              </div>
            </div>

            <!-- Responsive Images (Desktop & Mobile) -->
            <div class="responsive-image-row">
              <div class="image-spec-box">
                <div class="image-spec-header">
                  <span class="image-device-label"><i class="fas fa-desktop" style="color:#2563eb;"></i> ديسكتوب</span>
                  <span class="image-ratio-tag">16:9 / 21:9</span>
                </div>
                <input type="url" class="studio-input" value="${escapeHtml(desktop)}" placeholder="رابط صورة عريضة" onchange="updateHeroSlideField(${idx}, 'desktopImage', this.value)">
                <div class="image-preview-thumb">
                  ${desktop ? `<img src="${escapeHtml(desktop)}" alt="Desktop" onerror="this.parentElement.innerHTML='<span class=thumb-empty>صورة غير صالحة</span>'">` : `<span class="thumb-empty"><i class="fas fa-image"></i> بدون صورة</span>`}
                </div>
              </div>

              <div class="image-spec-box">
                <div class="image-spec-header">
                  <span class="image-device-label"><i class="fas fa-mobile-alt" style="color:#fe5d9f;"></i> هاتف</span>
                  <span class="image-ratio-tag">9:16 / 3:4</span>
                </div>
                <input type="url" class="studio-input" value="${escapeHtml(mobile)}" placeholder="رابط صورة طولية" onchange="updateHeroSlideField(${idx}, 'mobileImage', this.value)">
                <div class="image-preview-thumb">
                  ${mobile ? `<img src="${escapeHtml(mobile)}" alt="Mobile" onerror="this.parentElement.innerHTML='<span class=thumb-empty>صورة غير صالحة</span>'">` : `<span class="thumb-empty"><i class="fas fa-mobile-alt"></i> بدون صورة</span>`}
                </div>
              </div>
            </div>

            <!-- Content Inputs -->
            <div class="studio-form-group">
              <label class="studio-label">العنوان الرئيسي (Heading)</label>
              <input type="text" class="studio-input" value="${escapeHtml(slide.title || '')}" placeholder="جمال طبيعي مستخلص بعناية" onchange="updateHeroSlideField(${idx}, 'title', this.value)">
            </div>
            <div class="studio-form-group">
              <label class="studio-label">الوصف الفرعي (Subtitle)</label>
              <input type="text" class="studio-input" value="${escapeHtml(slide.subtitle || '')}" placeholder="تركيبات مصرية طبيعية 100%" onchange="updateHeroSlideField(${idx}, 'subtitle', this.value)">
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
              <div class="studio-form-group">
                <label class="studio-label">نص الزر (CTA)</label>
                <input type="text" class="studio-input" value="${escapeHtml(slide.buttonText || 'تسوقي الآن')}" onchange="updateHeroSlideField(${idx}, 'buttonText', this.value)">
              </div>
              <div class="studio-form-group">
                <label class="studio-label">رابط الزر (URL)</label>
                <input type="text" class="studio-input" value="${escapeHtml(slide.link || '/all-products')}" onchange="updateHeroSlideField(${idx}, 'link', this.value)">
              </div>
            </div>
          </div>
        `;
      });

      container.innerHTML = `
        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas fa-images"></i> شرائح العرض (${studioState.hero.length})</h4>
            <button type="button" class="btn-studio-outline" style="padding:4px 8px; font-size:0.75rem;" onclick="addHeroSlide()">
              <i class="fas fa-plus"></i> إضافة شريحة
            </button>
          </div>
          <p class="studio-hint">يدعم كل سلايد مصدري صورة منفصلين للشاشات العريضة والهواتف لضمان عدم القص والتوافق المثالي.</p>
          <div id="heroSlidesSortableList">
            ${slidesHtml}
          </div>
        </div>
      `;

      const sortableEl = document.getElementById('heroSlidesSortableList');
      if (sortableEl) {
        Sortable.create(sortableEl, {
          handle: '.slide-drag-handle',
          animation: 150,
          onEnd: (evt) => {
            if (evt.oldIndex !== undefined && evt.newIndex !== undefined) {
              const moved = studioState.hero.splice(evt.oldIndex, 1)[0];
              studioState.hero.splice(evt.newIndex, 0, moved);
              recordStateMutation();
              renderHeroInspector(container);
            }
          }
        });
      }
    }

    (window as any).updateHeroSlideField = function(idx: number, field: keyof HeroSlide, val: any) {
      if (!studioState.hero[idx]) return;
      (studioState.hero[idx] as any)[field] = val;
      if (field === 'desktopImage' || field === 'mobileImage') {
        studioState.hero[idx].image = studioState.hero[idx].desktopImage || studioState.hero[idx].mobileImage || '';
      }
      recordStateMutation();
    };

    (window as any).addHeroSlide = function() {
      studioState.hero.push({
        desktopImage: 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg',
        mobileImage: 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg',
        duration: 5,
        title: 'شريحة ترويجية جديدة',
        subtitle: 'اكتشفي تشكيلة داندي الطبيعية للعناية الفائقة.',
        buttonText: 'تسوقي الآن',
        link: '/all-products'
      });
      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تمت إضافة شريحة جديدة');
    };

    (window as any).deleteHeroSlide = function(idx: number) {
      if (studioState.hero.length <= 1) {
        showStudioToast('يجب أن تحتوي الصفحة الرئيسية على شريحة واحدة على الأقل', true);
        return;
      }
      studioState.hero.splice(idx, 1);
      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تم حذف الشريحة');
    };

    /* --------------------------------------------------------------------------
       INSPECTOR: 2. TRUST BAR
       -------------------------------------------------------------------------- */
    function renderTrustInspector(container: HTMLElement) {
      container.innerHTML = `
        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas fa-shield-alt"></i> شريط المزايا (Trust Strip)</h4>
          </div>
          <p class="studio-hint">ثلاث مزايا رئيسية تظهر أسفل بانر الهيرو لتعزيز الثقة ومعدلات التحويل.</p>

          ${[1, 2, 3].map(num => {
            const itemKey = ('item' + num) as 'item1' | 'item2' | 'item3';
            const item = studioState.trust[itemKey] || {};
            return `
              <div style="background:#f9fafb; border:1px solid var(--studio-border); border-radius:6px; padding:10px; margin-bottom:12px;">
                <h5 style="margin:0 0 8px 0; font-size:0.82rem; font-weight:700; color:#374151;">الميزة #${num}</h5>
                <div class="studio-form-group">
                  <label class="studio-label">الأيقونة (FontAwesome class أو كود SVG)</label>
                  <input type="text" class="studio-input" value="${escapeHtml(item.icon || '')}" placeholder="مثال: fa-shield-alt أو fa-truck" onchange="updateTrustItem('${itemKey}', 'icon', this.value)">
                </div>
                <div class="studio-form-group">
                  <label class="studio-label">العنوان</label>
                  <input type="text" class="studio-input" value="${escapeHtml(item.title || '')}" placeholder="عنوان الميزة" onchange="updateTrustItem('${itemKey}', 'title', this.value)">
                </div>
                <div class="studio-form-group">
                  <label class="studio-label">الوصف القصير</label>
                  <input type="text" class="studio-input" value="${escapeHtml(item.desc || '')}" placeholder="شرح مبسط" onchange="updateTrustItem('${itemKey}', 'desc', this.value)">
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;
    }

    (window as any).updateTrustItem = function(key: 'item1' | 'item2' | 'item3', field: string, val: string) {
      if (!studioState.trust[key]) studioState.trust[key] = {};
      (studioState.trust[key] as any)[field] = val;
      recordStateMutation();
    };

    /* --------------------------------------------------------------------------
       INSPECTOR: 3. DYNAMIC PRODUCT SECTIONS (Offers & New Arrivals)
       -------------------------------------------------------------------------- */
    function renderProductsSectionInspector(container: HTMLElement, secKey: 'offers' | 'newArrivals') {
      let sec = studioState.sections.find(s => (secKey === 'offers' ? s.type === 'offers' : s.type !== 'offers'));
      if (!sec) {
        sec = {
          id: 'sec-' + secKey,
          type: secKey === 'offers' ? 'offers' : 'newArrivals',
          title: secKey === 'offers' ? 'العروض الخاصة' : 'أحدث المنتجات',
          subtitle: secKey === 'offers' ? 'عروض مميزة' : 'تشكيلة مختارة',
          visible: true,
          manualProducts: {}
        };
        studioState.sections.push(sec);
      }

      // Catalog products list for manual selection
      let prodsListHtml = '';
      let selectedCount = 0;
      for (const pid in productsCatalogCache) {
        const prod = productsCatalogCache[pid];
        if (prod.isHidden) continue;
        const isSelected = sec.manualProducts && sec.manualProducts[pid];
        if (isSelected) selectedCount++;
        prodsListHtml += `
          <label style="display:flex; align-items:center; gap:8px; padding:6px 8px; border-bottom:1px solid #f3f4f6; cursor:pointer; font-size:0.8rem;">
            <input type="checkbox" ${isSelected ? 'checked' : ''} onchange="toggleManualProduct('${sec.id}', '${pid}', this.checked)">
            <img src="${prod.image || '/assets/images/logo.png'}" style="width:28px; height:28px; object-fit:cover; border-radius:4px;">
            <span style="flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeHtml(prod.name || '')}</span>
            <span style="color:#6b7280; font-weight:600;">${prod.price || 0} ج.م</span>
          </label>
        `;
      }

      container.innerHTML = `
        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas fa-tags"></i> ${escapeHtml(sec.title || '')}</h4>
            <label class="studio-switch-label" style="gap:6px;">
              <input type="checkbox" ${sec.visible !== false ? 'checked' : ''} onchange="updateSecField('${sec.id}', 'visible', this.checked)">
              <span class="studio-switch-text">إظهار القسم</span>
            </label>
          </div>

          <div class="studio-form-group">
            <label class="studio-label">عنوان القسم الرئيسي</label>
            <input type="text" class="studio-input" value="${escapeHtml(sec.title || '')}" onchange="updateSecField('${sec.id}', 'title', this.value)">
          </div>

          <div class="studio-form-group">
            <label class="studio-label">النص العلوي (Eyebrow Tag)</label>
            <input type="text" class="studio-input" value="${escapeHtml(sec.subtitle || '')}" onchange="updateSecField('${sec.id}', 'subtitle', this.value)">
          </div>

          <div class="studio-form-group">
            <label class="studio-label">مصدر المنتجات المعروضة</label>
            <select class="studio-select" onchange="updateSecField('${sec.id}', 'type', this.value); renderActiveInspector();">
              <option value="offers" ${sec.type === 'offers' ? 'selected' : ''}>العروض والخصومات تلقائياً</option>
              <option value="bestsellers" ${sec.type === 'bestsellers' ? 'selected' : ''}>الأكثر مبيعاً تلقائياً</option>
              <option value="manual" ${sec.type === 'manual' ? 'selected' : ''}>اختيار يدوي من كتالوج المتجر</option>
            </select>
          </div>

          ${sec.type === 'manual' ? `
            <div class="studio-form-group" style="margin-top:14px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <label class="studio-label" style="margin-bottom:0;">المنتجات المحددة (${selectedCount})</label>
                <span style="font-size:0.72rem; color:#6b7280;">انقري لتحديد المنتجات</span>
              </div>
              <input type="text" class="studio-input" placeholder="بحث في المنتجات..." style="margin-bottom:6px;" oninput="filterManualProds(this.value)">
              <div id="manualProdsScrollBox" style="max-height:180px; overflow-y:auto; border:1px solid var(--studio-border); border-radius:6px; background:#ffffff;">
                ${prodsListHtml}
              </div>
            </div>
          ` : ''}
        </div>
      `;
    }

    (window as any).updateSecField = function(secId: string, field: string, val: any) {
      const s = studioState.sections.find(item => item.id === secId);
      if (s) {
        (s as any)[field] = val;
        recordStateMutation();
      }
    };

    (window as any).toggleManualProduct = function(secId: string, prodId: string, isChecked: boolean) {
      const s = studioState.sections.find(item => item.id === secId);
      if (s) {
        if (!s.manualProducts) s.manualProducts = {};
        if (isChecked) {
          s.manualProducts[prodId] = true;
        } else {
          delete s.manualProducts[prodId];
        }
        recordStateMutation();
      }
    };

    (window as any).filterManualProds = function(query: string) {
      const q = (query || '').toLowerCase().trim();
      const labels = document.querySelectorAll('#manualProdsScrollBox label');
      labels.forEach(l => {
        const txt = (l.textContent || '').toLowerCase();
        (l as HTMLElement).style.display = txt.includes(q) ? 'flex' : 'none';
      });
    };

    /* --------------------------------------------------------------------------
       INSPECTOR: 4. CATEGORIES & COLLECTIONS (Layout-Aware Responsive System)
       -------------------------------------------------------------------------- */
    function renderCategoriesInspector(container: HTMLElement) {
      const catKeys = Object.keys(studioState.categories || {});
      const editingKey = activeCategoryEditKey;
      const currentEditingCat = editingKey ? studioState.categories[editingKey] : null;

      let catListHtml = '';
      catKeys.forEach(key => {
        const c = studioState.categories[key];
        const layout = c.layoutVariant || 'auto';
        const spec = categoryLayoutSpecs[layout] || categoryLayoutSpecs.auto;
        const desktopImg = c.desktopImage || c.image || '';
        const isCurrent = key === editingKey;

        catListHtml += `
          <div style="display:flex; align-items:center; gap:8px; padding:8px 10px; background:${isCurrent ? 'var(--studio-accent-soft)' : '#f9fafb'}; border:1px solid ${isCurrent ? 'var(--studio-accent)' : 'var(--studio-border)'}; border-radius:6px; margin-bottom:8px;">
            <img src="${escapeHtml(desktopImg || '/assets/images/logo.png')}" style="width:36px; height:36px; object-fit:cover; border-radius:4px;">
            <div style="flex:1; min-width:0;">
              <div style="display:flex; align-items:center; gap:6px;">
                <h5 style="margin:0; font-size:0.84rem; font-weight:700;">${escapeHtml(c.name || 'بدون اسم')}</h5>
                <span class="variant-pill variant-pill-${layout}">${spec.nameAr.split(' ')[0]}</span>
              </div>
              <small style="color:#6b7280; font-size:0.72rem;">${escapeHtml(c.tagline || '')}</small>
            </div>
            <button type="button" class="btn-nav-action" onclick="startCategoryEdit('${key}')" title="تعديل هذا القسم">
              <i class="fas fa-edit"></i>
            </button>
            <button type="button" class="btn-nav-action" onclick="deleteCategoryItem('${key}')" title="حذف" style="color:#dc2626;">
              <i class="fas fa-trash-alt"></i>
            </button>
          </div>
        `;
      });

      // Active form state (add vs edit)
      const formTitle = editingKey ? `تعديل القسم: ${escapeHtml(currentEditingCat?.name || '')}` : 'إضافة مجموعة جديدة';
      const nameVal = currentEditingCat?.name || '';
      const tagVal = currentEditingCat?.tagline || '';
      const countVal = currentEditingCat?.count || '';
      const layoutVal = currentEditingCat?.layoutVariant || 'auto';
      const desktopVal = currentEditingCat?.desktopImage || currentEditingCat?.image || '';
      const mobileVal = currentEditingCat?.mobileImage || currentEditingCat?.desktopImage || currentEditingCat?.image || '';
      const activeSpec = categoryLayoutSpecs[layoutVal] || categoryLayoutSpecs.auto;

      container.innerHTML = `
        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas fa-th-large"></i> الأقسام الحالية (${catKeys.length})</h4>
            ${editingKey ? `
              <button type="button" class="btn-studio-outline" style="padding:4px 8px; font-size:0.72rem;" onclick="cancelCategoryEdit()">
                <i class="fas fa-plus"></i> إضافة قسم جديد
              </button>
            ` : ''}
          </div>
          <div style="max-height:160px; overflow-y:auto; margin-bottom:14px;">
            ${catListHtml || '<p style="color:#9ca3af; font-size:0.78rem; text-align:center; padding:12px;">لا توجد أقسام مسجلة.</p>'}
          </div>

          <!-- Add / Edit Form -->
          <div style="background:#fdfdfd; border:1px solid var(--studio-border); border-radius:8px; padding:14px;">
            <h5 style="margin:0 0 10px 0; font-size:0.86rem; font-weight:800; color:var(--studio-text);">${formTitle}</h5>

            <div class="studio-form-group">
              <label class="studio-label">اسم القسم</label>
              <input type="text" id="catFormName" class="studio-input" value="${escapeHtml(nameVal)}" placeholder="العناية بالبشرة">
            </div>

            <div style="display:grid; grid-template-columns:1.5fr 1fr; gap:8px;">
              <div class="studio-form-group">
                <label class="studio-label">النص التسويقي (Tagline)</label>
                <input type="text" id="catFormTagline" class="studio-input" value="${escapeHtml(tagVal)}" placeholder="ترطيب ونضارة">
              </div>
              <div class="studio-form-group">
                <label class="studio-label">العدد/الشارة</label>
                <input type="text" id="catFormCount" class="studio-input" value="${escapeHtml(countVal)}" placeholder="12 منتج">
              </div>
            </div>

            <div class="studio-form-group">
              <label class="studio-label">قالب القسم بالشبكة (Layout Variant)</label>
              <select id="catFormLayout" class="studio-select" onchange="onCategoryLayoutSelectionChange(this.value)">
                <option value="auto" ${layoutVal === 'auto' ? 'selected' : ''}>تلقائي تحريري (Auto Alternating)</option>
                <option value="wide" ${layoutVal === 'wide' ? 'selected' : ''}>عريض أفقي (Wide - ارتفاع 250px)</option>
                <option value="large" ${layoutVal === 'large' ? 'selected' : ''}>كبير رئيسي (Large - ارتفاع 350px)</option>
                <option value="tall" ${layoutVal === 'tall' ? 'selected' : ''}>طولي عمودي (Tall - ارتفاع 360px)</option>
                <option value="small" ${layoutVal === 'small' ? 'selected' : ''}>مدمج صغير (Small - ارتفاع 240px)</option>
              </select>
            </div>

            <!-- Dynamic Dimension Guidance Box -->
            <div id="catGuidanceCard" style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px; padding:10px; margin-bottom:12px;">
              <div style="font-size:0.75rem; font-weight:700; color:#166534; margin-bottom:4px; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-ruler-combined"></i> أبعاد وتوصيات القالب المختار (<span id="catGuidanceName">${activeSpec.nameAr.split(' ')[0]}</span>)
              </div>
              <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; font-size:0.72rem; color:#14532d;">
                <div><strong>ديسكتوب:</strong> <span id="catGuidanceDesktop">${activeSpec.desktop.label}</span></div>
