          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <div class="studio-form-group">
              <label class="studio-label">نص الزر الثانوي</label>
              <input type="text" class="studio-input" dir="auto" value="${escapeHtml(heroMeta.secondaryCtaLabel || '')}" placeholder="${isEnMode ? 'Our Philosophy' : 'فلسفة داندي'}" oninput="updateHeroMetaField('secondaryCtaLabel', this.value, true)" onchange="updateHeroMetaField('secondaryCtaLabel', this.value)">
            </div>
            <div class="studio-form-group">
              <label class="studio-label">رابط الزر الثانوي</label>
              <input type="text" class="studio-input" dir="ltr" value="${escapeHtml(heroMeta.secondaryCtaHref || '')}" placeholder="${isEnMode ? '/en/about-us' : '/about-us'}" oninput="updateHeroMetaField('secondaryCtaHref', this.value, true)" onchange="updateHeroMetaField('secondaryCtaHref', this.value)">
            </div>
          </div>
        </div>

        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas fa-images"></i> شرائح العرض (${studioState.hero.length})</h4>
            <button type="button" class="btn-studio-outline" style="padding:4px 8px; font-size:0.75rem;" onclick="addHeroSlide()">
              <i class="fas fa-plus"></i> إضافة شريحة
            </button>
          </div>
          <p class="studio-hint">يدعم كل سلايد مصدري صورة منفصلين للشاشات العريضة والهواتف (بما في ذلك الصور الطولية 9:16 و3:4) عبر &lt;picture&gt;.</p>
          <div id="heroSlidesSortableList">
            ${slidesHtml}
          </div>
        </div>
      `;

      const sortableEl = document.getElementById('heroSlidesSortableList');
      if (sortableEl) {
        Sortable.create(sortableEl, {
          handle: '.slide-drag-handle',
          animation: 150,
          onEnd: (evt) => {
            if (evt.oldIndex !== undefined && evt.newIndex !== undefined) {
              const moved = studioState.hero.splice(evt.oldIndex, 1)[0];
              studioState.hero.splice(evt.newIndex, 0, moved);
              recordStateMutation();
              renderHeroInspector(container);
            }
          }
        });
      }
    }

    (window as any).updateHeroMetaField = function(field: keyof HeroMetaConfig, val: string, isLiveInput = false) {
      if (studioLang === 'en') {
        const ov = ensureEnOverlay();
        if (!ov.heroMeta) ov.heroMeta = {};
        ov.heroMeta[field] = val;
      } else {
        if (!studioState.heroMeta) studioState.heroMeta = {};
        studioState.heroMeta[field] = val;
      }
      if (isLiveInput) scheduleLivePreviewMutation();
      else recordStateMutation();
    };

    (window as any).updateHeroSlideField = function(idx: number, field: keyof HeroSlide, val: any, isLiveInput = false) {
      if (!studioState.hero[idx]) return;
      const isLocalizedText = field === 'title' || field === 'subtitle' || field === 'buttonText' || field === 'link';
      if (studioLang === 'en' && isLocalizedText) {
        const ov = ensureEnOverlay();
        if (!ov.heroSlides) ov.heroSlides = {};
        if (!ov.heroSlides[idx]) ov.heroSlides[idx] = {};
        ov.heroSlides[idx][field] = val;
      } else {
        (studioState.hero[idx] as any)[field] = val;
        if (field === 'desktopImage' || field === 'mobileImage') {
          studioState.hero[idx].image = studioState.hero[idx].desktopImage || studioState.hero[idx].mobileImage || '';
        }
      }
      if (isLiveInput) scheduleLivePreviewMutation();
      else recordStateMutation();
    };

    (window as any).addHeroSlide = function() {
      studioState.hero.push({
        desktopImage: '/assets/images/hero/hero-1.jpg',
        mobileImage: '/assets/images/hero/hero-1.jpg',
        duration: 5,
        title: 'شريحة ترويجية جديدة',
        subtitle: 'اكتشفي تشكيلة داندي الطبيعية للعناية الفائقة.',
        buttonText: 'تسوقي الآن',
        link: '/all-products'
      });
      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تمت إضافة شريحة جديدة');
    };

    (window as any).deleteHeroSlide = function(idx: number) {
      if (studioState.hero.length <= 1) {
        showStudioToast('يجب أن تحتوي الصفحة الرئيسية على شريحة واحدة على الأقل', true);
        return;
      }
      studioState.hero.splice(idx, 1);
      recordStateMutation();
      renderActiveInspector();
      showStudioToast('تم حذف الشريحة');
    };

    /* --------------------------------------------------------------------------
       INSPECTOR: 2. TRUST BAR (SECTION HEADER + 3 OR 4 CARDS + ICON PICKER)
       -------------------------------------------------------------------------- */
    function renderTrustInspector(container: HTMLElement) {
      const isEnMode = studioLang === 'en';
      const trustMeta = isEnMode
        ? (studioState.enOverlay?.trustSection || {})
        : (studioState.trustSection || {});
      const keys: Array<'item1' | 'item2' | 'item3' | 'item4'> = studioState.trust.item4
        ? ['item1', 'item2', 'item3', 'item4']
        : ['item1', 'item2', 'item3'];

      container.innerHTML = `
        ${renderEnModeBannerHtml()}
        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas fa-heading"></i> ترويسة شريط المزايا (اختياري)</h4>
          </div>
          <p class="studio-hint">عند ترك العنوان والعنوان الفرعي فارغين يظهر شريط المزايا مباشرة بدون ترويسة علوية.</p>
          <div class="studio-form-group">
            <label class="studio-label">الشريط العلوي (Kicker)</label>
            <input type="text" class="studio-input" dir="auto" value="${escapeHtml(trustMeta.kicker || '')}" placeholder="${isEnMode ? 'EN: Why Choose DANDY' : 'مثال: لماذا داندي؟'}" oninput="updateTrustSectionMeta('kicker', this.value, true)" onchange="updateTrustSectionMeta('kicker', this.value)">
          </div>
          <div class="studio-form-group">
            <label class="studio-label">عنوان القسم</label>
            <input type="text" class="studio-input" dir="auto" value="${escapeHtml(trustMeta.title || '')}" placeholder="${isEnMode ? 'EN: Trusted Botanical Care' : 'مثال: عناية موثوقة كل يوم'}" oninput="updateTrustSectionMeta('title', this.value, true)" onchange="updateTrustSectionMeta('title', this.value)">
          </div>
        </div>

        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas fa-shield-alt"></i> بطاقات المزايا (${keys.length})</h4>
            ${!studioState.trust.item4 ? `
              <button type="button" class="btn-studio-outline" style="padding:4px 8px; font-size:0.72rem;" onclick="toggleFourthTrustItem(true)">
                <i class="fas fa-plus"></i> إضافة بطاقة رابعة
              </button>
            ` : `
              <button type="button" class="btn-studio-outline" style="padding:4px 8px; font-size:0.72rem; color:#dc2626; border-color:#fca5a5;" onclick="toggleFourthTrustItem(false)">
                <i class="fas fa-trash-alt"></i> إزالة البطاقة الرابعة
              </button>
            `}
          </div>
          <p class="studio-hint">بطاقات المزايا التي تظهر أسفل بانر الهيرو لتعزيز الثقة ومعدلات التحويل.</p>

          ${keys.map((itemKey, idx) => {
            const baseItem = studioState.trust[itemKey] || {};
            const enItem = studioState.enOverlay?.trustItems?.[itemKey] || {};
            const titleVal = isEnMode ? (enItem.title || '') : (baseItem.title || '');
            const descVal = isEnMode ? (enItem.desc || '') : (baseItem.desc || '');
            const iconVal = baseItem.icon || '';
            const matchingPreset = TRUST_ICON_PRESETS.some(p => p.value === iconVal) ? iconVal : '';

            return `
              <div style="background:#f9fafb; border:1px solid var(--studio-border); border-radius:6px; padding:10px; margin-bottom:12px;">
                <h5 style="margin:0 0 8px 0; font-size:0.82rem; font-weight:700; color:#374151; display:flex; align-items:center; justify-content:space-between;">
                  <span>الميزة #${idx + 1}</span>
                  ${iconVal ? `<i class="fas ${escapeHtml(iconVal)}" style="color:var(--studio-accent);"></i>` : ''}
                </h5>
                <div class="studio-form-group">
                  <label class="studio-label">الأيقونة السريعة ${sharedTagHtml()}</label>
                  <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
                    <select class="studio-select" onchange="if(this.value){ updateTrustItem('${itemKey}', 'icon', this.value); renderActiveInspector(); }">
                      <option value="">-- اختيار أيقونة --</option>
                      ${TRUST_ICON_PRESETS.map(p => `<option value="${p.value}" ${matchingPreset === p.value ? 'selected' : ''}>${p.label}</option>`).join('')}
                    </select>
                    <input type="text" class="studio-input" dir="ltr" value="${escapeHtml(iconVal)}" placeholder="fa-leaf" oninput="updateTrustItem('${itemKey}', 'icon', this.value, true)" onchange="updateTrustItem('${itemKey}', 'icon', this.value)">
                  </div>
                </div>
                <div class="studio-form-group">
                  <label class="studio-label">العنوان</label>
                  <input type="text" class="studio-input" dir="auto" value="${escapeHtml(titleVal)}" placeholder="${isEnMode ? 'EN: Trust benefit title...' : 'عنوان الميزة'}" oninput="updateTrustItem('${itemKey}', 'title', this.value, true)" onchange="updateTrustItem('${itemKey}', 'title', this.value)">
                </div>
                <div class="studio-form-group">
                  <label class="studio-label">الوصف القصير</label>
                  <input type="text" class="studio-input" dir="auto" value="${escapeHtml(descVal)}" placeholder="${isEnMode ? 'EN: Short explanation...' : 'شرح مبسط'}" oninput="updateTrustItem('${itemKey}', 'desc', this.value, true)" onchange="updateTrustItem('${itemKey}', 'desc', this.value)">
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;
    }

    (window as any).updateTrustSectionMeta = function(field: 'kicker' | 'title', val: string, isLiveInput = false) {
      if (studioLang === 'en') {
        const ov = ensureEnOverlay();
        if (!ov.trustSection) ov.trustSection = {};
        ov.trustSection[field] = val;
      } else {
        if (!studioState.trustSection) studioState.trustSection = {};
        studioState.trustSection[field] = val;
      }
      if (isLiveInput) scheduleLivePreviewMutation();
      else recordStateMutation();
    };

    (window as any).toggleFourthTrustItem = function(enable: boolean) {
      if (enable) {
        studioState.trust.item4 = {
          icon: 'fa-heart',
          title: 'عناية يومية آمنة',
          desc: 'تركيبات لطيفة خالية من المواد القاسية ومناسبة للاستخدام اليومي.'
        };
      } else {
        delete studioState.trust.item4;
      }
      recordStateMutation();
      renderActiveInspector();
    };

    (window as any).updateTrustItem = function(key: 'item1' | 'item2' | 'item3' | 'item4', field: string, val: string, isLiveInput = false) {
      if (studioLang === 'en' && (field === 'title' || field === 'desc')) {
        const ov = ensureEnOverlay();
        if (!ov.trustItems) ov.trustItems = {};
        if (!ov.trustItems[key]) ov.trustItems[key] = {};
        ov.trustItems[key][field] = val;
      } else {
        if (!studioState.trust[key]) studioState.trust[key] = {};
        (studioState.trust[key] as any)[field] = val;
      }
      if (isLiveInput) scheduleLivePreviewMutation();
      else recordStateMutation();
    };

    /* --------------------------------------------------------------------------
       INSPECTOR: 3. DYNAMIC PRODUCT SECTIONS (Offers & New Arrivals)
       -------------------------------------------------------------------------- */
    function renderProductsSectionInspector(container: HTMLElement, secKey: 'offers' | 'newArrivals') {
      const isEnMode = studioLang === 'en';
      let sec = findDynamicProductSection(secKey);
      if (!sec) {
        sec = {
          id: secKey === 'offers' ? 'sec-special-offers' : 'sec-new-arrivals',
          type: secKey === 'offers' ? 'offers' : 'newArrivals',
          title: secKey === 'offers' ? 'العروض الخاصة' : 'مستحضرات مختارة لروتينكِ اليومي',
          subtitle: secKey === 'offers' ? 'مختارات العروض' : 'مختارات داندي',
          visible: true,
          limit: 8,
          manualProducts: {}
        };
        studioState.sections.push(sec);
      }

      const enSecOv = studioState.enOverlay?.sections?.[sec.id] || studioState.enOverlay?.sections?.[secKey] || {};
      const titleVal = isEnMode ? (enSecOv.title || '') : (sec.title || '');
      const subVal = isEnMode ? (enSecOv.subtitle || '') : (sec.subtitle || '');
      const moreLabelVal = isEnMode ? (enSecOv.viewAllLabel || '') : (sec.viewAllLabel || '');
      const moreHrefVal = isEnMode ? (enSecOv.viewAllHref || '') : (sec.viewAllHref || '');
      const currentLimit = Number(sec.limit) >= 2 && Number(sec.limit) <= 12 ? Number(sec.limit) : 8;

      // Catalog products list for manual selection
      let prodsListHtml = '';
      let selectedCount = 0;
      for (const pid in productsCatalogCache) {
        const prod = productsCatalogCache[pid];
        if (prod.isHidden) continue;
        const isSelected = sec.manualProducts && sec.manualProducts[pid];
        if (isSelected) selectedCount++;
        prodsListHtml += `
          <label style="display:flex; align-items:center; gap:8px; padding:6px 8px; border-bottom:1px solid #f3f4f6; cursor:pointer; font-size:0.8rem;">
            <input type="checkbox" ${isSelected ? 'checked' : ''} onchange="toggleManualProduct('${sec.id}', '${pid}', this.checked)">
            <img src="${prod.image || '/assets/images/logo.png'}" style="width:28px; height:28px; object-fit:cover; border-radius:4px;">
            <span style="flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeHtml(prod.name || '')}</span>
            <span style="color:#6b7280; font-weight:600;">${prod.price || 0} ج.م</span>
          </label>
        `;
      }

      container.innerHTML = `
        ${renderEnModeBannerHtml()}
        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas fa-tags"></i> ${escapeHtml(sec.title || '')}</h4>
          </div>

          <div class="studio-form-group">
            <label class="studio-label">عنوان القسم الرئيسي</label>
            <input type="text" class="studio-input" dir="auto" value="${escapeHtml(titleVal)}" placeholder="${isEnMode ? 'EN: Section heading...' : 'عنوان القسم'}" oninput="updateSecField('${sec.id}', 'title', this.value, '${secKey}', true)" onchange="updateSecField('${sec.id}', 'title', this.value, '${secKey}')">
          </div>

          <div class="studio-form-group">
            <label class="studio-label">النص العلوي (Eyebrow Tag)</label>
            <input type="text" class="studio-input" dir="auto" value="${escapeHtml(subVal)}" placeholder="${isEnMode ? 'EN: Kicker tag...' : 'النص العلوي'}" oninput="updateSecField('${sec.id}', 'subtitle', this.value, '${secKey}', true)" onchange="updateSecField('${sec.id}', 'subtitle', this.value, '${secKey}')">
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <div class="studio-form-group">
              <label class="studio-label">مصدر المنتجات ${sharedTagHtml()}</label>
              <select class="studio-select" onchange="updateSecField('${sec.id}', 'type', this.value, '${secKey}'); renderActiveInspector();">
                <option value="offers" ${sec.type === 'offers' ? 'selected' : ''}>العروض والخصومات تلقائياً</option>
                <option value="bestsellers" ${sec.type === 'bestsellers' ? 'selected' : ''}>الأكثر مبيعاً تلقائياً</option>
                <option value="newArrivals" ${sec.type === 'newArrivals' ? 'selected' : ''}>أحدث المنتجات تلقائياً</option>
                <option value="all" ${sec.type === 'all' ? 'selected' : ''}>مختارات المتجر (كل المنتجات)</option>
                <option value="manual" ${sec.type === 'manual' ? 'selected' : ''}>اختيار يدوي من الكتالوج</option>
              </select>
            </div>
            <div class="studio-form-group">
              <label class="studio-label">عدد المنتجات (2-12) ${sharedTagHtml()}</label>
              <input type="number" min="2" max="12" class="studio-input" value="${currentLimit}" oninput="updateSecField('${sec.id}', 'limit', Math.max(2, Math.min(12, parseInt(this.value) || 8)), '${secKey}', true)" onchange="updateSecField('${sec.id}', 'limit', Math.max(2, Math.min(12, parseInt(this.value) || 8)), '${secKey}')">
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <div class="studio-form-group">
              <label class="studio-label">نص زر المزيد</label>
              <input type="text" class="studio-input" dir="auto" value="${escapeHtml(moreLabelVal)}" placeholder="${isEnMode ? 'View All Products' : 'عرض الكل'}" oninput="updateSecField('${sec.id}', 'viewAllLabel', this.value, '${secKey}', true)" onchange="updateSecField('${sec.id}', 'viewAllLabel', this.value, '${secKey}')">
            </div>
            <div class="studio-form-group">
              <label class="studio-label">رابط زر المزيد</label>
              <input type="text" class="studio-input" dir="ltr" value="${escapeHtml(moreHrefVal)}" placeholder="${isEnMode ? '/en/all-products' : '/all-products'}" oninput="updateSecField('${sec.id}', 'viewAllHref', this.value, '${secKey}', true)" onchange="updateSecField('${sec.id}', 'viewAllHref', this.value, '${secKey}')">
            </div>
          </div>

          ${sec.type === 'manual' ? `
            <div class="studio-form-group" style="margin-top:14px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <label class="studio-label" style="margin-bottom:0;">المنتجات المحددة (${selectedCount}) ${sharedTagHtml()}</label>
                <span style="font-size:0.72rem; color:#6b7280;">انقري لتحديد المنتجات</span>
              </div>
              <input type="text" class="studio-input" placeholder="بحث في المنتجات..." style="margin-bottom:6px;" oninput="filterManualProds(this.value)">
              <div id="manualProdsScrollBox" style="max-height:180px; overflow-y:auto; border:1px solid var(--studio-border); border-radius:6px; background:#ffffff;">
                ${prodsListHtml}
              </div>
            </div>
          ` : ''}
        </div>
      `;
    }

    (window as any).updateSecField = function(secId: string, field: string, val: any, secKey?: string, isLiveInput = false) {
      const s = studioState.sections.find(item => item.id === secId);
      if (!s) return;
      const isLocalized = field === 'title' || field === 'subtitle' || field === 'viewAllLabel' || field === 'viewAllHref';
      if (studioLang === 'en' && isLocalized) {
        const ov = ensureEnOverlay();
        if (!ov.sections) ov.sections = {};
        const ovKey = secId || secKey || 'sec';
        if (!ov.sections[ovKey]) ov.sections[ovKey] = {};
        ov.sections[ovKey][field] = val;
      } else {
        (s as any)[field] = val;
      }
      if (isLiveInput) scheduleLivePreviewMutation();
      else recordStateMutation();
    };

    (window as any).toggleManualProduct = function(secId: string, prodId: string, isChecked: boolean) {
      const s = studioState.sections.find(item => item.id === secId);
      if (s) {
        if (!s.manualProducts) s.manualProducts = {};
        if (isChecked) {
          s.manualProducts[prodId] = true;
        } else {
          delete s.manualProducts[prodId];
        }
        recordStateMutation();
      }
    };

    (window as any).filterManualProds = function(query: string) {
      const q = (query || '').toLowerCase().trim();
      const labels = document.querySelectorAll('#manualProdsScrollBox label');
      labels.forEach(l => {
        const txt = (l.textContent || '').toLowerCase();
        (l as HTMLElement).style.display = txt.includes(q) ? 'flex' : 'none';
      });
    };

    /* --------------------------------------------------------------------------
       INSPECTOR: 4. CATEGORIES & COLLECTIONS (HEADER + ORDER + VISIBILITY + DESC)
       -------------------------------------------------------------------------- */
    function getOrderedCategoryKeys(): string[] {
      const entries = Object.entries(studioState.categories || {});
      return entries
        .map(([key, item], index) => ({
          key,
          sortOrder: typeof item?.order === 'number' && Number.isFinite(item.order) ? item.order : index,
          index
        }))
        .sort((a, b) => a.sortOrder - b.sortOrder || a.index - b.index)
        .map(x => x.key);
    }

    function renderCategoriesInspector(container: HTMLElement) {
      const isEnMode = studioLang === 'en';
      const catMeta = isEnMode
        ? (studioState.enOverlay?.categoriesSection || {})
        : (studioState.categoriesSection || {});
      const catKeys = getOrderedCategoryKeys();
      const editingKey = activeCategoryEditKey;
      const currentEditingCat = editingKey ? studioState.categories[editingKey] : null;
      const currentEditingEn = editingKey ? (studioState.enOverlay?.categories?.[editingKey] || {}) : {};

      let catListHtml = '';
      catKeys.forEach((key, idx) => {
        const c = studioState.categories[key];
        const layout = c.layoutVariant || 'auto';
        const spec = categoryLayoutSpecs[layout] || categoryLayoutSpecs.auto;
        const desktopImg = c.desktopImage || c.image || '';
        const isCurrent = key === editingKey;
        const isCatVisible = c.visible !== false;

        catListHtml += `
          <div style="display:flex; align-items:center; gap:6px; padding:8px 8px; background:${isCurrent ? 'var(--studio-accent-soft)' : '#f9fafb'}; border:1px solid ${isCurrent ? 'var(--studio-accent)' : 'var(--studio-border)'}; border-radius:6px; margin-bottom:8px; opacity:${isCatVisible ? '1' : '0.6'};">
            <div style="display:flex; flex-direction:column; gap:2px;">
              <button type="button" class="btn-nav-action" style="width:22px; height:20px;" onclick="moveCategoryOrder('${key}', -1)" ${idx === 0 ? 'disabled' : ''} title="تحريك لأعلى">
                <i class="fas fa-chevron-up"></i>
              </button>
              <button type="button" class="btn-nav-action" style="width:22px; height:20px;" onclick="moveCategoryOrder('${key}', 1)" ${idx === catKeys.length - 1 ? 'disabled' : ''} title="تحريك لأسفل">
                <i class="fas fa-chevron-down"></i>
              </button>
            </div>
            <img src="${escapeHtml(desktopImg || '/assets/images/logo.png')}" style="width:36px; height:36px; object-fit:cover; border-radius:4px;">
            <div style="flex:1; min-width:0;">
              <div style="display:flex; align-items:center; gap:6px;">
                <h5 style="margin:0; font-size:0.84rem; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeHtml(c.name || 'بدون اسم')}</h5>
                <span class="variant-pill variant-pill-${layout}">${spec.nameAr.split(' ')[0]}</span>
              </div>
              <small style="color:#6b7280; font-size:0.72rem; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeHtml(c.tagline || '')}</small>
            </div>
            <button type="button" class="btn-nav-action ${isCatVisible ? 'active-vis' : 'hidden-vis'}" onclick="toggleCategoryVisibility('${key}')" title="${isCatVisible ? 'إخفاء التصنيف' : 'إظهار التصنيف'}">
              <i class="fas ${isCatVisible ? 'fa-eye' : 'fa-eye-slash'}"></i>
            </button>
            <button type="button" class="btn-nav-action" onclick="startCategoryEdit('${key}')" title="تعديل هذا القسم">
              <i class="fas fa-edit"></i>
            </button>
            <button type="button" class="btn-nav-action" onclick="deleteCategoryItem('${key}')" title="حذف" style="color:#dc2626;">
              <i class="fas fa-trash-alt"></i>
            </button>
          </div>
        `;
      });

      const formTitle = editingKey ? `تعديل القسم: ${escapeHtml(currentEditingCat?.name || '')}` : 'إضافة مجموعة جديدة';
      const nameVal = isEnMode && editingKey ? (currentEditingEn.name || '') : (currentEditingCat?.name || '');
      const tagVal = isEnMode && editingKey ? (currentEditingEn.tagline || '') : (currentEditingCat?.tagline || '');
      const countVal = isEnMode && editingKey ? (currentEditingEn.count || '') : (currentEditingCat?.count || '');
      const descVal = isEnMode && editingKey ? (currentEditingEn.description || '') : (currentEditingCat?.description || '');
      const layoutVal = currentEditingCat?.layoutVariant || 'auto';
      const desktopVal = currentEditingCat?.desktopImage || currentEditingCat?.image || '';
      const mobileVal = currentEditingCat?.mobileImage || currentEditingCat?.desktopImage || currentEditingCat?.image || '';
      const activeSpec = categoryLayoutSpecs[layoutVal] || categoryLayoutSpecs.auto;

      container.innerHTML = `
        ${renderEnModeBannerHtml()}
        <div class="inspector-card">
          <div class="inspector-card-header">
            <h4 class="inspector-card-title"><i class="fas fa-heading"></i> ترويسة ورابط قسم التصنيفات</h4>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <div class="studio-form-group">
              <label class="studio-label">الشريط العلوي (Kicker)</label>
              <input type="text" class="studio-input" dir="auto" value="${escapeHtml(catMeta.kicker || '')}" placeholder="${isEnMode ? 'Primary Categories' : 'الأقسام الرئيسية'}" oninput="updateCategoriesSectionMeta('kicker', this.value, true)" onchange="updateCategoriesSectionMeta('kicker', this.value)">
            </div>
            <div class="studio-form-group">
              <label class="studio-label">العنوان الرئيسي</label>
              <input type="text" class="studio-input" dir="auto" value="${escapeHtml(catMeta.title || '')}" placeholder="${isEnMode ? 'Shop by Routine' : 'تسوقي حسب الروتين'}" oninput="updateCategoriesSectionMeta('title', this.value, true)" onchange="updateCategoriesSectionMeta('title', this.value)">
            </div>
          </div>
