    async function initStudio() {
      // Helper function to reliably resolve auth even if Firebase scripts are still loading
      function waitForAuth(): Promise<any> {
        return new Promise((resolve) => {
          const immediateAuth = (window as any).auth || (typeof (window as any).firebase !== 'undefined' && (window as any).firebase.auth ? (window as any).firebase.auth() : null);
          if (immediateAuth) return resolve(immediateAuth);

          let attempts = 0;
          const maxAttempts = 40; // 40 * 100ms = 4 seconds
          const interval = setInterval(() => {
            attempts++;
            const a = (window as any).auth || (typeof (window as any).firebase !== 'undefined' && (window as any).firebase.auth ? (window as any).firebase.auth() : null);
            if (a) {
              clearInterval(interval);
              resolve(a);
            } else if (attempts >= maxAttempts) {
              clearInterval(interval);
              resolve(null);
            }
          }, 100);
        });
      }

      const auth = await waitForAuth();
      if (!auth) {
        // If auth fails to initialize after timeout, redirect securely to login without loading ANY data
        window.location.replace('/login');
        return;
      }

      auth.onAuthStateChanged(async (user: any) => {
        if (!user) {
          window.location.href = '/login';
          return;
        }
        if (!user.email || user.email.toLowerCase() !== 'admin@dandy.com') {
          // Immediate kickout for non-admin logged-in users before loading any data
          window.location.replace('/');
          return;
        }

        // ONLY executed if user is authenticated and verified as admin@dandy.com
        await loadProductsCatalog();
        await loadStudioFirebaseData();
        setupKeyboardShortcuts();
        setupWindowUnloadWarning();
        setupPreviewBridgeListener();
      });
    }

    async function loadProductsCatalog() {
      const db = (window as any).db || (typeof (window as any).firebase !== 'undefined' ? (window as any).firebase.database() : null);
      if (!db) return;
      try {
        const snap = await db.ref('products').once('value');
        if (snap.exists()) {
          productsCatalogCache = snap.val();
        }
      } catch (e) {
        console.warn('Error loading products catalog:', e);
      }
    }

    async function loadStudioFirebaseData() {
      const db = (window as any).db || (typeof (window as any).firebase !== 'undefined' ? (window as any).firebase.database() : null);
      if (!db) return;

      try {
        const [homeSnap, catSnap] = await Promise.all([
          db.ref('homepage').once('value'),
          db.ref('categories').once('value')
        ]);

        const homeData = homeSnap.exists() ? homeSnap.val() : {};
        const catData = catSnap.exists() ? catSnap.val() : {};
        const loadedReviews = Array.isArray(homeData.dynamicReviews) && homeData.dynamicReviews.length
          ? homeData.dynamicReviews
          : Array.isArray(homeData.reviews)
            ? homeData.reviews
            : [];
        const loadedTrust = homeData.trust || { item1: {}, item2: {}, item3: {} };

        studioState = {
          hero: Array.isArray(homeData.dynamicHero) ? homeData.dynamicHero : [],
          heroMeta: homeData.heroMeta || {},
          sections: Array.isArray(homeData.dynamicSections) ? homeData.dynamicSections : [],
          trust: {
            item1: loadedTrust.item1 || {},
            item2: loadedTrust.item2 || {},
            item3: loadedTrust.item3 || {},
            ...(loadedTrust.item4 ? { item4: loadedTrust.item4 } : {})
          },
          trustSection: homeData.trustSection || {},
          categoriesSection: homeData.categoriesSection || {},
          blogSection: homeData.blogSection || {},
          reviewsSection: homeData.reviewsSection || {},
          reviews: loadedReviews,
          categories: catData || {},
          promoBanner: homeData.promoBanner || {},
          customSections: Array.isArray(homeData.customSections) ? homeData.customSections : [],
          sectionOrder: Array.isArray(homeData.sectionOrder) ? homeData.sectionOrder : undefined,
          sectionsVisibility: homeData.sectionsVisibility || (homeData.sections && typeof homeData.sections === 'object' ? homeData.sections : {}),
          enOverlay: homeData.enOverlay && typeof homeData.enOverlay === 'object' ? homeData.enOverlay : {}
        };

        // Fallbacks if empty
        if (!studioState.hero.length) {
          studioState.hero = [{
            desktopImage: '/assets/images/hero/hero-1.jpg',
            mobileImage: '/assets/images/hero/hero-1.jpg',
            duration: 5,
            title: 'عناية طبيعية متوازنة لبشرة أكثر إشراقاً وشعر أكثر قوة',
            subtitle: 'تركيبات صيدلانية لطيفة محضّرة من الزيوت النباتية والزبدات المغذية.',
            buttonText: 'تسوقي الآن',
            link: '/all-products'
          }];
        }

        if (!studioState.sections.length) {
          studioState.sections = [
            { id: 'sec-special-offers', type: 'offers', title: 'العروض الخاصة', subtitle: 'مختارات العروض', visible: true, order: 0 },
            { id: 'sec-new-arrivals', type: 'newArrivals', title: 'مستحضرات مختارة لروتينكِ اليومي', subtitle: 'مختارات داندي', visible: true, order: 1 }
          ];
        }

        // Initialize history stack
        historyStack = [cloneState(studioState)];
        historyIndex = 0;
        isDirty = false;
        updateToolbarStatus();

        // Render UI
        renderSectionsNavigator();
        renderActiveInspector();
      } catch (err) {
        console.error('Error loading studio data:', err);
        showStudioToast('تعذر تحميل بيانات الصفحة الرئيسية من الخادم', true);
      }
    }

