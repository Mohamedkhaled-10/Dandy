      const badge = visuals.badgeText || 'Pink Friday';
      const heroImg = visuals.heroImageUrl || 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=1200&q=80';

      const offers = Array.isArray(draftCampaign.offers) ? draftCampaign.offers : [];
      const validOffers = offers.map(o => {
        const prod = catalogProducts.find(p => String(p.id) === String(o.productId));
        const base = prod ? (parseFloat(prod.price) || 0) : 0;
        const disc = parseFloat(o.discountPercentage) || 0;
        const camp = Math.round(base * (1 - disc / 100));
        return {
          prod,
          base,
          disc,
          camp,
          badge: o.badgeText || badge
        };
      }).filter(x => x.prod);

      if (currentPreviewView === 'announcement') {
        container.innerHTML = `
          <div style="background: linear-gradient(90deg, #d98d99 0%, #b86b77 100%); color: #fff; padding: 10px 16px; border-radius: 6px; display: flex; align-items: center; justify-content: center; gap: 10px; font-weight: 700; font-size: 0.85rem; text-align: center;">
            <span>✨</span>
            <span>Pink Friday من داندي — اكتشفي العروض الخاصة الآن</span>
            <span style="background: rgba(255,255,255,0.2); padding: 2px 10px; border-radius: 20px; font-size: 0.75rem;">عرض المنتجات &larr;</span>
          </div>
          <div style="margin-top: 24px; padding: 20px; background: #f9fafb; border-radius: 8px; border: 1px dashed #d1d5db; text-align: center; color: #6b7280; font-size: 0.85rem;">
            هذا الشريط يظهر في أعلى كافة صفحات المتجر كشريط إعلان ترويجي للحملة طوال فترة الفعالية.
          </div>
        `;
      } else if (currentPreviewView === 'home') {
        container.innerHTML = `
          <div style="background: #ffffff; border-radius: 12px; border: 1px solid #fce7f3; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="height: 180px; position: relative;">
              <img src="${heroImg}" style="width: 100%; height: 100%; object-fit: cover; object-position: ${visuals.bannerPosition || 'center'};">
              <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.6) 100%);"></div>
              <div style="position: absolute; bottom: 16px; right: 20px; color: #fff;">
                <span style="background: #be185d; color: #fff; font-size: 0.72rem; font-weight: 800; padding: 3px 10px; border-radius: 20px; margin-bottom: 6px; display: inline-block;">Pink Friday Event</span>
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800;">${headline}</h3>
              </div>
            </div>
            <div style="padding: 20px; text-align: right;">
              <p style="margin: 0 0 16px 0; font-size: 0.88rem; color: #4b5563; line-height: 1.6;">${subtitle}</p>
              <button style="background: #be185d; color: #fff; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 700; font-size: 0.85rem; cursor: pointer;">
                ${cta} &larr;
              </button>
            </div>
          </div>
        `;
      } else if (currentPreviewView === 'landing') {
        let gridHtml = '';
        validOffers.forEach(item => {
          gridHtml += `
            <div style="background: #fff; border: 1px solid #fbcfe8; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column;">
              <div style="height: 140px; position: relative; background: #fdf2f8;">
                <span style="position: absolute; top: 8px; right: 8px; background: #be185d; color: #fff; font-size: 0.7rem; font-weight: 800; padding: 2px 8px; border-radius: 4px;">-${item.disc}%</span>
                <img src="${item.prod.image || ''}" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
              <div style="padding: 12px; display: flex; flex-direction: column; flex: 1;">
                <h4 style="margin: 0 0 6px 0; font-size: 0.85rem; font-weight: 700; color: #111827;">${item.prod.name}</h4>
                <div style="margin-top: auto; display: flex; align-items: baseline; gap: 8px;">
                  <strong style="color: #be185d; font-size: 1rem;">${item.camp} EGP</strong>
                  <span style="font-size: 0.75rem; text-decoration: line-through; color: #9ca3af;">${item.base} EGP</span>
                </div>
              </div>
            </div>
          `;
        });

        container.innerHTML = `
          <div style="text-align: center; margin-bottom: 24px; padding: 20px; background: #fdf2f8; border-radius: 10px;">
            <span style="color: #be185d; font-weight: 800; font-size: 0.78rem;">حملة الجمال السنوية</span>
            <h2 style="margin: 6px 0; font-size: 1.4rem; font-weight: 800; color: #111827;">${headline}</h2>
            <p style="margin: 0; font-size: 0.85rem; color: #4b5563;">${subtitle}</p>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px;">
            ${gridHtml || '<p style="grid-column: 1/-1; text-align: center; color: #9ca3af;">لم يتم إضافة منتجات بعد</p>'}
          </div>
        `;
      } else if (currentPreviewView === 'product') {
        const item = validOffers[0] || { prod: { name: 'كريم بديل الليزر 60 مل' }, base: 350, camp: 280, disc: 20 };
        container.innerHTML = `
          <div style="border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; background: #fff; max-width: 400px; margin: 0 auto;">
            <div style="display: inline-block; background: #fdf2f8; color: #be185d; border: 1px solid #fbcfe8; font-weight: 800; font-size: 0.75rem; padding: 3px 10px; border-radius: 20px; margin-bottom: 12px;">
              ✨ عرض حصري: Pink Friday (-${item.disc}%)
            </div>
            <h3 style="margin: 0 0 10px 0; font-size: 1.1rem; font-weight: 800; color: #111827;">${item.prod.name}</h3>
            <div style="display: flex; align-items: baseline; gap: 10px; margin-bottom: 16px;">
              <span style="font-size: 1.4rem; font-weight: 800; color: #be185d;">${item.camp} جنيه</span>
              <span style="font-size: 0.9rem; text-decoration: line-through; color: #9ca3af;">${item.base} جنيه</span>
              <span style="font-size: 0.75rem; color: #047857; font-weight: 700; background: #ecfdf5; padding: 2px 6px; border-radius: 4px;">وفّري ${item.base - item.camp} جنيه</span>
            </div>
            <button style="width: 100%; background: #111827; color: #fff; padding: 12px; border-radius: 6px; font-weight: 700; border: none; cursor: not-allowed; opacity: 0.8;" disabled>
              إضافة للسلة (معاينة فقط)
            </button>
          </div>
        `;
      } else if (currentPreviewView === 'cart') {
        container.innerHTML = `
          <div style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; max-width: 440px; margin: 0 auto;">
            <h4 style="margin: 0 0 14px 0; font-size: 1rem; font-weight: 800; color: #111827;">ملخص الطلب (Checkout Simulation)</h4>
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem; color: #4b5563;">
              <span>إجمالي المنتجات قبل الخصم:</span>
              <span>750 EGP</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem; color: #be185d; font-weight: 700;">
              <span>وفر عروض Pink Friday:</span>
              <span>- 150 EGP</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem; color: #059669;">
              <span>الشحن (توصيل مجاني):</span>
              <span>0 EGP</span>
            </div>
            <div style="border-top: 1px solid #e5e7eb; padding-top: 10px; margin-top: 10px; display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 800; color: #111827;">
              <span>المجموع النهائي:</span>
              <span>600 EGP</span>
            </div>
            <div style="margin-top: 16px; background: #ecfdf5; color: #065f46; font-size: 0.78rem; padding: 8px 12px; border-radius: 6px; border: 1px solid #a7f3d0; text-align: center;">
              <i class="fas fa-shield-alt"></i> تم تأكيد وتطبيق تسعير Pink Friday من السيرفر مباشرة
            </div>
          </div>
        `;
      }
    }

    // Startup
    initAuthGuard();
  })();
</script>
