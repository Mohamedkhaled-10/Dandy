---
// src/pages/dashboard-pink-friday.astro
// Dandy Cosmetics — Dedicated Pink Friday Multi-Year Campaign Management Suite
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="إدارة حملة Pink Friday | Dandy Operations"
  description="لوحة التحكم السنوية لإدارة حملة وتخفيضات Pink Friday لمتجر داندي"
  robots="noindex, nofollow"
  showHeader={false}
  showFooter={false}
  showDashboardNav={true}
>
  <slot name="head" slot="head">
    <style is:global>
      :root {
        --pf-pink: #d98d99;
        --pf-pink-dark: #b86b77;
        --pf-pink-light: #fdf2f4;
        --pf-pink-border: #f5cbd1;
      }

      .pf-admin-wrap {
        padding: 24px 20px 80px;
        max-width: 1400px;
        margin: 0 auto;
        font-family: 'Cairo', sans-serif;
      }

      /* Top Header & Year Selector */
      .pf-admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
        background: #ffffff;
        padding: 20px 24px;
        border-radius: 10px;
        border: 1px solid var(--border-light, #e5e7eb);
      }

      .pf-header-info h1 {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--color-primary, #111827);
        margin: 0 0 6px 0;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .pf-header-info h1 .pf-badge {
        font-size: 0.75rem;
        padding: 3px 10px;
        border-radius: 20px;
        background: var(--pf-pink-light);
        color: var(--pf-pink-dark);
        border: 1px solid var(--pf-pink-border);
        font-weight: 700;
      }

      .pf-header-info p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--color-muted, #6b7280);
      }

      .pf-header-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .pf-year-select-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f9fafb;
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
      }

      .pf-year-select-wrap label {
        font-size: 0.8rem;
        font-weight: 700;
        color: #374151;
      }

      .pf-year-select {
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 5px 10px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #111827;
        background: #ffffff;
        outline: none;
      }

      .btn-new-year {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 700;
        background: #ffffff;
        color: #374151;
        border: 1px solid #d1d5db;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .btn-new-year:hover {
        border-color: #111827;
        color: #111827;
      }

      /* Draft & Publish Action Ribbon */
      .pf-ribbon-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        padding: 14px 20px;
        border-radius: 10px;
        margin-bottom: 24px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
      }

      .pf-ribbon-status {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.85rem;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
      }
      .status-pill.active { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
      .status-pill.scheduled { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
      .status-pill.ended { background: #f3f4f6; color: #4b5563; border: 1px solid #e5e7eb; }
      .status-pill.disabled { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

      .draft-indicator {
        font-weight: 700;
        font-size: 0.8rem;
        padding: 3px 8px;
        border-radius: 6px;
        background: #fdf2f8;
        color: #be185d;
        border: 1px solid #fbcfe8;
      }

      .pf-action-btns {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }

      .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease;
        border: 1px solid transparent;
        font-family: inherit;
      }

      .btn-action-preview {
        background: #ffffff;
        color: #374151;
        border-color: #d1d5db;
      }
      .btn-action-preview:hover {
        background: #f9fafb;
        border-color: #9ca3af;
      }

      .btn-action-save {
        background: #ffffff;
        color: #1e40af;
        border-color: #bfdbfe;
      }
      .btn-action-save:hover {
        background: #eff6ff;
      }

      .btn-action-publish {
        background: var(--pf-pink);
        color: #ffffff;
        border-color: var(--pf-pink);
      }
      .btn-action-publish:hover {
        background: var(--pf-pink-dark);
      }

      .btn-action-revert {
        background: #ffffff;
        color: #6b7280;
        border-color: #e5e7eb;
      }
      .btn-action-revert:hover {
        color: #b91c1c;
        border-color: #fecaca;
      }

      /* KPI Stats Grid */
      .pf-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
      }

      .pf-stat-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .pf-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
      }

      .pf-stat-body h4 {
        margin: 0 0 2px 0;
        font-size: 0.78rem;
        color: #6b7280;
        font-weight: 600;
      }

      .pf-stat-body span {
        font-size: 1.25rem;
        font-weight: 800;
        color: #111827;
      }

      /* Main Sections Layout: Controls & Products */
      .pf-layout-grid {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 24px;
        align-items: start;
      }

      @media (max-width: 1024px) {
        .pf-layout-grid {
          grid-template-columns: 1fr;
        }
      }

      .pf-panel-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 24px;
      }

      .pf-panel-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #111827;
        margin: 0 0 16px 0;
        padding-bottom: 12px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .pf-form-group {
        margin-bottom: 14px;
      }

      .pf-form-group label {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        color: #374151;
        margin-bottom: 6px;
      }

      .pf-form-input, .pf-form-select, .pf-form-textarea {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.85rem;
        font-family: inherit;
        background: #ffffff;
        outline: none;
        box-sizing: border-box;
      }
      .pf-form-input:focus, .pf-form-select:focus, .pf-form-textarea:focus {
        border-color: #111827;
      }

      .pf-toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        background: #f9fafb;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        margin-bottom: 14px;
      }

      .pf-toggle-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #111827;
      }

      .pf-switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
      }
      .pf-switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }
      .pf-slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #d1d5db;
        transition: .2s;
        border-radius: 24px;
      }
      .pf-slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .2s;
        border-radius: 50%;
      }
      input:checked + .pf-slider {
        background-color: #10b981;
      }
      input:checked + .pf-slider:before {
        transform: translateX(20px);
      }

      /* Hero Visual Preview */
      .pf-visual-preview-box {
        margin-top: 10px;
        height: 120px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        background: #f3f4f6;
        position: relative;
      }

      .pf-visual-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* Products Table & Search */
      .pf-products-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
      }

      .btn-add-prod {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 700;
        background: #111827;
        color: #ffffff;
        border: none;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .btn-add-prod:hover {
        background: #374151;
      }

      .table-container {
        overflow-x: auto;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
      }

      .pf-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
        text-align: right;
      }

      .pf-table th {
        background: #f9fafb;
        padding: 10px 14px;
        font-weight: 700;
        color: #4b5563;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
      }

      .pf-table td {
        padding: 12px 14px;
        border-bottom: 1px solid #f3f4f6;
        vertical-align: middle;
      }

      .prod-cell {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .prod-thumb {
        width: 44px;
        height: 44px;
        border-radius: 6px;
        object-fit: cover;
        border: 1px solid #e5e7eb;
        background: #f9fafb;
      }

      .prod-meta-title {
        font-weight: 700;
        color: #111827;
        margin-bottom: 2px;
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .prod-meta-id {
        font-size: 0.72rem;
        color: #9ca3af;
      }

      .discount-input {
        width: 70px;
        padding: 6px 8px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.85rem;
        text-align: center;
      }

      .price-calc {
        font-weight: 800;
        color: #047857;
      }

      .price-old {
        font-size: 0.72rem;
        text-decoration: line-through;
        color: #9ca3af;
        margin-top: 2px;
      }

      .btn-del-offer {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        color: #b91c1c;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
      }
      .btn-del-offer:hover {
        background: #dc2626;
        color: #ffffff;
      }

      .offer-status-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
      }
      .offer-status-badge.valid { background: #ecfdf5; color: #047857; }
      .offer-status-badge.warning { background: #fffbeb; color: #b45309; }
      .offer-status-badge.error { background: #fef2f2; color: #b91c1c; }

      /* Modals */
      .pf-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        padding: 20px;
      }

      .pf-modal-dialog {
        background: #ffffff;
        border-radius: 12px;
        max-width: 600px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        padding: 24px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      }

      .pf-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e5e7eb;
      }

      .pf-modal-header h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 800;
        color: #111827;
      }

      .pf-modal-close {
        background: none;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        color: #9ca3af;
      }

      /* Multi-Device Interactive Preview Drawer / Modal */
      .pf-preview-modal-dialog {
        max-width: 1280px;
        width: 95%;
        padding: 0;
        overflow: hidden;
      }

      .pf-preview-header {
        background: #111827;
        color: #ffffff;
        padding: 14px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
      }

      .preview-device-toggles {
        display: flex;
        gap: 6px;
        background: rgba(255, 255, 255, 0.1);
        padding: 4px;
        border-radius: 8px;
      }

      .btn-device {
        background: transparent;
        color: #9ca3af;
        border: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
      }
      .btn-device.active {
        background: #ffffff;
        color: #111827;
      }

      .preview-view-toggles {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding: 4px;
      }

      .btn-view-tab {
        background: transparent;
        color: #d1d5db;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        cursor: pointer;
        white-space: nowrap;
        font-family: inherit;
      }
      .btn-view-tab.active {
        background: var(--pf-pink);
        border-color: var(--pf-pink);
        color: #ffffff;
        font-weight: 700;
      }

      .pf-preview-stage {
        background: #e5e7eb;
        min-height: 520px;
        max-height: 75vh;
        overflow-y: auto;
        display: flex;
        justify-content: center;
        padding: 24px 16px;
      }

      .pf-preview-frame {
        background: #ffffff;
        transition: width 0.3s ease;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        border-radius: 8px;
        overflow: hidden;
      }
      .pf-preview-frame.desktop { width: 100%; max-width: 1200px; }
      .pf-preview-frame.tablet { width: 768px; }
      .pf-preview-frame.mobile { width: 390px; }

      .catalog-search-wrap {
        margin-bottom: 14px;
      }

      .catalog-list {
        max-height: 340px;
        overflow-y: auto;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
      }

      .catalog-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        border-bottom: 1px solid #f3f4f6;
        cursor: pointer;
        transition: background 0.15s ease;
      }
      .catalog-item:hover {
        background: #f9fafb;
      }
      .catalog-item.already-added {
        opacity: 0.5;
        background: #f3f4f6;
        cursor: not-allowed;
      }

      /* Toast Notification */
      .pf-toast {
        position: fixed;
        bottom: 24px;
        left: 24px;
        background: #111827;
        color: #ffffff;
        padding: 12px 20px;
        border-radius: 8px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
        z-index: 3000;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.3s ease;
        pointer-events: none;
      }
      .pf-toast.show {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }
      .pf-toast.success { background: #065f46; border: 1px solid #059669; }
      .pf-toast.error { background: #991b1b; border: 1px solid #dc2626; }
    </style>
  </slot>

  <main class="pf-admin-wrap" dir="rtl">
    <!-- Header: Title & Year Switcher -->
    <div class="pf-admin-header">
      <div class="pf-header-info">
        <h1>
          <i class="fas fa-tags" style="color: var(--pf-pink);"></i>
          <span>إدارة حملة Pink Friday السنوية</span>
          <span class="pf-badge" id="headerYearBadge">2026</span>
        </h1>
        <p>نظام الحملات السنوية المستقل لتخفيضات شهر نوفمبر وإدارتها بالكامل دون تعديل الكود.</p>
      </div>

      <div class="pf-header-controls">
        <div class="pf-year-select-wrap">
          <label for="yearSelector"><i class="fas fa-calendar-alt"></i> حملة سنة:</label>
          <select id="yearSelector" class="pf-year-select">
            <option value="2026">2026</option>
          </select>
        </div>

        <button type="button" class="btn-new-year" id="btnOpenNewYearModal">
          <i class="fas fa-plus"></i>
          <span>بدء سنة جديدة</span>
        </button>
      </div>
    </div>

    <!-- Draft & Publish Ribbon -->
    <div class="pf-ribbon-actions">
      <div class="pf-ribbon-status">
        <span class="status-pill scheduled" id="campaignStatusPill">
          <i class="fas fa-clock"></i>
          <span id="campaignStatusText">مجدولة</span>
        </span>
        <span class="draft-indicator" id="draftStatusBadge">
          <i class="fas fa-pen"></i> وضع التعديل (مسودة غير منشورة)
        </span>
        <span style="font-size: 0.78rem; color: #6b7280;" id="lastPublishedText">
          لم يتم النشر بعد
        </span>
      </div>

      <div class="pf-action-btns">
        <button type="button" class="btn-action btn-action-preview" id="btnOpenPreview">
          <i class="fas fa-eye"></i>
          <span>معاينة الحملة</span>
        </button>

        <button type="button" class="btn-action btn-action-save" id="btnSaveDraft">
          <i class="fas fa-save"></i>
          <span>حفظ كمسودة</span>
        </button>

        <button type="button" class="btn-action btn-action-publish" id="btnOpenPublishModal">
          <i class="fas fa-rocket"></i>
          <span>اعتماد ونشر الحملة</span>
        </button>

        <button type="button" class="btn-action btn-action-revert" id="btnRestorePublished" title="إلغاء التعديلات غير المنشورة">
          <i class="fas fa-undo"></i>
          <span>استعادة المنشور</span>
        </button>
      </div>
    </div>

    <!-- KPI Stats Counters -->
    <div class="pf-stats-grid">
      <div class="pf-stat-card">
        <div class="pf-stat-icon" style="background: #fdf2f8; color: #db2777;">
          <i class="fas fa-box-open"></i>
        </div>
        <div class="pf-stat-body">
          <h4>إجمالي المنتجات بالحملة</h4>
          <span id="statTotalOffers">0</span>
        </div>
      </div>

      <div class="pf-stat-card">
        <div class="pf-stat-icon" style="background: #ecfdf5; color: #059669;">
          <i class="fas fa-check-circle"></i>
        </div>
        <div class="pf-stat-body">
          <h4>عروض صالحة وجاهزة للعملاء</h4>
          <span id="statValidOffers">0</span>
        </div>
      </div>

      <div class="pf-stat-card">
        <div class="pf-stat-icon" style="background: #eff6ff; color: #2563eb;">
          <i class="fas fa-percent"></i>
        </div>
        <div class="pf-stat-body">
          <h4>متوسط نسبة الخصم</h4>
          <span id="statAvgDiscount">0%</span>
        </div>
      </div>

      <div class="pf-stat-card">
        <div class="pf-stat-icon" style="background: #fffbeb; color: #d97706;">
          <i class="fas fa-coins"></i>
        </div>
        <div class="pf-stat-body">
          <h4>أعلى وفر للعميل</h4>
          <span id="statMaxSaving">0 ج.م</span>
        </div>
      </div>
    </div>

    <!-- Main Two-Column Workflow -->
    <div class="pf-layout-grid">
      <!-- Left Column: Dates, Visibility & Visuals -->
      <div class="pf-left-col">
        <!-- Campaign Controls Panel -->
        <div class="pf-panel-card">
          <h3 class="pf-panel-title">
            <span><i class="fas fa-sliders-h"></i> التحكم الأساسي والجدولة</span>
          </h3>

          <div class="pf-toggle-row">
            <div>
              <div class="pf-toggle-label">تفعيل الحملة برمجياً</div>
