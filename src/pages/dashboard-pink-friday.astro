    // Calculate Campaign Status & KPIs
    function updateStatusAndKPIs() {
      const statusPill = document.getElementById('campaignStatusPill');
      const statusText = document.getElementById('campaignStatusText');

      if (!draftCampaign) {
        if (statusPill && statusText) {
          statusPill.className = 'status-pill disabled';
          statusText.textContent = hasLoadError ? 'خطأ بالتحميل' : 'غير مسجلة';
        }
        document.getElementById('statTotalOffers').textContent = '0';
        document.getElementById('statValidOffers').textContent = '0';
        document.getElementById('statAvgDiscount').textContent = '0%';
        document.getElementById('statMaxSaving').textContent = '0 ج.م';
        return;
      }

      const now = new Date();
      const startStr = draftCampaign.startAt || draftCampaign.startDate;
      const endStr = draftCampaign.endAt || draftCampaign.endDate;
      const start = startStr ? new Date(startStr) : null;
      const end = endStr ? new Date(endStr) : null;

      let status = 'disabled';
      let statusLabel = 'غير مفعلة';
      let statusClass = 'disabled';

      if (!draftCampaign.enabled) {
        status = 'disabled';
        statusLabel = 'غير مفعلة';
        statusClass = 'disabled';
      } else if (start && now < start) {
        status = 'scheduled';
        statusLabel = 'مجدولة (تبدأ قريباً)';
        statusClass = 'scheduled';
      } else if (end && now > end) {
        status = 'ended';
        statusLabel = 'انتهت الحملة';
        statusClass = 'ended';
      } else {
        status = 'active';
        statusLabel = 'مفعلة ونشطة';
        statusClass = 'active';
      }

      if (statusPill && statusText) {
        statusPill.className = `status-pill ${statusClass}`;
        statusText.textContent = statusLabel;
      }

      // KPIs
      const offers = Array.isArray(draftCampaign.offers) ? draftCampaign.offers : [];
      const collections = Array.isArray(draftCampaign.collections) ? draftCampaign.collections : [];
      let validOffers = 0;
      let totalDiscount = 0;
      let maxSaving = 0;

      offers.forEach(o => {
        const prod = catalogProducts.find(p => String(p.id) === String(o.productId));
        const disc = parseFloat(o.discountPercentage) || 0;
        if (prod && !prod.isHidden && !prod.isSoldOut && disc > 0 && disc < 100) {
          validOffers++;
          totalDiscount += disc;
          const basePrice = parseFloat(prod.price) || 0;
          const campPrice = Math.round(basePrice * (1 - disc / 100));
          const saving = basePrice - campPrice;
          if (saving > maxSaving) maxSaving = saving;
        }
      });

      let validCollections = 0;
      collections.forEach(col => {
        if (!col || col.active === false) return;
        const colItems = Array.isArray(col.items) ? col.items : [];
        if (colItems.length === 0) return;
        let isColValid = true;
        let colBase = 0;
        colItems.forEach(it => {
          const prod = catalogProducts.find(p => String(p.id) === String(it.productId));
          if (!prod || prod.isHidden || prod.isSoldOut) {
            isColValid = false;
          } else {
            colBase += (parseFloat(prod.price) || 0);
          }
        });
        if (isColValid && colBase > 0) {
          validCollections++;
          let colFinal = colBase;
          if (col.pricingType === 'package') {
            colFinal = parseFloat(col.packagePrice) || colBase;
          } else if (col.pricingType === 'percentage') {
            const pct = parseFloat(col.discountPercentage) || 0;
            colFinal = Math.round(colBase * (1 - pct / 100));
          }
          const colSaving = Math.max(0, colBase - colFinal);
          if (colSaving > maxSaving) maxSaving = colSaving;
        }
      });

      document.getElementById('statTotalOffers').textContent = collections.length > 0
        ? `${offers.length} (+${collections.length} كوليكشن)`
        : `${offers.length}`;

      document.getElementById('statValidOffers').textContent = validCollections > 0
        ? `${validOffers} (+${validCollections} كوليكشن)`
        : `${validOffers}`;

      document.getElementById('statAvgDiscount').textContent = validOffers > 0 ? Math.round(totalDiscount / validOffers) + '%' : '0%';
      document.getElementById('statMaxSaving').textContent = maxSaving + ' ج.م';

      // Last published info
      const lpEl = document.getElementById('lastPublishedText');
      if (lpEl) {
        if (publishedCampaign && publishedCampaign.updatedAt) {
          const d = new Date(publishedCampaign.updatedAt);
          lpEl.textContent = `آخر اعتماد: ${d.toLocaleDateString('ar-EG')} ${d.toLocaleTimeString('ar-EG')}`;
        } else {
          lpEl.textContent = 'لم يتم النشر بعد';
        }
      }
    }

