<script is:inline>
  (function() {
    let currentYear = 2026;
    let allYears = [2026];
    let draftCampaign = null;
    let publishedCampaign = null;
    let catalogProducts = [];
    let isDraftDirty = false;
    let isDataLoaded = false;
    let hasLoadError = false;

    // Toast helper
    function showToast(msg, type = 'success') {
      const toast = document.getElementById('pfToast');
      const msgEl = document.getElementById('toastMsg');
      if (!toast || !msgEl) return;
      msgEl.textContent = msg;
      toast.className = `pf-toast show ${type}`;
      setTimeout(() => {
        toast.className = 'pf-toast';
      }, 4000);
    }

    // Modal Stack & Layering Manager
    let activeModalStack = [];

    function openModal(id) {
      const modal = document.getElementById(id);
      if (!modal) return;

      const existingIndex = activeModalStack.indexOf(id);
      if (existingIndex !== -1) {
        activeModalStack.splice(existingIndex, 1);
      }
      activeModalStack.push(id);

      // Dynamically calculate z-index to guarantee top-most modal stacking above all lower modals
      const baseZIndex = 2000;
      const stackZIndex = baseZIndex + (activeModalStack.length * 100);
      modal.style.zIndex = String(stackZIndex);
      modal.style.display = 'flex';
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.style.display = 'none';
      activeModalStack = activeModalStack.filter(mId => mId !== id);
    }

    // Close button listeners
    document.querySelectorAll('[data-close-modal]').forEach(btn => {
      btn.addEventListener('click', () => {
        closeModal(btn.getAttribute('data-close-modal'));
      });
    });

    // Close top modal when clicking directly on its backdrop background
    document.querySelectorAll('.pf-modal-backdrop').forEach(backdrop => {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) {
          closeModal(backdrop.id);
        }
      });
    });

    // Close top modal on Escape key press
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeModalStack.length > 0) {
        const topModalId = activeModalStack[activeModalStack.length - 1];
        closeModal(topModalId);
      }
    });

    // Helper: Firebase Auth ID Token for API Calls
    async function getAuthToken() {
      const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
      if (!auth || !auth.currentUser) return '';
      return await auth.currentUser.getIdToken();
    }

    // Strict Admin Auth Guard
    function initAuthGuard() {
      function check(user) {
        if (!user) {
          window.location.href = '/login';
          return;
        }
        if (!user.email || user.email.toLowerCase() !== 'admin@dandy.com') {
          window.location.replace('/');
          return;
        }
        loadAllData();
      }

      const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
      if (auth && typeof auth.onAuthStateChanged === 'function') {
        auth.onAuthStateChanged(check);
      } else {
        let attempts = 0;
        const interval = setInterval(() => {
          attempts++;
          const a = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
          if (a && typeof a.onAuthStateChanged === 'function') {
            clearInterval(interval);
            a.onAuthStateChanged(check);
          } else if (attempts > 30) {
            clearInterval(interval);
            window.location.href = '/login';
          }
        }, 100);
      }
    }

    // Load Data via API & RTDB
    async function loadAllData() {
      isDataLoaded = false;
      hasLoadError = false;
      renderOffersTable();
      renderCollectionsTable();
      updateStatusAndKPIs();

      try {
        const token = await getAuthToken();
        const res = await fetch(`/api/pink-friday/admin?year=${currentYear}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (res.status === 401 || res.status === 403) {
          window.location.href = '/login';
          return;
        }

        const data = await res.json();
        if (data.success && data.campaigns) {
          const campaignKey = `pink-friday-${currentYear}`;
          const yearCampaignObj = data.campaigns[campaignKey] || null;

          if (yearCampaignObj) {
            draftCampaign = yearCampaignObj.draft || null;
            publishedCampaign = yearCampaignObj.published || null;
          } else {
            draftCampaign = null;
            publishedCampaign = null;
          }

          // Extract available years list safely
          const extractedYears = Object.keys(data.campaigns).map(k => {
            const m = k.match(/\d{4}/);
            return m ? parseInt(m[0], 10) : null;
          }).filter(Boolean);

          allYears = Array.from(new Set([...extractedYears, currentYear])).sort((a, b) => b - a);

          isDataLoaded = true;
          hasLoadError = false;

          populateYearSelector();
          syncFormWithDraft();
          updateStatusAndKPIs();
        } else {
          draftCampaign = null;
          publishedCampaign = null;
          isDataLoaded = false;
          hasLoadError = true;
          showToast(data.error || 'تعذر تحميل بيانات الحملة من السيرفر', 'error');
          renderOffersTable();
          renderCollectionsTable();
          updateStatusAndKPIs();
        }

        // Fetch products catalog from RTDB for selection
        const db = window.db || (typeof firebase !== 'undefined' ? firebase.database() : null);
        if (db) {
          db.ref('products').once('value', snap => {
            catalogProducts = [];
            if (snap.exists()) {
              snap.forEach(c => {
                catalogProducts.push({ id: c.key, ...c.val() });
              });
            }
            renderOffersTable();
            renderCollectionsTable();
          });
        }
      } catch (err) {
        console.error('Error loading Pink Friday data:', err);
        draftCampaign = null;
        publishedCampaign = null;
        isDataLoaded = false;
        hasLoadError = true;
        showToast('تعذر تحميل بيانات الحملة من السيرفر', 'error');
        renderOffersTable();
        renderCollectionsTable();
        updateStatusAndKPIs();
      }
    }

    function populateYearSelector() {
      const sel = document.getElementById('yearSelector');
      if (!sel) return;
      sel.innerHTML = '';
      allYears.forEach(y => {
        const opt = document.createElement('option');
        opt.value = y;
        opt.textContent = y;
        if (Number(y) === Number(currentYear)) opt.selected = true;
        sel.appendChild(opt);
      });
      document.getElementById('headerYearBadge').textContent = currentYear;
    }

    document.getElementById('yearSelector')?.addEventListener('change', (e) => {
      currentYear = parseInt(e.target.value, 10);
      loadAllData();
    });

    // Populate Form from draftCampaign
    function syncFormWithDraft() {
      if (!draftCampaign) return;

      const enabledToggle = document.getElementById('campaignEnabledToggle');
      if (enabledToggle) enabledToggle.checked = draftCampaign.enabled !== false;

      const startVal = draftCampaign.startAt || draftCampaign.startDate;
      const startDateInput = document.getElementById('campaignStartDate');
      if (startDateInput && startVal) {
        startDateInput.value = startVal.slice(0, 16);
      }

      const endVal = draftCampaign.endAt || draftCampaign.endDate;
      const endDateInput = document.getElementById('campaignEndDate');
      if (endDateInput && endVal) {
        endDateInput.value = endVal.slice(0, 16);
      }

      const visuals = draftCampaign.visuals || {};
      const headlineInput = document.getElementById('visualHeadline');
      if (headlineInput) headlineInput.value = visuals.headline || 'عروض Pink Friday الحصرية';

      const subtitleInput = document.getElementById('visualSubtitle');
      if (subtitleInput) subtitleInput.value = visuals.subtitle || '';

      const heroImgInput = document.getElementById('visualHeroImg');
      if (heroImgInput) heroImgInput.value = visuals.heroImageUrl || '';

      const heroPreviewImg = document.getElementById('heroPreviewImg');
      if (heroPreviewImg) {
        heroPreviewImg.src = visuals.heroImageUrl || 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=1200&q=80';
      }

      const bannerPos = document.getElementById('visualBannerPosition');
      if (bannerPos) bannerPos.value = visuals.bannerPosition || 'center';

      const ctaInput = document.getElementById('visualCtaText');
      if (ctaInput) ctaInput.value = visuals.ctaText || 'اكتشفي عروض Pink Friday';

      const badgeInput = document.getElementById('visualBadgeText');
      if (badgeInput) badgeInput.value = visuals.badgeText || 'Pink Friday';

      renderOffersTable();
      renderCollectionsTable();
    }

    // Read form state into draftCampaign
    function updateDraftFromForm() {
      if (!draftCampaign) return;

      draftCampaign.enabled = document.getElementById('campaignEnabledToggle').checked;
      const sVal = document.getElementById('campaignStartDate').value;
      const eVal = document.getElementById('campaignEndDate').value;
      if (sVal) {
        const isoStart = sVal.length === 16 ? sVal + ':00' : sVal;
        draftCampaign.startDate = isoStart;
        draftCampaign.startAt = isoStart;
      }
      if (eVal) {
        const isoEnd = eVal.length === 16 ? eVal + ':00' : eVal;
        draftCampaign.endDate = isoEnd;
        draftCampaign.endAt = isoEnd;
      }

      draftCampaign.visuals = {
        headline: document.getElementById('visualHeadline').value.trim(),
        subtitle: document.getElementById('visualSubtitle').value.trim(),
        heroImageUrl: document.getElementById('visualHeroImg').value.trim(),
        bannerPosition: document.getElementById('visualBannerPosition').value,
        ctaText: document.getElementById('visualCtaText').value.trim(),
        badgeText: document.getElementById('visualBadgeText').value.trim()
      };

      isDraftDirty = true;
      updateStatusAndKPIs();
    }

    // Listen to form input changes
    ['campaignEnabledToggle', 'campaignStartDate', 'campaignEndDate', 'visualHeadline', 'visualSubtitle', 'visualHeroImg', 'visualBannerPosition', 'visualCtaText', 'visualBadgeText'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateDraftFromForm);
      document.getElementById(id)?.addEventListener('change', updateDraftFromForm);
    });

    document.getElementById('visualHeroImg')?.addEventListener('input', (e) => {
      const img = document.getElementById('heroPreviewImg');
      if (img) img.src = e.target.value.trim() || 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=1200&q=80';
    });

    // Render Offers Table
    function renderOffersTable() {
      const tbody = document.getElementById('offersTableBody');
      if (!tbody) return;

      if (hasLoadError) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" style="text-align: center; padding: 40px; color: #b91c1c;">
              <i class="fas fa-exclamation-triangle" style="font-size: 2rem; display: block; margin-bottom: 10px;"></i>
              فشل تحميل بيانات الحملة من السيرفر. يرجى إعادة تنشيط الصفحة أو المحاولة لاحقاً.
            </td>
          </tr>
        `;
        return;
      }

      if (!isDataLoaded) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" style="text-align: center; padding: 40px; color: #6b7280;">
              <i class="fas fa-spinner fa-spin" style="font-size: 2rem; display: block; margin-bottom: 10px;"></i>
              جاري تحميل بيانات الحملة...
            </td>
          </tr>
        `;
        return;
      }

      if (!draftCampaign) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" style="text-align: center; padding: 40px; color: #4b5563;">
              <i class="fas fa-calendar-times" style="font-size: 2rem; color: #9ca3af; display: block; margin-bottom: 10px;"></i>
              لا توجد مسودة بيانات للحملة لسنة ${currentYear}. انقري على "بدء سنة جديدة" لإنشائها.
            </td>
          </tr>
        `;
        return;
      }

      const offers = Array.isArray(draftCampaign.offers) ? draftCampaign.offers : [];
      if (offers.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" style="text-align: center; padding: 40px; color: #6b7280;">
              <i class="fas fa-tag" style="font-size: 2rem; color: #d1d5db; display: block; margin-bottom: 10px;"></i>
              لا توجد منتجات مضافة للحملة بعد. انقري على "إضافة منتج من الكتالوج" للبدء.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = '';
      offers.forEach((offer, idx) => {
        const prod = catalogProducts.find(p => String(p.id) === String(offer.productId));
        const basePrice = prod ? (parseFloat(prod.price) || 0) : 0;
        const disc = parseFloat(offer.discountPercentage) || 0;
        const campPrice = Math.round(basePrice * (1 - disc / 100));
        const saving = Math.max(0, basePrice - campPrice);

        // Validity check
        let statusBadge = '<span class="offer-status-badge valid">صالح</span>';
        if (!prod) {
          statusBadge = '<span class="offer-status-badge error" title="المنتج غير موجود في الكتالوج">مفقود</span>';
        } else if (prod.isHidden) {
          statusBadge = '<span class="offer-status-badge warning" title="المنتج مخفي في المتجر">مخفي</span>';
        } else if (prod.isSoldOut) {
          statusBadge = '<span class="offer-status-badge warning" title="المنتج نافذ الكمية">نفذ</span>';
        } else if (disc <= 0 || disc >= 100) {
          statusBadge = '<span class="offer-status-badge error" title="نسبة الخصم غير صالحة">خصم غير صالح</span>';
        }

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <div class="prod-cell">
              <img src="${prod && prod.image ? prod.image : 'https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=100&q=80'}" class="prod-thumb" alt="">
              <div>
                <div class="prod-meta-title">${prod ? prod.name : 'منتج غير معروف'}</div>
                <div class="prod-meta-id">ID: ${offer.productId}</div>
              </div>
            </div>
          </td>
          <td><strong>${basePrice}</strong> ج.م</td>
          <td>
            <input type="number" min="1" max="99" value="${disc}" class="discount-input" data-offer-idx="${idx}" onchange="window.updateOfferDiscount(${idx}, this.value)"> %
          </td>
          <td>
            <span class="price-calc">${campPrice} ج.م</span>
            <div class="price-old">${basePrice} ج.م</div>
          </td>
          <td><strong style="color: #d97706;">${saving}</strong> ج.م</td>
          <td>
            <input type="text" value="${offer.badgeText || 'Pink Friday'}" style="width: 90px; padding: 4px 6px; font-size: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px;" data-offer-idx="${idx}" onchange="window.updateOfferBadge(${idx}, this.value)">
          </td>
          <td>${statusBadge}</td>
          <td>
            <button type="button" class="btn-del-offer" title="إزالة من الحملة" onclick="window.removeOfferFromCampaign(${idx})">
              <i class="fas fa-trash"></i>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Global Offer Operations
    window.updateOfferDiscount = function(idx, val) {
      if (!draftCampaign || !Array.isArray(draftCampaign.offers) || !draftCampaign.offers[idx]) return;
      const num = Math.min(99, Math.max(1, parseInt(val, 10) || 10));
      draftCampaign.offers[idx].discountPercentage = num;
      isDraftDirty = true;
      renderOffersTable();
      updateStatusAndKPIs();
    };

    window.updateOfferBadge = function(idx, val) {
      if (!draftCampaign || !Array.isArray(draftCampaign.offers) || !draftCampaign.offers[idx]) return;
      draftCampaign.offers[idx].badgeText = (val || '').trim();
      isDraftDirty = true;
    };

    window.removeOfferFromCampaign = function(idx) {
      if (!draftCampaign || !Array.isArray(draftCampaign.offers) || !draftCampaign.offers[idx]) return;
      draftCampaign.offers.splice(idx, 1);
      isDraftDirty = true;
      renderOffersTable();
      updateStatusAndKPIs();
      showToast('تمت إزالة المنتج من عروض الحملة');
    };

    // Render Collections Table
    function renderCollectionsTable() {
      const tbody = document.getElementById('collectionsTableBody');
      if (!tbody) return;

      if (hasLoadError || !isDataLoaded || !draftCampaign) {
        tbody.innerHTML = `<tr><td colspan="9" style="text-align: center; padding: 30px; color: #9ca3af;">يرجى انتظار تحميل البيانات...</td></tr>`;
        return;
      }

      const collections = Array.isArray(draftCampaign.collections) ? draftCampaign.collections : [];
      if (collections.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" style="text-align: center; padding: 30px; color: #6b7280;">
              <i class="fas fa-cubes" style="font-size: 1.8rem; color: #d1d5db; display: block; margin-bottom: 8px;"></i>
              لا توجد كوليكشنز مضافة للحملة بعد. انقري على "إنشاء كوليكشن جديد" للبدء.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = '';
      collections.forEach((col, idx) => {
        const items = Array.isArray(col.items) ? col.items : [];
        let totalBase = 0;
        items.forEach(it => {
          const p = catalogProducts.find(prod => String(prod.id) === String(it.productId));
          if (p) totalBase += (parseFloat(p.price) || 0);
        });

        let finalPrice = totalBase;
        if (col.pricingType === 'package') {
          finalPrice = parseFloat(col.packagePrice) || totalBase;
        } else if (col.pricingType === 'percentage') {
          const pct = parseFloat(col.discountPercentage) || 0;
          finalPrice = Math.round(totalBase * (1 - pct / 100));
        }

        const savings = Math.max(0, totalBase - finalPrice);
        const dupBadge = col.allowDuplicates
          ? '<span style="color:#047857; background:#ecfdf5; padding:2px 6px; border-radius:4px; font-weight:700;">نعم</span>'
          : '<span style="color:#6b7280; background:#f3f4f6; padding:2px 6px; border-radius:4px;">لا</span>';

        const statusBadge = col.active !== false
          ? '<span class="offer-status-badge valid">نشط</span>'
          : '<span class="offer-status-badge warning">معطل</span>';

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <strong style="color:#111827; font-size:0.85rem;">${col.name || 'كوليكشن بدون اسم'}</strong>
            <div style="font-size:0.72rem; color:#6b7280;">${col.badgeText || 'كوليكشن Pink Friday'}</div>
          </td>
          <td><strong>${items.length}</strong> منتجات</td>
          <td>${dupBadge}</td>
          <td><span style="font-size:0.78rem;">${col.pricingType === 'package' ? 'بكج ثابت (' + finalPrice + ' ج.م)' : 'خصم نسبة ' + (col.discountPercentage || 0) + '%'}</span></td>
          <td>${totalBase} ج.م</td>
          <td><strong style="color:#be185d;">${finalPrice}</strong> ج.م</td>
          <td><strong style="color:#047857;">${savings}</strong> ج.م</td>
          <td>${statusBadge}</td>
          <td>
            <button type="button" class="btn-action" style="padding:4px 8px; font-size:0.75rem;" onclick="window.editCollection(${idx})">
              <i class="fas fa-edit"></i> تعديل
            </button>
            <button type="button" class="btn-del-offer" title="حذف" onclick="window.deleteCollection(${idx})">
              <i class="fas fa-trash"></i>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Collection Modal State & Logic
    let currentEditingColIndex = -1;
    let tempColItems = [];

    window.openAddCollectionModal = function() {
      currentEditingColIndex = -1;
      tempColItems = [];
      document.getElementById('colModalTitle').textContent = 'إنشاء كوليكشن جديد';
      document.getElementById('colNameInput').value = '';
      document.getElementById('colBadgeInput').value = 'كوليكشن Pink Friday';
      document.getElementById('colDescInput').value = '';
      document.getElementById('colCoverImgInput').value = '';
      document.getElementById('colActiveToggle').checked = true;
      document.getElementById('colDuplicatesToggle').checked = false;
      document.getElementById('colPricingType').value = 'package';
      document.getElementById('colPackagePriceInput').value = '';
      document.getElementById('colDiscountPctInput').value = '20';
      toggleColPricingFields();
      renderColItemsTable();
      openModal('collectionModal');
    };

    document.getElementById('btnOpenAddCollectionModal')?.addEventListener('click', window.openAddCollectionModal);

    window.editCollection = function(idx) {
      if (!draftCampaign || !Array.isArray(draftCampaign.collections) || !draftCampaign.collections[idx]) return;
      currentEditingColIndex = idx;
      const col = draftCampaign.collections[idx];
      tempColItems = (col.items || []).map((it, i) => {
        if (typeof it === 'string') {
          return { collectionItemId: 'ci_' + i + '_' + Date.now(), productId: String(it) };
        }
        return {
          collectionItemId: it.collectionItemId || ('ci_' + i + '_' + Date.now()),
          productId: String(it.productId || it.id || ''),
          defaultVariantId: it.defaultVariantId || ''
        };
      });

      document.getElementById('colModalTitle').textContent = 'تعديل كوليكشن: ' + (col.name || '');
      document.getElementById('colNameInput').value = col.name || '';
      document.getElementById('colBadgeInput').value = col.badgeText || 'كوليكشن Pink Friday';
      document.getElementById('colDescInput').value = col.description || '';
      document.getElementById('colCoverImgInput').value = col.coverImage || '';
      document.getElementById('colActiveToggle').checked = col.active !== false;
      document.getElementById('colDuplicatesToggle').checked = Boolean(col.allowDuplicates);
      document.getElementById('colPricingType').value = col.pricingType || 'package';
      document.getElementById('colPackagePriceInput').value = col.packagePrice || '';
      document.getElementById('colDiscountPctInput').value = col.discountPercentage || 20;

      toggleColPricingFields();
      renderColItemsTable();
      openModal('collectionModal');
    };

    function toggleColPricingFields() {
      const type = document.getElementById('colPricingType').value;
      const pkgWrap = document.getElementById('colPackagePriceWrap');
      const pctWrap = document.getElementById('colDiscountPctWrap');
      if (type === 'package') {
        pkgWrap.style.display = 'block';
        pctWrap.style.display = 'none';
      } else {
        pkgWrap.style.display = 'none';
        pctWrap.style.display = 'block';
      }
      calcColSummary();
    }

    document.getElementById('colPricingType')?.addEventListener('change', toggleColPricingFields);
    document.getElementById('colPackagePriceInput')?.addEventListener('input', calcColSummary);
    document.getElementById('colDiscountPctInput')?.addEventListener('input', calcColSummary);

    function renderColItemsTable() {
      const tbody = document.getElementById('colItemsTableBody');
      if (!tbody) return;

      if (tempColItems.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: #9ca3af; padding: 20px;">لم يتم إضافة منتجات للكوليكشن بعد.</td></tr>`;
        calcColSummary();
        return;
      }

      tbody.innerHTML = '';
      tempColItems.forEach((item, i) => {
        const prod = catalogProducts.find(p => String(p.id) === String(item.productId));
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <div style="display:flex; align-items:center; gap:8px;">
              <img src="${prod?.image || 'https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=100&q=80'}" style="width:28px; height:28px; border-radius:4px; object-fit:cover;">
              <strong>${prod?.name || item.productId}</strong>
            </div>
          </td>
          <td>${prod?.price || 0} ج.م</td>
          <td>
            <input type="text" value="${item.defaultVariantId || ''}" placeholder="كود/اسم الرائحة" style="width:100px; padding:3px 6px; font-size:0.75rem; border:1px solid #d1d5db; border-radius:4px;" onchange="tempColItems[${i}].defaultVariantId = this.value">
          </td>
          <td>
            <button type="button" class="btn-action" style="padding:2px 6px;" onclick="moveColItem(${i}, -1)">▲</button>
            <button type="button" class="btn-action" style="padding:2px 6px;" onclick="moveColItem(${i}, 1)">▼</button>
          </td>
          <td>
            <button type="button" class="btn-del-offer" style="width:24px; height:24px;" onclick="removeColItem(${i})"><i class="fas fa-trash"></i></button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      calcColSummary();
    }

    window.moveColItem = function(index, dir) {
      const target = index + dir;
      if (target < 0 || target >= tempColItems.length) return;
      const temp = tempColItems[index];
      tempColItems[index] = tempColItems[target];
      tempColItems[target] = temp;
      renderColItemsTable();
    };

    window.removeColItem = function(index) {
      tempColItems.splice(index, 1);
      renderColItemsTable();
    };

    function calcColSummary() {
      let baseTotal = 0;
      tempColItems.forEach(it => {
        const p = catalogProducts.find(prod => String(prod.id) === String(it.productId));
        if (p) baseTotal += (parseFloat(p.price) || 0);
      });

      const type = document.getElementById('colPricingType').value;
      let finalPrice = baseTotal;
      if (type === 'package') {
        finalPrice = parseFloat(document.getElementById('colPackagePriceInput').value) || baseTotal;
      } else {
        const pct = parseFloat(document.getElementById('colDiscountPctInput').value) || 0;
        finalPrice = Math.round(baseTotal * (1 - pct / 100));
      }

      const savings = Math.max(0, baseTotal - finalPrice);
      document.getElementById('colSummaryBasePrice').textContent = baseTotal;
      document.getElementById('colSummaryFinalPrice').textContent = finalPrice;
      document.getElementById('colSummarySavings').textContent = savings;
    }

