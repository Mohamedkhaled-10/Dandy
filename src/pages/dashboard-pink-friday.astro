    // Global Offer Operations
    window.updateOfferDiscount = function(idx, val) {
      if (!draftCampaign || !draftCampaign.offers[idx]) return;
      const num = Math.min(99, Math.max(1, parseInt(val, 10) || 10));
      draftCampaign.offers[idx].discountPercentage = num;
      isDraftDirty = true;
      renderOffersTable();
      updateStatusAndKPIs();
    };

    window.updateOfferBadge = function(idx, val) {
      if (!draftCampaign || !draftCampaign.offers[idx]) return;
      draftCampaign.offers[idx].badgeText = (val || '').trim();
      isDraftDirty = true;
    };

    window.removeOfferFromCampaign = function(idx) {
      if (!draftCampaign || !draftCampaign.offers[idx]) return;
      draftCampaign.offers.splice(idx, 1);
      isDraftDirty = true;
      renderOffersTable();
      updateStatusAndKPIs();
      showToast('تمت إزالة المنتج من عروض الحملة');
    };

    // Calculate Campaign Status & KPIs
    function updateStatusAndKPIs() {
      if (!draftCampaign) return;

      const now = new Date();
      const start = draftCampaign.startDate ? new Date(draftCampaign.startDate) : null;
      const end = draftCampaign.endDate ? new Date(draftCampaign.endDate) : null;

      let status = 'disabled';
      let statusLabel = 'غير مفعلة';
      let statusClass = 'disabled';

      if (!draftCampaign.enabled) {
        status = 'disabled';
        statusLabel = 'غير مفعلة';
        statusClass = 'disabled';
      } else if (start && now < start) {
        status = 'scheduled';
        statusLabel = 'مجدولة (تبدأ قريباً)';
        statusClass = 'scheduled';
      } else if (end && now > end) {
        status = 'ended';
        statusLabel = 'انتهت الحملة';
        statusClass = 'ended';
      } else {
        status = 'active';
        statusLabel = 'مفعلة ونشطة';
        statusClass = 'active';
      }

      const statusPill = document.getElementById('campaignStatusPill');
      const statusText = document.getElementById('campaignStatusText');
      if (statusPill && statusText) {
        statusPill.className = `status-pill ${statusClass}`;
        statusText.textContent = statusLabel;
      }

      // KPIs
      const offers = draftCampaign.offers || [];
      const totalOffers = offers.length;
      let validOffers = 0;
      let totalDiscount = 0;
      let maxSaving = 0;

      offers.forEach(o => {
        const prod = catalogProducts.find(p => String(p.id) === String(o.productId));
        const disc = parseFloat(o.discountPercentage) || 0;
        if (prod && !prod.isHidden && !prod.isSoldOut && disc > 0 && disc < 100) {
          validOffers++;
          totalDiscount += disc;
          const basePrice = parseFloat(prod.price) || 0;
          const campPrice = Math.round(basePrice * (1 - disc / 100));
          const saving = basePrice - campPrice;
          if (saving > maxSaving) maxSaving = saving;
        }
      });

      document.getElementById('statTotalOffers').textContent = totalOffers;
      document.getElementById('statValidOffers').textContent = validOffers;
      document.getElementById('statAvgDiscount').textContent = validOffers > 0 ? Math.round(totalDiscount / validOffers) + '%' : '0%';
      document.getElementById('statMaxSaving').textContent = maxSaving + ' ج.م';

      // Last published info
      const lpEl = document.getElementById('lastPublishedText');
      if (lpEl) {
        if (publishedCampaign && publishedCampaign.updatedAt) {
          const d = new Date(publishedCampaign.updatedAt);
          lpEl.textContent = `آخر اعتماد: ${d.toLocaleDateString('ar-EG')} ${d.toLocaleTimeString('ar-EG')}`;
        } else {
          lpEl.textContent = 'لم يتم النشر بعد';
        }
      }
    }

    // Modal: Catalog Selection Search
    document.getElementById('btnOpenAddProductModal')?.addEventListener('click', () => {
      renderCatalogSearch();
      openModal('addProductModal');
    });

    function renderCatalogSearch(filter = '') {
      const list = document.getElementById('catalogListItems');
      if (!list) return;
      list.innerHTML = '';

      const query = (filter || '').toLowerCase().trim();
      const existingIds = new Set((draftCampaign?.offers || []).map(o => String(o.productId)));

      const matches = catalogProducts.filter(p => {
        if (!query) return true;
        const nameMatch = (p.name || '').toLowerCase().includes(query);
        const idMatch = String(p.id).toLowerCase().includes(query);
        return nameMatch || idMatch;
      });

      if (matches.length === 0) {
        list.innerHTML = '<div style="padding: 24px; text-align: center; color: #9ca3af;">لا توجد منتجات مطابقة في الكتالوج</div>';
        return;
      }

      matches.forEach(p => {
        const isAdded = existingIds.has(String(p.id));
        const div = document.createElement('div');
        div.className = `catalog-item ${isAdded ? 'already-added' : ''}`;
        div.innerHTML = `
          <div style="display: flex; align-items: center; gap: 10px;">
            <img src="${p.image || 'https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=100&q=80'}" style="width: 36px; height: 36px; border-radius: 4px; object-fit: cover;">
            <div>
              <strong style="font-size: 0.82rem; color: #111827;">${p.name || ''}</strong>
              <div style="font-size: 0.72rem; color: #6b7280;">السعر: ${p.price || 0} ج.م | ${p.category || 'عام'}</div>
            </div>
          </div>
          <div>
            ${isAdded ? '<span style="font-size: 0.75rem; color: #6b7280;">مضاف مسبقاً</span>' : '<button type="button" class="btn-action btn-action-publish" style="padding: 4px 10px; font-size: 0.75rem;">+ إضافة</button>'}
          </div>
        `;

        if (!isAdded) {
          div.addEventListener('click', () => {
            if (!draftCampaign.offers) draftCampaign.offers = [];
            draftCampaign.offers.push({
              productId: String(p.id),
              discountPercentage: 20,
              badgeText: 'Pink Friday',
              active: true
            });
            isDraftDirty = true;
            renderOffersTable();
            updateStatusAndKPIs();
            closeModal('addProductModal');
            showToast(`تمت إضافة "${p.name}" إلى عروض الحملة بنسبة 20%`);
          });
        }
        list.appendChild(div);
      });
    }

