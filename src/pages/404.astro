---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="الصفحة غير متوفرة | Dandy"
  description="عذراً، الصفحة التي تبحثين عنها غير موجودة حالياً في متجر داندي."
  robots="noindex, follow"
>
  <slot name="head" slot="head">
    <style is:global>
      .error-wrap {
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding-top: 130px;
        padding-bottom: 60px;
      }
    </style>
  </slot>

  <main class="error-wrap container">
    <i class="fas fa-leaf" style="font-size:4rem; color:var(--color-blush, #DB2777); margin-bottom:20px;"></i>
    <h2 style="font-family:'Cairo', sans-serif; font-size:2rem; margin-bottom:12px; color:var(--color-primary, #333);">عذراً، المسلك غير متوفر أو قيد التعديل!</h2>
    <p style="color:var(--color-muted, #777); max-width:480px; margin-bottom:30px;">يبدو أن الصفحة التي تحاولين الكشف عنها غير موجودة حالياً. يمكنكِ التوجه مجدداً لمنتجات دلالكِ ونضارتك الفعالة.</p>
    <a href="/pages/shop/all-products.html" class="cta-btn" style="border-radius:99px; padding:14px 28px;">تصفحي مجموعات داندي الفاخرة</a>
  </main>
</BaseLayout>
