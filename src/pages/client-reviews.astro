---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="آراء وتجارب العملاء | Dandy Cosmetics"
  description="تجارب وآراء حقيقية لعملاء داندي حول جودة وفعالية منتجات العناية بالبشرة والشعر."
  keywords="Dandy, Dandy Cosmetics, دندي, داندي, آراء العملاء, تجارب العملاء, تقييمات داندي"
  canonical="https://dandy-ebon.vercel.app/client-reviews"
>
  <slot name="head" slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dandy-ebon.vercel.app/client-reviews" />
    <meta property="og:title" content="آراء وتجارب العملاء | Dandy Cosmetics" />
    <meta property="og:description" content="تجارب وآراء حقيقية لعملاء داندي حول جودة وفعالية منتجات العناية بالبشرة والشعر." />
    <meta property="og:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- GLightbox CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />

    <style is:global>
      .reviews-page-header {
        padding: 120px 20px 32px;
        text-align: right;
        max-width: 1200px;
        margin: 0 auto;
      }

      .reviews-page-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 0 0 8px 0;
        letter-spacing: -0.02em;
      }

      .reviews-page-header p {
        font-size: 0.95rem;
        color: var(--color-muted);
        margin: 0;
        max-width: 600px;
        line-height: 1.6;
      }

      .reviews-section {
        padding: 10px 0 80px;
      }

      .reviews-category-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--color-primary);
        margin: 32px 0 20px;
      }

      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
      }

      .review-capsule {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        overflow: hidden;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
      }

      .review-capsule:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
        border-color: var(--color-blush);
      }

      .review-capsule img {
        width: 100%;
        height: 320px;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
      }

      .review-capsule:hover img {
        transform: scale(1.02);
      }

      .video-thumbnail-play {
        background: #18181b;
        width: 100%;
        height: 320px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        position: relative;
        cursor: pointer;
      }

      .video-thumbnail-play i {
        font-size: 2.8rem;
        color: var(--color-blush);
        margin-bottom: 10px;
        transition: transform 0.2s ease;
      }

      .review-capsule:hover .video-thumbnail-play i {
        transform: scale(1.1);
      }

      .video-thumbnail-play span {
        font-weight: 600;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.85);
      }

      .reviews-empty {
        text-align: center;
        grid-column: 1 / -1;
        padding: 40px 20px;
        color: var(--color-muted);
        font-size: 0.9rem;
        background: var(--color-surface);
        border: 1px dashed var(--border-light);
        border-radius: var(--border-radius-md);
      }

      @media (max-width: 640px) {
        .reviews-page-header {
          padding-top: 100px;
        }
        .gallery-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 12px;
        }
        .review-capsule img,
        .video-thumbnail-play {
          height: 220px;
        }
      }
    </style>
  </slot>

  <!-- Header -->
  <header class="reviews-page-header" dir="rtl">
    <h1>تجارب وآراء العملاء</h1>
    <p>مشاركات وتجارب حقيقية شاركها عملاؤنا بعد استخدام منتجات داندي للعناية بالبشرة والشعر.</p>
  </header>

  <!-- Gallery Grids -->
  <main class="reviews-section container" dir="rtl">
    <h2 class="reviews-category-title">تجارب وصور العملاء</h2>
    <div class="gallery-grid" id="testimonial-images">
      <p style="text-align: center; grid-column: 1 / -1; color: var(--color-muted); padding: 30px 0;">جاري تحميل التجارب المصورة...</p>
    </div>

    <h2 class="reviews-category-title">تجارب مرئية</h2>
    <div class="gallery-grid" id="testimonial-videos">
      <p style="text-align: center; grid-column: 1 / -1; color: var(--color-muted); padding: 30px 0;">جاري تحميل التجارب المرئية...</p>
    </div>
  </main>

  <!-- GLightbox JS plugin -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>

  <script is:inline>
    const db = window.db || (window.firebase && firebase.database ? firebase.database() : null);
    const imageSection = document.getElementById("testimonial-images");
    const videoSection = document.getElementById("testimonial-videos");

    if (db) {
      db.ref('testimonials').on('value', (snapshot) => {
        const data = snapshot.val();
        if (!imageSection || !videoSection) return;
        imageSection.innerHTML = '';
        videoSection.innerHTML = '';

        if (!data) {
          imageSection.innerHTML = '<div class="reviews-empty"><p>لا توجد تجارب مصورة منشورة حالياً.</p></div>';
          videoSection.innerHTML = '<div class="reviews-empty"><p>لا توجد تجارب مرئية منشورة حالياً.</p></div>';
          return;
        }

        let imageCount = 0;
        let videoCount = 0;

        Object.values(data).forEach(item => {
          const capsule = document.createElement('div');
          capsule.className = 'review-capsule';

          if (item.type === 'image') {
            imageCount++;
            const link = document.createElement('a');
            link.href = item.url;
            link.className = 'glightbox';
            link.setAttribute('data-gallery', 'testimonial-images');
            link.setAttribute('data-title', 'تجربة عميل مع منتجات داندي');

            const img = document.createElement('img');
            img.src = item.url;
            img.alt = "تجربة استخدام منتجات داندي";
            img.loading = "lazy";

            link.appendChild(img);
            capsule.appendChild(link);
            imageSection.appendChild(capsule);
          } else if (item.type === 'video') {
            videoCount++;
            const link = document.createElement('a');
            link.href = item.url;
            link.className = 'glightbox';
            link.setAttribute('data-gallery', 'testimonial-videos');
            link.setAttribute('data-type', 'video');
            link.setAttribute('data-title', 'تجربة فيديو مع داندي');

            const thumb = document.createElement('div');
            thumb.className = 'video-thumbnail-play';
            thumb.innerHTML = `
              <i class="fas fa-play-circle"></i>
              <span>مشاهدة الفيديو</span>
            `;

            link.appendChild(thumb);
            capsule.appendChild(link);
            videoSection.appendChild(capsule);
          }
        });

        if (imageCount === 0) {
          imageSection.innerHTML = '<div class="reviews-empty"><p>لا توجد تجارب مصورة منشورة حالياً.</p></div>';
        }
        if (videoCount === 0) {
          videoSection.innerHTML = '<div class="reviews-empty"><p>لا توجد تجارب مرئية منشورة حالياً.</p></div>';
        }

        if (window.GLightbox) {
          GLightbox({ selector: '.glightbox' });
        }
      });
    } else {
      if (imageSection) imageSection.innerHTML = '<div class="reviews-empty"><p>لا توجد تجارب متاحة حالياً.</p></div>';
      if (videoSection) videoSection.innerHTML = '<div class="reviews-empty"><p>لا توجد تجارب متاحة حالياً.</p></div>';
    }
  </script>
</BaseLayout>

