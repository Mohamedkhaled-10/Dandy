---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Invoice Details & Tracking | Dandy"
  description="تفاصيل الفاتورة وتتبع مسار شحن وتوصيل الطلب من متجر داندي."
  canonical="https://dandy-ebon.vercel.app/invoice"
>
  <slot name="head" slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <script is:inline src="/assets/js/order-flow-helpers.js"></script>

    <style is:global>
      .invoice-section {
        padding: 130px 0 80px;
      }

      .invoice-panel {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-lg);
        padding: 40px;
        box-shadow: var(--shadow-lg);
        max-width: 800px;
        margin: 0 auto;
      }

      .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px dashed var(--border-light);
        padding-bottom: 24px;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 16px;
      }

      .invoice-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--color-primary);
      }

      .invoice-code-tag {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--color-rose-kiss-500, #fe5d9f);
        background: var(--color-lavender-veil-600, #f3e8f5);
        border: 1px solid var(--color-soft-blossom-500, #f4bbd3);
        padding: 4px 14px;
        border-radius: 99px;
        margin-top: 4px;
        display: inline-block;
      }

      .invoice-badge-status {
        display: inline-block;
        padding: 6px 14px;
        font-weight: 700;
        font-size: 0.85rem;
        border-radius: 99px;
      }

      .status-new { background: rgba(60, 119, 90, 0.1); color: var(--color-success); border: 1px solid rgba(60, 119, 90, 0.2); }
      .status-contact { background: rgba(194, 136, 52, 0.1); color: var(--color-warning); border: 1px solid rgba(194, 136, 52, 0.2); }
      .status-done { background: var(--color-surface-soft); color: var(--color-muted); border: 1px solid var(--border-light); }

      .invoice-coords {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
      }

      .coord-card {
        background: var(--color-surface-soft);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-md);
        padding: 20px;
      }

      .coord-card h3 {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 12px;
        color: var(--color-primary);
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding-bottom: 6px;
      }

      .coord-card p {
        font-size: 0.95rem;
        color: var(--color-text);
        margin-bottom: 4px;
      }

      .invoice-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0 30px;
      }

      .invoice-table th {
        padding: 10px;
        background: var(--color-surface-soft);
        color: var(--color-muted);
        font-weight: 700;
        border-bottom: 1px solid var(--border-light);
      }

      .invoice-table td {
        padding: 14px 10px;
        border-bottom: 1px solid var(--border-light);
      }

      .invoice-table img {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 6px;
        margin-left: 10px;
        vertical-align: middle;
        border: 1px solid var(--border-light);
      }

      .bill-summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--border-light);
        padding-top: 20px;
        margin-top: 20px;
        flex-wrap: wrap;
        gap: 16px;
      }

      .invoice-action-pills {
        display: flex;
        gap: 10px;
      }

      .invoice-action-pills .i-btn {
        padding: 10px 20px;
        border-radius: 99px;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        cursor: pointer;
        transition: var(--transition-fast);
      }

      .i-btn-print { background: var(--color-surface-soft); border: 1px solid var(--border-light); color: var(--color-primary); }
      .i-btn-wp { background: #25D366; color: #fff; }
      .i-btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); }

      @media (max-width: 600px) {
        .invoice-coords {
          grid-template-columns: 1fr;
        }
        .invoice-panel {
          padding: 20px;
        }
        .bill-summary {
          flex-direction: column;
          align-items: flex-start;
        }
        .invoice-action-pills {
          width: 100%;
        }
        .invoice-action-pills .i-btn {
          flex: 1;
          justify-content: center;
        }
      }

      /* Status Timeline Tracker styling */
      .timeline-container {
        margin: 30px 0 40px;
        position: relative;
      }

      .timeline-steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        flex-wrap: nowrap;
        padding: 20px 0;
      }

      .timeline-steps::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 10%;
        right: 10%;
        height: 4px;
        background: var(--border-light);
        z-index: 1;
        transform: translateY(-50%);
      }

      .timeline-progress-bar {
        position: absolute;
        top: 50%;
        right: 10%; /* RTL progression */
        left: auto;
        height: 4px;
        background: var(--color-success);
        z-index: 2;
        transform: translateY(-50%);
        transition: width 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        width: 0%;
      }

      .step-item {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        flex: 1;
      }

      .step-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--color-surface);
        border: 2px solid var(--border-light);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-muted);
        font-size: 1rem;
        font-weight: 700;
        transition: var(--transition-smooth);
      }

      .step-item.active .step-circle {
        background: var(--color-success);
        color: #fff;
        border-color: var(--color-success);
        box-shadow: 0 0 16px rgba(60, 119, 90, 0.3);
      }

      .step-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-muted);
        text-align: center;
        transition: var(--transition-fast);
      }

      .step-item.active .step-label {
        color: var(--color-primary);
      }

      .price-crossed {
        text-decoration: line-through;
        color: var(--color-muted);
        margin-right: 8px;
      }

      /* Summary Breakdown Table Styles */
      .invoice-table tfoot td {
        padding: 10px;
        font-size: 0.95rem;
        border-bottom: 1px solid var(--border-light);
      }
    </style>
  </slot>

  <section class="invoice-section">
    <div class="container" id="invoiceStateContainer" style="display:none;"></div>
    <div class="container" id="invoiceCard">
      
      <div class="invoice-panel" dir="rtl">
        
        <div class="invoice-header">
          <div>
            <h2 class="invoice-title">تمت معالجة الطلب بنجاح!</h2>
            <span class="invoice-code-tag" id="invoiceCode">...جاري التحميل</span>
            <p style="color:var(--color-muted); font-size:0.85rem; margin-top:6px;">تاريخ التسجيل: <span id="invoiceDate">...</span></p>
          </div>
          <div style="text-align: left;">
            <button id="btnCopyCode" onclick="copyInvoiceToClipboard()" style="background:#fff; border:1px solid var(--border-light); border-radius:99px; padding:6px 14px; font-weight:700; cursor:pointer; font-size:0.85rem; color:var(--color-primary); display:inline-flex; align-items:center; gap:6px; transition:var(--transition-fast);">
              <i class="fas fa-copy"></i> نسخ الكود
            </button>
            <div style="margin-top: 10px;">
              <span class="invoice-badge-status status-new" id="statusBadge">قيد المراجعة</span>
            </div>
          </div>
        </div>

        <!-- Customer Spam Folder Notice -->
        <div class="customer-spam-notice" style="background: #faf7f8; border: 1px solid #f0e2ea; border-radius: 12px; padding: 14px 18px; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 12px;">
          <div style="color: var(--color-rose-kiss-500, #fe5d9f); font-size: 1.25rem; margin-top: 2px;">
            <i class="fas fa-envelope-open-text"></i>
          </div>
          <div style="font-size: 0.88rem; line-height: 1.6; color: #555;">
            <strong style="color: var(--color-primary); display: block; margin-bottom: 4px; font-size: 0.92rem;">تنبيه بخصوص تحديثات طلبك</strong>
            قد تصل رسائل تأكيد الطلب وتحديثات الشحن من DANDY إلى مجلد الرسائل غير المرغوب فيها (Spam) في Gmail.
            إذا وجدت رسالة متوقعة من عنواننا الرسمي <code style="direction: ltr; display: inline-block; background: #fff; padding: 1px 6px; border-radius: 4px; border: 1px solid #ebdbe3; color: var(--color-primary); font-size: 0.82rem;">dandybeauty4@gmail.com</code>، وبعد التأكد من عنوان المرسل، يمكنك اختيار «ليست رسالة غير مرغوب فيها» (Not spam)، ليسهل عليك العثور على تحديثات طلبك القادمة في صندوق الوارد.
          </div>
        </div>

        <div class="cancelled-banner" id="cancelledBanner" style="display:none; background:rgba(184, 67, 79, 0.08); border:1px solid var(--color-danger); color:var(--color-danger); padding:16px; border-radius:var(--border-radius-sm); text-align:center; font-weight:700; margin-bottom:20px;">
          <i class="fas fa-ban"></i> تم إلغاء هذا الطلب.
        </div>

        <div class="timeline-container" id="timelineContainer">
          <div class="timeline-steps">
            <div class="timeline-progress-bar" id="timelineProgressBar"></div>
            
            <div class="step-item" id="step-new">
              <div class="step-circle"><i class="fas fa-asterisk"></i></div>
              <div class="step-label">قيد المراجعة</div>
            </div>
            
            <div class="step-item" id="step-processing">
              <div class="step-circle"><i class="fas fa-cog"></i></div>
              <div class="step-label">قيد التجهيز</div>
            </div>
            
            <div class="step-item" id="step-shipped">
              <div class="step-circle"><i class="fas fa-truck-moving"></i></div>
              <div class="step-label">تم الشحن</div>
            </div>
            
            <div class="step-item" id="step-delivered">
              <div class="step-circle"><i class="fas fa-check-double"></i></div>
              <div class="step-label">تم التوصيل</div>
            </div>
          </div>
        </div>

        <div class="invoice-coords">
          <div class="coord-card">
            <h3>بيانات العميل</h3>
            <p>الاسم: <strong id="custName">...</strong></p>
            <p style="margin-top: 8px;">رقم الهاتف: <span id="custPhone">...</span></p>
            <p>البريد الإلكتروني: <span id="custEmail">...</span></p>
          </div>
          <div class="coord-card">
            <h3>عنوان التوصيل</h3>
            <p>المحافظة: <strong id="custGov">...</strong></p>
            <p style="margin-top: 8px;">المدينة/المنطقة: <span id="custCity">...</span></p>
            <p>تفاصيل الشارع: <span id="custAddress">...</span></p>
          </div>
        </div>

        <table class="invoice-table">
          <thead>
            <tr>
              <th style="text-align: right;">المنتج</th>
              <th style="text-align: right;">التفاصيل</th>
              <th style="text-align: left; width: 140px;">السعر الإجمالي</th>
            </tr>
          </thead>
          <tbody id="itemsBody">
            <tr>
              <td colspan="3" style="text-align: center; color: var(--color-muted); padding: 24px;">جاري تحميل المنتجات...</td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="2" style="text-align: left; font-weight: 700; color: var(--color-muted);">المجموع الفرعي:</td>
              <td id="tableSubtotal" style="text-align: left; font-weight: 700;">...</td>
            </tr>
            <tr id="tableCouponRow" style="display: none; background: rgba(5, 150, 105, 0.04);">
              <td colspan="2" id="tableCouponLabel" style="text-align: left; font-weight: 700; color: #059669;">خصم الكوبون:</td>
              <td id="tableCouponDiscount" style="text-align: left; font-weight: 800; color: #059669; direction: ltr;">0 ج.م</td>
            </tr>
            <tr>
              <td colspan="2" style="text-align: left; font-weight: 700; color: var(--color-muted);">مصاريف الشحن:</td>
              <td id="tableShipping" style="text-align: left; font-weight: 700; color: var(--color-success);">...</td>
            </tr>
            <tr>
              <td colspan="2" style="text-align: left; font-weight: 800; color: var(--color-primary); font-size: 1.1rem; border-top: 2px solid var(--color-primary);">الإجمالي الكلي:</td>
              <td id="tableGrandTotal" style="text-align: left; font-weight: 800; color: var(--color-primary); font-size: 1.1rem; border-top: 2px solid var(--color-primary);">...</td>
            </tr>
          </tfoot>
        </table>

        <div class="bill-summary">
          <div>
            <span style="font-size: 0.9rem; color: var(--color-muted); font-weight: 700;">طريقة الدفع</span>
            <div style="font-size: 1.25rem; font-weight: 800; color: var(--color-success);"><i class="fas fa-money-bill-wave"></i> الدفع عند الاستلام (COD)</div>
          </div>
          <div class="invoice-action-pills">
            <button class="i-btn i-btn-print" id="print-btn"><i class="fas fa-print"></i> طباعة الفاتورة / PDF</button>
            <button class="i-btn i-btn-wp" id="share-whatsapp"><i class="fab fa-whatsapp"></i> تتبع عبر واتساب</button>
          </div>
        </div>

        <div style="margin-top: 40px; border-top: 1px dashed var(--border-light); padding-top: 20px;">
          <p style="color: var(--color-muted); font-size: 0.9rem; line-height: 1.8;">
            <strong style="color: var(--color-primary);">تتبع مستمر:</strong>
            ستتلقى تحديثات مرئية فورية لحالة الطلب على هذه الشاشة بينما يقوم فريقنا بتجهيز وشحن طلبك بأمان.
          </p>
        </div>

      </div>
    </div>
  </section>

  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    const idParam = params.get('id');
    const invoiceParam = params.get('invoice');

    const invoiceCodeEl = document.getElementById('invoiceCode');
    const statusBadge = document.getElementById('statusBadge');
    const invoiceDateEl = document.getElementById('invoiceDate');

    const custName = document.getElementById('custName');
    const custPhone = document.getElementById('custPhone');
    const custEmail = document.getElementById('custEmail');
    const custGov = document.getElementById('custGov');
    const custCity = document.getElementById('custCity');
    const custAddress = document.getElementById('custAddress');
    const itemsBody = document.getElementById('itemsBody');

    const tableSubtotal = document.getElementById('tableSubtotal');
    const tableCouponRow = document.getElementById('tableCouponRow');
    const tableCouponLabel = document.getElementById('tableCouponLabel');
    const tableCouponDiscount = document.getElementById('tableCouponDiscount');
    const tableShipping = document.getElementById('tableShipping');
    const tableGrandTotal = document.getElementById('tableGrandTotal');

    function formatInvoiceEgp(value) {
      const n = Number(value);
      if (!Number.isFinite(n)) return '0';
      const rounded = Math.round(n * 100) / 100;
      const clean = Object.is(rounded, -0) ? 0 : rounded;
      return Math.abs(clean - Math.round(clean)) < 1e-9 ? String(Math.round(clean)) : String(clean);
    }

    const DEFAULT_FALLBACK_IMAGE = 'https://images.unsplash.com/photo-1608248597481-496100c80836?auto=format&fit=crop&w=100&q=80';
    let currentInvoiceCode = '';

    function sanitizeImageUrl(url) {
      if (typeof url !== 'string') return DEFAULT_FALLBACK_IMAGE;
      const trimmed = url.trim();
      if (!trimmed) return DEFAULT_FALLBACK_IMAGE;
      if (trimmed.startsWith('/') || trimmed.startsWith('https://') || trimmed.startsWith('http://')) {
        return trimmed;
      }
      return DEFAULT_FALLBACK_IMAGE;
    }

    function setStatusBadge(status){
      const s = status || 'New';
      
      let label = 'قيد المراجعة';
      let cssClass = 'status-new';
      
      if (s === 'جديد' || s === 'قيد الانتظار' || s === 'New' || s === 'Pending') {
        label = 'قيد المراجعة';
        cssClass = 'status-new';
      } else if (s === 'تم التواصل' || s === 'قيد التجهيز' || s === 'قيد التحضير' || s === 'قيد المعالجة' || s === 'Processing') {
        label = 'قيد التجهيز';
        cssClass = 'status-contact';
      } else if (s === 'تم الشحن' || s === 'جاري الشحن' || s === 'جاري التوصيل' || s === 'شحن' || s === 'Shipped') {
        label = 'تم الشحن';
        cssClass = 'status-contact';
      } else if (s === 'مكتمل' || s === 'تم التوصيل' || s === 'واصل' || s === 'Delivered') {
        label = 'تم التوصيل';
        cssClass = 'status-done';
      } else if (s === 'ملغي' || s === 'Cancelled') {
        label = 'تم الإلغاء';
        cssClass = 'status-done';
      }

      statusBadge.textContent = label;
      statusBadge.className = 'invoice-badge-status ' + cssClass;
      
      setTimelineStatus(s);
    }

    function setTimelineStatus(status) {
      const s = status || 'New';
      
      document.getElementById('step-new').className = 'step-item';
      document.getElementById('step-processing').className = 'step-item';
      document.getElementById('step-shipped').className = 'step-item';
      document.getElementById('step-delivered').className = 'step-item';
      
      document.getElementById('cancelledBanner').style.display = 'none';
      document.getElementById('timelineContainer').style.display = 'block';

      if (s === 'ملغي' || s === 'Cancelled') {
        document.getElementById('cancelledBanner').style.display = 'block';
        document.getElementById('timelineContainer').style.display = 'none';
        return;
      }

      const norm = getNormalizedStatus(s);

      if (norm === 'new') {
        document.getElementById('step-new').classList.add('active', 'current');
        document.getElementById('timelineProgressBar').style.width = '0%';
      } else if (norm === 'processing') {
        document.getElementById('step-new').classList.add('active');
        document.getElementById('step-processing').classList.add('active', 'current');
        document.getElementById('timelineProgressBar').style.width = '33%';
      } else if (norm === 'shipped') {
        document.getElementById('step-new').classList.add('active');
        document.getElementById('step-processing').classList.add('active');
        document.getElementById('step-shipped').classList.add('active', 'current');
        document.getElementById('timelineProgressBar').style.width = '66%';
      } else if (norm === 'delivered') {
        document.getElementById('step-new').classList.add('active');
        document.getElementById('step-processing').classList.add('active');
        document.getElementById('step-shipped').classList.add('active');
        document.getElementById('step-delivered').classList.add('active');
        document.getElementById('timelineProgressBar').style.width = '100%';
      }
    }

    function getNormalizedStatus(s) {
      if (s === 'جديد' || s === 'قيد الانتظار' || s === 'New' || s === 'Pending') return 'new';
      if (s === 'تم التواصل' || s === 'قيد التجهيز' || s === 'قيد التحضير' || s === 'قيد المعالجة' || s === 'Processing') return 'processing';
      if (s === 'تم الشحن' || s === 'جاري الشحن' || s === 'جاري التوصيل' || s === 'شحن' || s === 'Shipped') return 'shipped';
      if (s === 'مكتمل' || s === 'تم التوصيل' || s === 'واصل' || s === 'Delivered') return 'delivered';
      return 'new';
    }

    window.copyInvoiceToClipboard = function() {
      const code = invoiceCodeEl.textContent;
      if (code && code !== '...جاري التحميل' && code !== '...Loading') {
        navigator.clipboard.writeText(code).then(() => {
          const btn = document.getElementById('btnCopyCode');
          btn.innerHTML = '<i class="fas fa-check"></i> تم النسخ!';
          setTimeout(() => {
            btn.innerHTML = '<i class="fas fa-copy"></i> نسخ الكود';
          }, 2000);
        });
      }
    };

    function drawOrder(order, key) {
      const stateContainer = document.getElementById('invoiceStateContainer');
      const cardEl = document.getElementById('invoiceCard');
      if (stateContainer) stateContainer.style.display = 'none';
      if (cardEl) cardEl.style.display = 'block';

      currentInvoiceCode = order.invoiceCode || key || '';
      invoiceCodeEl.textContent = currentInvoiceCode || '-';
      invoiceDateEl.textContent = order.timestamp ? new Date(order.timestamp).toLocaleString('en-US') : new Date().toLocaleString('en-US');

      custName.textContent = order.name || '-';
      custPhone.textContent = order.phone || '-';
      custEmail.textContent = order.email || 'غير متوفر';
      custAddress.textContent = order.address || '-';
      custGov.textContent = order.governorate || '-';
      custCity.textContent = order.city || '-';

      itemsBody.innerHTML = '';
      let calculatedSubtotal = 0;

      if (order.products && order.products.length > 0) {
        order.products.forEach(p => {
          const quantity = parseInt(p.quantity) || 1;
          const lineTotal = (typeof p.lineTotal === 'number')
            ? p.lineTotal
            : (Number(p.price) || 0) * (Number(p.quantity) || 1);

          calculatedSubtotal += lineTotal;

          const tr = document.createElement('tr');

          // Cell 1: Image + Product Name (safe DOM)
          const tdProduct = document.createElement('td');
          const prodFlex = document.createElement('div');
          prodFlex.style.display = 'flex';
          prodFlex.style.alignItems = 'center';
          prodFlex.style.gap = '10px';

          const imgEl = document.createElement('img');
          imgEl.loading = 'lazy';
          imgEl.src = sanitizeImageUrl(p.image);
          imgEl.alt = p.name || 'منتج داندي';
          imgEl.onerror = function() {
            this.onerror = null;
            this.src = DEFAULT_FALLBACK_IMAGE;
          };

          const titleEl = document.createElement('strong');
          titleEl.style.color = 'var(--color-primary)';
          titleEl.style.fontSize = '0.95rem';
          titleEl.textContent = p.name || 'منتج داندي';

          prodFlex.appendChild(imgEl);
          prodFlex.appendChild(titleEl);
          tdProduct.appendChild(prodFlex);

          // Cell 2: Details (variants & quantity, safe DOM)
          const tdDetails = document.createElement('td');
          const varInfo = typeof getVariantsDisplayInfo === 'function'
            ? getVariantsDisplayInfo(p)
            : (p.selectedVariant && p.selectedVariant.name ? { count: 1, label: 'الرائحة', text: p.selectedVariant.name } : null);

          if (varInfo && varInfo.text && String(varInfo.text).trim() !== '' && varInfo.text !== 'undefined') {
            const varWrap = document.createElement('div');
            varWrap.style.display = 'inline-flex';
            varWrap.style.alignItems = 'center';
            varWrap.style.gap = '6px';
            varWrap.style.fontSize = '0.88rem';
            varWrap.style.color = 'var(--color-rose-kiss-500, #fe5d9f)';
            varWrap.style.fontWeight = '600';

            const icon = document.createElement('i');
            icon.className = 'fas fa-spray-can';
            icon.style.fontSize = '0.75rem';
            varWrap.appendChild(icon);

            const spanText = document.createElement('span');
            spanText.appendChild(document.createTextNode((varInfo.label || 'الرائحة') + ': '));
            const strongVar = document.createElement('strong');
            strongVar.textContent = String(varInfo.text);
            spanText.appendChild(strongVar);
            spanText.appendChild(document.createTextNode(' × ' + quantity));
            varWrap.appendChild(spanText);

            tdDetails.appendChild(varWrap);
          } else {
            const qtySpan = document.createElement('span');
            qtySpan.style.fontSize = '0.88rem';
            qtySpan.style.color = 'var(--color-muted)';
            qtySpan.style.fontWeight = '600';
            qtySpan.textContent = '× ' + quantity;
            tdDetails.appendChild(qtySpan);
          }

          if (p.isCollection && Array.isArray(p.items) && p.items.length > 0) {
            const colList = document.createElement('div');
            colList.style.marginTop = '6px';
            colList.style.fontSize = '0.78rem';
            colList.style.color = 'var(--color-muted)';
            p.items.forEach(sub => {
              const subRow = document.createElement('div');
              const subName = sub.productName || sub.name || '';
              const subVar = sub.variantName ? ' (' + sub.variantName + ')' : '';
              subRow.textContent = '• ' + subName + subVar;
              colList.appendChild(subRow);
            });
            tdDetails.appendChild(colList);
          }

          // Cell 3: Price Total
          const tdPrice = document.createElement('td');
          tdPrice.style.textAlign = 'left';
          tdPrice.style.fontWeight = '800';
          tdPrice.style.color = 'var(--color-rose-kiss-500, #fe5d9f)';
          tdPrice.style.whiteSpace = 'nowrap';

          if (p.discount && typeof p.lineTotal !== 'number') {
            const price = parseFloat(p.price) || 0;
            const discountAmount = (price * parseFloat(p.discount)) / 100;
            const finalPrice = price - discountAmount;
            tdPrice.appendChild(document.createTextNode((finalPrice * quantity).toFixed(0) + ' ج.م '));
            const crossed = document.createElement('span');
            crossed.className = 'price-crossed';
            crossed.textContent = (price * quantity).toFixed(0);
            tdPrice.appendChild(crossed);
          } else {
            tdPrice.textContent = lineTotal.toFixed(0) + ' ج.م';
          }

          tr.appendChild(tdProduct);
          tr.appendChild(tdDetails);
          tr.appendChild(tdPrice);
          itemsBody.appendChild(tr);
        });

        const rawCoupon = order.coupon && typeof order.coupon === 'object' && !Array.isArray(order.coupon)
          ? order.coupon
          : null;
        const couponCode = rawCoupon && typeof rawCoupon.code === 'string' && rawCoupon.code.trim()
          ? rawCoupon.code.trim().toUpperCase()
          : '';
        const couponDiscountVal = rawCoupon && Number.isFinite(Number(rawCoupon.discountAmount)) && Number(rawCoupon.discountAmount) > 0
          ? Math.round(Number(rawCoupon.discountAmount) * 100) / 100
          : 0;

        const subtotalVal = order.subtotal !== undefined ? parseFloat(order.subtotal) : calculatedSubtotal;
        const shippingVal = order.shippingFee !== undefined ? parseFloat(order.shippingFee) : 0;
        const totalVal = order.totalAmount !== undefined
          ? parseFloat(order.totalAmount)
          : Math.max(0, Math.round((subtotalVal - couponDiscountVal + shippingVal) * 100) / 100);

        tableSubtotal.textContent = formatInvoiceEgp(subtotalVal) + " ج.م";
        if (tableCouponRow && tableCouponLabel && tableCouponDiscount) {
          if (couponCode && couponDiscountVal > 0) {
            tableCouponLabel.textContent = "خصم الكوبون (" + couponCode + "):";
            tableCouponDiscount.textContent = "-" + formatInvoiceEgp(couponDiscountVal) + " ج.م";
            tableCouponRow.style.display = "table-row";
          } else {
            tableCouponRow.style.display = "none";
            tableCouponLabel.textContent = "خصم الكوبون:";
            tableCouponDiscount.textContent = "0 ج.م";
          }
        }
        tableShipping.textContent = formatInvoiceEgp(shippingVal) + " ج.م";
        tableGrandTotal.textContent = formatInvoiceEgp(totalVal) + " ج.م";

        // =========================================================================
        // إضافة حدث الشراء (Meta Pixel Purchase Event) عبر DandyMeta
        // =========================================================================
        const transactionId = order.invoiceCode || key;

        if (window.DandyMeta && typeof window.DandyMeta.trackPurchase === 'function') {
          window.DandyMeta.trackPurchase(order);
        } else if (typeof fbq !== 'undefined') {
          const storageKey = 'meta_pixel_purchase_fired_' + transactionId;
          const safeStorage = getSafeSessionStorage();
          let alreadyFired = false;
          try {
            alreadyFired = Boolean(safeStorage && safeStorage.getItem(storageKey));
          } catch(e) {}

          if (!alreadyFired) {
            let contentIds = [];
            (order.products || []).forEach(p => {
              if (p.type === 'collection' || p.isCollection || p.collectionId) {
                const subItems = Array.isArray(p.items) ? p.items : (Array.isArray(p.selectedItems) ? p.selectedItems : []);
                subItems.forEach(s => {
                  if (s.productId || s.id) contentIds.push(s.productId || s.id);
                });
              } else {
                const pid = p.productId || p.id;
                if (pid) contentIds.push(pid);
              }
            });

            fbq('track', 'Purchase', {
              content_type: 'product',
              content_ids: contentIds,
              value: parseFloat(totalVal.toFixed(2)),
              currency: 'EGP',
              transaction_id: transactionId
            });

            try {
              if (safeStorage) {
                safeStorage.setItem(storageKey, 'true');
              }
            } catch(e) {}
          }
        }

      } else {
        itemsBody.innerHTML = '<tr><td colspan="3" style="text-align:center;color:var(--color-muted);padding:20px;">سلة المشتريات فارغة.</td></tr>';
        tableSubtotal.textContent = '0 ج.م';
        if (tableCouponRow) tableCouponRow.style.display = 'none';
        tableShipping.textContent = '0 ج.م';
        tableGrandTotal.textContent = '0 ج.م';
      }

      setStatusBadge(order.status || 'New');
    }

    function renderInvoiceStateCard(options) {
      const stateContainer = document.getElementById('invoiceStateContainer');
      const cardEl = document.getElementById('invoiceCard');
      if (!stateContainer) return;

      if (cardEl) {
        cardEl.style.display = 'none';
      }

      const wrapper = document.createElement('div');
      wrapper.style.textAlign = 'center';
      wrapper.style.padding = '70px 24px';
      wrapper.style.background = '#fff';
      wrapper.style.border = '1px solid var(--border-light)';
      wrapper.style.borderRadius = 'var(--border-radius-lg)';
      wrapper.style.boxShadow = 'var(--shadow-sm)';
      wrapper.style.maxWidth = '600px';
      wrapper.style.margin = '0 auto';
      wrapper.setAttribute('dir', 'rtl');

      const icon = document.createElement('i');
      icon.className = options.iconClass || 'fas fa-exclamation-circle';
      icon.style.fontSize = '3.2rem';
      icon.style.color = options.iconColor || 'var(--color-danger)';
      icon.style.marginBottom = '16px';
      wrapper.appendChild(icon);

      const h2 = document.createElement('h2');
      h2.style.margin = '0 0 10px';
      h2.style.fontWeight = '800';
      h2.style.color = 'var(--color-primary)';
      h2.textContent = options.title || 'تعذر عرض الفاتورة';
      wrapper.appendChild(h2);

      const p = document.createElement('p');
      p.style.color = 'var(--color-muted)';
      p.style.lineHeight = '1.7';
      p.style.margin = '0 auto 22px';
      p.style.maxWidth = '460px';
      p.textContent = options.message || '';
      wrapper.appendChild(p);

      const actionsRow = document.createElement('div');
      actionsRow.style.display = 'flex';
      actionsRow.style.justifyContent = 'center';
      actionsRow.style.flexWrap = 'wrap';
      actionsRow.style.gap = '12px';

      if (options.onRetry) {
        const retryBtn = document.createElement('button');
        retryBtn.type = 'button';
        retryBtn.id = 'btnRetryLoadInvoice';
        retryBtn.className = 'i-btn i-btn-print';
        retryBtn.innerHTML = '<i class="fas fa-redo"></i> إعادة المحاولة';
        retryBtn.addEventListener('click', options.onRetry);
        actionsRow.appendChild(retryBtn);
      }

      if (options.trackHref) {
        const trackLink = document.createElement('a');
        trackLink.href = options.trackHref;
        trackLink.id = 'legacyTrackRedirectLink';
        trackLink.className = 'i-btn i-btn-wp';
        trackLink.style.textDecoration = 'none';
        trackLink.innerHTML = '<i class="fas fa-truck"></i> الانتقال إلى تتبع الطلب';
        actionsRow.appendChild(trackLink);
      }

      const homeLink = document.createElement('a');
      homeLink.href = '/';
      homeLink.className = 'i-btn';
      homeLink.style.textDecoration = 'none';
      homeLink.style.background = '#f3f4f6';
      homeLink.style.color = 'var(--color-primary)';
      homeLink.textContent = 'العودة للرئيسية';
      actionsRow.appendChild(homeLink);

      wrapper.appendChild(actionsRow);
      stateContainer.innerHTML = '';
      stateContainer.appendChild(wrapper);
      stateContainer.style.display = 'block';
    }

    function orderError(customTitle, customMessage, onRetry) {
      renderInvoiceStateCard({
        iconClass: onRetry ? 'fas fa-clock' : 'fas fa-exclamation-circle',
        iconColor: onRetry ? '#d97706' : 'var(--color-danger)',
        title: customTitle || 'الفاتورة غير موجودة',
        message: customMessage || 'يرجى التحقق من رابط الفاتورة أو تتبع طلبك باستخدام كود الفاتورة ورقم الهاتف.',
        trackHref: '/track-order',
        onRetry: onRetry || null
      });
    }

    let activeInvoiceTokenInMemory = null;
    const rejectedInvoiceTokens = new Set();

    function getSafeSessionStorage() {
      const flow = window.DandyOrderFlow;
      if (flow && typeof flow.getSafeSessionStorage === 'function') {
        return flow.getSafeSessionStorage(window);
      }
      try {
        return window.sessionStorage || null;
      } catch (_) {
        return null;
      }
    }

    function stripInvoiceHashFromUrl() {
      if (!window.location.hash) return;
      try {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      } catch (_) {}
    }

    async function loadInvoiceWithToken(accessToken, tokenResolution) {
      const flow = window.DandyOrderFlow;
      const candidateToken = accessToken || activeInvoiceTokenInMemory;
      if (!candidateToken || rejectedInvoiceTokens.has(candidateToken)) {
        activeInvoiceTokenInMemory = null;
        orderError(
          'رابط الفاتورة غير صالح أو انتهت صلاحيته',
          'لم نتمكن من التحقق من رابط الفاتورة. يمكنكِ مراجعة الرابط المرسل إلى بريدكِ الإلكتروني أو متابعة حالة الطلب عبر صفحة تتبع الطلب.',
          null
        );
        return;
      }

      activeInvoiceTokenInMemory = candidateToken;
      const effectiveToken = activeInvoiceTokenInMemory;
      let res = null;
      let data = {};
      let networkError = false;

      try {
        res = await fetch('/api/public-invoice', {
          method: 'POST',
          cache: 'no-store',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ access: effectiveToken })
        });
        data = await res.json().catch(() => ({}));
      } catch (_) {
        networkError = true;
      }

      const outcome = flow
        ? flow.classifyPublicInvoiceResponse({
            ok: Boolean(res && res.ok),
            status: res ? res.status : 0,
            data,
            networkError
          })
        : {
            action: (res && res.ok && data && data.success && data.order) ? 'RENDER_INVOICE' : 'INVALID_OR_NOT_FOUND',
            order: data && data.order,
            clearSessionToken: Boolean(res && res.status === 404),
            stripHash: Boolean(res && res.status === 404),
            showRetry: !res || res.status !== 404,
            title: 'تعذر تحميل الفاتورة',
            message: 'يرجى المحاولة مرة أخرى.'
          };

      if (outcome.action === 'RENDER_INVOICE' && outcome.order) {
        drawOrder(outcome.order, outcome.order.orderId || outcome.order.invoiceCode);
        if (tokenResolution && tokenResolution.stripHashAfterRender) {
          stripInvoiceHashFromUrl();
        }
        return;
      }

      if (outcome.clearSessionToken) {
        activeInvoiceTokenInMemory = null;
        rejectedInvoiceTokens.add(effectiveToken);
        if (flow) {
          flow.clearInvoiceSessionToken(getSafeSessionStorage());
        }
      }

      if (outcome.stripHash || outcome.clearSessionToken) {
        stripInvoiceHashFromUrl();
      }

      orderError(
        outcome.title,
        outcome.message,
        outcome.showRetry ? () => loadInvoiceWithToken(effectiveToken, tokenResolution) : null
      );
    }

    (function bootstrapInvoicePage() {
      const flow = window.DandyOrderFlow;
      const safeStorage = getSafeSessionStorage();
      const tokenResolution = flow
        ? flow.resolveInvoiceAccessToken(window.location.hash, safeStorage)
        : {
            token: null,
            source: 'none',
            persisted: false,
            shouldStripHash: false,
            stripHashAfterRender: false
          };

      if (tokenResolution.shouldStripHash) {
        stripInvoiceHashFromUrl();
      }

      if (tokenResolution.token) {
        loadInvoiceWithToken(tokenResolution.token, tokenResolution);
        return;
      }

      // Legacy URL handling: NEVER read Firebase RTDB directly; NEVER pass phone in URL
      if (invoiceParam && invoiceParam.trim()) {
        const cleanCode = invoiceParam.trim().toUpperCase();
        renderInvoiceStateCard({
          iconClass: 'fas fa-shield-alt',
          iconColor: 'var(--color-rose-kiss-500, #fe5d9f)',
          title: 'تم تحديث نظام حماية الفواتير',
          message:
            'للحفاظ على خصوصية بياناتكِ، تتطلب روابط الفواتير القديمة إدخال كود الطلب (' +
            cleanCode +
            ') ورقم الهاتف للتحقق عبر صفحة تتبع الطلب.',
          trackHref: '/track-order?code=' + encodeURIComponent(cleanCode)
        });
        return;
      }

      if (idParam && idParam.trim()) {
        renderInvoiceStateCard({
          iconClass: 'fas fa-shield-alt',
          iconColor: 'var(--color-rose-kiss-500, #fe5d9f)',
          title: 'الرابط القديم غير متاح للعرض المباشر',
          message:
            'لحماية بيانات الطلبات، لم يعد عرض الفاتورة متاحاً عبر معرف الطلب المباشر. يرجى استخدام رابط الفاتورة المرسل لبريدكِ الإلكتروني أو صفحة تتبع الطلب.',
          trackHref: '/track-order'
        });
        return;
      }

      orderError();
    })();

    document.getElementById('print-btn')?.addEventListener('click', () => window.print());

    document.getElementById('share-whatsapp')?.addEventListener('click', () => {
      const safeCode = currentInvoiceCode || invoiceCodeEl.textContent || '';
      const trackingUrl = safeCode
        ? `${window.location.origin}/track-order?code=${encodeURIComponent(safeCode)}`
        : `${window.location.origin}/track-order`;
      const wpInquiry = `مرحباً، أود الاستعلام عن حالة شحن طلب Dandy الخاص بي:\n- كود الفاتورة: ${safeCode}\n- العميل: ${custName.textContent}\n- الحالة الحالية: ${statusBadge.textContent}\n- رابط التتبع: ${trackingUrl}`;
      window.open(`https://wa.me/201038941005?text=${encodeURIComponent(wpInquiry)}`, '_blank');
    });
  </script>
</BaseLayout>
