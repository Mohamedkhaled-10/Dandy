  <script is:inline>
    // ==========================================
    // DANDY ENTERPRISE BI ANALYTICS ENGINE
    // ==========================================

    function escapeHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    const currencyFormatter = new Intl.NumberFormat('en-EG', {
      style: 'decimal',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    });

    function formatMoney(amount) {
      return currencyFormatter.format(Math.round(amount || 0)) + ' ج.م';
    }

    // Cairo Date Helper (Africa/Cairo UTC+2 / UTC+3)
    function getCairoDateString(dateInput) {
      if (!dateInput) return null;
      const d = new Date(dateInput);
      if (isNaN(d.getTime())) return null;
      return d.toLocaleDateString('en-CA', { timeZone: 'Africa/Cairo' });
    }

    function formatCairoDateTime(dateInput) {
      if (!dateInput) return '--';
      const d = new Date(dateInput);
      if (isNaN(d.getTime())) return '--';
      return d.toLocaleString('ar-EG', {
        timeZone: 'Africa/Cairo',
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
      });
    }

    // Standardize order status
    function normalizeStatus(raw) {
      if (!raw) return 'جديد';
      const s = String(raw).trim();
      const lower = s.toLowerCase();
      if (lower === 'new') return 'جديد';
      if (lower === 'completed') return 'تم التوصيل';
      if (lower === 'cancelled' || lower === 'canceled') return 'ملغي';
      return s;
    }

    // Global in-memory state
    const biState = {
      allOrders: [],
      allProducts: [],
      currentPeriod: '7d', // today, 7d, 30d, 90d, this_month, last_month, all, custom
      customStart: null,
      customEnd: null,
      filteredOrders: [],
      priorPeriodOrders: [],
      productSortBy: 'qty', // 'qty' or 'rev'
      latencyMs: 0,
      lastSync: null,
      charts: {
        velocity: null,
        status: null,
        revenueBreakdown: null,
        deliveredTrend: null,
        governorate: null,
        customerSegment: null
      }
    };

    function appendDiagnosticLog(msg, type = 'INFO') {
      const consoleBox = document.getElementById('bi-diagnostic-logs');
      if (!consoleBox) return;
      const nowStr = new Date().toLocaleTimeString('en-US', { hour12: false });
      const row = document.createElement('div');
      row.style.marginBottom = '3px';
      if (type === 'ERROR') {
        row.style.color = '#f43f5e';
      } else if (type === 'SUCCESS') {
        row.style.color = '#34d399';
      } else if (type === 'WARN') {
        row.style.color = '#fbbf24';
      }
      row.textContent = `[${nowStr}] [${type}] ${msg}`;
      consoleBox.appendChild(row);
      consoleBox.scrollTop = consoleBox.scrollHeight;
    }

    // Strict Admin Auth Guard
    function checkAdminAuth() {
      const urlParams = new URLSearchParams(window.location.search);
      const isTestPreview = urlParams.get('test_preview') === '1' || (typeof window !== 'undefined' && window.sessionStorage && window.sessionStorage.getItem('__dandy_test_admin') === 'true');
      
      if (isTestPreview) {
        initializeUIHandlers();
        fetchDashboardData(true);
        return;
      }

      const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
      if (auth && typeof auth.onAuthStateChanged === 'function') {
        auth.onAuthStateChanged(handleAuthUser);
      } else {
        let attempts = 0;
        const poll = setInterval(() => {
          attempts++;
          const a = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);
          if (a && typeof a.onAuthStateChanged === 'function') {
            clearInterval(poll);
            a.onAuthStateChanged(handleAuthUser);
          } else if (attempts > 35) {
            clearInterval(poll);
            window.location.href = '/login';
          }
        }, 100);
      }
    }

    function handleAuthUser(user) {
      if (!user) {
        window.location.href = '/login';
        return;
      }
      if (!user.email || user.email.toLowerCase() !== 'admin@dandy.com') {
        window.location.replace('/');
        return;
      }
      // Authorized admin: start fetching and initialize UI
      initializeUIHandlers();
      fetchDashboardData(false);
    }

    // UI Handlers & Tabs
    function initializeUIHandlers() {
      // Tab switching
      const tabBtns = document.querySelectorAll('.bi-tab-btn');
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetTabId = btn.getAttribute('data-tab');
          tabBtns.forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.bi-tab-content').forEach(c => c.classList.remove('active'));
          btn.classList.add('active');
          const targetEl = document.getElementById(targetTabId);
          if (targetEl) targetEl.classList.add('active');
          window.dispatchEvent(new Event('resize'));
        });
      });

      // Period filters
      const periodBtns = document.querySelectorAll('.bi-pill-btn[data-period]');
      const customDatesBar = document.getElementById('custom-dates-bar');
      periodBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          periodBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const p = btn.getAttribute('data-period');
          biState.currentPeriod = p;

          if (p === 'custom') {
            if (customDatesBar) customDatesBar.classList.add('show');
          } else {
            if (customDatesBar) customDatesBar.classList.remove('show');
            applyPeriodFilterAndCompute();
          }
        });
      });

      // Custom date apply button
      const applyCustomBtn = document.getElementById('apply-custom-dates');
      if (applyCustomBtn) {
        applyCustomBtn.addEventListener('click', () => {
          const s = document.getElementById('custom-start-date').value;
          const e = document.getElementById('custom-end-date').value;
          if (!s || !e) {
            alert('يرجى تحديد تاريخ البداية والنهاية');
            return;
          }
          biState.customStart = s;
          biState.customEnd = e;
          applyPeriodFilterAndCompute();
        });
      }

      // Refresh button
      const refreshBtn = document.getElementById('btn-refresh');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', () => {
          const icon = document.getElementById('refresh-icon');
          if (icon) icon.classList.add('fa-spin');
          const urlParams = new URLSearchParams(window.location.search);
          const isTest = urlParams.get('test_preview') === '1' || (window.sessionStorage && window.sessionStorage.getItem('__dandy_test_admin') === 'true');
          fetchDashboardData(isTest).finally(() => {
            if (icon) icon.classList.remove('fa-spin');
          });
        });
      }

      // Export Dropdown
      const exportToggle = document.getElementById('btn-export-toggle');
      const exportDropdown = document.getElementById('export-dropdown');
      if (exportToggle && exportDropdown) {
        exportToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          exportDropdown.classList.toggle('show');
        });
        document.addEventListener('click', () => {
          exportDropdown.classList.remove('show');
