      appendDiagnosticLog(`Batch load completed in ${biState.latencyMs}ms. Loaded ${orders.length} orders and ${products.length} products.`, 'SUCCESS');

      // Update System Health card stats
      updateSystemHealthStaticMetrics();

      // Reveal content and hide loader
      document.getElementById('bi-loading').style.display = 'none';
      document.getElementById('bi-content').style.display = 'block';

      applyPeriodFilterAndCompute();
    }

    // System Health Static Metrics
    function updateSystemHealthStaticMetrics() {
      const latencyVal = document.getElementById('health-latency-val');
      const latencyTag = document.getElementById('health-latency-tag');
      const recCount = document.getElementById('health-records-count');
      const recSub = document.getElementById('health-records-sub');
      const qualityScore = document.getElementById('health-quality-score');
      const lastSyncEl = document.getElementById('health-last-sync-time');

      if (latencyVal) latencyVal.textContent = `${biState.latencyMs} ms`;
      if (latencyTag) {
        if (biState.latencyMs < 400) {
          latencyTag.className = 'bi-tag bi-tag-emerald';
          latencyTag.textContent = 'ممتاز (<400ms)';
        } else if (biState.latencyMs < 900) {
          latencyTag.className = 'bi-tag bi-tag-blue';
          latencyTag.textContent = 'جيد';
        } else {
          latencyTag.className = 'bi-tag bi-tag-amber';
          latencyTag.textContent = 'بطيء نسبياً';
        }
      }

      if (recCount) recCount.textContent = (biState.allOrders.length + biState.allProducts.length).toLocaleString();
      if (recSub) recSub.textContent = `${biState.allOrders.length} طلب + ${biState.allProducts.length} منتج في الذاكرة`;

      // Data Quality Check: % of orders with valid timestamp, totalAmount > 0, and non-empty phone
      if (biState.allOrders.length > 0) {
        let validOrders = 0;
        biState.allOrders.forEach(o => {
          const hasTime = !!o.timestamp && !isNaN(new Date(o.timestamp).getTime());
          const hasAmount = !isNaN(parseFloat(o.totalAmount || o.subtotal)) && parseFloat(o.totalAmount || o.subtotal) > 0;
          const hasPhone = !!o.phone && String(o.phone).trim().length >= 8;
          if (hasTime && hasAmount && hasPhone) validOrders++;
        });
        const qualityPct = ((validOrders / biState.allOrders.length) * 100).toFixed(1);
        if (qualityScore) qualityScore.textContent = `${qualityPct}%`;
      }

      if (lastSyncEl && biState.lastSync) {
        lastSyncEl.textContent = `آخر مزامنة: ${formatCairoDateTime(biState.lastSync)}`;
      }
    }

    // Time Filter Bounds Calculation (Cairo Local Time)
    function computeDateRangeBounds(periodKey) {
      // Determine today's Cairo date representation
      const now = new Date();
      const todayCairoStr = getCairoDateString(now); // "YYYY-MM-DD"
      const [year, month, day] = todayCairoStr.split('-').map(Number);
      
      const cairoTodayDate = new Date(year, month - 1, day);

      let startCurrent, endCurrent;
      let startPrior, endPrior;

      if (periodKey === 'today') {
        startCurrent = new Date(year, month - 1, day, 0, 0, 0);
        endCurrent = new Date(year, month - 1, day, 23, 59, 59, 999);

        // Prior is yesterday
        startPrior = new Date(year, month - 1, day - 1, 0, 0, 0);
        endPrior = new Date(year, month - 1, day - 1, 23, 59, 59, 999);
      } else if (periodKey === '7d') {
        startCurrent = new Date(year, month - 1, day - 6, 0, 0, 0);
        endCurrent = new Date(year, month - 1, day, 23, 59, 59, 999);

        startPrior = new Date(year, month - 1, day - 13, 0, 0, 0);
        endPrior = new Date(year, month - 1, day - 7, 23, 59, 59, 999);
      } else if (periodKey === '30d') {
        startCurrent = new Date(year, month - 1, day - 29, 0, 0, 0);
        endCurrent = new Date(year, month - 1, day, 23, 59, 59, 999);

        startPrior = new Date(year, month - 1, day - 59, 0, 0, 0);
        endPrior = new Date(year, month - 1, day - 30, 23, 59, 59, 999);
      } else if (periodKey === '90d') {
        startCurrent = new Date(year, month - 1, day - 89, 0, 0, 0);
        endCurrent = new Date(year, month - 1, day, 23, 59, 59, 999);

        startPrior = new Date(year, month - 1, day - 179, 0, 0, 0);
        endPrior = new Date(year, month - 1, day - 90, 23, 59, 59, 999);
      } else if (periodKey === 'this_month') {
        startCurrent = new Date(year, month - 1, 1, 0, 0, 0);
        endCurrent = new Date(year, month - 1, day, 23, 59, 59, 999);

        // Previous month full
        const daysInPrevMonth = new Date(year, month - 1, 0).getDate();
        startPrior = new Date(year, month - 2, 1, 0, 0, 0);
        endPrior = new Date(year, month - 2, Math.min(day, daysInPrevMonth), 23, 59, 59, 999);
      } else if (periodKey === 'last_month') {
        const prevMonthYear = month === 1 ? year - 1 : year;
        const prevMonthIdx = month === 1 ? 11 : month - 2;
        const daysInPrev = new Date(prevMonthYear, prevMonthIdx + 1, 0).getDate();

        startCurrent = new Date(prevMonthYear, prevMonthIdx, 1, 0, 0, 0);
        endCurrent = new Date(prevMonthYear, prevMonthIdx, daysInPrev, 23, 59, 59, 999);

        const priorPriorYear = prevMonthIdx === 0 ? prevMonthYear - 1 : prevMonthYear;
        const priorPriorIdx = prevMonthIdx === 0 ? 11 : prevMonthIdx - 1;
        const daysInPriorPrior = new Date(priorPriorYear, priorPriorIdx + 1, 0).getDate();

        startPrior = new Date(priorPriorYear, priorPriorIdx, 1, 0, 0, 0);
        endPrior = new Date(priorPriorYear, priorPriorIdx, daysInPriorPrior, 23, 59, 59, 999);
      } else if (periodKey === 'custom' && biState.customStart && biState.customEnd) {
        const [sy, sm, sd] = biState.customStart.split('-').map(Number);
        const [ey, em, ed] = biState.customEnd.split('-').map(Number);
        startCurrent = new Date(sy, sm - 1, sd, 0, 0, 0);
        endCurrent = new Date(ey, em - 1, ed, 23, 59, 59, 999);

        const durationMs = endCurrent.getTime() - startCurrent.getTime();
        endPrior = new Date(startCurrent.getTime() - 1);
        startPrior = new Date(endPrior.getTime() - durationMs);
      } else {
        // all time
        startCurrent = new Date(2020, 0, 1);
        endCurrent = new Date(year, month - 1, day, 23, 59, 59, 999);
        startPrior = null;
        endPrior = null;
      }

      return { startCurrent, endCurrent, startPrior, endPrior };
    }

    // Filter orders by date range
    function applyPeriodFilterAndCompute() {
      const bounds = computeDateRangeBounds(biState.currentPeriod);

      const periodBadge = document.getElementById('period-text-info');
      if (periodBadge) {
        if (biState.currentPeriod === 'all') {
          periodBadge.textContent = 'عرض شامل لجميع الطلبات المسجلة منذ التأسيس';
        } else {
          const sStr = bounds.startCurrent.toLocaleDateString('ar-EG', { month: 'short', day: 'numeric', year: 'numeric' });
          const eStr = bounds.endCurrent.toLocaleDateString('ar-EG', { month: 'short', day: 'numeric', year: 'numeric' });
          periodBadge.textContent = `من ${sStr} إلى ${eStr} (توقيت القاهرة)`;
        }
      }

      // Filter Current & Prior orders
      biState.filteredOrders = [];
      biState.priorPeriodOrders = [];

      biState.allOrders.forEach(o => {
        if (!o.timestamp) return;
        const oDate = new Date(o.timestamp);
        if (isNaN(oDate.getTime())) return;

        if (oDate >= bounds.startCurrent && oDate <= bounds.endCurrent) {
          biState.filteredOrders.push(o);
        } else if (bounds.startPrior && bounds.endPrior && oDate >= bounds.startPrior && oDate <= bounds.endPrior) {
          biState.priorPeriodOrders.push(o);
        }
      });

      appendDiagnosticLog(`Applied period filter '${biState.currentPeriod}': matched ${biState.filteredOrders.length} orders (prior period: ${biState.priorPeriodOrders.length})`, 'INFO');

      // Execute metrics computations
      computeAndRenderAllMetrics(bounds);
    }

    // Core Metrics Engine
    function computeAndRenderAllMetrics(bounds) {
      // 1. Process Current Period Orders
      const currentStats = aggregateOrderDataset(biState.filteredOrders);
      const priorStats = aggregateOrderDataset(biState.priorPeriodOrders);

      // 2. Render Overview KPIs
      renderExecutiveKPIs(currentStats, priorStats);

      // 3. Render Sales & Revenue Section
      renderRevenueTabKPIs(currentStats);

      // 4. Render Fulfillment Funnel & Geography
      renderFulfillmentSection(currentStats);

      // 5. Render Inventory & Products
      renderInventorySection(currentStats);

      // 6. Render Customer Intelligence
      renderCustomerIntelligence(currentStats);

      // 7. Render Marketing & Pink Friday
      renderMarketingSection(currentStats);

      // 8. Render All Interactive Charts
      renderAllCharts(currentStats, priorStats, bounds);
    }

    // Aggregates an array of orders into a metrics object
    function aggregateOrderDataset(orders) {
      let grossRegisteredValue = 0;
      let activeOrdersValue = 0;
      let deliveredRevenue = 0;
      let inPipelineValue = 0;
      let cancelledValue = 0;
      let shippingFeesTotal = 0;

      let totalOrderCount = orders.length;
      let activeOrderCount = 0;
      let deliveredOrderCount = 0;
      let cancelledOrderCount = 0;
      let totalUnitsSold = 0;

      const statusBreakdown = {
        'جديد': 0,
        'قيد التجهيز': 0,
        'تم الشحن': 0,
        'تم التوصيل': 0,
        'ملغي': 0
      };

      const dailyDeliveredMap = {};
      const dailyActiveMap = {};
      const dailySubtotalMap = {};
      const dailyShippingMap = {};

      const productsSoldMap = {};
      const customerOrdersMap = {};
      const governorateMap = {};

      let pinkFridayRevenue = 0;
      let pinkFridayOrdersCount = 0;
      let pinkFridayUnitsCount = 0;

      orders.forEach(o => {
        const rawStatus = normalizeStatus(o.status);
        let sKey = 'جديد';
        if (rawStatus === 'قيد التجهيز' || rawStatus === 'تم التواصل') sKey = 'قيد التجهيز';
        else if (rawStatus === 'تم الشحن' || rawStatus === 'جاري الشحن') sKey = 'تم الشحن';
        else if (rawStatus === 'تم التوصيل' || rawStatus === 'مكتمل') sKey = 'تم التوصيل';
        else if (rawStatus === 'ملغي') sKey = 'ملغي';

        statusBreakdown[sKey] = (statusBreakdown[sKey] || 0) + 1;

        // Financial extraction
        let orderTotal = 0;
        if (o.totalAmount && !isNaN(parseFloat(o.totalAmount))) {
          orderTotal = parseFloat(o.totalAmount);
        } else if (o.subtotal) {
          orderTotal = parseFloat(o.subtotal) + (parseFloat(o.shippingFee) || 0);
        } else if (o.products) {
          const sum = Object.values(o.products).reduce((acc, p) => {
            const lt = typeof p.lineTotal === 'number' ? p.lineTotal : (Number(p.price) || 0) * (Number(p.quantity) || 1);
            return acc + lt;
          }, 0);
          orderTotal = sum + (parseFloat(o.shippingFee) || 0);
        }

        const shippingFee = parseFloat(o.shippingFee) || 0;
        const subtotal = Math.max(0, orderTotal - shippingFee);

        grossRegisteredValue += orderTotal;

        if (sKey === 'ملغي') {
          cancelledOrderCount++;
          cancelledValue += orderTotal;
        } else {
          activeOrderCount++;
          activeOrdersValue += orderTotal;
          shippingFeesTotal += shippingFee;

          if (sKey === 'تم التوصيل') {
            deliveredOrderCount++;
            deliveredRevenue += orderTotal;
          } else {
            inPipelineValue += orderTotal;
          }

          // Daily groupings (Cairo Local Date)
          const cairoDate = getCairoDateString(o.timestamp);
          if (cairoDate) {
            dailyActiveMap[cairoDate] = (dailyActiveMap[cairoDate] || 0) + orderTotal;
            dailySubtotalMap[cairoDate] = (dailySubtotalMap[cairoDate] || 0) + subtotal;
            dailyShippingMap[cairoDate] = (dailyShippingMap[cairoDate] || 0) + shippingFee;

            if (sKey === 'تم التوصيل') {
              dailyDeliveredMap[cairoDate] = (dailyDeliveredMap[cairoDate] || 0) + orderTotal;
            }
          }

          // Products Sales aggregation
          let orderHasPinkFriday = false;
          if (o.products && typeof o.products === 'object') {
            Object.values(o.products).forEach(p => {
              if (!p) return;
              const pId = p.id || p.productId || p.name || 'مستحضر';
              const pName = p.name || 'مستحضر داندي';
              const pQty = parseInt(p.quantity, 10) || 1;
              const pPrice = Number(p.price) || 0;
              const pLineTotal = typeof p.lineTotal === 'number' ? p.lineTotal : (pPrice * pQty);

              totalUnitsSold += pQty;

              if (p.isPinkFriday) {
                orderHasPinkFriday = true;
                pinkFridayRevenue += pLineTotal;
                pinkFridayUnitsCount += pQty;
              }

              if (!productsSoldMap[pId]) {
                productsSoldMap[pId] = {
                  id: pId,
                  name: pName,
                  price: pPrice,
                  quantity: 0,
                  revenue: 0
                };
              }
              productsSoldMap[pId].quantity += pQty;
              productsSoldMap[pId].revenue += pLineTotal;
            });
          }

          if (orderHasPinkFriday) {
            pinkFridayOrdersCount++;
          }

          // Customer aggregation (normalized phone number)
          const rawPhone = String(o.phone || '').trim();
          const normPhone = rawPhone.replace(/\D/g, '');
          const custKey = normPhone || (o.name ? `name_${o.name.trim()}` : `order_${o.id}`);

          if (!customerOrdersMap[custKey]) {
            customerOrdersMap[custKey] = {
              name: o.name || 'عميل داندي',
              phone: rawPhone || 'غير مسجل',
              governorate: o.governorate || 'غير محدد',
              ordersCount: 0,
              totalSpent: 0
            };
          }
          customerOrdersMap[custKey].ordersCount++;
          customerOrdersMap[custKey].totalSpent += orderTotal;

          // Governorate aggregation
          const rawGov = String(o.governorate || 'أخرى / غير محدد').trim();
          if (!governorateMap[rawGov]) {
            governorateMap[rawGov] = {
              name: rawGov,
              ordersCount: 0,
              totalRevenue: 0,
              cancelledCount: 0
            };
          }
          governorateMap[rawGov].ordersCount++;
          governorateMap[rawGov].totalRevenue += orderTotal;
        }

        // Track cancellations per governorate
        if (sKey === 'ملغي' && o.governorate) {
          const rawGov = String(o.governorate).trim();
          if (!governorateMap[rawGov]) {
            governorateMap[rawGov] = {
              name: rawGov,
              ordersCount: 0,
              totalRevenue: 0,
              cancelledCount: 0
            };
          }
          governorateMap[rawGov].cancelledCount++;
        }
      });

      const aov = activeOrderCount > 0 ? (activeOrdersValue / activeOrderCount) : 0;
      const basketSize = activeOrderCount > 0 ? (totalUnitsSold / activeOrderCount) : 0;
      const deliveryRate = totalOrderCount > 0 ? ((deliveredOrderCount / totalOrderCount) * 100) : 0;
      const cancellationRate = totalOrderCount > 0 ? ((cancelledOrderCount / totalOrderCount) * 100) : 0;

      return {
        grossRegisteredValue,
        activeOrdersValue,
        deliveredRevenue,
        inPipelineValue,
        cancelledValue,
        shippingFeesTotal,
        totalOrderCount,
        activeOrderCount,
        deliveredOrderCount,
        cancelledOrderCount,
        totalUnitsSold,
        aov,
        basketSize,
        deliveryRate,
        cancellationRate,
        statusBreakdown,
        dailyDeliveredMap,
        dailyActiveMap,
        dailySubtotalMap,
        dailyShippingMap,
        productsSoldMap,
        customerOrdersMap,
        governorateMap,
        pinkFridayRevenue,
        pinkFridayOrdersCount,
        pinkFridayUnitsCount
      };
    }

    // Helper: Trend badge calculation
    function setTrendBadge(elId, current, prior, isReverse = false) {
      const el = document.getElementById(elId);
      if (!el) return;

      if (prior == null || prior === 0) {
        if (current > 0) {
          el.className = 'bi-trend-badge up';
          el.innerHTML = '<i class="fas fa-arrow-up"></i> +100%';
        } else {
          el.className = 'bi-trend-badge neutral';
          el.textContent = 'مستقر 0%';
        }
        return;
      }

      const diff = ((current - prior) / prior) * 100;
      const isPositive = diff >= 0;
      const isGood = isReverse ? !isPositive : isPositive;

      el.className = `bi-trend-badge ${isGood ? 'up' : 'down'}`;
      el.innerHTML = `<i class="fas fa-arrow-${isPositive ? 'up' : 'down'}"></i> ${Math.abs(diff).toFixed(1)}%`;
    }

    // Render Overview KPIs
    function renderExecutiveKPIs(curr, prior) {
      document.getElementById('kpi-delivered-revenue').textContent = formatMoney(curr.deliveredRevenue);
      setTrendBadge('trend-delivered-rev', curr.deliveredRevenue, prior.deliveredRevenue);

      document.getElementById('kpi-active-revenue').textContent = formatMoney(curr.activeOrdersValue);
      setTrendBadge('trend-active-rev', curr.activeOrdersValue, prior.activeOrdersValue);

      document.getElementById('kpi-total-orders').textContent = curr.totalOrderCount.toLocaleString();
      document.getElementById('kpi-active-orders-count').textContent = `${curr.activeOrderCount} طلب نشط`;
      setTrendBadge('trend-total-orders', curr.totalOrderCount, prior.totalOrderCount);

      document.getElementById('kpi-aov').textContent = formatMoney(curr.aov);
      setTrendBadge('trend-aov', curr.aov, prior.aov);

      document.getElementById('kpi-delivery-rate').textContent = `${curr.deliveryRate.toFixed(1)}%`;
      document.getElementById('kpi-cancellation-rate').textContent = `${curr.cancellationRate.toFixed(1)}%`;
      document.getElementById('kpi-basket-size').textContent = `${curr.basketSize.toFixed(1)} قطعة`;
    }

    // Render Revenue Tab KPIs
    function renderRevenueTabKPIs(curr) {
      document.getElementById('rev-gross-val').textContent = formatMoney(curr.grossRegisteredValue);
      document.getElementById('rev-delivered-val').textContent = formatMoney(curr.deliveredRevenue);
      document.getElementById('rev-pipeline-val').textContent = formatMoney(curr.inPipelineValue);
      document.getElementById('rev-cancelled-val').textContent = formatMoney(curr.cancelledValue);
      document.getElementById('rev-shipping-val').textContent = formatMoney(curr.shippingFeesTotal);
    }

    // Render Fulfillment Funnel & Geography
    function renderFulfillmentSection(curr) {
      const b = curr.statusBreakdown;
      const tot = curr.totalOrderCount || 1;

      document.getElementById('funnel-new').textContent = b['جديد'];
      document.getElementById('funnel-new-pct').textContent = `${((b['جديد'] / tot) * 100).toFixed(1)}%`;

      document.getElementById('funnel-prep').textContent = b['قيد التجهيز'];
      document.getElementById('funnel-prep-pct').textContent = `${((b['قيد التجهيز'] / tot) * 100).toFixed(1)}%`;

      document.getElementById('funnel-shipped').textContent = b['تم الشحن'];
      document.getElementById('funnel-shipped-pct').textContent = `${((b['تم الشحن'] / tot) * 100).toFixed(1)}%`;

      document.getElementById('funnel-delivered').textContent = b['تم التوصيل'];
      document.getElementById('funnel-delivered-pct').textContent = `${((b['تم التوصيل'] / tot) * 100).toFixed(1)}%`;

      document.getElementById('funnel-cancelled').textContent = b['ملغي'];
      document.getElementById('funnel-cancelled-pct').textContent = `${((b['ملغي'] / tot) * 100).toFixed(1)}%`;

      // Render Governorate Table
      const govTableBody = document.getElementById('governorate-table-body');
      if (govTableBody) {
        const sortedGovs = Object.values(curr.governorateMap).sort((a, b) => b.ordersCount - a.ordersCount);
        if (sortedGovs.length === 0) {
          govTableBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:16px;">لا توجد بيانات جغرافية في هذه الفترة.</td></tr>';
        } else {
          govTableBody.innerHTML = '';
          sortedGovs.forEach(g => {
            const share = ((g.ordersCount / tot) * 100).toFixed(1);
            const totalWithCancel = g.ordersCount + g.cancelledCount;
            const cancelPct = totalWithCancel > 0 ? ((g.cancelledCount / totalWithCancel) * 100).toFixed(1) : 0;
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td style="font-weight:700; color:var(--bi-slate-900);">${escapeHtml(g.name)}</td>
              <td><span class="bi-tag bi-tag-blue">${g.ordersCount} طلب</span></td>
              <td>${share}%</td>
              <td style="font-weight:700; color:var(--bi-primary-dark);">${formatMoney(g.totalRevenue)}</td>
              <td><span class="bi-tag ${cancelPct > 15 ? 'bi-tag-rose' : 'bi-tag-gray'}">${cancelPct}%</span></td>
            `;
            govTableBody.appendChild(tr);
          });
        }
      }
    }

    // Render Inventory & Products
    function renderInventorySection(curr) {
      let activeProds = 0;
      let lowStockCount = 0;
      let soldOutCount = 0;

      const catalogMap = {};
      biState.allProducts.forEach(p => {
        catalogMap[p.id] = p;
        if (!p.isHidden) activeProds++;
        const qty = parseInt(p.stockQuantity, 10) || 0;
        if (p.isSoldOut || qty <= 0) soldOutCount++;
        else if (qty > 0 && qty <= 5) lowStockCount++;
      });

      document.getElementById('inv-total-prods').textContent = biState.allProducts.length;
      document.getElementById('inv-active-prods').textContent = `${activeProds} منتج متاح على المتجر`;
      document.getElementById('inv-low-stock-count').textContent = lowStockCount;
      document.getElementById('inv-soldout-count').textContent = soldOutCount;

      renderTopProductsTable();

      // Zero-sales products
      const zeroTableBody = document.getElementById('zero-sales-table-body');
      if (zeroTableBody) {
        const zeroProds = biState.allProducts.filter(p => !curr.productsSoldMap[p.id]);
        if (zeroProds.length === 0) {
          zeroTableBody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:16px;">جميع المنتجات سجلت مبيعات في هذه الفترة!</td></tr>';
        } else {
          zeroTableBody.innerHTML = '';
          zeroProds.slice(0, 15).forEach(p => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td style="font-weight:700;">${escapeHtml(p.name)}</td>
              <td>${formatMoney(p.price)}</td>
              <td>${p.stockQuantity ?? 0} قطعة</td>
              <td><span class="bi-tag bi-tag-gray">${escapeHtml(p.category || 'عام')}</span></td>
            `;
            zeroTableBody.appendChild(tr);
          });
        }
      }
    }

    function renderTopProductsTable() {
      const topBody = document.getElementById('top-products-table-body');
      if (!topBody) return;

      const currentStats = aggregateOrderDataset(biState.filteredOrders);
      const prodsList = Object.values(currentStats.productsSoldMap);

      if (biState.productSortBy === 'rev') {
        prodsList.sort((a, b) => b.revenue - a.revenue);
      } else {
        prodsList.sort((a, b) => b.quantity - a.quantity);
      }

      const top10 = prodsList.slice(0, 10);
      if (top10.length === 0) {
        topBody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px;">لا توجد مبيعات مسجلة في هذا النطاق الزمني.</td></tr>';
        return;
      }

      topBody.innerHTML = '';
      top10.forEach((p, idx) => {
        const rankClass = idx === 0 ? 'bi-rank-1' : (idx === 1 ? 'bi-rank-2' : (idx === 2 ? 'bi-rank-3' : ''));
        // Find product in catalog for stock
        const catalogProd = biState.allProducts.find(cp => cp.id === p.id || cp.name === p.name);
        const stockQty = catalogProd ? (parseInt(catalogProd.stockQuantity, 10) || 0) : 'غير محدد';
        const isSoldOut = catalogProd ? catalogProd.isSoldOut : false;

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><span class="bi-rank ${rankClass}">${idx + 1}</span></td>
          <td style="font-weight:700; color:var(--bi-slate-900);">${escapeHtml(p.name)}</td>
          <td>${formatMoney(p.price)}</td>
          <td><span class="bi-tag bi-tag-blue">${p.quantity} قطعة</span></td>
          <td style="font-weight:700; color:var(--bi-primary-dark);">${formatMoney(p.revenue)}</td>
          <td>${stockQty}</td>
          <td>
            ${isSoldOut ? '<span class="bi-tag bi-tag-rose">نافد</span>' : '<span class="bi-tag bi-tag-emerald">متوفر</span>'}
          </td>
        `;
        topBody.appendChild(tr);
      });
    }

    // Render Customer Intelligence
    function renderCustomerIntelligence(curr) {
      const custs = Object.values(curr.customerOrdersMap);
      const uniqueCount = custs.length;
      let repeatCount = 0;

      custs.forEach(c => {
        if (c.ordersCount > 1) repeatCount++;
      });

      const repeatRate = uniqueCount > 0 ? ((repeatCount / uniqueCount) * 100) : 0;
      const avgSpend = uniqueCount > 0 ? (curr.activeOrdersValue / uniqueCount) : 0;

      document.getElementById('cust-unique-count').textContent = uniqueCount.toLocaleString();
      document.getElementById('cust-repeat-rate').textContent = `${repeatRate.toFixed(1)}%`;
      document.getElementById('cust-repeat-count').textContent = `${repeatCount} عميل اشترى أكثر من مرة`;
      document.getElementById('cust-avg-spend').textContent = formatMoney(avgSpend);

      // Top loyal customers table
      const topCustBody = document.getElementById('top-customers-table-body');
      if (topCustBody) {
        const sortedCusts = [...custs].sort((a, b) => b.totalSpent - a.totalSpent).slice(0, 10);
        if (sortedCusts.length === 0) {
          topCustBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:16px;">لا توجد بيانات عملاء في هذه الفترة.</td></tr>';
        } else {
          topCustBody.innerHTML = '';
          sortedCusts.forEach(c => {
            // Mask phone: 01012345678 -> 010****5678
            let maskedPhone = c.phone;
            if (maskedPhone.length >= 8) {
              const start = maskedPhone.slice(0, 3);
              const end = maskedPhone.slice(-4);
              maskedPhone = `${start}****${end}`;
            }

            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td style="font-weight:700; color:var(--bi-slate-900);">${escapeHtml(c.name)}</td>
              <td style="direction:ltr; text-align:right; font-family:monospace;">${escapeHtml(maskedPhone)}</td>
              <td><span class="bi-tag bi-tag-blue">${c.ordersCount} طلبات</span></td>
              <td style="font-weight:700; color:var(--bi-primary-dark);">${formatMoney(c.totalSpent)}</td>
              <td>${escapeHtml(c.governorate)}</td>
            `;
            topCustBody.appendChild(tr);
          });
        }
      }
    }

    // Render Marketing Section
    function renderMarketingSection(curr) {
      document.getElementById('mkt-pink-revenue').textContent = formatMoney(curr.pinkFridayRevenue);
      const share = curr.activeOrdersValue > 0 ? ((curr.pinkFridayRevenue / curr.activeOrdersValue) * 100).toFixed(1) : 0;
      document.getElementById('mkt-pink-share').textContent = `${share}% من إجمالي مبيعات الفترة`;

      document.getElementById('mkt-pink-orders').textContent = curr.pinkFridayOrdersCount;
      const orderShare = curr.activeOrderCount > 0 ? ((curr.pinkFridayOrdersCount / curr.activeOrderCount) * 100).toFixed(1) : 0;
      document.getElementById('mkt-pink-orders-pct').textContent = `${orderShare}% من مجموع الطلبات النشطة`;

      document.getElementById('mkt-promo-items').textContent = `${curr.pinkFridayUnitsCount} قطعة`;
    }

    // Render Charts
    function renderAllCharts(curr, prior, bounds) {
      if (typeof Chart === 'undefined') return;

      // 1. Overview Velocity Line Chart (Current vs Prior)
      renderVelocityChart(curr, prior, bounds);

      // 2. Overview Status Doughnut Chart
      renderStatusDonutChart(curr);

      // 3. Sales Tab: Stacked Revenue & Shipping Breakdown
      renderRevenueBreakdownChart(curr);

      // 4. Sales Tab: Delivered Revenue Trend
      renderDeliveredTrendChart(curr);

      // 5. Fulfillment Tab: Governorate Top 5 Bar Chart
      renderGovernorateBarChart(curr);

      // 6. Customers Tab: Retention Donut Chart
      renderCustomerSegmentChart(curr);
    }

    function renderVelocityChart(curr, prior, bounds) {
      const canvas = document.getElementById('overviewVelocityChart');
      if (!canvas) return;

      if (biState.charts.velocity) biState.charts.velocity.destroy();

      // Collect dates in current bounds
      const dates = [];
      const curMap = curr.dailyActiveMap;
      const curDates = Object.keys(curMap).sort();

      // If specific range, generate sequential dates
      let labels = [];
      let currentData = [];
      let priorData = [];

      if (curDates.length > 0) {
        labels = curDates.map(d => {
          const p = d.split('-');
          return p.length === 3 ? `${p[1]}/${p[2]}` : d;
        });
        currentData = curDates.map(d => curMap[d] || 0);

        // Align prior data sequentially
        const priorDates = Object.keys(prior.dailyActiveMap).sort();
        priorData = labels.map((_, idx) => {
          const pd = priorDates[idx];
          return pd ? (prior.dailyActiveMap[pd] || 0) : 0;
        });
      } else {
        labels = ['اليوم'];
        currentData = [0];
        priorData = [0];
      }

      biState.charts.velocity = new Chart(canvas, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'مبيعات الفترة الحالية',
              data: currentData,
              borderColor: '#db2777',
              backgroundColor: 'rgba(219, 39, 119, 0.08)',
              fill: true,
              tension: 0.3,
              pointRadius: 4,
              borderWidth: 2.5
            },
            {
              label: 'مبيعات الفترة السابقة المماثلة',
              data: priorData,
              borderColor: '#94a3b8',
              borderDash: [5, 5],
              backgroundColor: 'transparent',
              fill: false,
              tension: 0.3,
              pointRadius: 3,
              borderWidth: 2
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'top',
              rtl: true,
              labels: { font: { family: 'Cairo', size: 12 } }
            },
            tooltip: {
              rtl: true,
              callbacks: {
                label: ctx => ` ${ctx.dataset.label}: ${formatMoney(ctx.raw)}`
              }
            }
          },
          scales: {
            x: { grid: { display: false }, ticks: { font: { family: 'Cairo' } } },
            y: {
              beginAtZero: true,
              grid: { color: '#f1f5f9' },
              ticks: {
                font: { family: 'Cairo' },
                callback: val => formatMoney(val)
              }
            }
          }
        }
      });
    }

    function renderStatusDonutChart(curr) {
      const canvas = document.getElementById('overviewStatusChart');
      if (!canvas) return;

      if (biState.charts.status) biState.charts.status.destroy();

      const b = curr.statusBreakdown;
      const labels = ['جديد', 'قيد التجهيز', 'تم الشحن', 'تم التوصيل', 'ملغي'];
      const data = labels.map(l => b[l] || 0);
      const colors = ['#38bdf8', '#f59e0b', '#818cf8', '#10b981', '#ef4444'];

      biState.charts.status = new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: data,
            backgroundColor: colors,
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              rtl: true,
              labels: { font: { family: 'Cairo', size: 11 } }
            },
            tooltip: {
              rtl: true,
              callbacks: {
                label: ctx => {
                  const val = ctx.raw || 0;
                  const tot = ctx.dataset.data.reduce((a, b) => a + b, 0);
                  const pct = tot > 0 ? ((val / tot) * 100).toFixed(1) : 0;
                  return ` ${ctx.label}: ${val} طلب (${pct}%)`;
                }
              }
            }
          },
          cutout: '68%'
        }
      });
    }

    function renderRevenueBreakdownChart(curr) {
      const canvas = document.getElementById('revenueBreakdownBarChart');
      if (!canvas) return;

      if (biState.charts.revenueBreakdown) biState.charts.revenueBreakdown.destroy();

      const dates = Object.keys(curr.dailyActiveMap).sort();
      const labels = dates.map(d => {
        const p = d.split('-');
        return p.length === 3 ? `${p[1]}/${p[2]}` : d;
      });
      const subtotalData = dates.map(d => curr.dailySubtotalMap[d] || 0);
      const shippingData = dates.map(d => curr.dailyShippingMap[d] || 0);

      biState.charts.revenueBreakdown = new Chart(canvas, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'قيمة المنتجات (Subtotal)',
              data: subtotalData,
              backgroundColor: '#fe5d9f'
            },
            {
              label: 'رسوم الشحن (Shipping)',
              data: shippingData,
              backgroundColor: '#f59e0b'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { stacked: true, grid: { display: false }, ticks: { font: { family: 'Cairo' } } },
            y: {
              stacked: true,
              beginAtZero: true,
              grid: { color: '#f1f5f9' },
              ticks: { font: { family: 'Cairo' }, callback: val => formatMoney(val) }
            }
          },
          plugins: {
            legend: { rtl: true, position: 'top', labels: { font: { family: 'Cairo' } } },
            tooltip: { rtl: true, callbacks: { label: ctx => ` ${ctx.dataset.label}: ${formatMoney(ctx.raw)}` } }
          }
        }
      });
    }

    function renderDeliveredTrendChart(curr) {
      const canvas = document.getElementById('deliveredTrendChart');
      if (!canvas) return;

      if (biState.charts.deliveredTrend) biState.charts.deliveredTrend.destroy();

      const dates = Object.keys(curr.dailyDeliveredMap).sort();
      const labels = dates.map(d => {
        const p = d.split('-');
        return p.length === 3 ? `${p[1]}/${p[2]}` : d;
      });
      const data = dates.map(d => curr.dailyDeliveredMap[d] || 0);

      biState.charts.deliveredTrend = new Chart(canvas, {
        type: 'line',
        data: {
          labels: labels.length ? labels : ['لا توجد تسليمات'],
          datasets: [{
            label: 'إيرادات الطلبات المسلمة فعلياً',
            data: data.length ? data : [0],
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.1)',
            fill: true,
            tension: 0.35,
            pointRadius: 4,
            borderWidth: 2.5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { grid: { display: false }, ticks: { font: { family: 'Cairo' } } },
            y: {
              beginAtZero: true,
              grid: { color: '#f1f5f9' },
              ticks: { font: { family: 'Cairo' }, callback: val => formatMoney(val) }
            }
          },
          plugins: {
            legend: { display: false },
            tooltip: { rtl: true, callbacks: { label: ctx => ` ${formatMoney(ctx.raw)}` } }
          }
        }
      });
    }

    function renderGovernorateBarChart(curr) {
      const canvas = document.getElementById('governorateBarChart');
      if (!canvas) return;

      if (biState.charts.governorate) biState.charts.governorate.destroy();

      const sortedGovs = Object.values(curr.governorateMap).sort((a, b) => b.ordersCount - a.ordersCount).slice(0, 5);
      const labels = sortedGovs.map(g => g.name);
      const data = sortedGovs.map(g => g.ordersCount);

      biState.charts.governorate = new Chart(canvas, {
        type: 'bar',
        data: {
          labels: labels.length ? labels : ['لا توجد بيانات'],
          datasets: [{
            label: 'عدد الطلبات',
            data: data.length ? data : [0],
            backgroundColor: '#0284c7',
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          indexAxis: 'y',
          scales: {
            x: { beginAtZero: true, ticks: { font: { family: 'Cairo' } } },
            y: { ticks: { font: { family: 'Cairo' } } }
          },
          plugins: {
            legend: { display: false },
            tooltip: { rtl: true, callbacks: { label: ctx => ` ${ctx.raw} طلب` } }
          }
        }
      });
    }

    function renderCustomerSegmentChart(curr) {
      const canvas = document.getElementById('customerSegmentDonutChart');
      if (!canvas) return;

      if (biState.charts.customerSegment) biState.charts.customerSegment.destroy();

      const custs = Object.values(curr.customerOrdersMap);
      let singleCount = 0;
      let repeatCount = 0;

      custs.forEach(c => {
        if (c.ordersCount > 1) repeatCount++;
        else singleCount++;
      });

      biState.charts.customerSegment = new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: ['عملاء لمرة واحدة (One-Time)', 'عملاء متكررون (Repeat)'],
          datasets: [{
            data: [singleCount, repeatCount],
            backgroundColor: ['#94a3b8', '#db2777'],
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', rtl: true, labels: { font: { family: 'Cairo' } } },
            tooltip: {
              rtl: true,
              callbacks: {
                label: ctx => {
                  const tot = singleCount + repeatCount;
                  const pct = tot > 0 ? ((ctx.raw / tot) * 100).toFixed(1) : 0;
                  return ` ${ctx.label}: ${ctx.raw} عميل (${pct}%)`;
                }
              }
            }
          },
          cutout: '65%'
        }
      });
    }

    // ==========================================
    // EXPORT HELPERS (UTF-8 BOM FOR ARABIC EXCEL)
    // ==========================================
    function downloadCSV(filename, csvContent) {
      // Prepend UTF-8 BOM (\uFEFF)
      const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', filename);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    }

    function exportOrdersCSV() {
      if (biState.filteredOrders.length === 0) {
        alert('لا توجد طلبات لتصديرها في هذا النطاق الزمني');
        return;
      }

      let csv = 'رقم الطلب,كود الفاتورة,التاريخ (توقيت القاهرة),الحالة,اسم العميل,رقم الهاتف,المحافظة,المدينة,العنوان,إجمالي الطلب,مصاريف الشحن,عدد المنتجات\n';

      biState.filteredOrders.forEach(o => {
        const timeCairo = formatCairoDateTime(o.timestamp).replace(/,/g, ' ');
        const total = parseFloat(o.totalAmount || o.subtotal || 0);
        const shipping = parseFloat(o.shippingFee || 0);
        const prodCount = o.products ? Object.keys(o.products).length : 0;
        const cleanName = (o.name || '').replace(/,/g, ' ');
        const cleanPhone = (o.phone || '').replace(/,/g, ' ');
        const cleanGov = (o.governorate || '').replace(/,/g, ' ');
        const cleanCity = (o.city || '').replace(/,/g, ' ');
        const cleanAddress = (o.address || '').replace(/,/g, ' ');

        csv += `"${o.id}","${o.invoiceCode || ''}","${timeCairo}","${normalizeStatus(o.status)}","${cleanName}","${cleanPhone}","${cleanGov}","${cleanCity}","${cleanAddress}",${total},${shipping},${prodCount}\n`;
      });

      downloadCSV(`dandy_orders_${biState.currentPeriod}_${getCairoDateString(new Date())}.csv`, csv);
    }

    function exportProductsCSV() {
      const curr = aggregateOrderDataset(biState.filteredOrders);
      const prods = Object.values(curr.productsSoldMap);

      if (prods.length === 0) {
        alert('لا توجد مبيعات منتجات لتصديرها');
        return;
      }

      let csv = 'معرف المنتج,اسم المنتج,سعر القطعة,القطع المباعة,إجمالي المبيعات,المخزون المتبقي\n';
      prods.forEach(p => {
        const catalogProd = biState.allProducts.find(cp => cp.id === p.id || cp.name === p.name);
        const stockQty = catalogProd ? (catalogProd.stockQuantity ?? 0) : 0;
        const cleanName = (p.name || '').replace(/,/g, ' ');
        csv += `"${p.id}","${cleanName}",${p.price},${p.quantity},${p.revenue},${stockQty}\n`;
      });

      downloadCSV(`dandy_product_sales_${biState.currentPeriod}_${getCairoDateString(new Date())}.csv`, csv);
    }

    function exportGovernoratesCSV() {
      const curr = aggregateOrderDataset(biState.filteredOrders);
      const govs = Object.values(curr.governorateMap);

      let csv = 'المحافظة,عدد الطلبات,إجمالي الإيرادات,عدد الطلبات الملغاة\n';
      govs.forEach(g => {
        csv += `"${g.name}",${g.ordersCount},${g.totalRevenue},${g.cancelledCount}\n`;
      });

      downloadCSV(`dandy_governorates_${biState.currentPeriod}_${getCairoDateString(new Date())}.csv`, csv);
    }

    // Auto-init on page load
    document.addEventListener('DOMContentLoaded', () => {
      checkAdminAuth();
    });
  </script>
</BaseLayout>
