    function renderCustomProductsGridSection(sec) {
      let prods = [];
      if (sec.productSource === 'offers') {
        for (let key in globalProductsCache) {
          const p = globalProductsCache[key];
          if ((p.onSale || p.discount) && !p.isHidden) prods.push({ ...p, id: key });
        }
      } else if (sec.productSource === 'bestsellers') {
        for (let key in globalProductsCache) {
          const p = globalProductsCache[key];
          if (p.bestSeller && !p.isHidden) prods.push({ ...p, id: key });
        }
      } else if (sec.productSource === 'manual' && sec.manualProducts) {
        for (let key in sec.manualProducts) {
          if (sec.manualProducts[key] && globalProductsCache[key] && !globalProductsCache[key].isHidden) {
            prods.push({ ...globalProductsCache[key], id: key });
          }
        }
      } else {
        for (let key in globalProductsCache) {
          const p = globalProductsCache[key];
          if (!p.isHidden) prods.push({ ...p, id: key });
        }
      }

      const displayProds = prods.slice(0, sec.limit || 8);
      let cardsHtml = '';
      if (displayProds.length) {
        displayProds.forEach(p => {
          cardsHtml += buildProductCardHtml(p);
        });
      } else {
        cardsHtml = '<div style="grid-column:1/-1; text-align:center; padding:30px 0; color:var(--color-muted);">لا توجد منتجات متاحة بهذا القسم.</div>';
      }

      return `
