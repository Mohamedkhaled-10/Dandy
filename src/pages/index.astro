      const items = Array.isArray(sec.items) ? sec.items : [];
      let itemsHtml = '';
      items.forEach(item => {
        let iconHtml = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>';
        if (item.icon && item.icon.includes('<svg')) {
          iconHtml = item.icon;
        } else if (item.icon && item.icon.includes('fa-')) {
          iconHtml = `<i class="${item.icon}"></i>`;
        }

        itemsHtml += `
          <div class="trust-strip-item">
            <div class="trust-icon-box">${iconHtml}</div>
            <div class="trust-meta">
              <strong>${escapeHtml(item.title || '')}</strong>
              <p>${escapeHtml(item.desc || '')}</p>
            </div>
          </div>
        `;
      });

      return `
        <div class="home-container">
          <div class="trust-strip-inner">
            ${itemsHtml || '<p style="grid-column:1/-1; text-align:center; color:var(--color-muted);">أضيفي بطاقات الثقة</p>'}
          </div>
        </div>
      `;
    }

    function createCustomSectionElement(sec) {
      const secEl = document.createElement('section');
      secEl.id = sec.id;
      secEl.setAttribute('data-studio-section', sec.id);
      secEl.setAttribute('data-studio-title', sec.title || 'قسم مخصص');
      secEl.className = 'home-section scroll-reveal-up dynamic-custom-section is-revealed';

      let inner = '';
      if (sec.type === 'story') {
        inner = renderCustomStorySection(sec);
      } else if (sec.type === 'faq') {
        inner = renderCustomFaqSection(sec);
      } else if (sec.type === 'video') {
        inner = renderCustomVideoSection(sec);
      } else if (sec.type === 'gallery' || sec.type === 'imageGallery') {
        inner = renderCustomGallerySection(sec);
      } else if (sec.type === 'banner' || sec.type === 'promo') {
        inner = renderCustomBannerSection(sec);
      } else if (sec.type === 'products' || sec.type === 'grid') {
        inner = renderCustomProductsGridSection(sec);
      } else if (sec.type === 'trust') {
        inner = renderCustomTrustBadgesSection(sec);
      } else {
        inner = `<div class="home-container"><h2 class="section-main-title">${escapeHtml(sec.title || 'قسم مخصص')}</h2></div>`;
      }

      secEl.innerHTML = inner;

      // Attach studio inspection badge if in studio mode
      if (document.body.classList.contains('studio-preview-active')) {
        const title = sec.title || 'قسم مخصص';
        const badge = document.createElement('div');
        badge.className = 'studio-inspect-badge';
        badge.innerHTML = `<span class="dot"></span><span>تعديل: ${escapeHtml(title)}</span>`;
        secEl.appendChild(badge);

        secEl.addEventListener('click', (e) => {
          if (!document.body.classList.contains('studio-edit-mode')) return;
          if (e.target.closest('#homeLightbox') || e.target.closest('.lightbox-content')) return;

          e.preventDefault();
          e.stopPropagation();

          const sectionId = secEl.getAttribute('data-studio-section');
          document.querySelectorAll('[data-studio-section]').forEach(s => s.classList.remove('studio-active-section'));
          secEl.classList.add('studio-active-section');

          if (window.parent && window.parent !== window) {
            window.parent.postMessage({
              type: 'STUDIO_SECTION_CLICKED',
              sectionId: sectionId
            }, '*');
          }
        }, true);
      }

      return secEl;
    }

    function applySectionOrderAndVisibility(orderArray, visibilityMap, customSections) {
      const wrapper = document.querySelector('.homepage-wrapper');
      if (!wrapper) return;

      const customSectionsMap = {};
      if (Array.isArray(customSections)) {
        customSections.forEach(s => { if (s && s.id) customSectionsMap[s.id] = s; });
      } else if (customSections && typeof customSections === 'object') {
        for (let k in customSections) {
          const s = customSections[k];
          if (s) customSectionsMap[s.id || k] = s;
        }
      }

      // Reorder and inject sections
      if (Array.isArray(orderArray) && orderArray.length) {
        orderArray.forEach(key => {
          let secEl = wrapper.querySelector(`[data-studio-section="${key}"]`);
          
          // If it's a custom section that does not exist in DOM yet, create and insert it
          if (!secEl && customSectionsMap[key]) {
            secEl = createCustomSectionElement(customSectionsMap[key]);
            wrapper.appendChild(secEl);
          } else if (secEl && customSectionsMap[key]) {
            // Update existing custom section content
            const updatedEl = createCustomSectionElement(customSectionsMap[key]);
            secEl.replaceWith(updatedEl);
            secEl = updatedEl;
          }

          if (secEl) {
            wrapper.appendChild(secEl);
          }
        });
      }

      // Remove any custom section elements that are no longer in customSectionsMap or order
      const existingCustomEls = wrapper.querySelectorAll('.dynamic-custom-section');
      existingCustomEls.forEach(el => {
        const id = el.getAttribute('data-studio-section');
        if (id && (!customSectionsMap[id] || (orderArray && !orderArray.includes(id)))) {
          el.remove();
        }
      });

      // Adjust visibility
      if (visibilityMap && typeof visibilityMap === 'object') {
        for (const key in visibilityMap) {
          const secEl = wrapper.querySelector(`[data-studio-section="${key}"]`);
          if (secEl) {
            secEl.style.display = visibilityMap[key] === false ? 'none' : '';
          }
        }
      }

      if (window.DandyAnimationController) {
        window.DandyAnimationController.getInstance().refresh();
      }
    }

    /* --------------------------------------------------------------------------
       5. BLOG ARTICLES RENDERER (Firestore)
       -------------------------------------------------------------------------- */
    async function loadHomeBlog() {
      const container = document.getElementById('homeBlogContainer');
      if (!container) return;

      const firestore = window.firestore || (typeof firebase !== 'undefined' && firebase.firestore ? firebase.firestore() : null);
      if (!firestore) {
        document.getElementById('editorial-blog-section')?.style.setProperty('display', 'none');
        return;
      }

      try {
        const fetchPromise = firestore.collection('articles').orderBy('createdAt', 'desc').limit(3).get();
        const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('Firestore timeout')), 3500));
        const snapshot = await Promise.race([fetchPromise, timeoutPromise]);

        if (snapshot.empty) {
          document.getElementById('editorial-blog-section')?.style.setProperty('display', 'none');
          return;
        }

        let html = '';
        let validCount = 0;

        snapshot.forEach(doc => {
          const data = doc.data();
          if (data.status === 'draft') return;
          validCount++;

          const img = data.image || 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=600&q=80';
          const title = data.title || 'أسرار العناية بالجمال الطبيعي';
          const category = data.category || 'العناية بالبشرة';
          const excerpt = data.excerpt || (data.content ? data.content.replace(/<[^>]+>/g, '').substring(0, 110) + '...' : 'اكتشفي أفضل النصائح والوصفات الطبيعية للحفاظ على نضارة وإشراقة بشرتكِ.');
          const postLink = data.slug ? `/blog/${encodeURIComponent(data.slug)}` : `/post?id=${doc.id}`;

          html += `
            <a href="${postLink}" class="blog-journal-card">
              <div class="blog-card-thumb">
                <img src="${img}" alt="${escapeHtml(title)}" loading="lazy" />
              </div>
              <div class="blog-card-body">
                <span class="blog-meta-tag">${escapeHtml(category)}</span>
                <h3 class="blog-card-title">${escapeHtml(title)}</h3>
                <p class="blog-card-excerpt">${escapeHtml(excerpt)}</p>
                <span class="blog-card-link">
                  <span>اقرئي المقال</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                </span>
              </div>
            </a>
          `;
        });

        if (validCount > 0) {
          container.innerHTML = html;
          if (window.DandyAnimationController) {
            window.DandyAnimationController.getInstance().refresh();
          }
        } else {
          document.getElementById('editorial-blog-section')?.style.setProperty('display', 'none');
        }
      } catch (err) {
        console.warn("Home blog load failed:", err);
        document.getElementById('editorial-blog-section')?.style.setProperty('display', 'none');
      }
    }

    /* --------------------------------------------------------------------------
       6. REVIEWS RENDERER (Authentic Screenshots)
       -------------------------------------------------------------------------- */
    function renderReviews(reviews) {
      const container = document.getElementById('reviewsContainer');
      if (!container || !reviews || !reviews.length) return;

      let html = '';
      reviews.forEach(r => {
        if (!r.image) return;
        html += `
          <div class="review-screenshot-card" onclick="openLightbox('${r.image}')" title="انقري لتكبير صورة التجربة">
            <img src="${r.image}" alt="تجربة ورأي عميلة داندي" loading="lazy" />
            <div class="review-zoom-overlay">
              <div class="review-zoom-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              </div>
            </div>
          </div>
        `;
      });

      if (html) {
        container.innerHTML = html;
        if (window.DandyAnimationController) {
          window.DandyAnimationController.getInstance().refresh();
        }
      }
    }

    /* --------------------------------------------------------------------------
       7. LIGHTBOX CONTROLS
       -------------------------------------------------------------------------- */
    window.openLightbox = function(src) {
      const modal = document.getElementById('homeLightbox');
      const img = document.getElementById('homeLightboxImg');
      if (!modal || !img) return;
      img.src = src;
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function(e) {
      if (e && e.target && e.target.tagName === 'IMG') return; // Don't close if clicking image itself
      const modal = document.getElementById('homeLightbox');
      const img = document.getElementById('homeLightboxImg');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
        if (img) setTimeout(() => { img.src = ''; }, 250);
      }
    };

    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        window.closeLightbox();
      }
    });

    /* --------------------------------------------------------------------------
       8. ADD TO CART & BUSINESS LOGIC (100% Preserved)
       -------------------------------------------------------------------------- */
    window.addToCart = function(id, name, price, image, hasVariants, slug) {
      if (hasVariants) {
        const productLink = slug
          ? `/product/${encodeURIComponent(slug)}`
          : `/product?id=${id}`;
        window.location.href = productLink;
        return;
      }

      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      let exist = cart.findIndex(i => (i.productId || i.id) === id && (!i.selectedVariants || i.selectedVariants.length === 0) && !i.selectedVariant);
      if (exist !== -1) {
        cart[exist].quantity = (parseInt(cart[exist].quantity) || 0) + 1;
      } else {
        cart.push({ id, productId: id, name, price, image, quantity: 1 });
      }
      localStorage.setItem("cart", JSON.stringify(cart));

      // Facebook Pixel AddToCart event tracking
      if (typeof fbq === 'function') {
        fbq('track', 'AddToCart', {
          content_name: name,
          content_ids: [id],
          content_type: 'product',
          value: parseFloat(price) || 0,
          currency: 'EGP'
        });
      }

      // Update Header Cart Count Badge
      if (typeof window.updateSharedCartCount === 'function') {
        window.updateSharedCartCount();
      }

      // Modern Minimal Toast Notification
      showToastNotification(`تمت إضافة "${name}" إلى سلتكِ بنجاح`);
    };

    function showToastNotification(message) {
      const oldToast = document.getElementById('cart-toast-alert');
      if (oldToast) oldToast.remove();

      const toast = document.createElement('div');
      toast.id = 'cart-toast-alert';
      toast.setAttribute('style', `
        position: fixed;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%);
        background-color: var(--color-dust-grey-100, #2c2828);
        color: #ffffff;
        padding: 12px 24px;
        border-radius: 8px;
        font-family: var(--font-sans, 'Alexandria', 'Cairo', sans-serif);
        font-size: 0.85rem;
        font-weight: 500;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 8px 24px rgba(44,40,40,0.18);
        transition: opacity 0.25s ease, transform 0.25s ease;
      `);
      toast.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-rose-kiss-500, #fe5d9f)" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
        <span>${escapeHtml(message)}</span>
      `;
      document.body.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(-50%) translateY(8px)';
        setTimeout(() => toast.remove(), 250);
      }, 2500);
    }

    function escapeHtml(string) {
      if (!string) return '';
      return String(string)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    /* ==========================================================================
       HOMEPAGE STUDIO PREVIEW BRIDGE
       Enables live interactive editing, click-to-select, and viewport synchronization
       ========================================================================== */
    (function initStudioPreviewBridge() {
      const isStudio = new URLSearchParams(window.location.search).has('studio_preview') || window.self !== window.top;
      if (!isStudio) return;

      document.body.classList.add('studio-preview-active', 'studio-edit-mode');

      // Inject Studio Preview Styling
      const style = document.createElement('style');
      style.id = 'studio-preview-bridge-styles';
      style.textContent = `
        body.studio-preview-active {
          user-select: auto;
        }
        body.studio-edit-mode [data-studio-section] {
          position: relative;
          cursor: pointer;
          transition: outline 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
        }
        body.studio-edit-mode [data-studio-section]:hover {
          outline: 2px dashed #fe5d9f !important;
          outline-offset: -2px;
        }
        body.studio-edit-mode [data-studio-section].studio-active-section {
          outline: 3px solid #fe5d9f !important;
          outline-offset: -3px;
          box-shadow: 0 0 0 4px rgba(254, 93, 159, 0.25) !important;
        }
        .studio-inspect-badge {
          position: absolute;
          top: 10px;
          right: 14px;
          background: #111827;
          color: #ffffff;
          font-family: 'Cairo', sans-serif;
          font-size: 11px;
          font-weight: 700;
          padding: 4px 10px;
          border-radius: 6px;
          z-index: 9999;
          display: none;
          align-items: center;
          gap: 6px;
          box-shadow: 0 4px 14px rgba(0,0,0,0.18);
          pointer-events: none;
          direction: rtl;
        }
        .studio-inspect-badge span.dot {
          width: 7px;
          height: 7px;
          border-radius: 50%;
          background: #fe5d9f;
        }
        body.studio-edit-mode [data-studio-section]:hover > .studio-inspect-badge,
        body.studio-edit-mode [data-studio-section].studio-active-section > .studio-inspect-badge {
          display: flex;
        }
        /* Clean preview mode hides outlines */
        body.studio-preview-mode [data-studio-section] {
          outline: none !important;
          box-shadow: none !important;
          cursor: default;
        }
        body.studio-preview-mode .studio-inspect-badge {
          display: none !important;
        }
      `;
      document.head.appendChild(style);

      // Attach hover/click badges and click handlers to sections
      const sections = document.querySelectorAll('[data-studio-section]');
      sections.forEach(sec => {
        const title = sec.getAttribute('data-studio-title') || 'قسم بالصفحة الرئيسية';
        const badge = document.createElement('div');
        badge.className = 'studio-inspect-badge';
        badge.innerHTML = `<span class="dot"></span><span>تعديل: ${title}</span>`;
        sec.appendChild(badge);

        sec.addEventListener('click', (e) => {
          if (!document.body.classList.contains('studio-edit-mode')) return;
          // Don't intercept if lightbox or internal modal was clicked
          if (e.target.closest('#homeLightbox') || e.target.closest('.lightbox-content')) return;

          e.preventDefault();
          e.stopPropagation();

          const sectionId = sec.getAttribute('data-studio-section');
          highlightSection(sectionId);

          if (window.parent && window.parent !== window) {
            window.parent.postMessage({
              type: 'STUDIO_SECTION_CLICKED',
              sectionId: sectionId
            }, '*');
          }
        }, true);
      });

      function highlightSection(sectionId) {
        document.querySelectorAll('[data-studio-section]').forEach(s => s.classList.remove('studio-active-section'));
        if (!sectionId) return;
        const target = document.querySelector(`[data-studio-section="${sectionId}"]`);
        if (target) {
          target.classList.add('studio-active-section');
        }
      }

      function scrollToSection(sectionId) {
        const target = document.querySelector(`[data-studio-section="${sectionId}"]`);
        if (target) {
          highlightSection(sectionId);
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      // Handle messages from Studio Editor Parent
      window.addEventListener('message', (event) => {
        const data = event.data;
        if (!data || typeof data !== 'object') return;

        if (data.type === 'STUDIO_SELECT_SECTION') {
          scrollToSection(data.sectionId);
        } else if (data.type === 'STUDIO_SET_MODE') {
          if (data.mode === 'preview') {
            document.body.classList.remove('studio-edit-mode');
            document.body.classList.add('studio-preview-mode');
          } else {
            document.body.classList.remove('studio-preview-mode');
            document.body.classList.add('studio-edit-mode');
          }
        } else if (data.type === 'STUDIO_RELOAD') {
          loadHomepageDynamic();
          loadCategories();
        } else if (data.type === 'STUDIO_UPDATE_STATE') {
          // In-memory live update of components without requiring Firebase writes
          const state = data.state;
          if (!state) return;

          if (state.hero && state.hero.length) {
            renderHero(state.hero);
          }
          if (state.trust) {
            renderTrust(state.trust);
          }
          if (state.sections) {
            renderDynamicSections(state.sections);
          }
          if (state.promoBanner) {
            renderPromoBanner(state.promoBanner);
          }
          if (state.categories) {
            renderCategoriesList(state.categories);
          }
          if (state.reviews) {
            renderReviews(state.reviews);
          }
          if (state.sectionOrder || state.sectionsVisibility || state.customSections) {
            applySectionOrderAndVisibility(state.sectionOrder, state.sectionsVisibility, state.customSections);
          }
          if (window.DandyAnimationController) {
            window.DandyAnimationController.getInstance().refresh();
          }
        }
      });

      // Signal to Studio parent that preview is mounted
      if (window.parent && window.parent !== window) {
        window.parent.postMessage({ type: 'STUDIO_PREVIEW_READY' }, '*');
      }
    })();
  </script>
</BaseLayout>
