  <!-- ==========================================================================
       SCRIPTS: Preserving all Business Logic, Cart, Firebase & Pixel Tracking
       ========================================================================== -->
  <script is:inline>
    const db = window.db || (typeof firebase !== 'undefined' && firebase.database ? firebase.database() : null);
    let globalProductsCache = {};

    function initHomepage() {
      if (!db) {
        console.warn("Database not initialized yet");
        return;
      }

      // 1. Fetch products cache
      db.ref('products').once('value').then(snap => {
        if (snap.exists()) {
          globalProductsCache = snap.val();
        }
        // Load homepage dynamic layout
        loadHomepageDynamic();
      }).catch(err => {
        console.error("Products cache error:", err);
        loadHomepageDynamic();
      });

      // 2. Load Categories
      loadCategories();

      // 3. Load Blog Articles
      loadHomeBlog();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHomepage);
    } else {
      initHomepage();
    }

    function loadHomepageDynamic() {
      if (!db) return;

      db.ref('homepage').once('value').then(snap => {
        if (!snap.exists()) return;
        const data = snap.val();

        // 1. Hero
        if (data.dynamicHero && data.dynamicHero.length) {
          renderHero(data.dynamicHero);
        }

        // 2. Trust Strip
        if (data.trust) {
          renderTrust(data.trust);
        }

        // 3. Dynamic Product Sections (Primary & Secondary)
        if (data.dynamicSections) {
          renderDynamicSections(data.dynamicSections);
        } else {
          fallbackRenderSections();
        }

        // 4. Reviews
        if (data.dynamicReviews) {
          renderReviews(data.dynamicReviews);
        }
      }).catch(err => {
        console.error("Homepage dynamic load error:", err);
        fallbackRenderSections();
      });
    }

    /* --------------------------------------------------------------------------
       1. HERO RENDERER
       -------------------------------------------------------------------------- */
    function renderHero(slides) {
      const stage = document.getElementById('heroStage');
      const controls = document.getElementById('heroControls');
      if (!stage || !slides || !slides.length) return;

      let slidesHtml = '';
      let dotsHtml = '';

      slides.forEach((slide, idx) => {
        const isActive = idx === 0 ? 'active' : '';
        const title = slide.title || 'جمال طبيعي مستخلص بعناية فائقة';
        const subtitle = slide.subtitle || 'تركيبات مصرية طبيعية 100% غنية بخلاصات الزيوت العضوية لعناية متكاملة ببشرتكِ وشعركِ.';
        const btnText = slide.buttonText || 'تسوقي الآن';
        const btnLink = slide.link || '/all-products';
        const imgUrl = slide.image || 'https://i.postimg.cc/7Yt4TfBC/Whats-App-Image-2026-07-10-at-8-28-01-PM.jpg';

        slidesHtml += `
          <div class="hero-slide-item ${isActive}" data-slide-index="${idx}" style="background-image: url('${imgUrl}');">
            <div class="hero-text-card">
              <span class="hero-tagline">مستحضرات داندي الطبيعية • Dandy Cosmetics</span>
              <h1 class="hero-heading">${escapeHtml(title)}</h1>
              <p class="hero-desc">${escapeHtml(subtitle)}</p>
              <a href="${btnLink}" class="hero-primary-cta">
                <span>${escapeHtml(btnText)}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
              </a>
            </div>
          </div>
        `;

        dotsHtml += `<button type="button" class="hero-dot-indicator ${isActive}" data-index="${idx}" aria-label="شريحة ${idx + 1}"></button>`;
      });

      stage.innerHTML = slidesHtml;

      if (slides.length > 1 && controls) {
        controls.innerHTML = dotsHtml;
        controls.style.display = 'flex';

        let currentIndex = 0;
        let slideTimer;
        const slideItems = stage.querySelectorAll('.hero-slide-item');
        const dotItems = controls.querySelectorAll('.hero-dot-indicator');

        function showSlide(index) {
          if (!slideItems[currentIndex] || !slideItems[index]) return;
          slideItems[currentIndex].classList.remove('active');
          dotItems[currentIndex].classList.remove('active');
          currentIndex = index;
          slideItems[currentIndex].classList.add('active');
          dotItems[currentIndex].classList.add('active');
        }

        function nextSlide() {
          const nextIndex = (currentIndex + 1) % slideItems.length;
          showSlide(nextIndex);
        }

        dotItems.forEach(dot => {
          dot.addEventListener('click', (e) => {
            const idx = parseInt(e.target.getAttribute('data-index'), 10);
            showSlide(idx);
            resetTimer();
          });
        });

        function resetTimer() {
          clearInterval(slideTimer);
          const dur = (slides[currentIndex] && slides[currentIndex].duration) ? slides[currentIndex].duration * 1000 : 5000;
          slideTimer = setInterval(nextSlide, dur);
        }

        resetTimer();
      }
    }

    /* --------------------------------------------------------------------------
       2. TRUST STRIP RENDERER
       -------------------------------------------------------------------------- */
    function renderTrust(trustData) {
      const container = document.getElementById('trustStripContainer');
      if (!container || !trustData) return;

      const items = [trustData.item1, trustData.item2, trustData.item3].filter(Boolean);
      if (!items.length) return;

      const defaultIcons = [
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>',
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>'
      ];

      let html = '';
      items.forEach((item, idx) => {
        let iconHtml = defaultIcons[idx % defaultIcons.length];
        if (item.icon && item.icon.includes('<svg')) {
          iconHtml = item.icon;
        } else if (item.icon && item.icon.includes('fa-')) {
          iconHtml = `<i class="${item.icon}"></i>`;
        }

        html += `
          <div class="trust-strip-item">
            <div class="trust-icon-box">${iconHtml}</div>
            <div class="trust-meta">
              <strong>${escapeHtml(item.title || '')}</strong>
              <p>${escapeHtml(item.desc || '')}</p>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
    }

    /* --------------------------------------------------------------------------
       3. PRODUCT SECTIONS (Primary & Secondary)
       -------------------------------------------------------------------------- */
    function renderDynamicSections(sections) {
      if (!sections || !sections.length) {
        fallbackRenderSections();
        return;
      }

      const visibleSections = sections.filter(s => s.visible).sort((a, b) => (a.order || 0) - (b.order || 0));
      if (!visibleSections.length) {
        fallbackRenderSections();
        return;
      }

      // Section 1: Primary Section
      const sec1 = visibleSections[0];
      const prods1 = resolveSectionProducts(sec1);
      renderSectionGrid(
        'primaryProductsGrid',
        'primary-sec-title',
        'primary-sec-eyebrow',
        'primary-sec-link',
        sec1.title || 'العروض الخاصة',
        sec1.subtitle || 'عروض مميزة',
        sec1.type === 'offers' ? '/special-offers' : '/all-products',
        prods1
      );

      // Section 2: Secondary Section
      const sec2 = visibleSections[1] || visibleSections[0];
      if (visibleSections.length > 1) {
        const prods2 = resolveSectionProducts(sec2);
        renderSectionGrid(
          'secondaryProductsGrid',
          'secondary-sec-title',
          'secondary-sec-eyebrow',
          null,
          sec2.title || 'أحدث المنتجات',
          sec2.subtitle || 'تشكيلة مختارة',
          '/all-products',
          prods2
        );
      } else {
        fallbackSecondary();
      }
    }

    function resolveSectionProducts(sec) {
      let prods = [];
      if (!sec) return prods;

      if (sec.type === 'offers') {
        for (let key in globalProductsCache) {
          const p = globalProductsCache[key];
          if ((p.onSale || p.discount) && !p.isHidden) {
            prods.push({ ...p, id: key });
          }
        }
      } else if (sec.type === 'bestsellers') {
        for (let key in globalProductsCache) {
          const p = globalProductsCache[key];
          if (p.bestSeller && !p.isHidden) {
            prods.push({ ...p, id: key });
          }
        }
      } else if (sec.type === 'manual' && sec.manualProducts) {
        for (let key in sec.manualProducts) {
          if (sec.manualProducts[key] && globalProductsCache[key] && !globalProductsCache[key].isHidden) {
            prods.push({ ...globalProductsCache[key], id: key });
          }
        }
      }

      // Fallback if none found
      if (!prods.length) {
        for (let key in globalProductsCache) {
          const p = globalProductsCache[key];
          if (!p.isHidden) prods.push({ ...p, id: key });
        }
      }

      return prods.slice(0, 8);
    }

    function renderSectionGrid(gridId, titleId, eyebrowId, linkId, title, eyebrow, linkUrl, prods) {
      const grid = document.getElementById(gridId);
      const titleEl = document.getElementById(titleId);
      const eyebrowEl = document.getElementById(eyebrowId);
      const linkEl = linkId ? document.getElementById(linkId) : null;

      if (titleEl) titleEl.textContent = title;
      if (eyebrowEl && eyebrow) eyebrowEl.textContent = eyebrow;
      if (linkEl && linkUrl) linkEl.href = linkUrl;

      if (!grid) return;
      if (!prods.length) {
        grid.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:30px 0; color:var(--color-muted);">لا توجد منتجات متاحة حالياً.</div>';
        return;
      }

      let html = '';
      prods.forEach(prod => {
        html += buildProductCardHtml(prod);
      });
      grid.innerHTML = html;
    }

    function fallbackRenderSections() {
      let allProds = [];
      for (let key in globalProductsCache) {
        const p = globalProductsCache[key];
        if (!p.isHidden) allProds.push({ ...p, id: key });
      }

      const offers = allProds.filter(p => p.onSale || p.discount).slice(0, 8);
      const rest = allProds.filter(p => !p.onSale && !p.discount).slice(0, 8);

      renderSectionGrid(
        'primaryProductsGrid',
        'primary-sec-title',
        'primary-sec-eyebrow',
        'primary-sec-link',
        'العروض الخاصة',
        'عروض مميزة',
        '/special-offers',
        offers.length ? offers : allProds.slice(0, 8)
      );

      renderSectionGrid(
        'secondaryProductsGrid',
        'secondary-sec-title',
        'secondary-sec-eyebrow',
        null,
        'أحدث المنتجات',
        'تشكيلة مختارة',
        '/all-products',
        rest.length ? rest : allProds.slice(4, 12)
      );
    }

    function fallbackSecondary() {
      let prods = [];
      for (let key in globalProductsCache) {
        const p = globalProductsCache[key];
        if (!p.isHidden) prods.push({ ...p, id: key });
      }
      renderSectionGrid(
        'secondaryProductsGrid',
        'secondary-sec-title',
        'secondary-sec-eyebrow',
        null,
        'منتجات مميزة',
        'مختارات داندي',
        '/all-products',
        prods.slice(0, 8)
      );
    }

    // Wishlist Tracking
    window.userWishlistSet = window.userWishlistSet || new Set();

    function initWishlistTracking() {
      const auth = window.auth || (typeof firebase !== 'undefined' && firebase.auth ? firebase.auth() : null);
      if (!auth) return;

      auth.onAuthStateChanged(async (user) => {
        if (!user) {
          window.userWishlistSet.clear();
          updateWishlistUI();
          return;
        }

        try {
          if (!db) return;
          const snap = await db.ref('wishlists/' + user.uid).once('value');
          if (snap.exists()) {
            const val = snap.val() || {};
            window.userWishlistSet = new Set(Object.keys(val).filter(k => !!val[k]));
            updateWishlistUI();
          }
        } catch (e) {
          console.warn('Error loading wishlist set:', e);
        }
      });
    }

    function updateWishlistUI() {
      document.querySelectorAll('.btn-card-wishlist').forEach(btn => {
        const pid = btn.getAttribute('data-product-id');
        if (window.userWishlistSet.has(pid)) {
          btn.classList.add('active');
          const svg = btn.querySelector('svg');
          if (svg) svg.setAttribute('fill', 'currentColor');
        } else {
          btn.classList.remove('active');
          const svg = btn.querySelector('svg');
          if (svg) svg.setAttribute('fill', 'none');
        }
      });
    }

    window.toggleCardWishlist = async function(productId, btnEl) {
      const auth = window.auth || (typeof firebase !== 'undefined' && firebase.auth ? firebase.auth() : null);
      const user = auth ? auth.currentUser : null;

      if (!user) {
        showToast('سجّلي دخولك لحفظ المنتج في المفضلة');
        setTimeout(() => { window.location.href = '/account-login'; }, 1000);
        return;
      }

      const isFav = btnEl.classList.contains('active');
      const svg = btnEl.querySelector('svg');

      try {
        if (isFav) {
          await db.ref('wishlists/' + user.uid + '/' + productId).remove();
          window.userWishlistSet.delete(productId);
          btnEl.classList.remove('active');
          if (svg) svg.setAttribute('fill', 'none');
          showToast('تمت الإزالة من المفضلة');
        } else {
          await db.ref('wishlists/' + user.uid + '/' + productId).set(true);
          window.userWishlistSet.add(productId);
          btnEl.classList.add('active');
          if (svg) svg.setAttribute('fill', 'currentColor');
          showToast('تمت الإضافة إلى المفضلة');
        }
      } catch (err) {
        console.error('Error toggling wishlist:', err);
      }
    };

    initWishlistTracking();

    function buildProductCardHtml(prod) {
      const productLink = prod.slug
        ? `/product/${encodeURIComponent(prod.slug)}`
        : `/product?id=${prod.id}`;

      let badgeHtml = '';
      let priceHtml = `<span class="price-current">${prod.price} ج.م</span>`;

      if (prod.discount || prod.onSale) {
        const discountText = prod.discount ? `خصم ${prod.discount}%` : 'تخفيض';
        badgeHtml = `<span class="card-badge">${discountText}</span>`;
        if (prod.originalPrice) {
          priceHtml = `
            <span class="price-current">${prod.price} ج.م</span>
            <span class="price-old">${prod.originalPrice} ج.م</span>
          `;
        }
      }

      const hasVars = typeof hasSelectableVariants === 'function'
        ? hasSelectableVariants(prod)
        : (prod.hasVariants === true || prod.hasVariants === 'true');

      let actionBtn = '';
      if (hasVars) {
        actionBtn = `
          <button type="button" class="card-add-btn" onclick="event.stopPropagation(); window.location.href='${productLink}'">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            <span>اختاري الرائحة</span>
          </button>
        `;
      } else {
        const safeName = (prod.name || '').replace(/'/g, "\\'");
        actionBtn = `
          <button type="button" class="card-add-btn" onclick="event.stopPropagation(); addToCart('${prod.id}', '${safeName}', ${prod.price}, '${prod.image || ''}', false, '${prod.slug || ''}')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            <span>أضيفي للسلة</span>
          </button>
        `;
      }

      const isFavorited = window.userWishlistSet && window.userWishlistSet.has(prod.id);
      const heartActive = isFavorited ? 'active' : '';
      const heartFill = isFavorited ? 'currentColor' : 'none';

      return `
        <article class="modern-product-card" onclick="window.location.href='${productLink}'">
          <div class="card-image-box">
            ${badgeHtml}
            <button type="button" class="btn-card-wishlist ${heartActive}" data-product-id="${prod.id}" onclick="event.stopPropagation(); window.toggleCardWishlist('${prod.id}', this);" title="حفظ في المفضلة" aria-label="حفظ في المفضلة">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="${heartFill}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
            <img src="${prod.image || '/assets/images/logo.png'}" alt="${escapeHtml(prod.name || 'منتج داندي')}" loading="lazy" />
          </div>
          <div class="card-content-box">
            ${prod.category ? `<span class="card-category">${escapeHtml(prod.category)}</span>` : ''}
            <h3 class="card-title">${escapeHtml(prod.name || '')}</h3>
            <div class="card-price-row">
              ${priceHtml}
            </div>
            ${actionBtn}
          </div>
        </article>
      `;
    }

    /* --------------------------------------------------------------------------
       4. CATEGORIES RENDERER
       -------------------------------------------------------------------------- */
    function loadCategories() {
      if (!db) return;
      const catContainer = document.getElementById('dynamic-categories');
      if (!catContainer) return;

      db.ref('categories').once('value').then(snap => {
        if (!snap.exists()) {
          catContainer.innerHTML = '<div style="grid-column:1/-1; text-align:center; color:var(--color-muted);">لا توجد أقسام مسجلة.</div>';
          return;
        }

        let html = '';
        snap.forEach(child => {
          const c = child.val();
          html += `
            <a href="/all-products?category=${encodeURIComponent(c.name)}" class="category-tile">
              <div class="category-tile-thumb">
                <img src="${c.image || '/assets/images/logo.png'}" alt="${escapeHtml(c.name)} - داندي" loading="lazy" />
              </div>
              <div class="category-tile-label">
                <span class="category-tile-name">${escapeHtml(c.name)}</span>
                ${c.count ? `<span class="category-tile-count">${c.count} منتجات</span>` : ''}
              </div>
            </a>
          `;
        });

        catContainer.innerHTML = html;
      }).catch(err => {
        console.error("Categories error:", err);
      });
    }

    /* --------------------------------------------------------------------------
       5. BLOG ARTICLES RENDERER (Firestore)
       -------------------------------------------------------------------------- */
    async function loadHomeBlog() {
      const container = document.getElementById('homeBlogContainer');
      if (!container) return;

      const firestore = window.firestore || (typeof firebase !== 'undefined' && firebase.firestore ? firebase.firestore() : null);
      if (!firestore) {
        document.getElementById('editorial-blog-section')?.style.setProperty('display', 'none');
        return;
      }

      try {
        const fetchPromise = firestore.collection('articles').orderBy('createdAt', 'desc').limit(3).get();
        const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('Firestore timeout')), 3500));
        const snapshot = await Promise.race([fetchPromise, timeoutPromise]);

        if (snapshot.empty) {
          document.getElementById('editorial-blog-section')?.style.setProperty('display', 'none');
          return;
        }

        let html = '';
        let validCount = 0;

        snapshot.forEach(doc => {
          const data = doc.data();
          if (data.status === 'draft') return;
          validCount++;

          const img = data.image || 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=600&q=80';
          const title = data.title || 'أسرار العناية بالجمال الطبيعي';
          const category = data.category || 'العناية بالبشرة';
          const excerpt = data.excerpt || (data.content ? data.content.replace(/<[^>]+>/g, '').substring(0, 110) + '...' : 'اكتشفي أفضل النصائح والوصفات الطبيعية للحفاظ على نضارة وإشراقة بشرتكِ.');
          const postLink = data.slug ? `/blog/${encodeURIComponent(data.slug)}` : `/post?id=${doc.id}`;

          html += `
            <a href="${postLink}" class="blog-journal-card">
              <div class="blog-card-thumb">
                <img src="${img}" alt="${escapeHtml(title)}" loading="lazy" />
              </div>
              <div class="blog-card-body">
                <span class="blog-meta-tag">${escapeHtml(category)}</span>
                <h3 class="blog-card-title">${escapeHtml(title)}</h3>
                <p class="blog-card-excerpt">${escapeHtml(excerpt)}</p>
                <span class="blog-card-link">
                  <span>اقرئي المقال</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                </span>
              </div>
            </a>
          `;
        });

        if (validCount > 0) {
          container.innerHTML = html;
        } else {
          document.getElementById('editorial-blog-section')?.style.setProperty('display', 'none');
        }
      } catch (err) {
        console.warn("Home blog load failed:", err);
        document.getElementById('editorial-blog-section')?.style.setProperty('display', 'none');
      }
    }

    /* --------------------------------------------------------------------------
       6. REVIEWS RENDERER (Authentic Screenshots)
       -------------------------------------------------------------------------- */
    function renderReviews(reviews) {
      const container = document.getElementById('reviewsContainer');
      if (!container || !reviews || !reviews.length) return;

      let html = '';
      reviews.forEach(r => {
        if (!r.image) return;
        html += `
          <div class="review-screenshot-card" onclick="openLightbox('${r.image}')" title="انقري لتكبير صورة التجربة">
            <img src="${r.image}" alt="تجربة ورأي عميلة داندي" loading="lazy" />
            <div class="review-zoom-overlay">
              <div class="review-zoom-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              </div>
            </div>
          </div>
        `;
      });

      if (html) {
        container.innerHTML = html;
      }
    }

    /* --------------------------------------------------------------------------
       7. LIGHTBOX CONTROLS
       -------------------------------------------------------------------------- */
    window.openLightbox = function(src) {
      const modal = document.getElementById('homeLightbox');
      const img = document.getElementById('homeLightboxImg');
      if (!modal || !img) return;
      img.src = src;
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function(e) {
      if (e && e.target && e.target.tagName === 'IMG') return; // Don't close if clicking image itself
      const modal = document.getElementById('homeLightbox');
      const img = document.getElementById('homeLightboxImg');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
        if (img) setTimeout(() => { img.src = ''; }, 250);
      }
    };

    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        window.closeLightbox();
      }
    });

    /* --------------------------------------------------------------------------
       8. ADD TO CART & BUSINESS LOGIC (100% Preserved)
       -------------------------------------------------------------------------- */
    window.addToCart = function(id, name, price, image, hasVariants, slug) {
      if (hasVariants) {
        const productLink = slug
          ? `/product/${encodeURIComponent(slug)}`
          : `/product?id=${id}`;
        window.location.href = productLink;
        return;
      }

      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      let exist = cart.findIndex(i => (i.productId || i.id) === id && (!i.selectedVariants || i.selectedVariants.length === 0) && !i.selectedVariant);
      if (exist !== -1) {
        cart[exist].quantity = (parseInt(cart[exist].quantity) || 0) + 1;
      } else {
        cart.push({ id, productId: id, name, price, image, quantity: 1 });
      }
      localStorage.setItem("cart", JSON.stringify(cart));

      // Facebook Pixel AddToCart event tracking
      if (typeof fbq === 'function') {
        fbq('track', 'AddToCart', {
          content_name: name,
          content_ids: [id],
          content_type: 'product',
          value: parseFloat(price) || 0,
          currency: 'EGP'
        });
      }

      // Update Header Cart Count Badge
      if (typeof window.updateSharedCartCount === 'function') {
        window.updateSharedCartCount();
      }

      // Modern Minimal Toast Notification
      showToastNotification(`تمت إضافة "${name}" إلى سلتكِ بنجاح`);
    };

    function showToastNotification(message) {
      const oldToast = document.getElementById('cart-toast-alert');
      if (oldToast) oldToast.remove();

      const toast = document.createElement('div');
      toast.id = 'cart-toast-alert';
      toast.setAttribute('style', `
        position: fixed;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%);
        background-color: #1c1917;
        color: #ffffff;
        padding: 12px 24px;
        border-radius: 8px;
        font-family: var(--font-sans, 'Alexandria', 'Cairo', sans-serif);
        font-size: 0.85rem;
        font-weight: 500;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.18);
        transition: opacity 0.25s ease, transform 0.25s ease;
      `);
      toast.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#db2777" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
        <span>${escapeHtml(message)}</span>
      `;
      document.body.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(-50%) translateY(8px)';
        setTimeout(() => toast.remove(), 250);
      }, 2500);
    }

    function escapeHtml(string) {
      if (!string) return '';
      return String(string)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</BaseLayout>
