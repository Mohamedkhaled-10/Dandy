---
import BaseLayout from '../layouts/BaseLayout.astro';
const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<BaseLayout
  title="تسجيل دخول الإدارة | Dandy"
  description="بوابة تسجيل الدخول الآمن لمشرفي وموظفي متجر داندي للتجميل"
  robots="noindex, nofollow"
>
  <slot name="head" slot="head">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style is:global>
      .login-container {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding-top: 120px;
        padding-bottom: 60px;
      }

      .login-box {
        background: var(--color-surface);
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-lg);
        padding: 40px;
        width: 100%;
        max-width: 440px;
        box-shadow: var(--shadow-lg);
        text-align: center;
      }

      .login-box h2 {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--color-primary);
        margin-bottom: 8px;
      }

      .login-box p {
        color: var(--color-muted);
        font-size: 0.95rem;
        margin-bottom: 24px;
      }

      .form-group {
        text-align: right;
        margin-bottom: 20px;
      }

      .form-group label {
        display: block;
        font-weight: 700;
        margin-bottom: 6px;
        color: var(--color-primary);
        font-size: 0.9rem;
      }

      .form-group input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid var(--border-light);
        border-radius: var(--border-radius-sm);
        font-size: 0.95rem;
        outline: none;
        transition: var(--transition-fast);
      }

      .form-group input:focus {
        border-color: var(--color-blush);
        box-shadow: 0 0 0 3px rgba(217, 141, 153, 0.15);
      }

      .btn-login {
        width: 100%;
        padding: 14px;
        background: var(--color-blush);
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 99px;
        font-size: 1rem;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(217, 141, 153, 0.2);
        transition: var(--transition-smooth);
      }

      .btn-login:hover {
        background: var(--color-primary);
      }
    </style>
  </slot>

  <main class="login-container container">
    <div class="login-box">
      <i class="fas fa-user-shield" style="font-size:3rem; color:var(--color-blush); margin-bottom:16px;"></i>
      <h2>الدخول للوحة العمليات</h2>
      <p>مخصص لمشرفي وموظفي متجر داندي للتجميل</p>

      <div id="adminOnlyNotice" style="display:none; margin-bottom:20px; padding:12px 14px; background:#fef2f2; border:1px solid #fecaca; border-radius:8px; color:#991b1b; font-size:0.88rem; text-align:right; line-height:1.6;">
        <i class="fas fa-exclamation-triangle" style="margin-left:6px; color:#dc2626;"></i>
        <strong>تنبيه للمستخدم:</strong> هذه البوابة مخصصة لإدارة المتجر فقط. لعملاء داندي، يرجى <a href="/account-login" style="color:#b91c1c; text-decoration:underline; font-weight:700;">تسجيل الدخول من بوابة حساب العميل هنا</a>.
      </div>

      <form id="loginForm">
        <div class="form-group">
          <label for="l-email">البريد الإلكتروني المعتمد</label>
          <input type="email" id="l-email" placeholder="admin@dandy.com" required />
        </div>

        <div class="form-group" style="position: relative;">
          <label for="l-pass">كلمة المرور الحزامية</label>
          <input type="password" id="l-pass" placeholder="••••••••" required />
        </div>

        <!-- التحقق الأمني التلقائي عبر Cloudflare Turnstile -->
        <div class="login-turnstile-wrap" style="margin: 16px 0; display: flex; justify-content: center;">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
        </div>

        <button type="submit" id="adminLoginBtn" class="btn-login" style="margin-top: 10px;">تسجيل الدخول الآمن</button>
      </form>
    </div>
  </main>

  <script is:inline>
    const auth = window.auth || (typeof firebase !== 'undefined' ? firebase.auth() : null);

    if (auth) {
      // Active check redirect if already signed in
      auth.onAuthStateChanged(async user => {
        if (user) {
          if (user.email && user.email.toLowerCase() === 'admin@dandy.com') {
            window.location.href = '/dashboard';
          } else {
            // Non-admin user detected: sign out immediately and show warning
            try {
              await auth.signOut();
            } catch (e) {
              console.warn('Sign-out notice:', e);
            }
            const notice = document.getElementById('adminOnlyNotice');
            if (notice) {
              notice.style.display = 'block';
            }
          }
        }
      });

      // Handle secure submit login credentials
      document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();

        const email = document.getElementById('l-email').value.trim();
        const password = document.getElementById('l-pass').value.trim();
        const submitBtn = document.getElementById('adminLoginBtn');

        // جلب توكن كابتشا Cloudflare Turnstile
        let turnstileToken = '';
        if (typeof turnstile !== 'undefined') {
          try { turnstileToken = turnstile.getResponse() || ''; } catch(e) {}
        }
        if (!turnstileToken) {
          const input = document.querySelector('[name="cf-turnstile-response"]');
          if (input) turnstileToken = input.value;
        }

        if (!turnstileToken) {
          alert('يرجى إكمال اختبار التحقق البشري (CAPTCHA) أولاً.');
          return;
        }

        if (email.toLowerCase() !== 'admin@dandy.com') {
          const notice = document.getElementById('adminOnlyNotice');
          if (notice) {
            notice.style.display = 'block';
          }
          alert('هذه البوابة مخصصة لمشرفي النظام فقط. لعملاء داندي، يرجى تسجيل الدخول من صفحة حساب العميل.');
          window.location.href = '/account-login';
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'جاري التحقق...';
        }

        try {
          // التحقق السيرفري من الكابتشا ومعدل المحاولات
          const verifyRes = await fetch('/api/verify-turnstile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: turnstileToken, action: 'admin-login', email })
          });

          const verifyData = await verifyRes.json().catch(() => ({}));
          if (!verifyRes.ok || !verifyData.success) {
            alert(verifyData.message || 'فشل التحقق الأمني من الكابتشا. يرجى المحاولة مرة أخرى.');
            if (typeof turnstile !== 'undefined') {
              try { turnstile.reset(); } catch(e) {}
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'تسجيل الدخول الآمن';
            }
            return;
          }

          await auth.signInWithEmailAndPassword(email, password);
          // Automatic redirect triggers onAuthStateChanged above
        } catch (err) {
          console.error('Admin login error:', err);

          // تسجيل المحاولة الفاشلة في السيرفر
          fetch('/api/verify-turnstile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'report-failed-login',
              email,
              reason: err.code || 'invalid_admin_credentials'
            })
          }).catch(() => {});

          if (typeof turnstile !== 'undefined') {
            try { turnstile.reset(); } catch(e) {}
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'تسجيل الدخول الآمن';
          }
          alert('بيانات الدخول خاطئة أو غير مسجلة! نرجو مراجعة مسؤول النظام للتحقق.');
        }
      });
    }
  </script>
</BaseLayout>
