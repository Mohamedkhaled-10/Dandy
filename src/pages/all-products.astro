        const path = document.createElementNS ? document.createElementNS(ns, 'path') : document.createElement('path');
        path.setAttribute('d', 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z');
        svg.appendChild(path);
      } else if (type === 'bag') {
        const p1 = document.createElementNS ? document.createElementNS(ns, 'path') : document.createElement('path');
        p1.setAttribute('d', 'M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z');
        const p2 = document.createElementNS ? document.createElementNS(ns, 'path') : document.createElement('path');
        p2.setAttribute('d', 'M3 6h18');
