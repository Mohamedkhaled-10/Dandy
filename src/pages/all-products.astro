        lbl.textContent = 'اختاري الرائحة';
        varLink.appendChild(lbl);
        contentBox.appendChild(varLink);
      } else {
        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'card-add-btn add-cart-btn';
        addBtn.setAttribute('data-action', 'quick-add');
        addBtn.setAttribute('data-product-id', entry.id);
        addBtn.appendChild(createStaticSvgIcon('bag'));
        const lbl = document.createElement('span');
        lbl.textContent = 'أضيفي للسلة';
        addBtn.appendChild(lbl);
        contentBox.appendChild(addBtn);
      }

      article.appendChild(contentBox);
      return article;
    }

    function compareCatalogDomNodes(a, b, sortValue) {
      const idxA = parseInt(a.getAttribute('data-index') || '0', 10);
      const idxB = parseInt(b.getAttribute('data-index') || '0', 10);

      if (sortValue === 'price-asc') {
        const priceA = parseFloat(a.getAttribute('data-price') || '0');
        const priceB = parseFloat(b.getAttribute('data-price') || '0');
        if (priceA !== priceB) return priceA - priceB;
        return idxA - idxB;
      }

      if (sortValue === 'price-desc') {
        const priceA = parseFloat(a.getAttribute('data-price') || '0');
        const priceB = parseFloat(b.getAttribute('data-price') || '0');
        if (priceB !== priceA) return priceB - priceA;
        return idxA - idxB;
      }

      if (sortValue === 'rating-desc') {
        const revA = parseInt(a.getAttribute('data-reviews') || '0', 10);
        const revB = parseInt(b.getAttribute('data-reviews') || '0', 10);
        const rateA = revA > 0 ? parseFloat(a.getAttribute('data-rating') || '0') : 0;
        const rateB = revB > 0 ? parseFloat(b.getAttribute('data-rating') || '0') : 0;
        // Reviewed products strictly rank ahead of unreviewed products
        if ((revA > 0) !== (revB > 0)) return revB > 0 ? 1 : -1;
        if (rateB !== rateA) return rateB - rateA;
        if (revB !== revA) return revB - revA;
        return idxA - idxB;
      }

      if (sortValue === 'reviews-desc') {
        const revA = parseInt(a.getAttribute('data-reviews') || '0', 10);
        const revB = parseInt(b.getAttribute('data-reviews') || '0', 10);
        if (revB !== revA) return revB - revA;
        const rateA = revA > 0 ? parseFloat(a.getAttribute('data-rating') || '0') : 0;
        const rateB = revB > 0 ? parseFloat(b.getAttribute('data-rating') || '0') : 0;
        if (rateB !== rateA) return rateB - rateA;
        return idxA - idxB;
      }

      if (sortValue === 'featured') {
        const bestA = a.getAttribute('data-bestseller') === 'true' ? 1 : 0;
        const bestB = b.getAttribute('data-bestseller') === 'true' ? 1 : 0;
        if (bestB !== bestA) return bestB - bestA;
        return idxA - idxB;
      }

      return idxA - idxB;
    }

    function applyPaginationToProducts() {
      const container = document.getElementById('productContainer');
      if (!container) return;

      const allCards = Array.from(container.querySelectorAll('.product'));
      const matchingCards = allCards.filter((card) => !card.classList.contains('hidden'));
      const totalMatching = matchingCards.length;

      const maxPages = Math.max(1, Math.ceil(totalMatching / PAGE_SIZE));
      if (currentPage > maxPages) currentPage = maxPages;
      if (currentPage < 1) currentPage = 1;

      const visibleLimit = currentPage * PAGE_SIZE;

      matchingCards.forEach((card, idx) => {
        if (idx < visibleLimit) {
          card.classList.remove('batch-hidden');
          card.style.display = '';
        } else {
          card.classList.add('batch-hidden');
          card.style.display = 'none';
        }
      });

      const shownCount = Math.min(visibleLimit, totalMatching);
      const paginationWrap = document.getElementById('catalog-pagination');
      const paginationText = document.getElementById('pagination-status-text');
      const loadMoreBtn = document.getElementById('load-more-btn');
      const showingSummary = document.getElementById('showing-batch-summary');

      if (showingSummary) {
        showingSummary.textContent = totalMatching > PAGE_SIZE && shownCount < totalMatching
          ? `(معروض ${shownCount})`
          : '';
      }

      if (paginationWrap) {
        if (totalMatching > PAGE_SIZE && shownCount < totalMatching) {
          paginationWrap.style.display = 'flex';
          if (paginationText) {
            paginationText.textContent = `معروض ${shownCount} من أصل ${totalMatching} منتج`;
          }
          if (loadMoreBtn) {
            const remaining = totalMatching - shownCount;
            const nextBatch = Math.min(PAGE_SIZE, remaining);
            const span = loadMoreBtn.querySelector('span');
            if (span) span.textContent = `عرض المزيد (${nextBatch})`;
          }
        } else {
          paginationWrap.style.display = 'none';
        }
      }
    }

    window.sortProductsDOM = function() {
      const container = document.getElementById('productContainer');
      if (!container) return;
      const sortSelect = document.getElementById('sort-select');
      const sortValue = sortSelect ? sortSelect.value : 'default';

      const products = Array.from(container.querySelectorAll('.product'));
      if (products.length === 0) return;

      products.sort((a, b) => compareCatalogDomNodes(a, b, sortValue));
      products.forEach((p) => container.appendChild(p));
      applyPaginationToProducts();
    };

    function renderActiveChips(categoryFilters, statusFilters, query, priceState, minRating) {
      const chipsBar = document.getElementById('active-chips-bar');
      const chipsList = document.getElementById('active-chips-list');
      if (!chipsBar || !chipsList) return;

      const categoryLabels = {
        'skin care': 'العناية بالبشرة',
        'hair care': 'العناية بالشعر',
        'body care': 'العناية بالجسم',
        'perfume': 'العطور والمعطرات'
      };

      const statusLabels = {
        'offers': 'عروض وتخفيضات',
        'bestseller': 'الأكثر مبيعاً'
      };

      const chips = [];

      categoryFilters.forEach((val) => {
        chips.push({
          type: 'category',
          value: val,
          label: categoryLabels[val] || val
        });
      });

      statusFilters.forEach((val) => {
        chips.push({
          type: 'status',
          value: val,
          label: statusLabels[val] || val
        });
      });

      if (priceState && priceState.isValidRange && priceState.hasBounds) {
        if (priceState.minPrice !== null) {
          chips.push({
            type: 'minPrice',
            value: String(priceState.minPrice),
            label: `من ${priceState.minPrice} ج.م`
          });
        }
        if (priceState.maxPrice !== null) {
          chips.push({
            type: 'maxPrice',
            value: String(priceState.maxPrice),
            label: `حتى ${priceState.maxPrice} ج.م`
          });
        }
      }

      if (minRating !== null) {
        chips.push({
          type: 'minRating',
          value: String(minRating),
          label: minRating === 5 ? '5 نجوم فقط' : `${minRating} نجوم فأكثر`
        });
      }

      if (query) {
        chips.push({
          type: 'search',
          value: query,
          label: `بحث: "${query}"`
        });
      }

      if (chips.length === 0) {
        chipsBar.style.display = 'none';
        chipsList.innerHTML = '';
        return;
      }

      chipsBar.style.display = 'flex';
      chipsList.innerHTML = '';
      chips.forEach((chip) => {
        const chipEl = document.createElement('span');
        chipEl.className = 'filter-chip';

        const labelEl = document.createElement('span');
        labelEl.textContent = chip.label;

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'chip-remove-btn';
        removeBtn.title = 'إزالة الفلتر';
        removeBtn.setAttribute('aria-label', `إزالة فلتر ${chip.label}`);
        removeBtn.dataset.filterType = chip.type;
        removeBtn.dataset.filterValue = chip.value;
        const icon = document.createElement('i');
        icon.className = 'fas fa-times';
        icon.setAttribute('aria-hidden', 'true');
        removeBtn.appendChild(icon);
        removeBtn.addEventListener('click', () => {
          window.removeFilterChip(chip.type, chip.value);
        });

        chipEl.appendChild(labelEl);
        chipEl.appendChild(removeBtn);
        chipsList.appendChild(chipEl);
      });
    }

    window.removeFilterChip = function(type, value) {
      if (type === 'category' || type === 'status') {
        const selector = type === 'category' ? '#category-filters' : '#status-filters';
        const chk = Array.from(document.querySelectorAll(`${selector} input[type="checkbox"]`))
          .find((c) => c.value.toLowerCase() === String(value || '').toLowerCase());
        if (chk) chk.checked = false;
      } else if (type === 'search') {
        const sinp = document.getElementById('search-input');
        if (sinp) sinp.value = '';
        const sbox = document.getElementById('search-suggestions');
        if (sbox) sbox.style.display = 'none';
      } else if (type === 'minPrice') {
        const minInp = document.getElementById('min-price-input');
        if (minInp) minInp.value = '';
      } else if (type === 'maxPrice') {
        const maxInp = document.getElementById('max-price-input');
        if (maxInp) maxInp.value = '';
      } else if (type === 'minRating') {
        const allRadio = Array.from(document.querySelectorAll('#rating-filters input[type="radio"]'))
          .find((r) => r.value === '');
        if (allRadio) allRadio.checked = true;
      }

      currentPage = 1;
      window.applyFiltersAndSort();
    };

    function updateEmptyState(visibleCount, totalCount) {
      const container = document.getElementById('productContainer');
      if (!container) return;

      let emptyEl = document.getElementById('empty-products-state');

      if (visibleCount === 0 && totalCount > 0) {
        if (!emptyEl) {
          emptyEl = document.createElement('div');
          emptyEl.id = 'empty-products-state';
          emptyEl.className = 'empty-products-state';

          const iconWrap = document.createElement('div');
          iconWrap.className = 'empty-icon-wrap';
          iconWrap.setAttribute('aria-hidden', 'true');
          const icon = document.createElement('i');
          icon.className = 'fas fa-search';
          iconWrap.appendChild(icon);

          const heading = document.createElement('h3');
          heading.textContent = 'لم نجد أي منتجات تطابق اختياراتكِ';

          const desc = document.createElement('p');
          desc.textContent = 'جرّبي إزالة بعض الفلاتر أو استخدام كلمات بحث مختلفة للعثور على ما تبحثين عنه في داندي.';

          const resetBtn = document.createElement('button');
          resetBtn.type = 'button';
          resetBtn.className = 'btn-reset-filters';
          const redoIcon = document.createElement('i');
