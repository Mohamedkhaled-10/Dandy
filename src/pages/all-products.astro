    function updatePriceFeedbackUI(priceState) {
      const errEl = document.getElementById('price-range-error');
      const summaryEl = document.getElementById('price-range-summary');

      if (!priceState.isValidRange && priceState.error) {
        if (errEl) {
          errEl.textContent = priceState.error;
          errEl.style.display = 'block';
        }
        if (summaryEl) {
          summaryEl.style.display = 'none';
          summaryEl.textContent = '';
        }
        return;
      }

      if (errEl) {
        errEl.style.display = 'none';
        errEl.textContent = '';
      }

      if (summaryEl) {
        if (priceState.minPrice !== null && priceState.maxPrice !== null) {
          summaryEl.textContent = `النطاق المحدد: ${priceState.minPrice} – ${priceState.maxPrice} ج.م`;
          summaryEl.style.display = 'block';
        } else if (priceState.minPrice !== null) {
          summaryEl.textContent = `السعر من ${priceState.minPrice} ج.م فأكثر`;
          summaryEl.style.display = 'block';
        } else if (priceState.maxPrice !== null) {
          summaryEl.textContent = `السعر حتى ${priceState.maxPrice} ج.م`;
          summaryEl.style.display = 'block';
        } else {
          summaryEl.textContent = '';
          summaryEl.style.display = 'none';
        }
      }
