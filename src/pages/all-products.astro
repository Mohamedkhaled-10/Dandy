        p3.setAttribute('d', 'M16 10a4 4 0 01-8 0');
        svg.appendChild(p1);
        svg.appendChild(p2);
        svg.appendChild(p3);
      } else if (type === 'variant') {
        const p1 = document.createElementNS ? document.createElementNS(ns, 'path') : document.createElement('path');
        p1.setAttribute('d', 'M12 20h9');
