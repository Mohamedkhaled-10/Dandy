---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getAllProducts,
  getDeterministicSlug,
  optimizeCloudinaryUrl,
  SITE_URL,
  type Product
} from '../utils/products';
import {
  CATEGORY_TAXONOMY,
  PRODUCT_CATEGORY_OVERRIDES,
  getAllCategories,
  getCategorySlugForProduct
} from '../utils/categories';
import {
  getPublishedPinkFridayCampaign,
  calculatePinkFridayPricing
} from '../utils/pink-friday-server';
import {
  hasSelectableProductVariants
} from '../utils/server-variant-pricing';

// SEO Crawl Discipline: Parameter-aware robots signaling for all catalog filter/sort/pagination params
const AUDITED_CATALOG_PARAMS = ['category', 'status', 'search', 'sort', 'page', 'minPrice', 'maxPrice', 'minRating'];
const hasAuditedCatalogParam = AUDITED_CATALOG_PARAMS.some(param => Astro.url.searchParams.has(param));
const robotsDirective = hasAuditedCatalogParam ? 'noindex, follow' : 'index, follow';

const PAGE_SIZE = 12;

const CATEGORY_SLUG_TO_FILTER_VALUE: Record<string, string> = {
  'skin-care': 'skin care',
  'hair-care': 'hair care',
  'body-care': 'body care',
  'fragrance': 'perfume'
};

function sanitizeSsrImageUrl(rawUrl?: string): string {
  const fallback = '/assets/images/logo.png';
  if (!rawUrl || typeof rawUrl !== 'string') return fallback;
  const trimmed = rawUrl.trim();
  if (!trimmed) return fallback;
  if (trimmed.startsWith('/') && !trimmed.startsWith('//')) {
    return trimmed;
  }
  try {
    const parsed = new URL(trimmed);
    if (parsed.protocol === 'https:') {
      return parsed.toString();
    }
  } catch (_) {}
  return fallback;
}

function stripPlainDescription(text?: string): string {
  if (!text || typeof text !== 'string') return '';
  return text
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 360);
}

const [allRawProducts, livePfCampaign] = await Promise.all([
  getAllProducts(),
  getPublishedPinkFridayCampaign()
]);

// Mirror RTDB ordering (reverse chronological) and exclude hidden products
const visibleRawProducts: Product[] = allRawProducts
  .filter((p) => p && !p.isHidden)
  .reverse();

const ssrCatalogProducts = visibleRawProducts.map((product) => {
  const catSlug = getCategorySlugForProduct(product);
  const categoryInfo = CATEGORY_TAXONOMY[catSlug] || CATEGORY_TAXONOMY['skin-care'];
  const regularPrice = Number(product.price) || 0;
  const originalPriceNum = product.originalPrice ? Number(product.originalPrice) || null : null;
  const discountNum = product.discount ? Number(product.discount) || null : null;
  const pfPricing = calculatePinkFridayPricing(product, livePfCampaign);
  const isPinkFriday = Boolean(pfPricing && pfPricing.isEligible);
  const effectivePrice = isPinkFriday ? pfPricing.campaignPrice : regularPrice;
  const reviewCountNum = Number(product.reviewCount) > 0 ? Math.trunc(Number(product.reviewCount)) : 0;
  const avgRatingNum = reviewCountNum > 0 && Number(product.avgRating) > 0 ? Number(product.avgRating) : 0;
  const hasVariants = hasSelectableProductVariants(product);
  const safeImage = sanitizeSsrImageUrl(product.image);
  const resolvedSlug = product.resolvedSlug || getDeterministicSlug(product);
  const pfBadgeText = isPinkFriday
    ? (pfPricing.offer?.badgeText && pfPricing.offer.badgeText.trim()
        ? pfPricing.offer.badgeText.trim()
        : 'Pink Friday')
    : '';

  // Note: Strictly omit stockQuantity and any internal-only fields from serialized SSR payload
  return {
    id: String(product.id),
    name: String(product.name || 'منتج داندي'),
    resolvedSlug: String(resolvedSlug),
    slug: product.slug ? String(product.slug) : '',
    description: stripPlainDescription(product.description),
    price: regularPrice,
    effectivePrice,
    originalPrice: originalPriceNum,
    discount: discountNum,
    category: String(product.category || 'Skin care'),
    categorySlug: catSlug,
    categoryFilterValue: CATEGORY_SLUG_TO_FILTER_VALUE[catSlug] || 'skin care',
    categoryArabicName: categoryInfo.arabicName,
    image: safeImage,
    avgRating: avgRatingNum,
    reviewCount: reviewCountNum,
    bestSeller: Boolean(product.bestSeller),
    onSale: Boolean(product.onSale),
    isSoldOut: Boolean(product.isSoldOut),
    hasVariants,
    variantType: product.variantType || '',
    variants: hasVariants && product.variants ? product.variants : undefined,
    isPinkFriday,
    pfDiscountPercentage: isPinkFriday ? pfPricing.discountPercentage : 0,
    pfBadgeText
  };
});

const ssrCatalogBootstrap = {
  products: ssrCatalogProducts,
  categoryOverrides: PRODUCT_CATEGORY_OVERRIDES,
  categoryTaxonomy: Object.fromEntries(
    Object.values(CATEGORY_TAXONOMY).map((cat) => [
      cat.slug,
      {
        slug: cat.slug,
        arabicName: cat.arabicName,
        filterValue: CATEGORY_SLUG_TO_FILTER_VALUE[cat.slug] || 'skin care',
        sourceFirebaseCategories: cat.sourceFirebaseCategories
      }
    ])
  )
};

const serializedBootstrapJson = JSON.stringify(ssrCatalogBootstrap)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');

const categoriesList = getAllCategories().map((cat) => ({
  slug: cat.slug,
  arabicName: cat.arabicName,
  filterValue: CATEGORY_SLUG_TO_FILTER_VALUE[cat.slug] || 'skin care'
}));

const initialBatchPreviewCount = Math.min(PAGE_SIZE, ssrCatalogProducts.length);
---

<BaseLayout
  title="جميع المنتجات | Dandy Cosmetics - منتجات طبيعية للعناية"
  description="تصفحي جميع منتجات داندي (Dandy Cosmetics) للعناية بالبشرة والشعر. تشكيلة واسعة من مستحضرات التجميل الطبيعية والمضمونة بأسعار ممتازة."
  keywords="Dandy, Dandy Cosmetics, دندي, داندي, دندي للتجميل, جميع المنتجات, العناية بالبشرة, العناية بالشعر, مستحضرات تجميل, Skincare, Haircare"
  canonical="https://dandy-ebon.vercel.app/all-products"
  robots={robotsDirective}
>
  <slot name="head" slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dandy-ebon.vercel.app/all-products" />
    <meta property="og:title" content="جميع المنتجات | Dandy Cosmetics - منتجات طبيعية للعناية" />
    <meta property="og:description" content="تصفحي جميع منتجات داندي (Dandy Cosmetics) للعناية بالبشرة والشعر. تشكيلة واسعة من مستحضرات التجميل الطبيعية والمضمونة بأسعار ممتازة." />
    <meta property="og:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="جميع المنتجات | Dandy Cosmetics - منتجات طبيعية للعناية" />
    <meta name="twitter:description" content="تصفحي جميع منتجات داندي (Dandy Cosmetics) للعناية بالبشرة والشعر. تشكيلة واسعة من مستحضرات التجميل الطبيعية والمضمونة بأسعار ممتازة." />
    <meta name="twitter:image" content="https://res.cloudinary.com/dogk78w9z/image/upload/v1789152384/WhatsApp_Image_2026-06-18_at_5.55.06_PM.jpg" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "جميع المنتجات | Dandy Cosmetics",
        "description": "تصفحي جميع منتجات داندي للعناية بالبشرة والشعر الطبيعية.",
        "url": "https://dandy-ebon.vercel.app/all-products"
      }
    </script>

    <style is:global>
      /* ======================================================================
         DANDY CATALOG PAGE — LUXURY ARABIC RTL BEAUTY STOREFRONT
         ====================================================================== */

      .catalog-page-wrap {
        background: #fffdfb;
        min-height: 75vh;
        direction: rtl;
        text-align: right;
      }

      /* 1. Breadcrumbs */
      .catalog-breadcrumb-nav {
        background: #faf7f5;
        border-bottom: 1px solid var(--border-subtle, #ebe5e1);
        padding: 11px 0;
      }

      .catalog-breadcrumb-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        font-size: 0.85rem;
      }

      .catalog-breadcrumb-item {
        display: inline-flex;
        align-items: center;
      }

      .catalog-breadcrumb-link {
        color: var(--color-muted, #766c6c);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: color 0.15s ease;
      }

      .catalog-breadcrumb-link:hover,
      .catalog-breadcrumb-link:focus-visible {
        color: var(--color-rose-kiss-600, #df3f85);
      }

      .catalog-breadcrumb-separator {
        color: var(--color-subtle, #aea5a5);
        font-size: 0.7rem;
        display: inline-flex;
        align-items: center;
      }

      .catalog-breadcrumb-current {
        color: var(--color-text, #2c2828);
        font-weight: 700;
      }

      /* 2. Storefront Catalog Hero Header */
      .catalog-hero-section {
        background: linear-gradient(180deg, #fff6f9 0%, #fffdfb 100%);
        border-bottom: 1px solid var(--border-subtle, #ebe5e1);
        padding: 28px 0 24px;
      }

      .catalog-hero-inner {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .catalog-hero-top {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
      }

      .catalog-hero-copy {
        max-width: 720px;
      }

      .catalog-kicker {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--color-rose-kiss-600, #df3f85);
        margin-bottom: 6px;
        letter-spacing: 0.02em;
      }

      .catalog-h1 {
        font-size: clamp(1.55rem, 3vw, 2.15rem);
        font-weight: 800;
        color: #18181b;
        margin: 0 0 8px;
        line-height: 1.25;
      }

      .catalog-subtitle {
        font-size: 0.96rem;
        line-height: 1.65;
        color: var(--color-text-secondary, #595050);
        margin: 0;
      }

      .catalog-hero-stats {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.88rem;
        color: var(--color-text-secondary, #595050);
        font-weight: 600;
        white-space: nowrap;
      }

      .catalog-hero-stats strong {
        color: var(--color-rose-kiss-600, #df3f85);
        font-variant-numeric: tabular-nums;
      }

      /* Quick Category Navigation Tabs */
      .quick-categories-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding-top: 12px;
        border-top: 1px solid rgba(235, 229, 225, 0.8);
      }

      .quick-cat-btn {
        appearance: none;
        background: #ffffff;
        border: 1px solid var(--border-light, #dedbdb);
        color: var(--color-text, #2c2828);
        padding: 8px 15px;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease;
        white-space: nowrap;
      }

      .quick-cat-btn:hover {
        border-color: var(--color-rose-kiss-400, #ff82b3);
        color: var(--color-rose-kiss-600, #df3f85);
      }

      .quick-cat-btn.active,
      .quick-cat-btn[aria-pressed="true"] {
        background: #18181b;
        border-color: #18181b;
        color: #ffffff;
      }

      .quick-cat-btn:focus-visible {
        outline: 2px solid var(--color-rose-kiss-500, #fe5d9f);
        outline-offset: 2px;
      }

      /* 3. Main Catalog Grid & Sticky Sidebar */
      .shop-layout {
        direction: rtl;
        text-align: right;
        display: grid;
        grid-template-columns: 290px minmax(0, 1fr);
        gap: 30px;
        align-items: start;
        padding-top: 28px;
        padding-bottom: 72px;
      }

      .shop-sidebar {
        width: 100%;
        background: #ffffff;
        border: 1px solid var(--border-subtle, #ebe5e1);
        border-radius: 12px;
        padding: 20px;
        position: sticky;
        top: 84px;
        box-shadow: 0 2px 10px rgba(24, 24, 27, 0.03);
        z-index: 20;
        max-height: calc(100vh - 104px);
        overflow-y: auto;
      }

      .shop-sidebar::-webkit-scrollbar {
        width: 4px;
      }

      .shop-sidebar::-webkit-scrollbar-thumb {
        background: var(--border-light, #dedbdb);
        border-radius: 4px;
      }

      .shop-main {
        width: 100%;
        min-width: 0;
      }

      .filter-controls-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        padding-bottom: 14px;
        margin-bottom: 18px;
        border-bottom: 1px solid var(--border-subtle, #ebe5e1);
      }

      .sidebar-title-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.98rem;
        font-weight: 700;
        color: #18181b;
        min-width: 0;
      }

      .active-filters-badge {
        background: var(--color-rose-kiss-500, #fe5d9f);
        color: #fff;
        font-size: 0.72rem;
        padding: 2px 7px;
        border-radius: 6px;
        font-weight: 700;
        display: none;
        line-height: 1.3;
        font-variant-numeric: tabular-nums;
      }

      .clear-all-btn {
        background: none;
        border: none;
        color: var(--color-rose-kiss-600, #df3f85);
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        display: none;
        padding: 4px 8px;
        border-radius: 6px;
        font-family: inherit;
        white-space: nowrap;
        flex-shrink: 0;
        transition: background-color 0.15s ease;
      }

      .clear-all-btn:hover {
        background-color: rgba(254, 93, 159, 0.08);
      }

      .filter-section {
        margin-bottom: 20px;
        border-bottom: 1px solid var(--border-subtle, #ebe5e1);
        padding-bottom: 20px;
      }

      .filter-section:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
      }

      .filter-section h3 {
        font-size: 0.9rem;
        font-weight: 700;
        margin: 0 0 12px;
        color: #18181b;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .filter-section h3::before {
        content: '';
        display: inline-block;
        width: 3px;
        height: 14px;
        border-radius: 2px;
        background-color: var(--color-rose-kiss-500, #fe5d9f);
        flex-shrink: 0;
      }

      .filter-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .filter-label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        color: var(--color-text, #2c2828);
        font-size: 0.89rem;
        font-weight: 500;
        padding: 7px 9px;
        border-radius: 8px;
        transition: background-color 0.15s ease, color 0.15s ease;
        user-select: none;
      }

      .filter-label:hover {
        background-color: rgba(254, 93, 159, 0.05);
      }

      .filter-label:has(input:checked) {
        background-color: rgba(254, 93, 159, 0.08);
        color: var(--color-rose-kiss-600, #df3f85);
        font-weight: 600;
      }

      .filter-label input[type="checkbox"],
      .filter-label input[type="radio"] {
        appearance: none;
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        margin: 0;
        border: 1.5px solid #d4ccc8;
        border-radius: 5px;
        background-color: #ffffff;
        cursor: pointer;
        position: relative;
        flex-shrink: 0;
        transition: all 0.15s ease;
        display: grid;
        place-content: center;
      }

      .filter-label input[type="radio"] {
        border-radius: 50%;
      }

      .filter-label input:focus-visible {
        outline: 2px solid var(--color-rose-kiss-500, #fe5d9f);
        outline-offset: 2px;
      }

      .filter-label input:checked {
        background-color: var(--color-rose-kiss-500, #fe5d9f);
        border-color: var(--color-rose-kiss-500, #fe5d9f);
      }

      .filter-label input[type="checkbox"]:checked::after {
        content: '';
        width: 9px;
        height: 5px;
        border-left: 2px solid #ffffff;
        border-bottom: 2px solid #ffffff;
        transform: rotate(-45deg) translate(1px, -1px);
        display: block;
      }

      .filter-label input[type="radio"]:checked::after {
        content: '';
        width: 7px;
        height: 7px;
        background: #ffffff;
        border-radius: 50%;
        display: block;
      }

      /* Search Input & Suggestions */
      .catalog-search-wrapper {
        position: relative;
      }

      .catalog-search-box {
        width: 100%;
        background: #faf7f5;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 10px;
        border: 1px solid var(--border-subtle, #ebe5e1);
        transition: border-color 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
      }

      .catalog-search-box:focus-within {
        background: #ffffff;
        border-color: var(--color-rose-kiss-500, #fe5d9f);
        box-shadow: 0 0 0 3px rgba(254, 93, 159, 0.12);
      }

      .catalog-search-trigger {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: var(--color-rose-kiss-600, #df3f85);
        font-size: 0.98rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .catalog-search-box input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.9rem;
        color: #18181b;
        font-family: inherit;
      }

      .catalog-search-box input::placeholder {
        color: var(--color-subtle, #aea5a5);
      }

      .clear-search {
        width: 26px;
        height: 26px;
        border: none;
        border-radius: 50%;
        background: #ede9e6;
        cursor: pointer;
        display: none;
        align-items: center;
        justify-content: center;
        color: var(--color-text-secondary, #595050);
        font-size: 0.78rem;
        flex-shrink: 0;
        transition: background-color 0.15s ease;
      }

      .clear-search:hover {
        background: #ded8d4;
        color: #18181b;
      }

      .search-meta {
        margin-top: 8px;
        color: var(--color-muted, #766c6c);
        font-size: 0.8rem;
      }

      .search-suggestions {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        background: #ffffff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 14px 32px rgba(24, 24, 27, 0.12);
        display: none;
        z-index: 60;
        border: 1px solid var(--border-light, #dedbdb);
      }

      .search-suggestion-item {
        width: 100%;
        display: block;
        text-align: right;
        background: transparent;
        border: none;
        border-bottom: 1px solid #f4f0ed;
        padding: 10px 14px;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.88rem;
        color: #18181b;
        transition: background-color 0.15s ease, color 0.15s ease;
      }

      .search-suggestion-item:last-child {
        border-bottom: none;
      }

      .search-suggestion-item:hover,
      .search-suggestion-item.is-active {
        background: #fff4f8;
        color: var(--color-rose-kiss-600, #df3f85);
      }

      .search-suggestion-empty {
        padding: 12px 14px;
        font-size: 0.84rem;
        color: var(--color-muted, #766c6c);
        text-align: center;
      }

      /* Price Range Filter */
      .price-range-inputs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .price-input-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
      }

      .price-input-group label {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--color-muted, #766c6c);
      }

      .price-input-field {
        width: 100%;
        min-width: 0;
        background: #faf7f5;
        border: 1px solid var(--border-subtle, #ebe5e1);
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 0.88rem;
        font-family: inherit;
        color: #18181b;
        font-variant-numeric: tabular-nums;
        outline: none;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }

      .price-input-field:focus {
        background: #ffffff;
        border-color: var(--color-rose-kiss-500, #fe5d9f);
        box-shadow: 0 0 0 3px rgba(254, 93, 159, 0.12);
      }

      .price-range-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 10px;
      }

      .btn-apply-price {
        flex: 1;
        background: #18181b;
        color: #ffffff;
        border: none;
        border-radius: 7px;
        padding: 7px 12px;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.15s ease;
      }

      .btn-apply-price:hover {
        background: var(--color-rose-kiss-600, #df3f85);
      }

      .btn-reset-price {
        background: transparent;
        border: 1px solid var(--border-light, #dedbdb);
        color: var(--color-text-secondary, #595050);
        border-radius: 7px;
        padding: 6px 10px;
        font-family: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
      }

      .btn-reset-price:hover {
        border-color: var(--color-rose-kiss-500, #fe5d9f);
        color: var(--color-rose-kiss-600, #df3f85);
      }

      .price-range-summary {
        margin-top: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-rose-kiss-600, #df3f85);
        display: none;
      }

      .price-range-error {
        margin-top: 8px;
        font-size: 0.79rem;
        font-weight: 600;
        color: var(--color-danger, #be123c);
        background: #fff1f2;
        border: 1px solid #fecdd3;
        border-radius: 6px;
        padding: 6px 9px;
        display: none;
      }

      .rating-helper-note {
        margin-top: 6px;
        font-size: 0.75rem;
        color: var(--color-muted, #766c6c);
        line-height: 1.45;
      }

      /* Connection / Fallback Notice */
      .catalog-connection-notice {
        display: none;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
        padding: 10px 14px;
        border-radius: 10px;
        margin-bottom: 14px;
        font-size: 0.86rem;
        font-weight: 600;
      }

      .catalog-retry-btn {
        background: #ffffff;
        border: 1px solid #f59e0b;
        color: #92400e;
        padding: 5px 12px;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
      }

      .catalog-retry-btn:hover {
        background: #fef3c7;
      }

      /* Shop Main Toolbar */
      .shop-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        background: #ffffff;
        border: 1px solid var(--border-subtle, #ebe5e1);
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 16px;
      }

      .products-count-badge {
        font-size: 0.9rem;
        color: var(--color-text-secondary, #595050);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        flex-wrap: wrap;
        font-weight: 500;
      }

      .products-count-badge strong {
        color: var(--color-rose-kiss-600, #df3f85);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
      }

      .showing-batch-summary {
        font-size: 0.82rem;
        color: var(--color-muted, #766c6c);
      }

      .sort-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.86rem;
        color: var(--color-text-secondary, #595050);
        font-weight: 600;
      }

      .sort-select-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
      }

      .sort-select {
        appearance: none;
        -webkit-appearance: none;
        background: #faf7f5;
        border: 1px solid var(--border-subtle, #ebe5e1);
        border-radius: 8px;
        padding: 8px 12px 8px 30px;
        font-size: 0.86rem;
        font-weight: 600;
        color: #18181b;
        cursor: pointer;
        outline: none;
        font-family: inherit;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }

      .sort-select:hover {
        border-color: var(--color-rose-kiss-400, #ff82b3);
      }

      .sort-select:focus {
        border-color: var(--color-rose-kiss-500, #fe5d9f);
        box-shadow: 0 0 0 3px rgba(254, 93, 159, 0.12);
        background: #ffffff;
      }

      .sort-chevron {
        position: absolute;
        left: 11px;
        pointer-events: none;
        font-size: 0.72rem;
        color: var(--color-muted, #766c6c);
      }

      /* Active Filter Chips Bar */
      .active-chips-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: #fff9fb;
        border: 1px solid rgba(254, 93, 159, 0.25);
        border-radius: 10px;
        margin-bottom: 18px;
      }

      .chips-label {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--color-text-secondary, #595050);
      }

      .chips-list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
      }

      .filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        border: 1px solid rgba(254, 93, 159, 0.35);
        color: var(--color-rose-kiss-600, #df3f85);
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .chip-remove-btn {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        color: var(--color-rose-kiss-600, #df3f85);
        font-size: 0.75rem;
        transition: background-color 0.15s ease, color 0.15s ease;
      }

      .chip-remove-btn:hover {
        background: var(--color-rose-kiss-500, #fe5d9f);
        color: #ffffff;
      }

      .chips-clear-all {
        background: none;
        border: none;
        color: var(--color-muted, #766c6c);
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        padding: 4px 8px;
        margin-inline-start: auto;
        text-decoration: underline;
        font-family: inherit;
      }

      .chips-clear-all:hover {
        color: var(--color-danger, #be123c);
      }

      /* 4. Semantic Product Grid & Redesigned Cards */
      .catalog-page-wrap .product-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      @media (max-width: 1120px) {
        .catalog-page-wrap .product-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 16px;
        }
      }

      .catalog-page-wrap .product-card {
        background: #ffffff;
        border: 1px solid var(--border-subtle, #ebe5e1);
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
        cursor: default;
        height: 100%;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
      }

      .catalog-page-wrap .product-card:hover {
        border-color: var(--color-rose-kiss-400, #ff82b3);
        box-shadow: 0 10px 24px rgba(24, 24, 27, 0.06);
        transform: translateY(-2px);
      }

      .catalog-page-wrap .card-image-box {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        background: #f7f4f2;
        overflow: hidden;
        flex-shrink: 0;
      }

      .catalog-page-wrap .card-image-link {
        display: block;
        width: 100%;
        height: 100%;
      }

      .catalog-page-wrap .card-image-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.35s ease;
      }

      .catalog-page-wrap .product-card:hover .card-image-box img {
        transform: scale(1.03);
      }

      .catalog-page-wrap .card-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ffffff;
        color: var(--color-rose-kiss-600, #df3f85);
        border: 1px solid rgba(254, 93, 159, 0.35);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 4px;
        z-index: 2;
        line-height: 1.3;
        pointer-events: none;
      }

      .catalog-page-wrap .card-badge.pink-friday {
        background: #18181b;
        color: #ff82b3;
        border-color: #18181b;
      }

      .catalog-page-wrap .card-badge.sold-out {
        background: #2c2828;
        color: #ffffff;
        border-color: #2c2828;
      }

      .catalog-page-wrap .btn-card-wishlist {
        position: absolute;
        top: 10px;
        left: 10px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(24, 24, 27, 0.08);
        color: #78716c;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 3;
        padding: 0;
        transition: color 0.15s ease, transform 0.15s ease, background-color 0.15s ease;
      }

      .catalog-page-wrap .btn-card-wishlist:hover,
      .catalog-page-wrap .btn-card-wishlist.active {
        color: var(--color-rose-kiss-500, #fe5d9f);
        background: #ffffff;
      }

      .catalog-page-wrap .btn-card-wishlist:focus-visible {
        outline: 2px solid var(--color-rose-kiss-500, #fe5d9f);
        outline-offset: 2px;
      }

      .catalog-page-wrap .card-content-box {
        padding: 14px;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      .catalog-page-wrap .card-category {
        font-size: 0.73rem;
        font-weight: 600;
        color: var(--color-muted, #766c6c);
        margin-bottom: 4px;
        display: block;
      }

      .catalog-page-wrap .card-title {
        font-size: 0.94rem;
        font-weight: 700;
        margin: 0 0 8px;
        line-height: 1.45;
        min-height: 2.8em;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .catalog-page-wrap .product-title-link {
        color: #18181b;
        text-decoration: none;
        transition: color 0.15s ease;
      }

      .catalog-page-wrap .product-title-link:hover,
      .catalog-page-wrap .product-title-link:focus-visible {
        color: var(--color-rose-kiss-600, #df3f85);
      }

      .catalog-page-wrap .card-rating-mini {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.76rem;
        color: var(--color-muted, #766c6c);
        margin-bottom: 8px;
        font-variant-numeric: tabular-nums;
      }

      .catalog-page-wrap .card-rating-star {
        color: #eab308;
        font-size: 0.76rem;
      }

      .catalog-page-wrap .card-rating-val {
        font-weight: 700;
        color: #18181b;
      }

      .catalog-page-wrap .card-price-row {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: auto;
        margin-bottom: 12px;
        font-variant-numeric: tabular-nums;
      }

      .catalog-page-wrap .price-current {
        font-size: 1rem;
        font-weight: 800;
        color: #18181b;
      }

      .catalog-page-wrap .price-current.is-pf {
        color: var(--color-rose-kiss-600, #df3f85);
      }

      .catalog-page-wrap .price-old {
        font-size: 0.8rem;
        color: var(--color-subtle, #9a9090);
        text-decoration: line-through;
      }

      .catalog-page-wrap .card-add-btn {
        width: 100%;
        min-height: 40px;
        padding: 8px 12px;
        background: #faf7f5;
        border: 1px solid var(--border-light, #dedbdb);
        color: #18181b;
        font-size: 0.84rem;
        font-weight: 700;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        font-family: inherit;
        transition: background-color 0.16s ease, border-color 0.16s ease, color 0.16s ease;
      }

      .catalog-page-wrap .card-add-btn svg {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
      }

      .catalog-page-wrap .card-add-btn:hover:not(:disabled):not(.is-sold-out),
      .catalog-page-wrap .card-add-btn:focus-visible:not(:disabled):not(.is-sold-out) {
        background: var(--color-rose-kiss-500, #fe5d9f);
        border-color: var(--color-rose-kiss-500, #fe5d9f);
        color: #ffffff;
      }

      .catalog-page-wrap .card-add-btn.is-sold-out,
      .catalog-page-wrap .card-add-btn:disabled {
        background: #f4f4f5;
        border-color: #e4e4e7;
        color: #a1a1aa;
        cursor: not-allowed;
      }

      /* Progressive Pagination Controls */
      .catalog-pagination {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        padding-top: 16px;
        border-top: 1px solid var(--border-subtle, #ebe5e1);
      }

      .pagination-status-text {
        font-size: 0.84rem;
        color: var(--color-muted, #766c6c);
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      .btn-load-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #18181b;
        color: #ffffff;
        border: none;
        padding: 11px 28px;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.16s ease, transform 0.16s ease;
      }

      .btn-load-more:hover {
        background: var(--color-rose-kiss-600, #df3f85);
        transform: translateY(-1px);
      }

      .btn-load-more:focus-visible {
        outline: 2px solid var(--color-rose-kiss-500, #fe5d9f);
        outline-offset: 2px;
      }

      /* Empty State */
      .empty-products-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 48px 24px;
        background: #ffffff;
        border: 1px solid var(--border-subtle, #ebe5e1);
        border-radius: 12px;
        margin: 12px 0;
      }

      .empty-icon-wrap {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(254, 93, 159, 0.1);
        color: var(--color-rose-kiss-500, #fe5d9f);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 14px;
      }

      .empty-products-state h3 {
        font-size: 1.12rem;
        font-weight: 700;
        color: #18181b;
        margin: 0 0 8px;
      }

      .empty-products-state p {
        font-size: 0.9rem;
        color: var(--color-muted, #766c6c);
        max-width: 440px;
        margin: 0 auto 18px;
        line-height: 1.6;
      }

      .btn-reset-filters {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--color-rose-kiss-500, #fe5d9f);
        color: #ffffff;
        border: none;
        padding: 10px 22px;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.16s ease;
      }

      .btn-reset-filters:hover {
        background: var(--color-rose-kiss-600, #df3f85);
      }

      /* Cart Toast */
      .dandy-catalog-cart-toast {
        position: fixed;
        bottom: 84px;
        left: 50%;
        transform: translateX(-50%);
        background: #18181b;
        color: #ffffff;
        padding: 12px 18px;
        border-radius: 10px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
        z-index: 1050;
        display: flex;
        align-items: center;
        gap: 12px;
        max-width: calc(100vw - 24px);
        font-size: 0.88rem;
        font-weight: 600;
        border: 1px solid rgba(254, 93, 159, 0.35);
      }

      .dandy-toast-icon {
        color: #34d399;
        font-size: 1rem;
        flex-shrink: 0;
      }

      .dandy-toast-link {
        color: #ff82b3;
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .dandy-toast-link:hover {
        color: #ffffff;
      }

      /* Mobile Filter Drawer & Responsive 390px Rules */
      .mobile-filter-toggle {
        display: none;
        width: 100%;
        padding: 12px 16px;
        background: #ffffff;
        border: 1px solid var(--border-light, #dedbdb);
        border-radius: 10px;
        color: #18181b;
        font-family: inherit;
        font-size: 0.92rem;
        font-weight: 700;
        cursor: pointer;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .mobile-filter-toggle:hover {
        border-color: var(--color-rose-kiss-500, #fe5d9f);
      }

      .mobile-toggle-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .mobile-filter-count-pill {
        background: var(--color-rose-kiss-500, #fe5d9f);
        color: #ffffff;
        font-size: 0.74rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 6px;
        display: none;
      }

      .close-drawer-btn,
      .sidebar-overlay {
        display: none;
      }

      @media (max-width: 900px) {
        .catalog-hero-section {
          padding: 20px 0 18px;
        }

        .shop-layout {
          grid-template-columns: minmax(0, 1fr);
          gap: 16px;
          padding-top: 18px;
        }

        .mobile-filter-toggle {
          display: flex;
        }

        .shop-sidebar {
          position: fixed;
          top: 0;
          bottom: 0;
          right: -100%;
          left: auto;
          width: 310px;
          max-width: 88vw;
          height: 100vh;
          max-height: 100vh;
          border-radius: 16px 0 0 16px;
          z-index: 10000;
          transition: right 0.3s cubic-bezier(0.25, 1, 0.5, 1);
          padding: 20px;
          overflow-y: auto;
          box-shadow: -10px 0 36px rgba(0, 0, 0, 0.16);
        }

        .shop-sidebar.active {
          right: 0;
        }

        .sidebar-overlay {
          position: fixed;
          inset: 0;
          background: rgba(24, 24, 27, 0.45);
          backdrop-filter: blur(2px);
          z-index: 9998;
          display: none;
          opacity: 0;
          transition: opacity 0.25s ease;
        }

        .sidebar-overlay.active {
          display: block;
          opacity: 1;
        }

        .close-drawer-btn {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 34px;
          height: 34px;
          background: #f4f1ef;
          border: none;
          border-radius: 50%;
          margin-bottom: 16px;
          margin-inline-start: auto;
          cursor: pointer;
          color: #18181b;
          font-size: 1rem;
        }
      }

      @media (max-width: 600px) {
        .catalog-page-wrap .product-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 12px;
        }

        .catalog-page-wrap .card-content-box {
          padding: 10px 10px 12px;
        }

        .catalog-page-wrap .card-title {
          font-size: 0.84rem;
          min-height: 2.5em;
        }

        .catalog-page-wrap .card-add-btn {
          font-size: 0.78rem;
          padding: 7px 8px;
          min-height: 38px;
        }

        .shop-toolbar {
          padding: 10px 12px;
        }

        .sort-label {
          width: 100%;
          justify-content: space-between;
        }

        .quick-categories-bar {
          gap: 6px;
        }

        .quick-cat-btn {
          padding: 6px 11px;
          font-size: 0.8rem;
        }
      }

      /* Filter & Pagination Hidden States */
      .product.hidden,
      .product.batch-hidden {
        display: none !important;
      }

      body.filter-drawer-open {
        overflow: hidden;
      }

      @media (prefers-reduced-motion: reduce) {
        .shop-sidebar,
        .sidebar-overlay,
        .catalog-page-wrap .product-card,
        .catalog-page-wrap .card-image-box img,
        .btn-load-more,
        .quick-cat-btn {
          transition: none !important;
        }
      }
    </style>
  </slot>

  <div class="catalog-page-wrap">
    <!-- Sidebar Overlay Element -->
    <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

    <!-- Breadcrumb Navigation -->
    <nav class="catalog-breadcrumb-nav" aria-label="مسار التنقل">
      <div class="container">
        <ol class="catalog-breadcrumb-list">
          <li class="catalog-breadcrumb-item">
            <a href="/" class="catalog-breadcrumb-link">
              <i class="fas fa-home" aria-hidden="true"></i>
              <span>الرئيسية</span>
            </a>
          </li>
          <li class="catalog-breadcrumb-separator" aria-hidden="true">
            <i class="fas fa-chevron-left"></i>
          </li>
          <li class="catalog-breadcrumb-item catalog-breadcrumb-current" aria-current="page">
            <span>جميع المنتجات</span>
          </li>
        </ol>
      </div>
    </nav>

    <!-- Storefront Header & Quick Category Navigation -->
    <header class="catalog-hero-section">
      <div class="container">
        <div class="catalog-hero-inner">
          <div class="catalog-hero-top">
            <div class="catalog-hero-copy">
              <span class="catalog-kicker">كتالوج داندي كوزمتكس</span>
              <h1 class="catalog-h1">جميع مستحضرات داندي الطبيعية</h1>
              <p class="catalog-subtitle">
                تشكيلة متكاملة من مستحضرات العناية بالبشرة والشعر والجسم والعطور الطبيعية 100% غنية بالزيوت والمستخلصات العضوية.
              </p>
            </div>
            <div class="catalog-hero-stats">
              <span>إجمالي التشكيلة:</span>
              <strong id="catalog-total-available">{ssrCatalogProducts.length}</strong>
              <span>مستحضر</span>
            </div>
          </div>

          <div class="quick-categories-bar" id="quick-categories-bar" role="group" aria-label="تصفح سريع حسب القسم">
            <button type="button" class="quick-cat-btn active" data-quick-category="" aria-pressed="true">
              جميع الأقسام
            </button>
            {categoriesList.map((cat) => (
              <button
                type="button"
                class="quick-cat-btn"
                data-quick-category={cat.filterValue}
                aria-pressed="false"
              >
                {cat.arabicName}
              </button>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Main Shop Layout -->
    <div class="shop-layout container">
      <button
        type="button"
        class="mobile-filter-toggle"
        id="mobile-filter-toggle"
        aria-expanded="false"
        aria-controls="shop-sidebar"
      >
        <span class="mobile-toggle-label">
          <i class="fas fa-sliders-h" aria-hidden="true"></i>
          <span>تصفية وترتيب المنتجات</span>
        </span>
        <span id="mobile-filter-count-badge" class="mobile-filter-count-pill">0</span>
      </button>

      <aside class="shop-sidebar" id="shop-sidebar" aria-label="أدوات التصفية والبحث">
        <button
          type="button"
          class="close-drawer-btn"
          id="close-drawer-btn"
          aria-label="إغلاق أدوات التصفية"
        >
          <i class="fas fa-times" aria-hidden="true"></i>
        </button>

        <div class="filter-controls-top">
          <div class="sidebar-title-heading">
            <i class="fas fa-sliders-h" style="color: var(--color-rose-kiss-500, #fe5d9f); font-size: 0.92rem;" aria-hidden="true"></i>
            <span>تصفية المنتجات</span>
            <span id="sidebar-badge" class="active-filters-badge">0</span>
          </div>
          <button type="button" id="clear-all-filters" class="clear-all-btn">
            مسح الكل
          </button>
        </div>

        <!-- 1. Search -->
        <div class="filter-section">
          <h3>البحث في الكتالوج</h3>
          <div class="catalog-search-wrapper">
            <div class="catalog-search-box">
              <button type="button" id="trigger-search" class="catalog-search-trigger" aria-label="تنفيذ البحث">
                <i class="fas fa-search search-icon" aria-hidden="true"></i>
              </button>
              <input
                type="text"
                id="search-input"
                placeholder="ابحثي باسم المنتج أو القسم..."
                autocomplete="off"
                aria-label="البحث في الكتالوج"
                aria-autocomplete="list"
                aria-controls="search-suggestions"
              />
              <button type="button" id="clear-search" class="clear-search" aria-label="مسح البحث">
                <i class="fas fa-times" aria-hidden="true"></i>
              </button>
            </div>
            <div id="search-suggestions" class="search-suggestions" role="listbox" aria-label="اقتراحات البحث"></div>
            <div class="search-meta">
              <span id="results-count" aria-live="polite">عرض جميع المنتجات</span>
            </div>
          </div>
        </div>

        <!-- 2. Categories -->
        <div class="filter-section">
          <h3>أقسام وتصنيفات</h3>
          <div class="filter-list" id="category-filters">
            <label class="filter-label">
              <input type="checkbox" value="skin care" />
              <span>العناية بالبشرة</span>
            </label>
            <label class="filter-label">
              <input type="checkbox" value="hair care" />
              <span>العناية بالشعر</span>
            </label>
            <label class="filter-label">
              <input type="checkbox" value="body care" />
              <span>العناية بالجسم</span>
            </label>
            <label class="filter-label">
              <input type="checkbox" value="perfume" />
              <span>العطور والمعطرات</span>
            </label>
          </div>
        </div>

        <!-- 3. Promotional Status -->
        <div class="filter-section">
          <h3>عروض وتميّز</h3>
          <div class="filter-list" id="status-filters">
            <label class="filter-label">
              <input type="checkbox" value="offers" />
              <span>عروض وتخفيضات</span>
            </label>
            <label class="filter-label">
              <input type="checkbox" value="bestseller" />
              <span>الأكثر مبيعاً</span>
            </label>
          </div>
        </div>

        <!-- 4. Price Range (EGP) -->
        <div class="filter-section" id="price-filter-section">
          <h3>نطاق السعر (ج.م)</h3>
          <div class="price-range-inputs">
            <div class="price-input-group">
              <label for="min-price-input">الحد الأدنى</label>
              <input
                type="text"
                inputmode="decimal"
                id="min-price-input"
                class="price-input-field"
                placeholder="من (ج.م)"
                aria-label="الحد الأدنى للسعر بالجنيه المصري"
              />
            </div>
            <div class="price-input-group">
              <label for="max-price-input">الحد الأعلى</label>
              <input
                type="text"
                inputmode="decimal"
                id="max-price-input"
                class="price-input-field"
                placeholder="إلى (ج.م)"
                aria-label="الحد الأعلى للسعر بالجنيه المصري"
              />
            </div>
          </div>
          <div class="price-range-actions">
            <button type="button" id="apply-price-filter" class="btn-apply-price">تطبيق السعر</button>
            <button type="button" id="reset-price-filter" class="btn-reset-price">إعادة ضبط</button>
          </div>
          <div id="price-range-summary" class="price-range-summary"></div>
          <div id="price-range-error" class="price-range-error" role="alert"></div>
        </div>

        <!-- 5. Minimum Customer Rating -->
        <div class="filter-section" id="rating-filter-section">
          <h3>تقييم العميلات</h3>
          <div class="filter-list" id="rating-filters" role="radiogroup" aria-label="الحد الأدنى للتقييم">
            <label class="filter-label">
              <input type="radio" name="minRating" value="" checked />
              <span>جميع التقييمات</span>
            </label>
            <label class="filter-label">
              <input type="radio" name="minRating" value="5" />
              <span>5 نجوم فقط</span>
            </label>
            <label class="filter-label">
              <input type="radio" name="minRating" value="4" />
              <span>4 نجوم فأكثر</span>
            </label>
            <label class="filter-label">
              <input type="radio" name="minRating" value="3" />
              <span>3 نجوم فأكثر</span>
            </label>
          </div>
          <p class="rating-helper-note">تُحتسب التقييمات الحقيقية من مراجعات العميلات فقط.</p>
        </div>
      </aside>

      <main class="shop-main">
        <!-- Non-blocking Firebase Fallback Connection Banner -->
        <div class="catalog-connection-notice" id="catalog-connection-notice" role="status" aria-live="polite">
          <span>يتم عرض المنتجات المحمّلة مسبقاً، تعذّر التحديث المباشر حالياً.</span>
          <button type="button" id="retry-firebase-sync" class="catalog-retry-btn">إعادة المحاولة</button>
        </div>

        <!-- Toolbar: Count + Sort -->
        <div class="shop-toolbar" id="shop-toolbar">
          <div class="toolbar-left">
            <span class="products-count-badge" id="products-count-badge" aria-live="polite">
              عدد النتائج: <strong id="visible-count-num">{ssrCatalogProducts.length}</strong> منتج
              <span class="showing-batch-summary" id="showing-batch-summary">
                {ssrCatalogProducts.length > PAGE_SIZE ? `(معروض ${initialBatchPreviewCount})` : ''}
              </span>
            </span>
          </div>

          <div class="toolbar-right">
            <label for="sort-select" class="sort-label">
              <span>ترتيب حسب:</span>
              <div class="sort-select-wrapper">
                <select id="sort-select" class="sort-select" aria-label="ترتيب المنتجات">
                  <option value="default">الأحدث</option>
                  <option value="featured">اختيارات داندي المميزة</option>
                  <option value="price-asc">السعر: من الأقل للأعلى</option>
                  <option value="price-desc">السعر: من الأعلى للأقل</option>
                  <option value="rating-desc">الأعلى تقييماً</option>
                  <option value="reviews-desc">الأكثر تقييماً</option>
                </select>
                <i class="fas fa-chevron-down sort-chevron" aria-hidden="true"></i>
              </div>
            </label>
          </div>
        </div>

        <!-- Active Filter Chips Bar -->
        <div class="active-chips-bar" id="active-chips-bar" style="display: none;">
          <span class="chips-label">الفلاتر المطبقة:</span>
          <div class="chips-list" id="active-chips-list"></div>
          <button type="button" class="chips-clear-all" id="chips-clear-all">
            مسح الكل
          </button>
        </div>

        <!-- Server-Rendered Catalog Product Grid -->
        <div class="product-grid" id="productContainer" data-ssr-count={String(ssrCatalogProducts.length)}>
          {ssrCatalogProducts.length === 0 ? (
            <div class="empty-products-state" id="empty-database-state">
              <div class="empty-icon-wrap" aria-hidden="true">
                <i class="fas fa-box-open"></i>
              </div>
              <h3>لا توجد منتجات متاحة حالياً</h3>
              <p>يتم تحديث مجموعتنا قريباً، تفقّدي الصفحة لاحقاً.</p>
            </div>
          ) : (
            ssrCatalogProducts.map((item, idx) => {
              const productHref = `/product/${encodeURIComponent(item.resolvedSlug)}`;
              const isAboveFold = idx < 4;
              const isBatchHidden = idx >= PAGE_SIZE;

              let badgeLabel = '';
              let badgeVariantClass = '';
              let displayOldPrice: number | null = null;

              if (item.isSoldOut) {
                badgeLabel = 'نفذت الكمية';
                badgeVariantClass = 'sold-out';
              } else if (item.isPinkFriday) {
                badgeLabel = item.pfBadgeText || 'Pink Friday';
                badgeVariantClass = 'pink-friday';
                if (item.price > item.effectivePrice) {
                  displayOldPrice = item.price;
                }
              } else if (item.originalPrice && item.originalPrice > item.price) {
                badgeLabel = 'تخفيض';
                displayOldPrice = item.originalPrice;
              } else if (item.onSale && item.discount && item.discount > 0 && item.discount < 100) {
                badgeLabel = `خصم ${item.discount}%`;
                displayOldPrice = Math.round(item.price / (1 - item.discount / 100));
              } else if (item.bestSeller) {
                badgeLabel = 'الأكثر مبيعاً';
              }

              const hasOffer = Boolean(item.onSale || (item.originalPrice && item.originalPrice > item.price) || item.isPinkFriday);
              const optimizedImg = optimizeCloudinaryUrl(item.image, { width: 500, height: 500, crop: 'limit' }) || '/assets/images/logo.png';

              return (
                <article
                  class={`product-card product ${isBatchHidden ? 'batch-hidden' : ''}`.trim()}
                  data-product-id={item.id}
                  data-category={item.category}
                  data-category-slug={item.categorySlug}
                  data-category-filter={item.categoryFilterValue}
                  data-bestseller={item.bestSeller ? 'true' : 'false'}
                  data-offer={hasOffer ? 'true' : 'false'}
                  data-price={String(item.effectivePrice)}
                  data-rating={String(item.avgRating)}
                  data-reviews={String(item.reviewCount)}
                  data-index={String(idx)}
                >
                  <div class="card-image-box product-image-wrap">
                    {badgeLabel && (
                      <span class={`card-badge ${badgeVariantClass}`.trim()}>
                        {badgeLabel}
                      </span>
                    )}
                    <button
                      type="button"
                      class="btn-card-wishlist"
                      data-action="wishlist"
                      data-product-id={item.id}
                      title="حفظ في المفضلة"
                      aria-label={`حفظ ${item.name} في المفضلة`}
                      aria-pressed="false"
                    >
                      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                      </svg>
                    </button>
                    <a href={productHref} class="card-image-link" tabindex="-1" aria-hidden="true">
                      <img
                        src={optimizedImg}
                        alt={item.name}
                        width="400"
                        height="400"
                        loading={isAboveFold ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </a>
                  </div>

                  <div class="card-content-box product-info-box">
                    <span class="card-category">{item.categoryArabicName}</span>
                    <h3 class="card-title product-title">
                      <a href={productHref} class="product-title-link">{item.name}</a>
                    </h3>

                    {item.reviewCount > 0 && item.avgRating > 0 && (
                      <div class="card-rating-mini" aria-label={`التقييم ${item.avgRating.toFixed(1)} من 5 من ${item.reviewCount} تقييم`}>
                        <i class="fas fa-star card-rating-star" aria-hidden="true"></i>
                        <span class="card-rating-val">{item.avgRating.toFixed(1)}</span>
                        <span class="card-rating-count">({item.reviewCount})</span>
                      </div>
                    )}

                    <div class="card-price-row product-price">
                      <span class={`price-current ${item.isPinkFriday ? 'is-pf' : ''}`.trim()}>
                        {item.effectivePrice} ج.م
                      </span>
                      {displayOldPrice && displayOldPrice > item.effectivePrice && (
                        <span class="price-old">{displayOldPrice} ج.م</span>
                      )}
                    </div>

                    {item.isSoldOut ? (
                      <button
                        type="button"
                        disabled
                        class="card-add-btn add-cart-btn is-sold-out"
                        aria-disabled="true"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                        <span>نفذت الكمية</span>
                      </button>
                    ) : item.hasVariants ? (
                      <a href={productHref} class="card-add-btn add-cart-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        <span>اختاري الرائحة</span>
                      </a>
                    ) : (
                      <button
                        type="button"
                        class="card-add-btn add-cart-btn"
                        data-action="quick-add"
                        data-product-id={item.id}
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                        <span>أضيفي للسلة</span>
                      </button>
                    )}
                  </div>
                </article>
              );
            })
          )}
        </div>

        <!-- Progressive Batch Load More Pagination -->
        <div
          class="catalog-pagination"
          id="catalog-pagination"
          style={ssrCatalogProducts.length > PAGE_SIZE ? 'display: flex;' : 'display: none;'}
        >
          <p class="pagination-status-text" id="pagination-status-text">
            {`معروض ${initialBatchPreviewCount} من أصل ${ssrCatalogProducts.length} منتج`}
          </p>
          <button type="button" id="load-more-btn" class="btn-load-more">
            <span>عرض المزيد</span>
            <i class="fas fa-chevron-down" aria-hidden="true"></i>
          </button>
        </div>
      </main>
    </div>
  </div>

  <!-- Safe JSON SSR Catalog Payload (excludes stockQuantity) -->
  <script type="application/json" id="dandy-ssr-catalog-data" set:html={serializedBootstrapJson}></script>

  <script is:inline>
    const PAGE_SIZE = 12;
    const SAFE_FALLBACK_IMAGE = '/assets/images/logo.png';

    const DEFAULT_CATEGORY_OVERRIDES = {
      '-OvPqarOBOnNgQ_-kpTl': 'body-care',
      '-OW9WB1GTP1GaDoqcd2R': 'skin-care',
      '-OWF9Deint3XcB6iNdCE': 'skin-care',
      '-OvPpguWTAtcaWirD9Um': 'skin-care'
    };

    const SLUG_TO_FILTER_VALUE = {
      'skin-care': 'skin care',
      'hair-care': 'hair care',
      'body-care': 'body care',
      'fragrance': 'perfume'
    };

    const FILTER_VALUE_TO_SLUG = {
      'skin care': 'skin-care',
      'hair care': 'hair-care',
      'body care': 'body-care',
      'perfume': 'fragrance'
    };

    const SLUG_TO_ARABIC_NAME = {
      'skin-care': 'العناية بالبشرة',
      'hair-care': 'العناية بالشعر',
      'body-care': 'العناية بالجسم',
      'fragrance': 'العطور والمعطرات'
    };

    const CATEGORY_PARAM_ALIASES = {
      'skin care': 'skin care',
      'skin-care': 'skin care',
      'skin': 'skin care',
      'عناية بالبشرة': 'skin care',
      'العناية بالبشرة': 'skin care',
      'الزيوت العضوية': 'skin care',
      'مستحضرات النقاء': 'skin care',
      'hair care': 'hair care',
      'hair-care': 'hair care',
      'hair': 'hair care',
      'منتجات الشعر': 'hair care',
      'عناية بالشعر': 'hair care',
      'العناية بالشعر': 'hair care',
      'body care': 'body care',
      'body-care': 'body care',
      'body': 'body care',
      'منتجات الجسم': 'body care',
      'عناية بالجسم': 'body care',
      'العناية بالجسم': 'body care',
      'perfume': 'perfume',
      'fragrance': 'perfume',
      'fragrances': 'perfume',
      'منتجات العطور': 'perfume',
      'عطور ومستخلصات': 'perfume',
      'العطور والمعطرات': 'perfume'
    };

    // Load SSR Bootstrap State if present in HTML
    let ssrBootstrap = { products: [], categoryOverrides: DEFAULT_CATEGORY_OVERRIDES };
    try {
      const dataEl = document.getElementById('dandy-ssr-catalog-data');
      if (dataEl && dataEl.textContent) {
        const parsed = JSON.parse(dataEl.textContent);
        if (parsed && typeof parsed === 'object') {
          ssrBootstrap = parsed;
        }
      }
    } catch (_) {}

    const CATEGORY_OVERRIDES = (ssrBootstrap && ssrBootstrap.categoryOverrides) || DEFAULT_CATEGORY_OVERRIDES;

    // Pure Text Normalization Helper (Arabic Alef, Ya, Diacritics, Tatweel + English Case & Whitespace)
    function normalizeCatalogSearchText(input) {
      if (input === null || input === undefined) return '';
      return String(input)
        .replace(/[\u064B-\u065F\u0670]/g, '') // Strip Arabic harakat/diacritics
        .replace(/\u0640/g, '')               // Strip Arabic tatweel
        .replace(/[أإآٱ]/g, 'ا')              // Unify Alef forms
        .replace(/ى/g, 'ي')                    // Unify Alef Maksura & Ya
        .toLowerCase()
        .replace(/\s+/g, ' ')
        .trim();
    }

    function normalizeDigitsString(raw) {
      if (raw === null || raw === undefined) return '';
      return String(raw)
        .trim()
        .replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 0x0660))
        .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 0x06F0));
    }

    function parseStrictPriceValue(raw) {
      if (raw === null || raw === undefined) return { provided: false, valid: true, value: null };
      const cleaned = normalizeDigitsString(raw);
      if (!cleaned) return { provided: false, valid: true, value: null };
      if (!/^\d+(?:\.\d+)?$/.test(cleaned)) {
        return { provided: true, valid: false, value: null };
      }
      const num = Number(cleaned);
      if (!Number.isFinite(num) || num < 0) {
        return { provided: true, valid: false, value: null };
      }
      return { provided: true, valid: true, value: Math.round(num * 100) / 100 };
    }

    function validatePriceBounds(rawMin, rawMax) {
      const minRes = parseStrictPriceValue(rawMin);
      const maxRes = parseStrictPriceValue(rawMax);

      if ((minRes.provided && !minRes.valid) || (maxRes.provided && !maxRes.valid)) {
        return {
          minPrice: null,
          maxPrice: null,
          isValidRange: false,
          hasBounds: false,
          error: 'يرجى إدخال أسعار رقمية صحيحة وغير سالبة.'
        };
      }

      if (minRes.value !== null && maxRes.value !== null && minRes.value > maxRes.value) {
        return {
          minPrice: minRes.value,
          maxPrice: maxRes.value,
          isValidRange: false,
          hasBounds: true,
          error: 'الحد الأدنى للسعر يجب أن لا يتجاوز الحد الأعلى.'
        };
      }

      return {
        minPrice: minRes.value,
        maxPrice: maxRes.value,
        isValidRange: true,
        hasBounds: minRes.value !== null || maxRes.value !== null,
        error: ''
      };
    }

    function parseMinRatingValue(raw) {
      const cleaned = normalizeDigitsString(raw);
      if (cleaned === '3' || cleaned === '4' || cleaned === '5') {
        return Number(cleaned);
      }
      return null;
    }

    function parsePageValue(raw) {
      const cleaned = normalizeDigitsString(raw);
      if (!/^\d+$/.test(cleaned)) return 1;
      const num = parseInt(cleaned, 10);
      if (!Number.isFinite(num) || num < 1) return 1;
      return Math.min(num, 1000);
    }

    function sanitizeImageUrl(rawUrl) {
      if (!rawUrl || typeof rawUrl !== 'string') return SAFE_FALLBACK_IMAGE;
      const trimmed = rawUrl.trim();
      if (!trimmed) return SAFE_FALLBACK_IMAGE;
      if (trimmed.startsWith('/') && !trimmed.startsWith('//')) {
        return trimmed;
      }
      try {
        const parsed = new URL(trimmed);
        if (parsed.protocol === 'https:') {
          return parsed.toString();
        }
      } catch (_) {}
      return SAFE_FALLBACK_IMAGE;
    }

    function resolveCanonicalCategorySlug(product) {
      if (!product || typeof product !== 'object') return 'skin-care';
      const id = product.id ? String(product.id).trim() : '';
      if (id && Object.prototype.hasOwnProperty.call(CATEGORY_OVERRIDES, id)) {
        return CATEGORY_OVERRIDES[id];
      }
      const rawCat = String(product.category || '').trim().toLowerCase();
      if (rawCat && Object.prototype.hasOwnProperty.call(CATEGORY_PARAM_ALIASES, rawCat)) {
        const filterVal = CATEGORY_PARAM_ALIASES[rawCat];
        return FILTER_VALUE_TO_SLUG[filterVal] || 'skin-care';
      }
      if (rawCat.includes('hair') || rawCat.includes('شعر')) return 'hair-care';
      if (rawCat.includes('body') || rawCat.includes('جسم')) return 'body-care';
      if (rawCat.includes('perfume') || rawCat.includes('عطر') || rawCat.includes('fragrance')) return 'fragrance';
      return 'skin-care';
    }

    function sanitizeProductLink(product) {
      let candidate = '';
      if (typeof window.getProductLink === 'function') {
        candidate = String(window.getProductLink(product) || '');
      } else if (product && product.resolvedSlug) {
        candidate = '/product/' + encodeURIComponent(String(product.resolvedSlug));
      } else if (product && product.slug) {
        candidate = '/product/' + encodeURIComponent(String(product.slug));
      } else if (product && product.id) {
        candidate = '/product/' + encodeURIComponent(String(product.id));
      }

      if (candidate && candidate.startsWith('/') && !candidate.startsWith('//') && !/^javascript:/i.test(candidate)) {
        return candidate;
      }
      return '/all-products';
    }

    function checkProductHasSelectableVariants(product) {
      if (!product || typeof product !== 'object') return false;
      if (window.DandyVariants && typeof window.DandyVariants.hasSelectableVariants === 'function') {
        return window.DandyVariants.hasSelectableVariants(product);
      }
      if (typeof window.hasSelectableVariants === 'function') {
        return window.hasSelectableVariants(product);
      }
      const hasFlag = product.hasVariants === true || product.hasVariants === 'true';
      if (!hasFlag) return false;
      const vt = product.variantType === undefined || product.variantType === null ? '' : String(product.variantType).trim();
      if (vt && vt !== 'scent') return false;
      if (Array.isArray(product.variants)) return product.variants.length > 0;
      if (product.variants && typeof product.variants === 'object') return Object.keys(product.variants).length > 0;
      return false;
    }

    function getEffectiveCatalogPricing(product) {
      const regularPrice = Number(product && product.price) || 0;
      if (window.DandyPinkFriday && typeof window.DandyPinkFriday.getPricing === 'function') {
        const pf = window.DandyPinkFriday.getPricing(product);
        if (pf && pf.isEligible && Number.isFinite(Number(pf.campaignPrice)) && Number(pf.campaignPrice) > 0) {
          return {
            effectivePrice: Number(pf.campaignPrice),
            regularPrice: Number(pf.regularPrice) || regularPrice,
            isPinkFriday: true,
            discountPercentage: Number(pf.discountPercentage) || 0,
            badgeText: pf.badgeText || 'Pink Friday',
            pfPricing: pf
          };
        }
      }
      return {
        effectivePrice: regularPrice,
        regularPrice,
        isPinkFriday: false,
        discountPercentage: 0,
        badgeText: '',
        pfPricing: null
      };
    }

    function normalizeCatalogProductEntry(rawProduct, index) {
      const catSlug = resolveCanonicalCategorySlug(rawProduct);
      const catFilterValue = SLUG_TO_FILTER_VALUE[catSlug] || 'skin care';
      const catArabicName = SLUG_TO_ARABIC_NAME[catSlug] || 'العناية بالبشرة';
      const pricing = getEffectiveCatalogPricing(rawProduct);
      const reviewCount = Number(rawProduct.reviewCount) > 0 ? Math.trunc(Number(rawProduct.reviewCount)) : 0;
      const avgRating = reviewCount > 0 && Number(rawProduct.avgRating) > 0 ? Number(rawProduct.avgRating) : 0;
      const originalPriceNum = rawProduct.originalPrice ? Number(rawProduct.originalPrice) || null : null;
      const discountNum = rawProduct.discount ? Number(rawProduct.discount) || null : null;
      const isSoldOut = rawProduct.isSoldOut === true || rawProduct.isSoldOut === 'true';
      const isOffer = Boolean(
        rawProduct.onSale ||
        (originalPriceNum && originalPriceNum > pricing.regularPrice) ||
        pricing.isPinkFriday
      );

      const safeDesc = String(rawProduct.description || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
      const searchIndex = normalizeCatalogSearchText(
        [rawProduct.name || '', rawProduct.category || '', catArabicName, safeDesc].join(' ')
      );

      return {
        id: String(rawProduct.id || ''),
        name: String(rawProduct.name || 'منتج داندي'),
        resolvedSlug: rawProduct.resolvedSlug ? String(rawProduct.resolvedSlug) : '',
        slug: rawProduct.slug ? String(rawProduct.slug) : '',
        description: safeDesc,
        price: pricing.regularPrice,
        effectivePrice: pricing.effectivePrice,
        originalPrice: originalPriceNum,
        discount: discountNum,
        category: String(rawProduct.category || 'Skin care'),
        categorySlug: catSlug,
        categoryFilterValue: catFilterValue,
        categoryArabicName: catArabicName,
        image: sanitizeImageUrl(rawProduct.image),
        avgRating,
        reviewCount,
        bestSeller: Boolean(rawProduct.bestSeller),
        onSale: Boolean(rawProduct.onSale),
        isOffer,
        isSoldOut,
        hasVariants: checkProductHasSelectableVariants(rawProduct),
        variantType: rawProduct.variantType ? String(rawProduct.variantType) : '',
        variants: rawProduct.variants,
        isPinkFriday: pricing.isPinkFriday,
        pfDiscountPercentage: pricing.discountPercentage,
        pfBadgeText: pricing.badgeText,
        searchIndex,
        originalIndex: index
      };
    }

    function safeReadCartFromStorage() {
      let raw = null;
      try {
        raw = window.localStorage ? window.localStorage.getItem('cart') : null;
      } catch (_) {
        return [];
      }
      if (window.DandyVariants && typeof window.DandyVariants.safeParseCart === 'function') {
        return window.DandyVariants.safeParseCart(raw);
      }
      if (typeof window.safeParseCart === 'function') {
        return window.safeParseCart(raw);
      }
      if (typeof raw === 'string' && raw.trim()) {
        try {
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? parsed.filter((i) => i && typeof i === 'object') : [];
        } catch (_) {
          return [];
        }
      }
      return [];
    }

    function getCatalogCartCount(cart) {
      if (!Array.isArray(cart)) return 0;
      return cart.reduce((sum, item) => {
        const q = Number(item && item.quantity);
        return sum + (Number.isFinite(q) && q > 0 ? Math.trunc(q) : 1);
      }, 0);
    }

    // Store authoritative rendered products by ID (never store product secrets or stockQuantity)
    const productsById = new Map();
    let currentCatalogEntries = [];
    let currentPage = 1;
    let activeSuggestionIdx = -1;
    let lastDrawerTriggerEl = null;

    if (Array.isArray(ssrBootstrap.products) && ssrBootstrap.products.length > 0) {
      currentCatalogEntries = ssrBootstrap.products.map((p, idx) => normalizeCatalogProductEntry(p, idx));
      currentCatalogEntries.forEach((entry) => {
        if (entry.id) productsById.set(entry.id, entry);
      });
    }

    // Drawer Management with ARIA + Escape + Focus Restoration
    function setFilterDrawerOpen(open) {
      const sb = document.getElementById('shop-sidebar');
      const so = document.getElementById('sidebar-overlay');
      const trigger = document.getElementById('mobile-filter-toggle');
      const closeBtn = document.getElementById('close-drawer-btn');

      if (!sb) return;
      const shouldOpen = Boolean(open);

      if (shouldOpen) {
        const activeEl = document.activeElement;
        lastDrawerTriggerEl =
          activeEl && activeEl !== document.body && activeEl !== document.documentElement
            ? activeEl
            : (trigger || null);
        sb.classList.add('active');
        if (so) so.classList.add('active');
        if (trigger) trigger.setAttribute('aria-expanded', 'true');
        if (document.body && document.body.classList) {
          document.body.classList.add('filter-drawer-open');
        }
        if (closeBtn && typeof closeBtn.focus === 'function') {
          setTimeout(() => closeBtn.focus(), 40);
        }
      } else {
        sb.classList.remove('active');
        if (so) so.classList.remove('active');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
        if (document.body && document.body.classList) {
          document.body.classList.remove('filter-drawer-open');
        }
        if (lastDrawerTriggerEl && typeof lastDrawerTriggerEl.focus === 'function') {
          lastDrawerTriggerEl.focus();
          lastDrawerTriggerEl = null;
        }
      }
    }

    window.toggleFilterDrawer = function() {
      const sb = document.getElementById('shop-sidebar');
      const isActive = Boolean(sb && sb.classList.contains('active'));
      setFilterDrawerOpen(!isActive);
