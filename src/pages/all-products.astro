      const wishlistBtn = document.createElement('button');
      wishlistBtn.type = 'button';
      wishlistBtn.className = isFavorited ? 'btn-card-wishlist active' : 'btn-card-wishlist';
      wishlistBtn.setAttribute('data-action', 'wishlist');
      wishlistBtn.setAttribute('data-product-id', entry.id);
      wishlistBtn.title = 'حفظ في المفضلة';
      wishlistBtn.setAttribute('aria-label', `حفظ ${entry.name} في المفضلة`);
      wishlistBtn.setAttribute('aria-pressed', isFavorited ? 'true' : 'false');
