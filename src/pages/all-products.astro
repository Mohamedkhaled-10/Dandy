      const buttons = document.querySelectorAll('#quick-categories-bar .quick-cat-btn');
      if (!buttons || buttons.length === 0) return;

      buttons.forEach((btn) => {
        const target = (btn.getAttribute('data-quick-category') || '').toLowerCase();
