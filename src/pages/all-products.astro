      imgLink.setAttribute('href', productHref);
      imgLink.setAttribute('tabindex', '-1');
      imgLink.setAttribute('aria-hidden', 'true');

      const img = document.createElement('img');
      img.setAttribute('src', entry.image);
      img.setAttribute('alt', entry.name || 'منتج داندي');
      img.setAttribute('width', '400');
      img.setAttribute('height', '400');
      img.setAttribute('loading', index < 4 ? 'eager' : 'lazy');
      img.setAttribute('decoding', 'async');
      img.addEventListener('error', function onImgError() {
        img.removeEventListener('error', onImgError);
        img.setAttribute('src', SAFE_FALLBACK_IMAGE);
      });
      imgLink.appendChild(img);
      imgBox.appendChild(imgLink);
      article.appendChild(imgBox);

      // Content container
      const contentBox = document.createElement('div');
      contentBox.className = 'card-content-box product-info-box';

      const catSpan = document.createElement('span');
