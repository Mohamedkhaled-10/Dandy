    // Safe DOM Card Builder (zero dynamic innerHTML, zero inline onclick attributes)
    function buildProductCardElement(entry, index) {
      const productHref = sanitizeProductLink(entry);
      const isFavorited = window.userWishlistSet && window.userWishlistSet.has(entry.id);

      const article = document.createElement('article');
      article.className = 'product-card product';
      article.setAttribute('data-product-id', entry.id);
      article.setAttribute('data-category', entry.category);
      article.setAttribute('data-category-slug', entry.categorySlug);
      article.setAttribute('data-category-filter', entry.categoryFilterValue);
      article.setAttribute('data-bestseller', entry.bestSeller ? 'true' : 'false');
      article.setAttribute('data-offer', entry.isOffer ? 'true' : 'false');
      article.setAttribute('data-price', String(entry.effectivePrice));
      article.setAttribute('data-rating', String(entry.avgRating));
      article.setAttribute('data-reviews', String(entry.reviewCount));
      article.setAttribute('data-index', String(index));

      // Image container
      const imgBox = document.createElement('div');
      imgBox.className = 'card-image-box product-image-wrap';

      let badgeLabel = '';
      let badgeVariantClass = '';
      let displayOldPrice = null;

      if (entry.isSoldOut) {
        badgeLabel = 'نفذت الكمية';
        badgeVariantClass = 'sold-out';
      } else if (entry.isPinkFriday) {
        badgeLabel = entry.pfBadgeText || 'Pink Friday';
        badgeVariantClass = 'pink-friday';
        if (entry.price > entry.effectivePrice) {
          displayOldPrice = entry.price;
        }
      } else if (entry.originalPrice && entry.originalPrice > entry.price) {
        badgeLabel = 'تخفيض';
        displayOldPrice = entry.originalPrice;
      } else if (entry.onSale && entry.discount && entry.discount > 0 && entry.discount < 100) {
        badgeLabel = `خصم ${entry.discount}%`;
        displayOldPrice = Math.round(entry.price / (1 - entry.discount / 100));
      } else if (entry.bestSeller) {
        badgeLabel = 'الأكثر مبيعاً';
      }

      if (badgeLabel) {
        const badge = document.createElement('span');
        badge.className = badgeVariantClass ? `card-badge ${badgeVariantClass}` : 'card-badge';
        badge.textContent = badgeLabel;
        imgBox.appendChild(badge);
