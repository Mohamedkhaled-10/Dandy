    function normalizeCategoryParam(rawValue) {
      if (typeof rawValue !== 'string') return null;
      const trimmed = rawValue.trim().toLowerCase();
      if (!trimmed) return null;
      if (Object.prototype.hasOwnProperty.call(CATEGORY_PARAM_ALIASES, trimmed)) {
        return CATEGORY_PARAM_ALIASES[trimmed];
      }
      return trimmed;
    }

    window.syncCatalogUrl = function() {
      if (typeof window === 'undefined' || !window.location) return;
      const url = new URL(window.location.href);
      const params = url.searchParams;

      params.delete('category');
      params.delete('status');
      params.delete('search');
      params.delete('sort');
      params.delete('page');
      params.delete('minPrice');
      params.delete('maxPrice');
      params.delete('minRating');

      const selectedCategories = Array.from(
        document.querySelectorAll('#category-filters input[type="checkbox"]:checked')
      ).map((chk) => chk.value);
      selectedCategories.forEach((cat) => params.append('category', cat));

      const selectedStatuses = Array.from(
        document.querySelectorAll('#status-filters input[type="checkbox"]:checked')
      ).map((chk) => chk.value);
      selectedStatuses.forEach((st) => params.append('status', st));

      const sinp = document.getElementById('search-input');
      const searchVal = (sinp?.value || '').trim();
      if (searchVal) {
        params.set('search', searchVal);
      }

      const priceState = getActivePriceBoundsState();
      if (priceState.isValidRange) {
        if (priceState.minPrice !== null) params.set('minPrice', String(priceState.minPrice));
        if (priceState.maxPrice !== null) params.set('maxPrice', String(priceState.maxPrice));
      }

      const minRating = getActiveMinRating();
      if (minRating !== null) {
        params.set('minRating', String(minRating));
      }

      const sortSel = document.getElementById('sort-select');
      const validSortValues = sortSel
        ? Array.from(sortSel.options).map((opt) => opt.value)
        : ['default'];
      const sortVal = sortSel ? sortSel.value : 'default';
      if (sortVal && sortVal !== 'default' && validSortValues.includes(sortVal)) {
        params.set('sort', sortVal);
      }

      if (currentPage > 1) {
        params.set('page', String(currentPage));
      }

      const qs = params.toString();
      const nextUrl = `${url.pathname}${qs ? '?' + qs : ''}${url.hash}`;
      const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;

      if (nextUrl !== currentUrl && window.history && typeof window.history.replaceState === 'function') {
        window.history.replaceState(window.history.state, '', nextUrl);
      }
    };

    window.restoreCatalogStateFromUrl = function() {
      const urlParams = new URLSearchParams(window.location.search);

      const categoryCheckboxes = Array.from(
        document.querySelectorAll('#category-filters input[type="checkbox"]')
      );
      categoryCheckboxes.forEach((chk) => { chk.checked = false; });

      const rawCategories = urlParams.getAll('category');
      rawCategories.forEach((rawCat) => {
        const normalized = normalizeCategoryParam(rawCat);
        if (!normalized) return;
        const match = categoryCheckboxes.find(
          (chk) => chk.value.toLowerCase() === normalized
        );
        if (match) match.checked = true;
      });

      const statusCheckboxes = Array.from(
        document.querySelectorAll('#status-filters input[type="checkbox"]')
      );
      statusCheckboxes.forEach((chk) => { chk.checked = false; });

      const rawStatuses = urlParams.getAll('status');
      rawStatuses.forEach((rawStatus) => {
        const normalized = String(rawStatus || '').trim().toLowerCase();
        if (!normalized) return;
        const match = statusCheckboxes.find(
          (chk) => chk.value.toLowerCase() === normalized
        );
        if (match) match.checked = true;
      });

      const sinp = document.getElementById('search-input');
      if (sinp) {
        const rawSearch = urlParams.get('search');
        sinp.value = rawSearch && rawSearch.trim() ? rawSearch.trim() : '';
      }

      // Restore strictly validated price range from URL
      const minInp = document.getElementById('min-price-input');
      const maxInp = document.getElementById('max-price-input');
      const rawMinPrice = urlParams.get('minPrice');
      const rawMaxPrice = urlParams.get('maxPrice');
      const minParsed = parseStrictPriceValue(rawMinPrice);
      const maxParsed = parseStrictPriceValue(rawMaxPrice);

      let validUrlMin = minParsed.provided && minParsed.valid ? minParsed.value : null;
      let validUrlMax = maxParsed.provided && maxParsed.valid ? maxParsed.value : null;
      if (validUrlMin !== null && validUrlMax !== null && validUrlMin > validUrlMax) {
        // Reject impossible range from URL gracefully
        validUrlMin = null;
        validUrlMax = null;
      }
      if (minInp) minInp.value = validUrlMin !== null ? String(validUrlMin) : '';
      if (maxInp) maxInp.value = validUrlMax !== null ? String(validUrlMax) : '';

      // Restore strictly validated minRating from URL
      const urlMinRating = parseMinRatingValue(urlParams.get('minRating'));
      const ratingRadios = Array.from(document.querySelectorAll('#rating-filters input[type="radio"]'));
      ratingRadios.forEach((r) => {
        r.checked = urlMinRating !== null ? r.value === String(urlMinRating) : r.value === '';
      });

      // Restore sort
      const sortSel = document.getElementById('sort-select');
      if (sortSel) {
        const rawSort = (urlParams.get('sort') || '').trim().toLowerCase();
        const matchingOption = Array.from(sortSel.options).find(
          (opt) => opt.value.toLowerCase() === rawSort
        );
        sortSel.value = matchingOption ? matchingOption.value : 'default';
      }

      // Restore progressive page
      currentPage = parsePageValue(urlParams.get('page'));

      const activeCategories = categoryCheckboxes
        .filter((chk) => chk.checked)
        .map((chk) => chk.value.toLowerCase());
      const activeStatuses = statusCheckboxes
        .filter((chk) => chk.checked)
        .map((chk) => chk.value.toLowerCase());
      const displayQuery = (sinp?.value || '').trim();
      const priceState = validatePriceBounds(validUrlMin, validUrlMax);

      updatePriceFeedbackUI(priceState);
      syncQuickCategoryButtons(activeCategories);

      const clearSearchBtn = document.getElementById('clear-search');
      if (clearSearchBtn) {
        clearSearchBtn.style.display = displayQuery ? 'flex' : 'none';
      }

      renderActiveChips(activeCategories, activeStatuses, displayQuery, priceState, urlMinRating);
      window.updateBadgesAndClearBtn();
    };

    function matchesCategoryFilter(productEl, productEntry, categoryFilters) {
      if (!categoryFilters || categoryFilters.length === 0) return true;
      if (productEntry && productEntry.categoryFilterValue) {
        return categoryFilters.includes(productEntry.categoryFilterValue);
      }
      const rawCat = (productEl.getAttribute('data-category') || '').toLowerCase();
      const computedSlug = resolveCanonicalCategorySlug({
        id: productEl.getAttribute('data-product-id') || '',
        category: rawCat
      });
      const filterVal = SLUG_TO_FILTER_VALUE[computedSlug] || 'skin care';
      return categoryFilters.includes(filterVal) || categoryFilters.includes(rawCat);
    }

    window.applyFiltersAndSort = function(options) {
      const shouldSyncUrl = !options || options.syncUrl !== false;
      const shouldResetPage = Boolean(options && options.resetPage === true);
      if (shouldResetPage) {
        currentPage = 1;
      }

      const sinp = document.getElementById('search-input');
      const rawQuery = (sinp?.value || '').trim();
      const normalizedQuery = normalizeCatalogSearchText(rawQuery);

      const categoryFilters = Array.from(
        document.querySelectorAll('#category-filters input[type="checkbox"]:checked')
      ).map((chk) => chk.value.toLowerCase());

      const statusFilters = Array.from(
        document.querySelectorAll('#status-filters input[type="checkbox"]:checked')
      ).map((chk) => chk.value.toLowerCase());

      const priceState = getActivePriceBoundsState();
      updatePriceFeedbackUI(priceState);

      const minRating = getActiveMinRating();

      const products = Array.from(document.querySelectorAll('#productContainer .product'));
      let visibleCount = 0;

      products.forEach((product) => {
        const pid = product.getAttribute('data-product-id') || '';
        const entry = pid ? productsById.get(pid) : null;

        const isBestseller = product.getAttribute('data-bestseller') === 'true';
        const isOffer = product.getAttribute('data-offer') === 'true';
        const effectivePrice = entry
          ? entry.effectivePrice
          : parseFloat(product.getAttribute('data-price') || '0');
        const reviewCount = entry
          ? entry.reviewCount
          : parseInt(product.getAttribute('data-reviews') || '0', 10);
        const avgRating = entry
          ? entry.avgRating
          : (reviewCount > 0 ? parseFloat(product.getAttribute('data-rating') || '0') : 0);

        const searchSource = entry
          ? entry.searchIndex
          : normalizeCatalogSearchText(
              (product.querySelector('.product-title')?.textContent || '') +
              ' ' +
              (product.querySelector('.card-category')?.textContent || '') +
              ' ' +
              (product.getAttribute('data-category') || '')
            );

        const searchMatch = !normalizedQuery || searchSource.includes(normalizedQuery);
        const categoryMatch = matchesCategoryFilter(product, entry, categoryFilters);

        let statusMatch = true;
        if (statusFilters.length > 0) {
          statusMatch = false;
          if (statusFilters.includes('bestseller') && isBestseller) statusMatch = true;
          if (statusFilters.includes('offers') && isOffer) statusMatch = true;
        }

        let priceMatch = true;
        if (priceState.isValidRange && priceState.hasBounds) {
          if (priceState.minPrice !== null && effectivePrice < priceState.minPrice) priceMatch = false;
          if (priceState.maxPrice !== null && effectivePrice > priceState.maxPrice) priceMatch = false;
        }

        let ratingMatch = true;
        if (minRating !== null) {
          // Only products with real customer reviews (reviewCount > 0 & avgRating >= minRating) pass
          ratingMatch = reviewCount > 0 && avgRating >= minRating;
        }

        if (searchMatch && categoryMatch && statusMatch && priceMatch && ratingMatch) {
          product.style.display = '';
          product.classList.remove('hidden');
          visibleCount++;
        } else {
          product.style.display = 'none';
          product.classList.add('hidden');
          product.classList.remove('batch-hidden');
        }
      });

      const countNum = document.getElementById('visible-count-num');
      if (countNum) countNum.textContent = String(visibleCount);

      const resultsCountEl = document.getElementById('results-count');
      if (resultsCountEl) {
        resultsCountEl.textContent = rawQuery
          ? `تم العثور على ${visibleCount} منتج`
          : `عرض ${visibleCount} من المنتجات`;
      }

      const clearSearchBtn = document.getElementById('clear-search');
      if (clearSearchBtn) {
        clearSearchBtn.style.display = rawQuery ? 'flex' : 'none';
      }

      syncQuickCategoryButtons(categoryFilters);
      renderActiveChips(categoryFilters, statusFilters, rawQuery, priceState, minRating);
      updateEmptyState(visibleCount, products.length);
      window.updateBadgesAndClearBtn();
      window.sortProductsDOM();

      if (shouldSyncUrl) {
        window.syncCatalogUrl();
      }
    };

    window.clearAllFilters = function() {
      const checkboxes = document.querySelectorAll('.shop-sidebar input[type="checkbox"]');
      checkboxes.forEach((chk) => { chk.checked = false; });

      const sinp = document.getElementById('search-input');
      if (sinp) sinp.value = '';
      const sbox = document.getElementById('search-suggestions');
      if (sbox) sbox.style.display = 'none';

      const minInp = document.getElementById('min-price-input');
      if (minInp) minInp.value = '';
      const maxInp = document.getElementById('max-price-input');
      if (maxInp) maxInp.value = '';

      const ratingAll = Array.from(document.querySelectorAll('#rating-filters input[type="radio"]'))
        .find((r) => r.value === '');
      if (ratingAll) ratingAll.checked = true;

      const sortSel = document.getElementById('sort-select');
      if (sortSel) sortSel.value = 'default';

      currentPage = 1;
      window.applyFiltersAndSort({ syncUrl: true, resetPage: true });
    };

    // Wishlist Tracking & Authorization (preserved)
    window.userWishlistSet = window.userWishlistSet || new Set();

    function updateWishlistButtons() {
      document.querySelectorAll('.btn-card-wishlist').forEach((btn) => {
        const pid = btn.getAttribute('data-product-id');
        const svg = btn.querySelector('svg');
        if (pid && window.userWishlistSet.has(pid)) {
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          if (svg) svg.setAttribute('fill', 'currentColor');
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
          if (svg) svg.setAttribute('fill', 'none');
        }
      });
    }

    function initWishlistTracking() {
      const auth = window.auth || (typeof firebase !== 'undefined' && typeof firebase.auth === 'function' ? firebase.auth() : null);
      const dbRef = window.db || (typeof firebase !== 'undefined' && typeof firebase.database === 'function' ? firebase.database() : null);
      if (!auth || typeof auth.onAuthStateChanged !== 'function') return;

      auth.onAuthStateChanged(async (user) => {
        if (!user) {
          window.userWishlistSet.clear();
          updateWishlistButtons();
          return;
        }
        if (!dbRef || typeof dbRef.ref !== 'function') return;

        try {
          const snap = await dbRef.ref('wishlists/' + user.uid).once('value');
          if (snap && typeof snap.exists === 'function' && snap.exists()) {
            const val = snap.val() || {};
            window.userWishlistSet = new Set(Object.keys(val).filter((k) => !!val[k]));
            updateWishlistButtons();
          }
        } catch (e) {
          console.warn('Error loading wishlist set:', e);
        }
      });
    }

    window.toggleCardWishlist = async function(productId, btnEl) {
      if (!productId) return;
      const auth = window.auth || (typeof firebase !== 'undefined' && typeof firebase.auth === 'function' ? firebase.auth() : null);
      const dbRef = window.db || (typeof firebase !== 'undefined' && typeof firebase.database === 'function' ? firebase.database() : null);
      const user = auth ? auth.currentUser : null;

      if (!user) {
        if (typeof window.alert === 'function') {
          window.alert('سجّلي دخولك لحفظ المفضلة');
        }
        window.location.href = '/account-login';
        return;
      }

      if (!dbRef || typeof dbRef.ref !== 'function') return;

      const isFav = Boolean(btnEl && btnEl.classList.contains('active'));
      const svg = btnEl ? btnEl.querySelector('svg') : null;

      try {
        if (isFav) {
          await dbRef.ref('wishlists/' + user.uid + '/' + productId).remove();
          window.userWishlistSet.delete(productId);
          if (btnEl) {
            btnEl.classList.remove('active');
            btnEl.setAttribute('aria-pressed', 'false');
          }
          if (svg) svg.setAttribute('fill', 'none');
        } else {
          await dbRef.ref('wishlists/' + user.uid + '/' + productId).set(true);
          window.userWishlistSet.add(productId);
          if (btnEl) {
            btnEl.classList.add('active');
            btnEl.setAttribute('aria-pressed', 'true');
          }
          if (svg) svg.setAttribute('fill', 'currentColor');
        }
      } catch (err) {
        console.error('Error toggling wishlist:', err);
      }
    };

    let activeToastTimer = null;

    function showCatalogCartToast(productName) {
      const existing = document.getElementById('dandy-catalog-cart-toast');
      if (existing) existing.remove();
      if (activeToastTimer) {
        clearTimeout(activeToastTimer);
        activeToastTimer = null;
      }

      const toast = document.createElement('div');
      toast.id = 'dandy-catalog-cart-toast';
      toast.className = 'dandy-catalog-cart-toast';
      toast.setAttribute('role', 'status');
      toast.setAttribute('aria-live', 'polite');

      const icon = document.createElement('i');
      icon.className = 'fas fa-check-circle dandy-toast-icon';
      icon.setAttribute('aria-hidden', 'true');

      const messageSpan = document.createElement('span');
      const cleanName = String(productName || 'المنتج').trim();
      messageSpan.textContent = `تمت إضافة "${cleanName}" إلى السلة بنجاح`;

      const cartLink = document.createElement('a');
      cartLink.className = 'dandy-toast-link';
      cartLink.setAttribute('href', '/cart');
      cartLink.textContent = 'عرض السلة';

      toast.appendChild(icon);
      toast.appendChild(messageSpan);
      toast.appendChild(cartLink);

      if (document.body) {
        document.body.appendChild(toast);
      }

      activeToastTimer = setTimeout(() => {
        toast.remove();
        activeToastTimer = null;
      }, 3200);
    }

    function syncCartBadgesUI(cart) {
      if (typeof window.updateSharedCartCount === 'function') {
        window.updateSharedCartCount();
      }
      if (typeof window.updateCartCount === 'function') {
        window.updateCartCount();
      }
      const totalQty = getCatalogCartCount(cart);
      const headerBadge = document.getElementById('cart-count');
      if (headerBadge) headerBadge.textContent = String(totalQty);
      const sharedBadge = document.getElementById('shared-cart-count');
      if (sharedBadge) sharedBadge.textContent = String(totalQty);
    }

    function dispatchCartUpdatedEvent(detail) {
      if (typeof window.dispatchEvent !== 'function') return;
      try {
        if (typeof CustomEvent === 'function') {
          window.dispatchEvent(new CustomEvent('cart-updated', { detail }));
          return;
        }
      } catch (_) {}
      try {
        window.dispatchEvent({ type: 'cart-updated', detail });
      } catch (_) {}
    }

    function trackMetaAddToCartOnce(cartItem) {
      if (!cartItem) return;
      if (window.DandyMeta && typeof window.DandyMeta.trackAddToCart === 'function') {
        window.DandyMeta.trackAddToCart(cartItem);
      } else if (typeof window.fbq === 'function') {
        window.fbq('track', 'AddToCart', {
          content_name: cartItem.name,
          content_ids: [cartItem.productId || cartItem.id],
          content_type: 'product',
          value: Number(cartItem.price) || 0,
          currency: 'EGP'
        });
      }
    }

    // Unified Quick Add using shared mergeProductToCart() & safeParseCart()
    function performCatalogQuickAdd(productInput) {
      if (!productInput || !productInput.id) return { ok: false, reason: 'PRODUCT_NOT_FOUND' };

      const product = productsById.get(String(productInput.id)) || productInput;
      if (product.isSoldOut === true || product.isSoldOut === 'true') {
        return { ok: false, reason: 'PRODUCT_SOLD_OUT' };
      }

      if (checkProductHasSelectableVariants(product)) {
        window.location.href = sanitizeProductLink(product);
        return { ok: false, reason: 'REDIRECT_TO_VARIANTS' };
      }

      const mergeFn =
        (window.DandyVariants && typeof window.DandyVariants.mergeProductToCart === 'function' && window.DandyVariants.mergeProductToCart) ||
        (typeof window.mergeProductToCart === 'function' && window.mergeProductToCart);

      if (!mergeFn) {
        console.error('Shared mergeProductToCart utility is unavailable.');
        return { ok: false, reason: 'CART_UTILITY_UNAVAILABLE' };
      }

      const existingCart = safeReadCartFromStorage();
      const pfPricing =
        window.DandyPinkFriday && typeof window.DandyPinkFriday.getPricing === 'function'
          ? window.DandyPinkFriday.getPricing(product)
          : null;

      const result = mergeFn(existingCart, product, {
        quantity: 1,
        pinkFridayPricing: pfPricing && pfPricing.isEligible ? pfPricing : null
      });

      if (!result || !result.ok) {
        if (result && result.reason === 'VARIANT_REQUIRED') {
          window.location.href = sanitizeProductLink(product);
        }
        return result || { ok: false, reason: 'MERGE_FAILED' };
      }

      try {
        if (window.localStorage) {
          window.localStorage.setItem('cart', JSON.stringify(result.cart));
        }
      } catch (err) {
        console.error('Failed to persist catalog cart update:', err);
        return { ok: false, reason: 'STORAGE_WRITE_FAILED' };
      }

      syncCartBadgesUI(result.cart);
      dispatchCartUpdatedEvent({ item: result.item, cart: result.cart });
      trackMetaAddToCartOnce(result.item);
      showCatalogCartToast(result.item.name || product.name);
      return result;
    }

    window.quickAddByProductId = function(productId) {
      const entry = productsById.get(String(productId || ''));
      if (!entry) return { ok: false, reason: 'PRODUCT_NOT_FOUND' };
      return performCatalogQuickAdd(entry);
    };

    // Backward-compatible quickAdd wrapper that delegates to authoritative shared cart contract
    window.quickAdd = function(id, name, price, image, discount, onSale, hasVariants, slug) {
      const existing = productsById.get(String(id || ''));
      if (existing) {
        return performCatalogQuickAdd(existing);
      }
      return performCatalogQuickAdd({
        id: String(id || ''),
        name: name || 'منتج داندي',
        price: Number(price) || 0,
        image: sanitizeImageUrl(image),
        discount: discount || null,
        onSale: Boolean(onSale),
        hasVariants: Boolean(hasVariants),
        resolvedSlug: slug || ''
      });
    };

    // Render products array safely via createElement + textContent
    function renderCatalogProducts(rawList) {
      const container = document.getElementById('productContainer');
      if (!container) return;

      container.innerHTML = '';
      productsById.clear();

      const visibleRaw = (Array.isArray(rawList) ? rawList : []).filter((p) => p && !p.isHidden);

      const heroCountEl = document.getElementById('catalog-total-available');
      if (heroCountEl) heroCountEl.textContent = String(visibleRaw.length);

      if (visibleRaw.length === 0) {
        currentCatalogEntries = [];
        const emptyDb = document.createElement('div');
        emptyDb.className = 'empty-products-state';
        emptyDb.id = 'empty-database-state';

        const iconWrap = document.createElement('div');
        iconWrap.className = 'empty-icon-wrap';
        iconWrap.setAttribute('aria-hidden', 'true');
        const icon = document.createElement('i');
        icon.className = 'fas fa-box-open';
        iconWrap.appendChild(icon);

        const h3 = document.createElement('h3');
        h3.textContent = 'لا توجد منتجات متاحة حالياً';

        const p = document.createElement('p');
        p.textContent = 'يتم تحديث مجموعتنا قريباً، تفقّدي الصفحة لاحقاً.';

        emptyDb.appendChild(iconWrap);
        emptyDb.appendChild(h3);
        emptyDb.appendChild(p);
        container.appendChild(emptyDb);

        const countNum = document.getElementById('visible-count-num');
        if (countNum) countNum.textContent = '0';
        const paginationWrap = document.getElementById('catalog-pagination');
        if (paginationWrap) paginationWrap.style.display = 'none';
        return;
      }

      currentCatalogEntries = visibleRaw.map((item, idx) => {
        const normalized = normalizeCatalogProductEntry(item, idx);
        if (normalized.id) productsById.set(normalized.id, normalized);
        const cardEl = buildProductCardElement(normalized, idx);
        container.appendChild(cardEl);
        return normalized;
      });

      updateWishlistButtons();
      window.applyFiltersAndSort({ syncUrl: false });
    }

    function showConnectionNotice(show) {
      const notice = document.getElementById('catalog-connection-notice');
      if (notice) {
        notice.style.display = show ? 'flex' : 'none';
      }
    }

    function startFirebaseCatalogSync() {
      const db = window.db || (typeof firebase !== 'undefined' && typeof firebase.database === 'function' ? firebase.database() : null);

      if (!db || typeof db.ref !== 'function') {
        // Keep SSR cards visible and show non-blocking notice
        showConnectionNotice(true);
        return;
      }

      try {
        db.ref('products').on(
          'value',
          (snapshot) => {
            showConnectionNotice(false);
            if (!snapshot || typeof snapshot.exists !== 'function' || !snapshot.exists()) {
              renderCatalogProducts([]);
              return;
            }
            const allProductsData = [];
            snapshot.forEach((child) => {
              allProductsData.push({ id: child.key, ...child.val() });
            });
            allProductsData.reverse();
            renderCatalogProducts(allProductsData);
          },
          (err) => {
            console.warn('Firebase live products listener fallback active:', err);
            // Never erase SSR cards on Firebase failure
            showConnectionNotice(true);
          }
        );
      } catch (err) {
        console.warn('Firebase live products listener failed to initialize:', err);
        showConnectionNotice(true);
      }
    }

    // Delegated click handler on #productContainer (Quick Add & Wishlist — zero inline JS handlers)
    const productContainerEl = document.getElementById('productContainer');
    if (productContainerEl) {
      productContainerEl.addEventListener('click', (e) => {
        const target = e.target;
        if (!target || typeof target.closest !== 'function') return;

        const quickAddBtn = target.closest('[data-action="quick-add"]');
        if (quickAddBtn) {
          e.preventDefault();
          e.stopPropagation();
          const pid = quickAddBtn.getAttribute('data-product-id');
          if (pid) window.quickAddByProductId(pid);
          return;
        }

        const wishBtn = target.closest('[data-action="wishlist"]');
        if (wishBtn) {
          e.preventDefault();
          e.stopPropagation();
          const pid = wishBtn.getAttribute('data-product-id');
          if (pid) window.toggleCardWishlist(pid, wishBtn);
        }
      });
    }

    // Safe Search Suggestions & Keyboard Controls
    const searchInput = document.getElementById('search-input');
    const clearBtn = document.getElementById('clear-search');
    const suggestionsBox = document.getElementById('search-suggestions');

    function dismissSuggestions() {
      if (suggestionsBox) suggestionsBox.style.display = 'none';
      activeSuggestionIdx = -1;
    }

    function buildSuggestions(rawQuery) {
      if (!suggestionsBox) return;
      const trimmed = String(rawQuery || '').trim();
      const normQuery = normalizeCatalogSearchText(trimmed);

      if (!normQuery) {
        dismissSuggestions();
        return;
      }

      const matches = [];
      const seenNames = new Set();

      if (currentCatalogEntries.length > 0) {
        currentCatalogEntries.forEach((entry) => {
          if (!seenNames.has(entry.name) && entry.searchIndex.includes(normQuery)) {
            seenNames.add(entry.name);
            matches.push(entry.name);
          }
        });
      } else {
        document.querySelectorAll('#productContainer .product .product-title').forEach((item) => {
          const name = (item.textContent || '').trim();
          if (name && !seenNames.has(name) && normalizeCatalogSearchText(name).includes(normQuery)) {
            seenNames.add(name);
            matches.push(name);
          }
        });
      }

      suggestionsBox.innerHTML = '';
      activeSuggestionIdx = -1;

      if (matches.length === 0) {
        const emptyMsg = document.createElement('div');
        emptyMsg.className = 'search-suggestion-empty';
        emptyMsg.textContent = `لا توجد اقتراحات مطابقة لـ "${trimmed}"`;
        suggestionsBox.appendChild(emptyMsg);
        suggestionsBox.style.display = 'block';
        return;
      }

      matches.slice(0, 6).forEach((name, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'search-suggestion-item';
        btn.setAttribute('role', 'option');
        btn.setAttribute('data-suggestion-idx', String(idx));
        btn.textContent = name;
        btn.addEventListener('click', () => {
          if (searchInput) searchInput.value = name;
          dismissSuggestions();
          window.applyFiltersAndSort({ resetPage: true });
        });
        suggestionsBox.appendChild(btn);
      });

      suggestionsBox.style.display = 'block';
    }

    function runLiveSearch() {
      currentPage = 1;
      window.applyFiltersAndSort({ resetPage: true });
      buildSuggestions(searchInput ? searchInput.value : '');
    }

    if (searchInput) {
      searchInput.addEventListener('input', runLiveSearch);
      searchInput.addEventListener('focus', () => {
        if (searchInput.value && searchInput.value.trim()) {
          buildSuggestions(searchInput.value);
        }
      });
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          dismissSuggestions();
          return;
        }
        if (!suggestionsBox || suggestionsBox.style.display !== 'block') {
          if (e.key === 'Enter') {
            e.preventDefault();
            currentPage = 1;
            window.applyFiltersAndSort({ resetPage: true });
          }
          return;
        }
        const items = Array.from(suggestionsBox.querySelectorAll('.search-suggestion-item'));
        if (e.key === 'ArrowDown' && items.length > 0) {
          e.preventDefault();
          activeSuggestionIdx = (activeSuggestionIdx + 1) % items.length;
          items.forEach((it, idx) => it.classList.toggle('is-active', idx === activeSuggestionIdx));
        } else if (e.key === 'ArrowUp' && items.length > 0) {
          e.preventDefault();
          activeSuggestionIdx = activeSuggestionIdx <= 0 ? items.length - 1 : activeSuggestionIdx - 1;
          items.forEach((it, idx) => it.classList.toggle('is-active', idx === activeSuggestionIdx));
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeSuggestionIdx >= 0 && items[activeSuggestionIdx]) {
            searchInput.value = (items[activeSuggestionIdx].textContent || '').trim();
          }
          dismissSuggestions();
          window.applyFiltersAndSort({ resetPage: true });
        }
      });
    }

    document.getElementById('trigger-search')?.addEventListener('click', () => {
      runLiveSearch();
      if (searchInput) searchInput.focus();
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        dismissSuggestions();
        currentPage = 1;
        window.applyFiltersAndSort({ resetPage: true });
      });
    }

    // Event Hooks for Sidebar, Quick Category Tabs, Price Range, Rating, Sort, Load More, and Drawer
    document.getElementById('mobile-filter-toggle')?.addEventListener('click', () => {
      window.toggleFilterDrawer();
    });
    document.getElementById('close-drawer-btn')?.addEventListener('click', () => {
      setFilterDrawerOpen(false);
    });
    document.getElementById('sidebar-overlay')?.addEventListener('click', () => {
      setFilterDrawerOpen(false);
    });

    document.getElementById('clear-all-filters')?.addEventListener('click', () => {
      window.clearAllFilters();
    });
    document.getElementById('chips-clear-all')?.addEventListener('click', () => {
      window.clearAllFilters();
    });
    document.getElementById('retry-firebase-sync')?.addEventListener('click', () => {
      startFirebaseCatalogSync();
    });

    document.querySelectorAll('#quick-categories-bar .quick-cat-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = (btn.getAttribute('data-quick-category') || '').toLowerCase();
        const catBoxes = Array.from(document.querySelectorAll('#category-filters input[type="checkbox"]'));
        if (!target) {
          catBoxes.forEach((chk) => { chk.checked = false; });
        } else {
          const isOnlyThisSelected =
            catBoxes.filter((chk) => chk.checked).length === 1 &&
            catBoxes.some((chk) => chk.checked && chk.value.toLowerCase() === target);
          catBoxes.forEach((chk) => {
            chk.checked = isOnlyThisSelected ? false : chk.value.toLowerCase() === target;
          });
        }
        currentPage = 1;
        window.applyFiltersAndSort({ resetPage: true });
      });
    });

    document.querySelectorAll('.shop-sidebar input[type="checkbox"]').forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        currentPage = 1;
        window.applyFiltersAndSort({ resetPage: true });
      });
    });

    document.querySelectorAll('#rating-filters input[type="radio"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        currentPage = 1;
        window.applyFiltersAndSort({ resetPage: true });
      });
    });

    const minPriceInput = document.getElementById('min-price-input');
    const maxPriceInput = document.getElementById('max-price-input');

    function triggerPriceRangeFilter() {
      currentPage = 1;
      window.applyFiltersAndSort({ resetPage: true });
    }

    document.getElementById('apply-price-filter')?.addEventListener('click', triggerPriceRangeFilter);
    document.getElementById('reset-price-filter')?.addEventListener('click', () => {
      if (minPriceInput) minPriceInput.value = '';
      if (maxPriceInput) maxPriceInput.value = '';
      triggerPriceRangeFilter();
    });

    [minPriceInput, maxPriceInput].forEach((inp) => {
      if (!inp) return;
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          triggerPriceRangeFilter();
        }
      });
      inp.addEventListener('change', triggerPriceRangeFilter);
    });

    const sortSelect = document.getElementById('sort-select');
    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        window.sortProductsDOM();
        window.syncCatalogUrl();
      });
    }

    document.getElementById('load-more-btn')?.addEventListener('click', () => {
      currentPage += 1;
      applyPaginationToProducts();
      window.syncCatalogUrl();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const sb = document.getElementById('shop-sidebar');
        if (sb && sb.classList.contains('active')) {
          setFilterDrawerOpen(false);
        }
        dismissSuggestions();
      }
    });

    document.addEventListener('click', (e) => {
      if (
        suggestionsBox &&
        typeof suggestionsBox.contains === 'function' &&
        !suggestionsBox.contains(e.target) &&
        e.target !== searchInput
      ) {
        dismissSuggestions();
      }
    });

    // Expose pure helpers on window for deterministic testing & diagnostics
    window.DandyCatalogHelpers = {
      PAGE_SIZE,
      normalizeCatalogSearchText,
      validatePriceBounds,
      parseMinRatingValue,
      parsePageValue,
      sanitizeImageUrl,
      sanitizeProductLink,
      resolveCanonicalCategorySlug,
      getEffectiveCatalogPricing,
      normalizeCatalogProductEntry,
      safeReadCartFromStorage,
      performCatalogQuickAdd,
      renderCatalogProducts
    };

    // Attach safe image error fallback for SSR cards without inline event attributes
    document.querySelectorAll('#productContainer img').forEach((imgEl) => {
      if (!imgEl || typeof imgEl.addEventListener !== 'function') return;
      if (imgEl.complete && imgEl.naturalWidth === 0 && imgEl.getAttribute('src') !== SAFE_FALLBACK_IMAGE) {
        imgEl.setAttribute('src', SAFE_FALLBACK_IMAGE);
      }
      imgEl.addEventListener('error', function onSsrImgError() {
        imgEl.removeEventListener('error', onSsrImgError);
        imgEl.setAttribute('src', SAFE_FALLBACK_IMAGE);
      });
    });

    // Initial boot: restore URL state, apply to any SSR cards immediately, init wishlist & Firebase live sync
    window.restoreCatalogStateFromUrl();
    if (document.querySelectorAll('#productContainer .product').length > 0) {
      window.applyFiltersAndSort({ syncUrl: false });
    }
    initWishlistTracking();
    startFirebaseCatalogSync();
  </script>
</BaseLayout>
