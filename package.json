{
  "name": "dandy",
  "version": "1.0.0",
  "description": "Premium Arabic beauty, skincare, and natural cosmetics store.",
  "type": "module",
  "scripts": {
    "dev": "node -r ./patch-env.cjs ./node_modules/astro/bin/astro.mjs dev --host 0.0.0.0 --port 3000",
    "build": "node -r ./patch-env.cjs ./node_modules/astro/bin/astro.mjs build",
    "preview": "node -r ./patch-env.cjs ./node_modules/astro/bin/astro.mjs preview --host 0.0.0.0 --port 3000",
    "start": "node server.js",
    "lint": "node -r ./patch-env.cjs ./node_modules/astro/bin/astro.mjs sync"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "astro": "^7.3.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "gsap": "^3.15.0",
    "sortablejs": "^1.15.7"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.8",
    "@rolldown/binding-darwin-x64": "^1.2.8",
    "@rolldown/binding-linux-x64-gnu": "^1.2.8",
    "@rolldown/binding-win32-x64-msvc": "^1.2.8"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.9"
  },
  "overrides": {
    "jose": "^5.9.6"
  }
}